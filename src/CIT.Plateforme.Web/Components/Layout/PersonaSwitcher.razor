@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Web.Services
@inject IContexteUtilisateurWeb ContexteService
@inject NavigationManager NavigationManager

@if (Contexte?.EstAuthentifie == true && Contexte.EspacesDisponibles.Count > 1)
{
    <div class="dropdown me-3">
        <button class="btn btn-outline-primary btn-sm dropdown-toggle d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span>🔄 Espace : <strong>@LibelleEspace(Contexte.EspaceActif)</strong></span>
        </button>
        <ul class="dropdown-menu shadow-sm">
            @foreach (var espace in Contexte.EspacesDisponibles)
            {
                <li>
                    <button class="dropdown-item @(espace == Contexte.EspaceActif ? "active" : "")" type="button" @onclick="() => ChangerEspace(espace)">
                        @LibelleEspace(espace)
                    </button>
                </li>
            }
        </ul>
    </div>
}

@code {
    [Parameter]
    public ContexteUtilisateurVue? Contexte { get; set; }

    private void ChangerEspace(EspaceFonctionnel nouvelEspace)
    {
        ContexteService.BasculerEspace(nouvelEspace);
        var cible = nouvelEspace switch
        {
            EspaceFonctionnel.Supervision => "/supervision",
            EspaceFonctionnel.AdministrationCit => "/administration/comptes-a-valider",
            EspaceFonctionnel.Agent => "/agent/dashboard",
            EspaceFonctionnel.AdministrateurSociete => "/societe/dashboard",
            _ => "/client/dashboard"
        };
        NavigationManager.NavigateTo(cible);
    }

    private static string LibelleEspace(EspaceFonctionnel espace) => espace switch
    {
        EspaceFonctionnel.Client => "Espace Client",
        EspaceFonctionnel.AdministrateurSociete => "Espace Entreprise",
        EspaceFonctionnel.Agent => "Espace Opérateur CIT",
        EspaceFonctionnel.Supervision => "Supervision CIT",
        EspaceFonctionnel.AdministrationCit => "Administration CIT",
        _ => espace.ToString()
    };
}
