@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services

@if (Contexte?.EstAuthentifie == true && Contexte.EspacesDisponibles.Count > 1)
{
    @* Ouverture par <details> natif et bascule par POST : la mise en page est rendue en SSR
       statique (Routes.razor ne déclare aucun @rendermode), donc ni @onclick ni Bootstrap JS
       n'y sont opérants. Le POST dépose un cookie de préférence puis redirige — le choix
       survit ainsi à la requête, ce que ne permettait pas un champ de service scoped. *@
    <details class="cit-user-menu cit-persona mb-2">
        <summary class="cit-user-trigger cit-persona-trigger" aria-haspopup="true">
            <span class="d-flex align-items-center gap-2 flex-grow-1" style="min-width:0;">
                <span>🔄</span>
                <span class="small fw-semibold text-truncate">@LibelleEspace(Contexte.EspaceActif)</span>
            </span>
            <span class="cit-user-caret">▾</span>
        </summary>

        <div class="cit-user-dropdown cit-persona-dropdown" role="menu">
            @foreach (var espace in Contexte.EspacesDisponibles)
            {
                <form method="post" action="/contexte/espace" class="m-0">
                    <AntiforgeryToken />
                    <input type="hidden" name="espace" value="@espace" />
                    <button type="submit" role="menuitem"
                            class="cit-user-dropdown-item @(espace == Contexte.EspaceActif ? "actif" : "")">
                        <span>@(espace == Contexte.EspaceActif ? "✓" : "")</span>
                        @LibelleEspace(espace)
                    </button>
                </form>
            }
        </div>
    </details>
}

@code {
    [Parameter]
    public ContexteUtilisateurVue? Contexte { get; set; }

    private static string LibelleEspace(EspaceFonctionnel espace) => espace switch
    {
        EspaceFonctionnel.Client => SharedResourcesLocalizer.Get("Header.SpaceClient"),
        EspaceFonctionnel.AdministrateurSociete => SharedResourcesLocalizer.Get("Header.SpaceCompany"),
        EspaceFonctionnel.Agent => SharedResourcesLocalizer.Get("Header.SpaceOperator"),
        EspaceFonctionnel.Supervision => SharedResourcesLocalizer.Get("Header.SpaceSupervision"),
        EspaceFonctionnel.AdministrationCit => SharedResourcesLocalizer.Get("Header.SpaceAdmin"),
        EspaceFonctionnel.SupportN1 => SharedResourcesLocalizer.Get("Header.SpaceSupportN1"),
        _ => espace.ToString()
    };
}
