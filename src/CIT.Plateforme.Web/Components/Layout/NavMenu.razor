@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory
@inject IStringLocalizer<SharedResources> Loc
@implements IDisposable

@*
    MENU LATÉRAL — REMÉDIATION RECETTE UAT (D-05/D-15).

    Ce composant ne décide plus rien. Il affichait auparavant, pour chaque espace fonctionnel, la
    totalité des entrées de cet espace — sans jamais regarder les habilitations. La recette a
    mesuré jusqu'à 16 liens sur 22 menant à « Accès Refusé ».

    Le choix de ce qui est visible appartient désormais à ConstruireNavigationQuery, qui l'établit à
    partir des habilitations réelles et de RegleHabilitation — la même règle que celle appliquée par
    AutorisationService pour refuser côté serveur. Écrire ici un second test « cet utilisateur
    a-t-il cette permission ? » aurait créé une deuxième vérité, condamnée à diverger de la première.

    Le menu n'est pas une frontière de sécurité : chaque page garde son contrôle serveur, et il
    refuse toujours à qui tape l'URL directement.
*@

<div class="cit-sidebar">
    @if (_contexte is null)
    {
        <div class="p-3 text-muted small">@Loc["Nav.MenuLoading"]</div>
    }
    else if (!_contexte.EstAuthentifie)
    {
        <div class="cit-nav-group-title">@Loc["Nav.Home"]</div>
        <NavLink class="cit-nav-item" href="/" Match="NavLinkMatch.All">
            <span>🏠</span> @Loc["Nav.Home"]
        </NavLink>
        <NavLink class="cit-nav-item" href="/comptes/connexion">
            <span>🔑</span> @Loc["Nav.SignIn"]
        </NavLink>
        <NavLink class="cit-nav-item" href="/comptes/soumettre">
            <span>📝</span> @Loc["Nav.CreateCompanyAccount"]
        </NavLink>
    }
    else if (Rail && _groupes.Count > 0)
    {
        @* RAIL D'ICÔNES (bureau) — une icône par groupe ; son panneau de liens s'ouvre au survol ET
           au focus clavier (:focus-within), sans JavaScript : le layout est rendu en SSR statique.
           Le groupe contenant la page active est mis en évidence en CSS (:has(.active)). *@
        <nav class="cit-rail" aria-label="@Loc["Header.NavMenuAria"]">
            <a href="/" class="cit-rail-logo" title="YABA">
                <img src="images/logo_cit.jpeg" alt="Côte d'Ivoire Terminal" />
            </a>
            <div class="cit-rail-groupes">
                @foreach (var groupe in _groupes)
                {
                    <div class="cit-rail-groupe">
                        <button type="button" class="cit-rail-btn" aria-haspopup="true" aria-label="@Loc[groupe.Titre]">
                            <span aria-hidden="true">@groupe.Icone</span>
                        </button>
                        <div class="cit-rail-flyout" role="menu">
                            <div class="cit-rail-flyout-titre">@Loc[groupe.Titre]</div>
                            @foreach (var lien in groupe.Liens)
                            {
                                <NavLink class="cit-rail-lien" href="@lien.Route" role="menuitem"
                                         Match="@(lien.CorrespondanceExacte ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                                    <span aria-hidden="true">@lien.Icone</span> @Loc[lien.Libelle]
                                </NavLink>
                            }
                        </div>
                    </div>
                }
            </div>
            @* Le changement d'espace vit dans la barre supérieure (PersonaSwitcher EnBarre). *@
        </nav>
    }
    else
    {
        <div class="px-2 pt-2 pb-1 border-bottom border-white border-opacity-10 mb-2">
            <PersonaSwitcher Contexte="@_contexte" />
        </div>

        @if (_groupes.Count == 0)
        {
            @* Un compte sans aucune habilitation exploitable. Le dire vaut mieux que présenter un
               menu de liens qui refuseront tous. *@
            <div class="p-3 small text-white-50">
                @Loc["Nav.NoAccessibleScreen"]
            </div>
        }
        else
        {
            @foreach (var groupe in _groupes)
            {
                <details class="cit-accordion-group" open>
                    <summary class="cit-accordion-header">
                        <span class="cit-accordion-title">
                            <span>@groupe.Icone</span> @Loc[groupe.Titre]
                        </span>
                        <span class="cit-accordion-chevron">▶</span>
                    </summary>
                    <div class="cit-accordion-body">
                        @foreach (var lien in groupe.Liens)
                        {
                            <NavLink class="cit-nav-subitem" href="@lien.Route"
                                     Match="@(lien.CorrespondanceExacte ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                                <span>@lien.Icone</span> @Loc[lien.Libelle]
                            </NavLink>
                        }
                    </div>
                </details>
            }
        }
    }
</div>

@code {
    /// <summary>Vrai sur bureau : rail d'icônes à panneaux. Faux (mobile) : liste dépliée.</summary>
    [Parameter] public bool Rail { get; set; }

    private ContexteUtilisateurVue? _contexte;
    private IReadOnlyList<GroupeNavigationVue> _groupes = [];

    protected override async Task OnInitializedAsync()
    {
        ContexteService.SurChangementContexte += StateHasChangedWrapper;
        await RechargerAsync();
    }

    private async Task RechargerAsync()
    {
        _contexte = await ContexteService.ObtenirContexteAsync();

        if (_contexte is null || !_contexte.EstAuthentifie)
        {
            _groupes = [];
            return;
        }

        // ISOLATION PAR OPÉRATION — même motif que les pages d'administration (cf. 75bd614).
        // Le menu latéral est rendu sur CHAQUE page : interroger la base sur le DbContext partagé
        // de la requête le met en concurrence avec le rendu de la page elle-même, et le DbContext
        // n'est pas sûr en accès concurrent. Un scope par appel supprime la collision.
        using var scope = ScopeFactory.CreateScope();
        var construire = scope.ServiceProvider.GetRequiredService<ConstruireNavigationQuery>();

        _groupes = await construire.ExecuterAsync(
            _contexte.UtilisateurId,
            _contexte.EspaceActif,
            _contexte.SocieteId.HasValue);
    }

    private void StateHasChangedWrapper()
    {
        InvokeAsync(async () =>
        {
            await RechargerAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ContexteService.SurChangementContexte -= StateHasChangedWrapper;
    }
}
