@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.Localization
@inject IContexteUtilisateurWeb ContexteService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResources> Loc
@* FEATURE 009 (NOT-03) — compteur de non-lues du seul utilisateur authentifié. *@
@using Microsoft.Extensions.DependencyInjection
@inject Microsoft.Extensions.DependencyInjection.IServiceScopeFactory ScopeFactory

<header class="cit-header">
    <div class="d-flex align-items-center gap-3">
        @* Menu mobile — <details>/<summary> NATIF, sans Blazor.

           CORRECTIF : ce bouton était un <button type="button" @onclick="..."> qui ne se déclenchait JAMAIS.
           MainLayout est rendu en SSR statique (Routes.razor ne déclare aucun @rendermode) :
           il n'existe aucun circuit interactif pour le layout, donc aucun gestionnaire Blazor
           n'y est câblé côté client. Le panneau, son voile et sa croix de fermeture reposaient
           tous sur ce même @onclick mort.

           Même patron que le menu utilisateur (.cit-user-menu) et l'accordéon du menu latéral,
           déjà convertis pour cette raison. Le panneau vit ici, dans le <details>, car summary
           et contenu doivent partager le même élément ; .cit-modal-backdrop étant en
           position:fixed, sa place dans le DOM n'a aucune incidence sur l'affichage.

           Fermeture : nouvel appui sur le burger (qui passe au-dessus du voile et devient ✕),
           ou navigation vers un lien du menu — le rechargement SSR referme le <details>. *@
        @if (Contexte?.EstAuthentifie == true)
        {
            <details class="cit-mobile-menu d-lg-none">
                <summary class="btn btn-outline-secondary btn-sm cit-mobile-menu-trigger"
                         role="button" aria-label="@Loc["Header.NavMenuAria"]">
                    <span class="cit-burger-ouvrir" aria-hidden="true">☰</span>
                    <span class="cit-burger-fermer" aria-hidden="true">✕</span>
                </summary>

                <div class="cit-modal-backdrop">
                    <div class="cit-mobile-sidebar h-100 p-3">
                        <div class="d-flex align-items-center mb-4 pb-2 border-bottom border-light">
                            <span class="fw-bold fs-5 text-white">@Loc["Header.Menu"]</span>
                        </div>
                        <NavMenu />
                    </div>
                </div>
            </details>
        }

        @* Sur bureau, le logo vit dans le rail : la barre ne le répète pas (sauf pour un visiteur). *@
        <a href="/" class="cit-brand @(Contexte?.EstAuthentifie == true ? "d-lg-none" : "")">
            <img src="images/logo_cit.jpeg" alt="Côte d'Ivoire Terminal" class="cit-brand-logo" />
            <span class="cit-brand-sub d-none d-sm-inline-block">@Loc["Header.BrandSub"]</span>
        </a>

        @if (Contexte?.EstAuthentifie == true)
        {
            @* Espace actif + bascule entre espaces (dynamique : menu si plusieurs espaces). *@
            <div class="d-none d-lg-block">
                <PersonaSwitcher Contexte="@Contexte" EnBarre="true" />
            </div>

            @* RECHERCHE D'ÉCRAN (Ctrl+K) — propose uniquement les écrans du menu de ce compte : elle
               ne peut donc mener nulle part où le menu ne mène pas. Navigation par js/navigation-rapide.js. *@
            <div class="cit-recherche-ecran d-none d-md-flex" role="search">
                <span aria-hidden="true">🔍</span>
                <input type="search" list="cit-ecrans" data-recherche-ecran autocomplete="off"
                       placeholder="@Loc["Header.SearchScreen"]" aria-label="@Loc["Header.SearchScreen"]" />
                <kbd>Ctrl K</kbd>
                <datalist id="cit-ecrans">
                    @foreach (var lien in _ecrans)
                    {
                        <option value="@Loc[lien.Libelle]" data-route="@lien.Route"></option>
                    }
                </datalist>
            </div>
        }

        @* REMÉDIATION D-17 : entre 768 et ~1100 px, la barre affichait d'un coup la marque, le
           bandeau société, la langue, le thème, la cloche et l'identité — d'où un débordement
           horizontal de toute la page (+160 px à 768). Le bandeau société ne réapparaît donc qu'en
           XL, et le nom, potentiellement long, est tronqué au lieu de pousser la barre. *@
        @if (Contexte?.SocieteNom is not null)
        {
            <div class="d-none d-xl-flex align-items-center gap-2 ms-2 px-3 py-1 bg-light border rounded-pill small min-w-0">
                <span class="text-primary">🏢</span>
                <span class="fw-bold text-dark text-truncate" style="max-width: 220px;">@Contexte.SocieteNom</span>
                @if (Contexte.SocieteProfil.HasValue)
                {
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill py-1 px-2 u-fs-2xs">
                        @Contexte.SocieteProfil
                    </span>
                }
            </div>
        }
    </div>

    <div class="d-flex align-items-center gap-2">
        <LanguageSwitcher />
        @* Sélecteur de thème segmenté : l'état actif est posé par theme-manager.js (aria-pressed). *@
        <div class="cit-theme-switch" role="group" title="@Loc["Header.ThemeToggleTitle"]" aria-label="@Loc["Header.ThemeToggleAria"]">
            <button type="button" data-theme-set="light" aria-pressed="true" title="@Loc["Header.ThemeLight"]">☀ <span class="visually-hidden">@Loc["Header.ThemeLight"]</span></button>
            <button type="button" data-theme-set="dark" aria-pressed="false" title="@Loc["Header.ThemeDark"]">☾ <span class="visually-hidden">@Loc["Header.ThemeDark"]</span></button>
        </div>

        @if (Contexte?.EstAuthentifie == true)
        {
            @* Aide de l'écran courant (bouton « ? »). *@
            <AideContextuelle />
            <VisiteGuidee UtilisateurId="@Contexte.UtilisateurId" />

            @* FEATURE 009 (T148, NOT-03) — câblage de la cloche DÉJÀ PRÉSENTE : la structure et
               les classes CSS sont conservées telles quelles, seul le comportement est ajouté.
               MainLayout est rendu en SSR statique — un @onclick n'y serait jamais déclenché :
               la cloche est donc un lien, et le compteur est calculé au rendu serveur. *@
            <a href="/notifications" class="cit-notification-btn" title="@Loc["Header.Notifications"]"
               aria-label="@Loc["Header.NotificationsAria", NombreNonLues]">
                <span>🔔</span>
                @if (NombreNonLues > 0)
                {
                    <span class="cit-notification-badge">@(NombreNonLues > 99 ? "99+" : NombreNonLues)</span>
                }
            </a>
            <a href="/notifications/preferences" class="cit-notification-btn d-none d-sm-inline-flex" title="@Loc["Header.Settings"]" aria-label="@Loc["Header.Settings"]">
                <span>⚙️</span>
            </a>

            @* Menu utilisateur — <details>/<summary> natif.
               MainLayout est rendu en SSR statique (Routes.razor ne déclare aucun
               @rendermode) : un @onclick Blazor n'y serait jamais déclenché. Même
               patron que l'accordéon du menu latéral. *@
            <details class="cit-user-menu" data-cit-menu>
                <summary class="cit-user-trigger" title="@Loc["Header.MyAccount"]" aria-haspopup="true">
                    <span class="cit-user-avatar">@Initiale</span>
                    <span class="cit-user-identity d-none d-lg-flex">
                        <span class="cit-user-name">@Contexte.NomAffiche</span>
                        <span class="cit-user-role">@(Contexte.EstTransporteur ? Loc["Header.SpaceCarrier"] : LibelleEspace(Contexte.EspaceActif))</span>
                    </span>
                    <span class="cit-user-caret">▾</span>
                </summary>

                <div class="cit-user-dropdown" role="menu">
                    <div class="cit-user-dropdown-head">
                        <span class="cit-user-avatar lg">@Initiale</span>
                        <div class="min-w-0">
                            <div class="cit-user-dropdown-name">@Contexte.NomAffiche</div>
                            <div class="cit-user-dropdown-mail">@Contexte.Email</div>
                        </div>
                    </div>

                    <div class="cit-user-dropdown-sep"></div>

                    <a href="/comptes/mon-profil" class="cit-user-dropdown-item" role="menuitem">
                        <span>👤</span> @Loc["Header.MyProfile"]
                    </a>
                    <a href="/comptes/double-authentification" class="cit-user-dropdown-item" role="menuitem">
                        <span>🛡️</span> @Loc["Sécurité (2FA)"]
                    </a>
                    @if (Contexte.SocieteId.HasValue)
                    {
                        <a href="/comptes/profil" class="cit-user-dropdown-item" role="menuitem">
                            <span>🏢</span> @Loc["Header.CompanyProfile"]
                        </a>
                    }

                    @if (Contexte.DroitValidation == true)
                    {
                        <a href="/enrolement/a-valider" class="cit-user-dropdown-item" role="menuitem">
                            <span>✅</span> @Loc["Valid.Title"]
                        </a>
                    }
                    @if (Contexte.Permissions.Contains(CIT.Plateforme.Domain.Securite.Permission.ComptesImpersonation))
                    {
                        <a href="/administration/impersonation" class="cit-user-dropdown-item" role="menuitem">
                            <span>🎭</span> @Loc["Impersonation.MenuItem"]
                        </a>
                    }
                    <a href="/aide/manuel" class="cit-user-dropdown-item" role="menuitem">
                        <span>📖</span> @Loc["Header.UserManual"]
                    </a>

                    <div class="cit-user-dropdown-sep"></div>

                    <!-- La déconnexion reste un POST : ne jamais la transformer en lien. -->
                    <form method="post" action="/comptes/deconnexion" class="m-0">
                        <AntiforgeryToken />
                        <button type="submit" class="cit-user-dropdown-item danger w-100" role="menuitem">
                            <span>⏻</span> @Loc["Nav.Logout"]
                        </button>
                    </form>
                </div>
            </details>
        }
        else
        {
            <div class="d-flex gap-2 ms-2 ps-3">
                <a href="/comptes/connexion" class="btn btn-primary btn-sm rounded-pill px-4">
                    @Loc["Nav.Login"]
                </a>
            </div>
        }
    </div>
</header>

@code {
    [Parameter]
    public ContexteUtilisateurVue? Contexte { get; set; }

    /// <summary>
    /// FEATURE 009 (NOT-03) — indicateur permanent du nombre de notifications non lues.
    /// Calculé au rendu serveur, pour le SEUL utilisateur authentifié (le compteur ne peut
    /// structurellement pas exposer celui d'un tiers : la query ne prend que l'identité du
    /// contexte). Zéro est un résultat normal : le badge est alors masqué.
    /// </summary>
    private int NombreNonLues { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Contexte?.EstAuthentifie != true)
        {
            NombreNonLues = 0;
            return;
        }

        // PORTÉE DÉDIÉE — le bandeau est rendu sur CHAQUE page, et `OnParametersSetAsync` se
        // déclenche à chaque changement de paramètre, y compris pendant qu'une page charge ses
        // propres données. Les deux se partageaient le `DbContext` scopé du circuit Blazor, d'où
        // « A second operation was started on this context instance ».
        //
        // Même remède que sur les écrans d'administration : une portée par opération. Le compteur
        // ne doit jamais faire tomber la page qui l'héberge.
        using var scope = ScopeFactory.CreateScope();
        var compterNonLues = scope.ServiceProvider
            .GetRequiredService<CIT.Plateforme.Application.Notifications.CompterNonLuesQuery>();

        try
        {
            NombreNonLues = await compterNonLues.ExecuterAsync(Contexte.UtilisateurId);
        }
        catch (Exception)
        {
            // Un compteur indisponible n'est pas une raison de casser l'en-tête : il s'efface.
            NombreNonLues = 0;
        }

        try
        {
            // Écrans proposés à la recherche : exactement ceux du menu de ce compte.
            var menu = await scope.ServiceProvider.GetRequiredService<CIT.Plateforme.Web.Services.MenuEnCache>()
                .ObtenirAsync(Contexte.UtilisateurId, Contexte.EspaceActif, Contexte.SocieteId.HasValue);
            _ecrans = [.. menu.SelectMany(g => g.Liens).DistinctBy(l => l.Route)];
        }
        catch (Exception)
        {
            // Même principe : sans liste, la recherche reste simplement vide.
            _ecrans = [];
        }
    }

    private IReadOnlyList<LienNavigationVue> _ecrans = [];

    private string Initiale =>
        string.IsNullOrWhiteSpace(Contexte?.NomAffiche) ? "U" : Contexte!.NomAffiche.Trim()[..1].ToUpperInvariant();

    private string LibelleEspace(EspaceFonctionnel espace) => espace switch
    {
        EspaceFonctionnel.Client => Loc["Header.SpaceClient"],
        EspaceFonctionnel.AdministrateurSociete => Loc["Header.SpaceCompany"],
        EspaceFonctionnel.Agent => Loc["Header.SpaceOperator"],
        EspaceFonctionnel.Supervision => Loc["Header.SpaceSupervision"],
        EspaceFonctionnel.AdministrationCit => Loc["Header.SpaceAdmin"],
        EspaceFonctionnel.SupportN1 => Loc["Header.SpaceSupportN1"],
        _ => espace.ToString()
    };
}
