@inherits LayoutComponentBase
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Web.Services
@inject IContexteUtilisateurWeb ContexteService
@implements IDisposable

<div class="cit-app-container d-flex min-vh-100">
    @if (_contexte?.EstAuthentifie == true)
    {
        <!-- Desktop Sidebar -->
        <div class="cit-desktop-sidebar d-none d-lg-block">
            <NavMenu />
        </div>

        <!-- Mobile Offcanvas Sidebar -->
        @if (_mobileMenuOuvert)
        {
            <div class="cit-modal-backdrop d-lg-none" @onclick="ToggleMobileMenu">
                <div class="cit-mobile-sidebar h-100 p-3" @onclick:stopPropagation>
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-light">
                        <span class="fw-bold fs-5 text-white">Menu</span>
                        <button type="button" class="btn-close btn-close-white" @onclick="ToggleMobileMenu" aria-label="Fermer"></button>
                    </div>
                    <NavMenu />
                </div>
            </div>
        }
    }

    <!-- Main Content Wrapper -->
    <div class="cit-main-wrapper flex-grow-1 d-flex flex-column min-w-0">
        @if (_contexte?.EstAuthentifie == true)
        {
            <HeaderBar Contexte="@_contexte" OnToggleMobileMenu="ToggleMobileMenu" />
        }
        
        <main class="cit-main-content @(_contexte?.EstAuthentifie != true ? "d-flex align-items-center justify-content-center" : "")">
            <div class="container-fluid p-0">
                @Body
            </div>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Une erreur inattendue est survenue.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ContexteUtilisateurVue? _contexte;
    private bool _mobileMenuOuvert;

    protected override async Task OnInitializedAsync()
    {
        ContexteService.SurChangementContexte += ActualiserContexte;
        _contexte = await ContexteService.ObtenirContexteAsync();
    }

    private void ActualiserContexte()
    {
        InvokeAsync(async () =>
        {
            _contexte = await ContexteService.ObtenirContexteAsync();
            StateHasChanged();
        });
    }

    private void ToggleMobileMenu()
    {
        _mobileMenuOuvert = !_mobileMenuOuvert;
    }

    public void Dispose()
    {
        ContexteService.SurChangementContexte -= ActualiserContexte;
    }
}
