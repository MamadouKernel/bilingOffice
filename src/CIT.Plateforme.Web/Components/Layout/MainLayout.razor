@inherits LayoutComponentBase
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.Localization
@inject IContexteUtilisateurWeb ContexteService
@inject IStringLocalizer<SharedResources> Loc
@implements IDisposable

@* REMÉDIATION UI-09 : lien d'évitement. Au clavier, il permet de sauter directement au contenu
   sans traverser toute la navigation. Invisible tant qu'il n'a pas le focus (voir .cit-skip-link). *@
<a href="#cit-contenu-principal" class="cit-skip-link">@Loc["Layout.SkipToContent"]</a>

<div class="cit-app-container d-flex min-vh-100">
    @if (_contexte?.EstAuthentifie == true)
    {
        <!-- Desktop Sidebar -->
        <div class="cit-desktop-sidebar d-none d-lg-block">
            <NavMenu Rail="true" />
        </div>

        @* CORRECTIF — le panneau mobile vivait ici, piloté par _mobileMenuOuvert via des
           @onclick qui ne se déclenchaient jamais (MainLayout est rendu en SSR statique).
           Il est désormais porté par le <details> natif de HeaderBar, où summary et contenu
           partagent le même élément. Voir le commentaire détaillé dans HeaderBar.razor. *@
    }

    <!-- Main Content Wrapper -->
    <div class="cit-main-wrapper flex-grow-1 d-flex flex-column min-w-0">
        @* CORRECTIF — l'en-tête (langue, thème, marque) était masqué pour tout visiteur non
           authentifié : la page d'accueil et les autres écrans publics (connexion, inscription,
           simulation) n'offraient donc aucun moyen de changer de langue. HeaderBar gère déjà
           correctement l'état anonyme (bouton de connexion à la place du menu utilisateur,
           cloche de notifications masquée) — il n'y avait aucune raison de le masquer entièrement. *@
        <HeaderBar Contexte="@_contexte" />

        <main id="cit-contenu-principal" tabindex="-1" class="cit-main-content @(_contexte?.EstAuthentifie != true ? "d-flex align-items-center justify-content-center" : "")">
            <div class="container-fluid p-0">
                @Body
            </div>
        </main>
    </div>
</div>

@* Lanceur flottant de l'assistant — visible sur toutes les pages une fois connecté.
   Simple lien vers la page /assistant (pas de dépendance JS : fonctionne en SSR). *@
@if (_contexte?.EstAuthentifie == true && _contexte.Nature == NatureUtilisateur.Client)
{
    <AssistantFlottant />
}

<div id="blazor-error-ui" data-nosnippet>
    @Loc["Layout.UnexpectedError"]
    <a href="." class="reload">@Loc["Layout.Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ContexteUtilisateurVue? _contexte;

    protected override async Task OnInitializedAsync()
    {
        ContexteService.SurChangementContexte += ActualiserContexte;
        _contexte = await ContexteService.ObtenirContexteAsync();
    }

    private void ActualiserContexte()
    {
        InvokeAsync(async () =>
        {
            _contexte = await ContexteService.ObtenirContexteAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ContexteService.SurChangementContexte -= ActualiserContexte;
    }
}
