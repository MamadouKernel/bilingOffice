@using CIT.Plateforme.Web.Resources

<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible">
            @SharedResourcesLocalizer.Get("Reconnect.Rejoining")
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            @SharedResourcesLocalizer.Get("Reconnect.RejoinFailedPrefix") <span id="components-seconds-to-next-attempt"></span> @SharedResourcesLocalizer.Get("Reconnect.RejoinFailedSuffix")
        </p>
        <p class="components-reconnect-failed-visible">
            @SharedResourcesLocalizer.Get("Reconnect.Failed1")<br />@SharedResourcesLocalizer.Get("Reconnect.RetryOrReload")
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">
            @SharedResourcesLocalizer.Get("Reconnect.Retry")
        </button>
        <p class="components-pause-visible">
            @SharedResourcesLocalizer.Get("Reconnect.Paused")
        </p>
        <p class="components-resume-failed-visible">
            @SharedResourcesLocalizer.Get("Reconnect.ResumeFailed")<br />@SharedResourcesLocalizer.Get("Reconnect.RetryOrReload")
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">
            @SharedResourcesLocalizer.Get("Reconnect.Resume")
        </button>
    </div>
</dialog>
