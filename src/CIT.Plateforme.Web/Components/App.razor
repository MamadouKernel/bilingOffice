@using System.Globalization
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor Http
<!DOCTYPE html>
<!-- NFR-01: lang="fr" par défaut -->
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* AUCUNE RESSOURCE EXTERNE ICI. Les polices Manrope et JetBrains Mono étaient chargées
       depuis Google Fonts : point de panne hors du contrôle de la plateforme (un terminal
       portuaire n'a pas de connectivité sortante garantie), divulgation de l'IP de chaque
       poste client à un tiers, et contenu susceptible de changer sans que le dépôt bouge.
       Elles sont désormais auto-hébergées — voir les @font-face de app.css. *@
    @* Préchargement des polices variables auto-hébergées : premier rendu directement dans la bonne
       typographie, sans bascule visible (FOUT). crossorigin requis même en same-origin (les polices
       sont toujours récupérées en mode CORS). *@
    <link rel="preload" href="fonts/manrope.var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/jetbrainsmono.var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CIT.Plateforme.Web.styles.css"]" />
    <ImportMap nonce="@NonceScript" />
    <script src="js/theme-manager.js"></script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="js/telechargements.js"></script>
    @* Bascule « afficher / masquer » des champs de mot de passe. Le script pose un
       unique écouteur délégué sur le document : il reste donc valable pour les
       boutons que la navigation améliorée de Blazor fera apparaître ensuite, sans
       avoir à se raccrocher à chaque rendu. Balisage : Shared/ChampMotDePasse.razor *@
    <script src="js/afficher-mot-de-passe.js"></script>
    @* Retour du focus sur l'élément déclencheur à la fermeture d'une modale (WCAG 2.4.3). *@
    <script src="js/focus-management.js"></script>
    @* Recherche d'écran de l'en-tête (Ctrl+K) : écouteurs délégués, voir HeaderBar.razor. *@
    <script src="js/navigation-rapide.js"></script>
    @* Saisie OTP à cases animées (Comptes/VerifierCode.razor). *@
    <script src="js/otp.js"></script>
    @* Motion design : entrée du contenu après chaque navigation Blazor (voir app.css « MOTION »). *@
    <script src="js/motion.js"></script>
</body>

</html>

@code {
    // F2 — nonce CSP de la requête, généré par SecurityHeadersMiddleware et posé sur l'<ImportMap>
    // (seul script inline de la plateforme). Absent hors contexte HTTP (rendu de secours) : chaîne
    // vide, sans incidence.
    private string? NonceScript =>
        Http.HttpContext?.Items[CIT.Plateforme.Web.Middlewares.SecurityHeadersMiddleware.CleNonceScript] as string;
}
