@page "/dossiers/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.Client
@using CIT.Plateforme.Application.Dossiers
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirFicheDossierQuery FicheDossierQuery
@inject NavigationManager Navigation

@if (_chargement)
{
    <IndicateurChargement Message="Chargement du dossier..." />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger d-flex align-items-center justify-content-between my-3">
        <div>
            <strong>Erreur d'accès :</strong> @_erreur
        </div>
        <button class="btn btn-outline-danger btn-sm" @onclick="RetourArriere">← Retour</button>
    </div>
}
else if (_fiche is not null)
{
    <!-- En-tête Dossier -->
    <div class="cit-page-header">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="RetourArriere">
                ← Retour
            </button>
            <div>
                <h2 class="cit-page-title mb-0">
                    <span>📁</span> Dossier <span class="font-monospace text-primary">@_fiche.NumeroDossier</span>
                </h2>
                <div class="cit-page-subtitle">
                    Société <strong class="text-dark">@_fiche.SocieteNom</strong> · Créé par <strong>@_fiche.AuteurNom</strong> le @_fiche.DateCreationUtc.ToString("dd/MM/yyyy")
                </div>
            </div>
        </div>
        <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
            <span class="badge @BadgeClassDossier(_fiche.StatutGlobal) fs-6 px-3 py-2 rounded-pill">
                @LibelleEtatDossier(_fiche.StatutGlobal)
            </span>
        </div>
    </div>

    <!-- Métriques du dossier -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-primary">
                <div class="cit-stat-icon bg-primary-subtle text-primary">
                    📑
                </div>
                <div>
                    <div class="cit-stat-label">Total des tickets</div>
                    <div class="cit-stat-value text-primary">@_fiche.TotalTickets</div>
                    <div class="small text-muted">Lignes d'opérations rattachées</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-warning">
                <div class="cit-stat-icon bg-warning-subtle text-warning">
                    ⏳
                </div>
                <div>
                    <div class="cit-stat-label">Tickets en cours / action</div>
                    <div class="cit-stat-value text-warning">@_fiche.TotalTicketsEnCours</div>
                    <div class="small text-muted">En attente d'action client ou CIT</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-success">
                <div class="cit-stat-icon bg-success-subtle text-success">
                    ✅
                </div>
                <div>
                    <div class="cit-stat-label">Tickets clôturés</div>
                    <div class="cit-stat-value text-success">@_fiche.TotalTicketsClotures</div>
                    <div class="small text-muted">Opérations achevées avec succès</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Liste des tickets du dossier -->
    <div class="cit-card mb-4 p-0 overflow-hidden">
        <div class="p-3 bg-light border-bottom">
            <h6 class="fw-bold text-dark mb-0">Tickets et étapes du dossier</h6>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>N° Ticket & BL / Booking</th>
                        <th>Module & Type</th>
                        <th>File courante</th>
                        <th>Statut</th>
                        <th>Opérateur</th>
                        <th>Date de création</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _fiche.Tickets)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark font-monospace">@(t.NumeroBl ?? t.NumeroTicket)</div>
                                <div class="small text-muted font-monospace">Ref: @t.NumeroTicket</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@t.Module</span>
                                <span class="small text-muted ms-1">@t.TypeDemande</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@t.FileNom</span>
                            </td>
                            <td>
                                <StatutBadge Statut="@t.Statut" />
                            </td>
                            <td>
                                <span class="small text-muted">@(t.OperateurAssigneNom ?? "Non assigné")</span>
                            </td>
                            <td class="small text-muted font-monospace">
                                @t.DateCreationUtc.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-end">
                                <a href="/tickets/@t.TicketId" class="btn btn-outline-primary btn-sm">
                                    Consulter ➔
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _chargement = true;
    private string? _erreur;
    private FicheDossierVue? _fiche;
    private Guid _utilisateurId;
    private bool _estClient;

    protected override async Task OnParametersSetAsync()
    {
        await RechargerAsync();
    }

    private async Task RechargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _erreur = "Veuillez vous connecter pour consulter ce dossier.";
                return;
            }

            _utilisateurId = contexte.UtilisateurId;
            _estClient = contexte.Nature == NatureUtilisateur.Client;
            _fiche = await FicheDossierQuery.ExecuterAsync(_utilisateurId, Id);
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private static string BadgeClassDossier(StatutVisuelDossier etat) => etat switch
    {
        StatutVisuelDossier.ClotureTermine => "bg-success text-white",
        StatutVisuelDossier.EnAttenteClient => "bg-warning text-dark",
        StatutVisuelDossier.EnCoursTraitement => "bg-primary text-white",
        StatutVisuelDossier.Annule => "bg-secondary text-white",
        StatutVisuelDossier.Rejete => "bg-danger text-white",
        _ => "bg-info text-dark"
    };

    private static string LibelleEtatDossier(StatutVisuelDossier etat) => etat switch
    {
        StatutVisuelDossier.ClotureTermine => "Clôturé / Terminé",
        StatutVisuelDossier.EnAttenteClient => "Action requise",
        StatutVisuelDossier.EnCoursTraitement => "En cours CIT",
        StatutVisuelDossier.Annule => "Annulé",
        StatutVisuelDossier.Rejete => "Rejeté",
        _ => "En attente CIT"
    };

    private void RetourArriere()
    {
        if (_estClient)
        {
            Navigation.NavigateTo("/client/demandes");
        }
        else
        {
            Navigation.NavigateTo("/agent/dashboard");
        }
    }
}
