@page "/dossiers/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.Client
@using CIT.Plateforme.Application.Dossiers
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirFicheDossierQuery FicheDossierQuery
@inject NavigationManager Navigation

<PageTitle>@(_fiche is null ? Loc["DosF.PageTitleFallback"].Value : string.Format(Loc["DosF.PageTitlePrefix"].Value, _fiche.NumeroDossier)) — CIT</PageTitle>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["DosF.Loading"]" />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger d-flex align-items-center justify-content-between my-3" role="alert">
        <div>
            <strong>@Loc["Ticket.AccessErrorLabel"]</strong> @_erreur
        </div>
        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="RetourArriere">@Loc["DosF.Back"]</button>
    </div>
}
else if (_fiche is not null)
{
    <FilAriane Elements="@(new List<FilAriane.ElementAriane> { new(Loc["FicheAvoirExo.BcHome"].Value, "/"), new(string.Format(Loc["Ticket.BcDossier"].Value, _fiche.NumeroDossier)) })" />

    <!-- En-tête Dossier -->
    <div class="cit-page-header">
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="RetourArriere">
                @Loc["DosF.Back"]
            </button>
            <div>
                <h1 class="cit-page-title mb-0">
                    <span>📁</span> @Loc["DosF.HeaderPrefix"] <span class="font-monospace text-primary">@_fiche.NumeroDossier</span>
                </h1>
                <div class="cit-page-subtitle">
                    @Loc["Dash.Company"] <strong class="text-dark">@_fiche.SocieteNom</strong> · @Loc["DosF.CreatedBy"] <strong>@_fiche.AuteurNom</strong> @Loc["DosF.On"] @_fiche.DateCreationUtc.Horodate()
                </div>
            </div>
        </div>
        <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
            <span class="badge @BadgeClassDossier(_fiche.StatutGlobal) fs-6 px-3 py-2 rounded-pill">
                @LibelleEtatDossier(_fiche.StatutGlobal)
            </span>
        </div>
    </div>

    <!-- Métriques du dossier -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-primary">
                <div class="cit-stat-icon bg-primary-subtle text-primary">
                    📑
                </div>
                <div>
                    <div class="cit-stat-label">@Loc["DosF.KpiTotal"]</div>
                    <div class="cit-stat-value text-primary">@_fiche.TotalTickets</div>
                    <div class="small text-muted">@Loc["DosF.KpiTotalHint"]</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-warning">
                <div class="cit-stat-icon bg-warning-subtle text-warning">
                    ⏳
                </div>
                <div>
                    <div class="cit-stat-label">@Loc["DosF.KpiInProgress"]</div>
                    <div class="cit-stat-value text-warning">@_fiche.TotalTicketsEnCours</div>
                    <div class="small text-muted">@Loc["DosF.KpiInProgressHint"]</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-success">
                <div class="cit-stat-icon bg-success-subtle text-success">
                    ✅
                </div>
                <div>
                    <div class="cit-stat-label">@Loc["DosF.KpiClosed"]</div>
                    <div class="cit-stat-value text-success">@_fiche.TotalTicketsClotures</div>
                    <div class="small text-muted">@Loc["DosF.KpiClosedHint"]</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Liste des tickets du dossier -->
    <div class="cit-card mb-4 p-0 overflow-hidden">
        <div class="p-3 bg-light border-bottom">
            <h6 class="fw-bold text-dark mb-0">@Loc["DosF.TicketsSection"]</h6>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Loc["DosF.ColTicketBl"]</th>
                        <th>@Loc["DosF.ColModuleType"]</th>
                        <th>@Loc["DosF.ColCurrentQueue"]</th>
                        <th>@Loc["Societe.ColStatus"]</th>
                        <th>@Loc["DosF.ColOperator"]</th>
                        <th>@Loc["AvoirExoList.ColDate"]</th>
                        <th class="text-end">@Loc["SimHist.ColAction"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _fiche.Tickets)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark font-monospace">@(t.NumeroBl ?? t.NumeroTicket)</div>
                                <div class="small text-muted font-monospace">@Loc["DosF.RefWord"] @t.NumeroTicket</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@Loc.Module(t.Module)</span>
                                <span class="small text-muted ms-1">@Loc.TypeDemande(t.TypeDemande)</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@t.FileNom</span>
                            </td>
                            <td>
                                <StatutBadge Statut="@t.Statut" />
                            </td>
                            <td>
                                <span class="small text-muted">@(t.OperateurAssigneNom ?? Loc["DosF.Unassigned"].Value)</span>
                            </td>
                            <td class="small text-muted font-monospace">
                                @t.DateCreationUtc.Horodate()
                            </td>
                            <td class="text-end">
                                <a href="/tickets/@t.TicketId" class="btn btn-outline-primary btn-sm">
                                    @Loc["AvoirExoList.Consult"]
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _chargement = true;
    private string? _erreur;
    private FicheDossierVue? _fiche;
    private Guid _utilisateurId;
    private bool _estClient;

    protected override async Task OnParametersSetAsync()
    {
        await RechargerAsync();
    }

    private async Task RechargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _erreur = Loc["DosF.LoginRequired"].Value;
                return;
            }

            _utilisateurId = contexte.UtilisateurId;
            _estClient = contexte.Nature == NatureUtilisateur.Client;
            _fiche = await FicheDossierQuery.ExecuterAsync(_utilisateurId, Id);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private static string BadgeClassDossier(StatutVisuelDossier etat) => etat switch
    {
        StatutVisuelDossier.ClotureTermine => "bg-success text-white",
        StatutVisuelDossier.EnAttenteClient => "bg-warning text-dark",
        StatutVisuelDossier.EnCoursTraitement => "bg-primary text-white",
        StatutVisuelDossier.Annule => "bg-secondary text-white",
        StatutVisuelDossier.Rejete => "bg-danger text-white",
        _ => "bg-info text-dark"
    };

    private static string LibelleEtatDossier(StatutVisuelDossier etat) => etat switch
    {
        StatutVisuelDossier.ClotureTermine => SharedResourcesLocalizer.Get("Dash.EtatCloture"),
        StatutVisuelDossier.EnAttenteClient => SharedResourcesLocalizer.Get("Dash.EtatActionRequise"),
        StatutVisuelDossier.EnCoursTraitement => SharedResourcesLocalizer.Get("Dash.EtatEnCoursCit"),
        StatutVisuelDossier.Annule => SharedResourcesLocalizer.Get("Dash.EtatAnnule"),
        StatutVisuelDossier.Rejete => SharedResourcesLocalizer.Get("Dash.EtatRejete"),
        _ => SharedResourcesLocalizer.Get("Dash.EtatEnAttenteCit")
    };

    private void RetourArriere()
    {
        if (_estClient)
        {
            Navigation.NavigateTo("/client/demandes");
        }
        else
        {
            Navigation.NavigateTo("/agent/dashboard");
        }
    }
}
