@* REMÉDIATION routage (constaté en recette authentifiée, build publié) : cette page ET
   FicheDossier.razor revendiquaient toutes deux « /dossiers/{guid} » — le routeur levait une
   AmbiguousMatchException et TOUTE consultation de dossier renvoyait 500 (les deux pages étaient
   donc inatteignables). FicheDossier est la page canonique (contrôle d'accès central
   ObtenirFicheDossierQuery + ExigerConsultationDossierAsync, parcours client et tests de
   cloisonnement). Cette vue opérationnelle reçoit une route distincte. *@
@page "/dossiers/{DossierId:guid}/operationnel"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject ConsulterDossierQuery ConsulterDossier
@inject IContexteUtilisateurWeb ContexteService

<PageTitle>@Loc["DetDos.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>📁</span> @Loc["DetDos.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["DetDos.Subtitle"]</div>
    </div>
</div>

@if (_accesRefuse)
{
    <PermissionDenied Message="@Loc["DetDos.AccessDenied"]" />
}
else if (vue is not null)
{
    <div class="cit-card mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <span class="text-muted small">@Loc["DetDos.FileNumber"]</span>
                <div class="fs-4 fw-bold font-monospace text-primary">@vue.Numero</div>
            </div>
            <div>
                <span class="badge bg-primary-subtle text-primary fs-6">@vue.Etat</span>
            </div>
        </div>

        <h6 class="fw-bold text-dark mt-4 mb-2">@Loc["DetDos.LinkedTickets"]</h6>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Loc["AvoirExoList.ColTicket"]</th>
                        <th>@Loc["DetDos.ColCurrentStatus"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in vue.Tickets)
                    {
                        <tr>
                            <td class="font-monospace fw-bold text-primary">@ticket.Numero</td>
                            <td><span class="badge bg-light text-dark border">@ticket.Statut</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid DossierId { get; set; }

    private DossierVue? vue;
    private bool _accesRefuse;

    // L'identité vient du contexte serveur, jamais de la route : celle-ci ne porte que le dossier
    // demandé. Le refus est rendu comme tel plutôt que propagé en exception non gérée.
    protected override async Task OnInitializedAsync()
    {
        var contexte = await ContexteService.ObtenirContexteAsync();

        try
        {
            vue = await ConsulterDossier.ExecuterAsync(contexte.UtilisateurId, DossierId);
        }
        catch (AccesRefuseException)
        {
            _accesRefuse = true;
        }
    }
}
