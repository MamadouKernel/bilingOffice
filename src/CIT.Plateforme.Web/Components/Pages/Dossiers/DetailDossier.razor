@page "/dossiers/{DossierId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Services
@inject ConsulterDossierQuery ConsulterDossier
@inject IContexteUtilisateurWeb ContexteService

<PageTitle>Détail du dossier — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>📁</span> Dossier Opérationnel
        </h2>
        <div class="cit-page-subtitle">Suivi d'ensemble du dossier et de ses tickets dérivés</div>
    </div>
</div>

@if (_accesRefuse)
{
    <PermissionDenied Message="Ce dossier ne relève pas de votre périmètre." />
}
else if (vue is not null)
{
    <div class="cit-card mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <span class="text-muted small">Numéro de dossier :</span>
                <div class="fs-4 fw-bold font-monospace text-primary">@vue.Numero</div>
            </div>
            <div>
                <span class="badge bg-primary-subtle text-primary fs-6">@vue.Etat</span>
            </div>
        </div>

        <h6 class="fw-bold text-dark mt-4 mb-2">Tickets rattachés au dossier</h6>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>N° Ticket</th>
                        <th>Statut actuel</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in vue.Tickets)
                    {
                        <tr>
                            <td class="font-monospace fw-bold text-primary">@ticket.Numero</td>
                            <td><span class="badge bg-light text-dark border">@ticket.Statut</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid DossierId { get; set; }

    private DossierVue? vue;
    private bool _accesRefuse;

    // L'identité vient du contexte serveur, jamais de la route : celle-ci ne porte que le dossier
    // demandé. Le refus est rendu comme tel plutôt que propagé en exception non gérée.
    protected override async Task OnInitializedAsync()
    {
        var contexte = await ContexteService.ObtenirContexteAsync();

        try
        {
            vue = await ConsulterDossier.ExecuterAsync(contexte.UtilisateurId, DossierId);
        }
        catch (AccesRefuseException)
        {
            _accesRefuse = true;
        }
    }
}
