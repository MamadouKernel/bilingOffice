@page "/agent/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Agent
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirDashboardAgentQuery DashboardQuery

<PageTitle>@Loc["Agent.PageTitle"]</PageTitle>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["Agent.Loading"]" />
}
else if (_nonAutorise)
{
    <div class="py-4">
        <PermissionDenied Message="@_messageNonAutorise" />
    </div>
}
else if (_erreur is not null)
{
    <div class="alert alert-danger my-3" role="alert">@_erreur</div>
}
else if (_dashboard is not null)
{
    <div class="cit-page-header">
        <div>
            <h1 class="cit-page-title">
                <span>⚡</span> @Loc["Agent.Title"]
            </h1>
            <div class="cit-page-subtitle">@Loc["Agent.WelcomePrefix"] <strong class="text-dark">@_dashboard.AgentNom</strong> @Loc["Agent.WelcomeSuffix"]</div>
        </div>
    </div>

    <!-- Bandeau DIS-01 -->
    <BandeauDisponibiliteAgent AgentId="@_dashboard.AgentId" EstDisponibleInitial="@_dashboard.EstDisponible" />

    <!-- Métriques -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
            <div class="cit-stat-card border-start border-4 border-primary">
                <div class="cit-stat-icon bg-primary-subtle text-primary">
                    📋
                </div>
                <div>
                    <div class="cit-stat-label">@Loc["Agent.KpiMyTickets"]</div>
                    <div class="cit-stat-value text-primary font-monospace">@_dashboard.TotalTicketsEnCoursAgent</div>
                    <div class="small text-muted">@Loc["Agent.KpiMyTicketsHint"]</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="cit-stat-card border-start border-4 border-info">
                <div class="cit-stat-icon bg-info-subtle text-info">
                    🗂️
                </div>
                <div>
                    <div class="cit-stat-label">@Loc["Agent.KpiQueues"]</div>
                    <div class="cit-stat-value text-dark font-monospace">@_dashboard.FilesHabilitees.Count</div>
                    <div class="small text-muted">@Loc["Agent.KpiQueuesHint"]</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Synthèse des files de traitement -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark m-0">@Loc["Agent.QueuesTitle"]</h5>
        <span class="badge bg-light text-dark border">@Loc["Agent.RealTime"]</span>
    </div>

    @if (_dashboard.FilesHabilitees.Count == 0)
    {
        <EtatVide Titre="@Loc["Agent.NoQueueTitle"]"
                  Description="@Loc["Agent.NoQueueDesc"]"
                  Icone="🗂️" />
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var file in _dashboard.FilesHabilitees)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="cit-card h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="fw-bold text-dark m-0">@Loc.File(file.Nom)</h6>
                                <span class="badge bg-secondary-subtle text-secondary small">@Loc.Module(file.Module)</span>
                            </div>

                            <div class="d-flex justify-content-between py-2 border-top border-bottom small">
                                <span class="text-muted">@Loc["Agent.Waiting"]</span>
                                <strong class="@(file.TicketsEnAttente > 0 ? "text-warning font-monospace" : "text-muted font-monospace")">
                                    @file.TicketsEnAttente
                                </strong>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom small mb-3">
                                <span class="text-muted">@Loc["Agent.InProgress"]</span>
                                <strong class="text-primary font-monospace">@file.TicketsEnCours</strong>
                            </div>
                        </div>

                        <a href="@file.UrlFile" class="btn btn-outline-primary btn-sm w-100 fw-bold shadow-sm">
                            @Loc["Agent.AccessQueue"]
                        </a>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Mes tickets en cours de traitement -->
    @if (_dashboard.MesTicketsEnCours.Count > 0)
    {
        <h5 class="fw-bold text-dark mb-3">@Loc["Agent.MyFilesTitle"]</h5>
        <div class="cit-card p-0 overflow-hidden mb-4">
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["AvoirExoList.ColTicket"]</th>
                            <th>@Loc["Agent.ColBlBooking"]</th>
                            <th>@Loc["Agent.ColQueue"]</th>
                            <th>@Loc["Societe.ColStatus"]</th>
                            <th>@Loc["Agent.ColTakenCharge"]</th>
                            <th class="text-end">@Loc["SimHist.ColAction"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in _pagination1.Appliquer(_dashboard.MesTicketsEnCours))
                        {
                            <tr>
                                <td>
                                    <a href="/tickets/@ticket.TicketId" class="fw-bold text-primary font-monospace text-decoration-none">
                                        @ticket.NumeroTicket
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark font-monospace">@ticket.NumeroBl</span>
                                </td>
                                <td><span class="badge bg-light text-dark border">@Loc.File(ticket.FileNom)</span></td>
                                <td>
                                    <StatutBadge Statut="@ticket.Statut" />
                                </td>
                                <td class="small text-muted font-monospace">
                                    @ticket.DatePriseEnChargeUtc.Horodate()
                                </td>
                                <td class="text-end">
                                    <a href="/tickets/@ticket.TicketId" class="btn btn-outline-primary btn-sm">
                                        @Loc["Agent.Resume"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }
    else if (_dashboard.FilesHabilitees.Count > 0)
    {
        @* Aucun ticket tenu : on guide vers l'action utile plutôt que de masquer la section. *@
        <div class="cit-card border-0 shadow-sm bg-light d-flex align-items-center gap-3 p-4 mb-4">
            <span class="fs-2" aria-hidden="true">✅</span>
            <div>
                <h6 class="fw-bold m-0 text-dark">@Loc["Agent.NoTicketsTitle"]</h6>
                <p class="small text-muted m-0">@Loc["Agent.NoTicketsText"]</p>
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private DashboardAgentVue? _dashboard;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["Agent.LoginRequired"].Value;
                return;
            }

            if (contexte.Nature != NatureUtilisateur.Agent)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["Agent.AgentsOnly"].Value;
                return;
            }

            _dashboard = await DashboardQuery.ExecuterAsync(contexte.UtilisateurId);
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = MessagesUtilisateur.Texte(ex);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }
}
