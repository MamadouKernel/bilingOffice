@page "/enrolement/{TicketId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Documents
@using CIT.Plateforme.Application.Enrolement
@using CIT.Plateforme.Application.Messagerie
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Tickets
@using CIT.Plateforme.Domain.Documents
@using CIT.Plateforme.Domain.Enrolement
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirFicheEnrolementQuery ObtenirFiche
@inject PrendreEnChargeCommand PrendreEnCharge
@inject AttenteClientCommand AttenteClient
@inject ValiderEnrolementCommand ValiderEnrolement
@inject DeclencherConvocationCommand DeclencherConvocation
@inject ConstaterRemiseBadgeCommand ConstaterRemiseBadge
@inject PublierMessageCommand PublierMessage
@inject DeposerDocumentCommand DeposerDocument

<PageTitle>@Loc["FicheEnrol.PageTitlePrefix"] @(_fiche?.NumeroTicket ?? "") — CIT</PageTitle>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["FicheEnrol.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else if (_fiche is not null)
{
    var f = _fiche;

    <FilAriane Elements="@(new List<FilAriane.ElementAriane> { new(Loc["FicheAvoirExo.BcHome"].Value, "/"), _estClient ? new FilAriane.ElementAriane(Loc["FicheEnrol.BcMyEnrollments"].Value, "/enrolement/mes-enrolements") : new FilAriane.ElementAriane(Loc["FicheEnrol.BcAgentQueue"].Value, "/enrolement/file-agent-gate"), new(Loc["FicheAvoirExo.BcSheet"].Value) })" />

    <div class="cit-page-header">
        <div>
            <h1 class="cit-page-title">
                <span>🚚</span> @Loc["FicheAvoirExo.FileWord"] @f.NumeroTicket
            </h1>
            <div class="cit-page-subtitle">@(f.Objet ?? Loc["FicheEnrol.SubtitleObjectFallback"].Value) — @Loc["FicheEnrol.QueueWord"] @f.FileNom</div>
        </div>
        <div class="mt-3 mt-md-0">
            <StatutBadge Statut="@f.Statut" />
        </div>
    </div>

    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-3" role="alert">@_erreur</div>
    }
    @if (_actionSuccess is not null)
    {
        <div class="alert alert-success py-2 small mb-3" role="status">@_actionSuccess</div>
    }

    @if (f.TypeObjet is not null)
    {
        <div class="cit-card mb-4">
            <h6 class="fw-bold text-dark mb-2">@Loc["FicheEnrol.TypeSensLabel"]</h6>
            <span class="badge bg-primary-subtle text-primary me-1">@Loc[$"Enrol.Objet.{f.TypeObjet}"]</span>
            <span class="badge @(f.Sens == SensEnrolement.Retrait ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success")">@Loc[$"Enrol.Sens.{f.Sens}"]</span>
        </div>
    }

    <div class="cit-card mb-4">
        <h6 class="fw-bold text-dark mb-2">@Loc["Enrol.DescLabel"]</h6>
        <p class="mb-0">@(f.Description ?? "—")</p>
    </div>

    @if (!_estClient)
    {
        <div class="cit-card mb-4">
            <h6 class="fw-bold text-dark mb-3">@Loc["FicheEnrol.AgentActionsTitle"]</h6>
            <div class="d-flex flex-wrap gap-2">
                @if (f.PeutPrendreEnCharge)
                {
                    <button type="button" class="btn btn-outline-success btn-sm fw-semibold" @onclick="PrendreEnChargeAsync">@Loc["FicheEnrol.BtnTakeCharge"]</button>
                }
                @if (f.PeutDemanderComplement)
                {
                    <button type="button" class="btn btn-outline-warning btn-sm fw-semibold" @onclick="() => _afficherFormulaireComplement = true">@Loc["FicheEnrol.BtnRequestComplement"]</button>
                }
                @if (f.PeutValider)
                {
                    <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" @onclick="ValiderAsync">@Loc["FicheEnrol.BtnValidate"]</button>
                }
                @if (f.PeutConvoquer)
                {
                    <button type="button" class="btn btn-outline-info btn-sm fw-semibold" @onclick="ConvoquerAsync">@Loc["FicheEnrol.BtnConvene"]</button>
                }
                @if (f.PeutConstaterBadge)
                {
                    <button type="button" class="btn btn-outline-dark btn-sm fw-semibold" @onclick="ConstaterBadgeAsync">@Loc["FicheEnrol.BtnBadge"]</button>
                }
            </div>

            @if (_afficherFormulaireComplement)
            {
                <div class="mt-3">
                    <label for="motif-du-complement-demande" class="form-label small fw-semibold">@Loc["FicheEnrol.ComplementMotifLabel"]</label>
                    <div class="input-group">
                        <input id="motif-du-complement-demande" class="form-control" @bind="_motifComplement" @bind:event="oninput" placeholder="@Loc["FicheEnrol.ComplementMotifPlaceholder"]" />
                        <button type="button" class="btn btn-warning fw-bold" @onclick="DemanderComplementAsync" disabled="@string.IsNullOrWhiteSpace(_motifComplement)">@Loc["FicheEnrol.Send"]</button>
                    </div>
                </div>
            }
        </div>
    }

    @if (_estClient && f.PeutRepondreComplement)
    {
        <div class="cit-card mb-4 border-warning">
            <h6 class="fw-bold text-dark mb-2">@Loc["FicheEnrol.ClientComplementTitle"]</h6>
            <p class="text-muted small">@Loc["FicheEnrol.ClientComplementDesc"]</p>
            <div class="mb-2">
                <textarea class="form-control" rows="3" @bind="_reponseComplement" @bind:event="oninput" placeholder="@Loc["FicheEnrol.ClientComplementPlaceholder"]"></textarea>
            </div>
            <button type="button" class="btn btn-primary btn-sm fw-bold" @onclick="RepondreComplementAsync" disabled="@string.IsNullOrWhiteSpace(_reponseComplement)">@Loc["FicheEnrol.SendReply"]</button>
        </div>
    }

    @if (f.PeutDeposerDocument)
    {
        <div class="cit-card mb-4">
            <h6 class="fw-bold text-dark mb-2">@Loc["FicheEnrol.UploadTitle"]</h6>
            <InputFile class="form-control form-control-sm" OnChange="DeposerPieceAsync" />
        </div>
    }

    <div class="cit-card mb-4 p-0 overflow-hidden">
        <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light"><tr><th>@Loc["FicheEnrol.ColPiece"]</th><th>@Loc["FicheEnrol.ColSize"]</th><th>@Loc["FicheEnrol.ColAntivirus"]</th><th>@Loc["FicheEnrol.ColDepositedOn"]</th></tr></thead>
                <tbody>
                    @foreach (var d in _pagination1.Appliquer(f.Documents))
                    {
                        <tr>
                            <td class="fw-semibold text-dark">📄 @d.NomFichier</td>
                            <td class="small text-muted">@((d.TailleOctets / 1024.0).ToString("0.0")) @Loc["Common.KoUnit"]</td>
                            <td><span class="badge bg-success-subtle text-success">@d.StatutAntivirus</span></td>
                            <td class="small text-muted font-monospace">@d.DateDepotUtc.Horodate()</td>
                        </tr>
                    }
                </tbody>
            </table>
            <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
        </div>
    </div>

    <div class="cit-card mb-4">
        <h6 class="fw-bold text-dark mb-3">@Loc["FicheEnrol.MessagesTitle"]</h6>
        @foreach (var m in f.Messages)
        {
            <div class="mb-2 pb-2 border-bottom">
                <div class="small fw-semibold text-dark">@m.AuteurNom @(m.EstInterne ? Loc["FicheEnrol.InternalNote"].Value : "")</div>
                <div class="small">@m.Contenu</div>
            </div>
        }
    </div>

    <div class="cit-card mb-4">
        <h6 class="fw-bold text-dark mb-3">@Loc["FicheEnrol.HistoryTitle"]</h6>
        <ChronologieTicket Evenements="@f.Chronologie" />
    </div>
}

@code {
    private readonly EtatPagination _pagination1 = new();

    [Parameter]
    public Guid TicketId { get; set; }

    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private string? _actionSuccess;
    private FicheEnrolementVue? _fiche;
    private Guid _appelantId;
    private bool _estClient;
    private bool _afficherFormulaireComplement;
    private string _motifComplement = string.Empty;
    private string _reponseComplement = string.Empty;

    private static readonly ReglesDepotDocument ReglesPieces = new(
        ExtensionsAutorisees: ["pdf", "jpg", "jpeg", "png"], TailleMaxOctets: 10 * 1024 * 1024);

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["FicheEnrol.LoginRequired"].Value;
                return;
            }

            _appelantId = contexte.UtilisateurId;
            _estClient = contexte.Nature == NatureUtilisateur.Client;
            _fiche = await ObtenirFiche.ExecuterAsync(_appelantId, TicketId);
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task PrendreEnChargeAsync() => await ExecuterActionAsync(() => PrendreEnCharge.ExecuterAsync(_appelantId, TicketId), Loc["FicheEnrol.MsgTakenCharge"].Value);

    private async Task ValiderAsync() => await ExecuterActionAsync(() => ValiderEnrolement.ExecuterAsync(_appelantId, TicketId), Loc["FicheEnrol.MsgValidated"].Value);

    private async Task ConvoquerAsync() => await ExecuterActionAsync(() => DeclencherConvocation.ExecuterAsync(_appelantId, TicketId), Loc["FicheEnrol.MsgConvened"].Value);

    private async Task ConstaterBadgeAsync() => await ExecuterActionAsync(() => ConstaterRemiseBadge.ExecuterAsync(_appelantId, TicketId), Loc["FicheEnrol.MsgBadge"].Value);

    private async Task DemanderComplementAsync()
    {
        if (string.IsNullOrWhiteSpace(_motifComplement)) return;
        await ExecuterActionAsync(() => AttenteClient.MettreEnAttenteAsync(_appelantId, TicketId, _motifComplement), Loc["FicheEnrol.MsgComplementRequested"].Value);
        _afficherFormulaireComplement = false;
        _motifComplement = string.Empty;
    }

    private async Task RepondreComplementAsync()
    {
        if (string.IsNullOrWhiteSpace(_reponseComplement)) return;
        await ExecuterActionAsync(async () =>
        {
            await PublierMessage.PublierMessageClientAsync(_appelantId, TicketId, _reponseComplement);
            await AttenteClient.RependreApresReponseAsync(TicketId);
        }, Loc["FicheEnrol.MsgReplySent"].Value);
        _reponseComplement = string.Empty;
    }

    private async Task DeposerPieceAsync(InputFileChangeEventArgs e)
    {
        try
        {
            await using var flux = e.File.OpenReadStream(ReglesPieces.TailleMaxOctets);
            await using var memoire = new MemoryStream();
            await flux.CopyToAsync(memoire);

            if (_estClient)
            {
                await DeposerDocument.DeposerPourClientAsync(_appelantId, TicketId, e.File.Name, e.File.ContentType, memoire, memoire.Length, ReglesPieces);
            }
            else
            {
                await DeposerDocument.DeposerPourAgentAsync(_appelantId, TicketId, e.File.Name, e.File.ContentType, memoire, memoire.Length, ReglesPieces);
            }

            _actionSuccess = Loc["Enrol.PieceUploaded"].Value;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private async Task ExecuterActionAsync(Func<Task> action, string messageSucces)
    {
        _erreur = null;
        _actionSuccess = null;
        try
        {
            await action();
            _actionSuccess = messageSucces;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }
}
