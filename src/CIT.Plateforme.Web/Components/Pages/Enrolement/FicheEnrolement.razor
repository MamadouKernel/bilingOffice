@page "/enrolement/{TicketId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Documents
@using CIT.Plateforme.Application.Enrolement
@using CIT.Plateforme.Application.Messagerie
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Tickets
@using CIT.Plateforme.Domain.Documents
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirFicheEnrolementQuery ObtenirFiche
@inject PrendreEnChargeCommand PrendreEnCharge
@inject AttenteClientCommand AttenteClient
@inject ValiderEnrolementCommand ValiderEnrolement
@inject DeclencherConvocationCommand DeclencherConvocation
@inject ConstaterRemiseBadgeCommand ConstaterRemiseBadge
@inject PublierMessageCommand PublierMessage
@inject DeposerDocumentCommand DeposerDocument

<PageTitle>Fiche enrôlement @(_fiche?.NumeroTicket ?? "") — CIT</PageTitle>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement du dossier..." />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else if (_fiche is not null)
{
    var f = _fiche;

    <div class="cit-page-header">
        <div>
            <h2 class="cit-page-title">
                <span>🚚</span> Dossier @f.NumeroTicket
            </h2>
            <div class="cit-page-subtitle">@(f.Objet ?? "Enrôlement Transporteurs") — File @f.FileNom</div>
        </div>
        <div class="mt-3 mt-md-0">
            <StatutBadge Statut="@f.Statut" />
        </div>
    </div>

    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-3">@_erreur</div>
    }
    @if (_actionSuccess is not null)
    {
        <div class="alert alert-success py-2 small mb-3">@_actionSuccess</div>
    }

    <div class="cit-card mb-4">
        <h6 class="fw-bold text-dark mb-2">Description</h6>
        <p class="mb-0">@(f.Description ?? "—")</p>
    </div>

    @if (!_estClient)
    {
        <div class="cit-card mb-4">
            <h6 class="fw-bold text-dark mb-3">Actions Agent Gate</h6>
            <div class="d-flex flex-wrap gap-2">
                @if (f.PeutPrendreEnCharge)
                {
                    <button class="btn btn-outline-success btn-sm fw-semibold" @onclick="PrendreEnChargeAsync">📥 Prendre en charge</button>
                }
                @if (f.PeutDemanderComplement)
                {
                    <button class="btn btn-outline-warning btn-sm fw-semibold" @onclick="() => _afficherFormulaireComplement = true">📨 Demander un complément</button>
                }
                @if (f.PeutValider)
                {
                    <button class="btn btn-outline-primary btn-sm fw-semibold" @onclick="ValiderAsync">✅ Valider</button>
                }
                @if (f.PeutConvoquer)
                {
                    <button class="btn btn-outline-info btn-sm fw-semibold" @onclick="ConvoquerAsync">📣 Déclencher la convocation</button>
                }
                @if (f.PeutConstaterBadge)
                {
                    <button class="btn btn-outline-dark btn-sm fw-semibold" @onclick="ConstaterBadgeAsync">🪪 Constater la remise du badge</button>
                }
            </div>

            @if (_afficherFormulaireComplement)
            {
                <div class="mt-3">
                    <label for="motif-du-complement-demande" class="form-label small fw-semibold">Motif du complément demandé</label>
                    <div class="input-group">
                        <input id="motif-du-complement-demande" class="form-control" @bind="_motifComplement" @bind:event="oninput" placeholder="Ex. : permis de conduire manquant" />
                        <button class="btn btn-warning fw-bold" @onclick="DemanderComplementAsync" disabled="@string.IsNullOrWhiteSpace(_motifComplement)">Envoyer</button>
                    </div>
                </div>
            }
        </div>
    }

    @if (_estClient && f.PeutRepondreComplement)
    {
        <div class="cit-card mb-4 border-warning">
            <h6 class="fw-bold text-dark mb-2">⚠️ Un complément est demandé</h6>
            <p class="text-muted small">Répondez par un message et/ou déposez une pièce complémentaire pour que l'instruction reprenne.</p>
            <div class="mb-2">
                <textarea class="form-control" rows="3" @bind="_reponseComplement" @bind:event="oninput" placeholder="Votre réponse..."></textarea>
            </div>
            <button class="btn btn-primary btn-sm fw-bold" @onclick="RepondreComplementAsync" disabled="@string.IsNullOrWhiteSpace(_reponseComplement)">Envoyer ma réponse</button>
        </div>
    }

    @if (f.PeutDeposerDocument)
    {
        <div class="cit-card mb-4">
            <h6 class="fw-bold text-dark mb-2">Déposer une pièce</h6>
            <InputFile class="form-control form-control-sm" OnChange="DeposerPieceAsync" />
        </div>
    }

    <div class="cit-card mb-4 p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light"><tr><th>Pièce</th><th>Taille</th><th>Antivirus</th><th>Déposée le</th></tr></thead>
                <tbody>
                    @foreach (var d in f.Documents)
                    {
                        <tr>
                            <td class="fw-semibold text-dark">📄 @d.NomFichier</td>
                            <td class="small text-muted">@((d.TailleOctets / 1024.0).ToString("0.0")) Ko</td>
                            <td><span class="badge bg-success-subtle text-success">@d.StatutAntivirus</span></td>
                            <td class="small text-muted font-monospace">@d.DateDepotUtc.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="cit-card mb-4">
        <h6 class="fw-bold text-dark mb-3">Messages</h6>
        @foreach (var m in f.Messages)
        {
            <div class="mb-2 pb-2 border-bottom">
                <div class="small fw-semibold text-dark">@m.AuteurNom @(m.EstInterne ? "(note interne)" : "")</div>
                <div class="small">@m.Contenu</div>
            </div>
        }
    </div>

    <div class="cit-card mb-4">
        <h6 class="fw-bold text-dark mb-3">Historique</h6>
        <ChronologieTicket Evenements="@f.Chronologie" />
    </div>
}

@code {
    [Parameter]
    public Guid TicketId { get; set; }

    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private string? _actionSuccess;
    private FicheEnrolementVue? _fiche;
    private Guid _appelantId;
    private bool _estClient;
    private bool _afficherFormulaireComplement;
    private string _motifComplement = string.Empty;
    private string _reponseComplement = string.Empty;

    private static readonly ReglesDepotDocument ReglesPieces = new(
        ExtensionsAutorisees: ["pdf", "jpg", "jpeg", "png"], TailleMaxOctets: 10 * 1024 * 1024);

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Veuillez vous connecter pour accéder à ce dossier.";
                return;
            }

            _appelantId = contexte.UtilisateurId;
            _estClient = contexte.Nature == NatureUtilisateur.Client;
            _fiche = await ObtenirFiche.ExecuterAsync(_appelantId, TicketId);
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task PrendreEnChargeAsync() => await ExecuterActionAsync(() => PrendreEnCharge.ExecuterAsync(_appelantId, TicketId), "Dossier pris en charge.");

    private async Task ValiderAsync() => await ExecuterActionAsync(() => ValiderEnrolement.ExecuterAsync(_appelantId, TicketId), "Dossier validé.");

    private async Task ConvoquerAsync() => await ExecuterActionAsync(() => DeclencherConvocation.ExecuterAsync(_appelantId, TicketId), "Convocation déclenchée.");

    private async Task ConstaterBadgeAsync() => await ExecuterActionAsync(() => ConstaterRemiseBadge.ExecuterAsync(_appelantId, TicketId), "Remise du badge constatée — dossier clôturé.");

    private async Task DemanderComplementAsync()
    {
        if (string.IsNullOrWhiteSpace(_motifComplement)) return;
        await ExecuterActionAsync(() => AttenteClient.MettreEnAttenteAsync(_appelantId, TicketId, _motifComplement), "Complément demandé.");
        _afficherFormulaireComplement = false;
        _motifComplement = string.Empty;
    }

    private async Task RepondreComplementAsync()
    {
        if (string.IsNullOrWhiteSpace(_reponseComplement)) return;
        await ExecuterActionAsync(async () =>
        {
            await PublierMessage.PublierMessageClientAsync(_appelantId, TicketId, _reponseComplement);
            await AttenteClient.RependreApresReponseAsync(TicketId);
        }, "Votre réponse a été envoyée — le dossier reprend son instruction.");
        _reponseComplement = string.Empty;
    }

    private async Task DeposerPieceAsync(InputFileChangeEventArgs e)
    {
        try
        {
            await using var flux = e.File.OpenReadStream(ReglesPieces.TailleMaxOctets);
            await using var memoire = new MemoryStream();
            await flux.CopyToAsync(memoire);

            if (_estClient)
            {
                await DeposerDocument.DeposerPourClientAsync(_appelantId, TicketId, e.File.Name, e.File.ContentType, memoire, memoire.Length, ReglesPieces);
            }
            else
            {
                await DeposerDocument.DeposerPourAgentAsync(_appelantId, TicketId, e.File.Name, e.File.ContentType, memoire, memoire.Length, ReglesPieces);
            }

            _actionSuccess = "Pièce déposée et analysée.";
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
    }

    private async Task ExecuterActionAsync(Func<Task> action, string messageSucces)
    {
        _erreur = null;
        _actionSuccess = null;
        try
        {
            await action();
            _actionSuccess = messageSucces;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
    }
}
