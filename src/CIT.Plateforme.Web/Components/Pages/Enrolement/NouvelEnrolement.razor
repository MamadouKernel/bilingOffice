@page "/enrolement/soumettre"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Documents
@using CIT.Plateforme.Application.Enrolement
@using CIT.Plateforme.Domain.Documents
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject IContexteUtilisateurWeb ContexteService
@inject SoumettreEnrolementCommand SoumettreEnrolement
@inject DeposerDocumentCommand DeposerDocument

<PageTitle>Nouvel enrôlement — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>🚚</span> Nouvel enrôlement
        </h2>
        <div class="cit-page-subtitle">Renseignez vos informations et déposez les pièces demandées — un dossier tracé de bout en bout sera créé</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/enrolement/mes-enrolements" class="btn btn-outline-secondary btn-sm shadow-sm">← Mes enrôlements</a>
    </div>
</div>

<div style="max-width: 760px;">
    @if (_chargement)
    {
        <IndicateurChargement Message="Chargement du formulaire..." />
    }
    else if (_nonAutorise)
    {
        <PermissionDenied Message="@_messageNonAutorise" />
    }
    else if (_ticketCreeId is not null)
    {
        <div class="cit-card border-success p-4 mb-4">
            <div class="d-flex align-items-center gap-3 text-success mb-3">
                <span class="fs-2">✅</span>
                <div>
                    <h5 class="fw-bold mb-0">Enrôlement soumis avec succès !</h5>
                    <div class="text-muted small">Numéro de suivi unique : <strong class="font-monospace text-primary">@_ticketCreeNumero</strong></div>
                </div>
            </div>

            <h6 class="fw-bold text-dark mt-4 mb-2">Déposer une pièce justificative (facultatif à ce stade)</h6>
            <InputFile class="form-control form-control-sm" OnChange="DeposerPieceAsync" />
            @if (_messagePiece is not null)
            {
                <div class="small mt-2 @(_erreurPiece ? "text-danger" : "text-success")">@_messagePiece</div>
            }

            <div class="mt-4">
                <a href="/enrolement/mes-enrolements" class="btn btn-primary fw-bold px-4">Voir mes enrôlements ➔</a>
            </div>
        </div>
    }
    else
    {
        @if (_erreur is not null)
        {
            <div class="alert alert-danger mb-4">@_erreur</div>
        }

        <div class="cit-card mb-4">
            <div class="mb-3">
                <label class="form-label small fw-semibold text-dark" for="objet">Objet</label>
                <input id="objet" class="form-control" placeholder="Ex. : Enrôlement chauffeur — camion frigorifique" @bind="_objet" @bind:event="oninput" maxlength="200" />
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold text-dark" for="description">Description</label>
                <textarea id="description" class="form-control" rows="5" placeholder="Détaillez les informations utiles à votre enrôlement..." @bind="_description" @bind:event="oninput"></textarea>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a href="/enrolement/mes-enrolements" class="btn btn-outline-secondary">Annuler</a>
                <button class="btn btn-primary px-4 fw-bold shadow-sm" @onclick="SoumettreAsync" disabled="@(!PeutSoumettre || _envoiEnCours)">
                    @(_envoiEnCours ? "Envoi en cours..." : "🚀 Soumettre l'enrôlement")
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private bool _envoiEnCours;
    private Guid? _ticketCreeId;
    private string? _ticketCreeNumero;
    private string? _messagePiece;
    private bool _erreurPiece;

    private Guid _utilisateurId;
    private string _objet = string.Empty;
    private string _description = string.Empty;

    private static readonly ReglesDepotDocument ReglesPieces = new(
        ExtensionsAutorisees: ["pdf", "jpg", "jpeg", "png"], TailleMaxOctets: 10 * 1024 * 1024);

    private bool PeutSoumettre => !string.IsNullOrWhiteSpace(_objet) && !string.IsNullOrWhiteSpace(_description);

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Veuillez vous connecter pour soumettre un enrôlement.";
                return;
            }

            if (!contexte.Permissions.Contains(Permission.EnrolementSoumettre))
            {
                _nonAutorise = true;
                _messageNonAutorise = "Votre compte n'est pas habilité à soumettre un enrôlement.";
                return;
            }

            _utilisateurId = contexte.UtilisateurId;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task SoumettreAsync()
    {
        if (!PeutSoumettre)
        {
            return;
        }

        _envoiEnCours = true;
        _erreur = null;
        try
        {
            var resultat = await SoumettreEnrolement.ExecuterAsync(_utilisateurId, new SoumettreEnrolementRequete(_objet, _description));

            _ticketCreeId = resultat.TicketId;
            _ticketCreeNumero = resultat.NumeroTicket;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _envoiEnCours = false;
        }
    }

    private async Task DeposerPieceAsync(InputFileChangeEventArgs e)
    {
        if (_ticketCreeId is not Guid ticketId)
        {
            return;
        }

        try
        {
            await using var flux = e.File.OpenReadStream(ReglesPieces.TailleMaxOctets);
            await using var memoire = new MemoryStream();
            await flux.CopyToAsync(memoire);

            await DeposerDocument.DeposerPourClientAsync(_utilisateurId, ticketId, e.File.Name, e.File.ContentType, memoire, memoire.Length, ReglesPieces);

            _messagePiece = "Pièce déposée et analysée.";
            _erreurPiece = false;
        }
        catch (Exception ex)
        {
            _messagePiece = ex.Message;
            _erreurPiece = true;
        }
    }
}
