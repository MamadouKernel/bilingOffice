@page "/enrolement/soumettre"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Administration
@using CIT.Plateforme.Application.Documents
@using CIT.Plateforme.Application.Enrolement
@using CIT.Plateforme.Domain.Documents
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject SoumettreEnrolementCommand SoumettreEnrolement
@inject DeposerDocumentCommand DeposerDocument
@inject ListerChampsFormulaireEnrolementQuery ListerChampsFormulaire

<PageTitle>@Loc["Enrol.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>🚚</span> @Loc["Enrol.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["Enrol.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/enrolement/mes-enrolements" class="btn btn-outline-secondary btn-sm shadow-sm">@Loc["Enrol.MyEnrollments"]</a>
    </div>
</div>

<div class="cit-page-etroite">
    @if (_chargement)
    {
        <IndicateurChargement Message="@Loc["Complaint.LoadingForm"]" />
    }
    else if (_nonAutorise)
    {
        <PermissionDenied Message="@_messageNonAutorise" />
    }
    else if (_ticketCreeId is not null)
    {
        <div class="cit-card border-success p-4 mb-4">
            <div class="d-flex align-items-center gap-3 text-success mb-3">
                <span class="fs-2">✅</span>
                <div>
                    <h5 class="fw-bold mb-0">@Loc["Enrol.SuccessTitle"]</h5>
                    <div class="text-muted small">@Loc["Complaint.TrackingNumber"] <strong class="font-monospace text-primary">@_ticketCreeNumero</strong></div>
                </div>
            </div>

            <h6 class="fw-bold text-dark mt-4 mb-2">@Loc["Enrol.UploadDocTitle"]</h6>
            <InputFile class="form-control form-control-sm" OnChange="DeposerPieceAsync" multiple />
            <div class="form-text">@Loc["Docs.MultipleHint"]</div>
            @if (_messagePiece is not null)
            {
                <div class="small mt-2 @(_erreurPiece ? "text-danger" : "text-success")">@_messagePiece</div>
            }

            <div class="mt-4">
                <a href="/enrolement/mes-enrolements" class="btn btn-primary fw-bold px-4">@Loc["Enrol.ViewMyEnrollments"]</a>
            </div>
        </div>
    }
    else
    {
        @if (_erreur is not null)
        {
            <div class="alert alert-danger mb-4" role="alert">@_erreur</div>
        }

        <div class="cit-card mb-4">
            <div class="mb-3">
                <label class="form-label small fw-semibold text-dark" for="objet">@Loc["Enrol.ObjectLabel"]</label>
                <input id="objet" class="form-control" placeholder="@Loc["Enrol.ObjectPlaceholder"]" @bind="_objet" @bind:event="oninput" maxlength="200" />
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold text-dark" for="description">@Loc["Enrol.DescLabel"]</label>
                <textarea id="description" class="form-control" rows="5" placeholder="@Loc["Enrol.DescPlaceholder"]" @bind="_description" @bind:event="oninput"></textarea>
            </div>

            @if (_champsFormulaire.Count > 0)
            {
                <!-- ENR-01 (remédiation) : champs structurés paramétrables, rendus dynamiquement à
                     partir du référentiel administrable — aucun champ n'est codé en dur ici. -->
                <div class="mb-4">
                    <h6 class="fw-bold text-dark mb-3">@Loc["Enrol.ChampsTitle"]</h6>
                    @foreach (var champ in _champsFormulaire)
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark" for="@("champ-" + champ.Code)">
                                @champ.Libelle
                                @if (champ.EstObligatoire)
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>
                            @switch (champ.Type)
                            {
                                case CIT.Plateforme.Domain.Enrolement.TypeChampEnrolement.Date:
                                    <input id="@("champ-" + champ.Code)" type="date" class="form-control w-auto"
                                           value="@ObtenirValeurChamp(champ.Code)"
                                           @oninput="e => DefinirValeurChamp(champ.Code, e.Value?.ToString() ?? string.Empty)" />
                                    break;
                                case CIT.Plateforme.Domain.Enrolement.TypeChampEnrolement.Liste:
                                    <select id="@("champ-" + champ.Code)" class="form-select"
                                            @onchange="e => DefinirValeurChamp(champ.Code, e.Value?.ToString() ?? string.Empty)">
                                        <option value="">—</option>
                                        @foreach (var opt in (champ.Options ?? string.Empty).Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                        {
                                            <option value="@opt" selected="@(ObtenirValeurChamp(champ.Code) == opt)">@opt</option>
                                        }
                                    </select>
                                    break;
                                default:
                                    <input id="@("champ-" + champ.Code)" class="form-control"
                                           value="@ObtenirValeurChamp(champ.Code)"
                                           @oninput="e => DefinirValeurChamp(champ.Code, e.Value?.ToString() ?? string.Empty)" />
                                    break;
                            }
                        </div>
                    }
                </div>
            }

            <div class="d-flex justify-content-end gap-2">
                <a href="/enrolement/mes-enrolements" class="btn btn-outline-secondary">@Loc["Common.Cancel"]</a>
                <button type="button" class="btn btn-primary px-4 fw-bold shadow-sm" @onclick="SoumettreAsync" disabled="@(!PeutSoumettre || _envoiEnCours)">
                    @(_envoiEnCours ? Loc["Enrol.Sending"].Value : Loc["Enrol.Submit"].Value)
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private bool _envoiEnCours;
    private Guid? _ticketCreeId;
    private string? _ticketCreeNumero;
    private string? _messagePiece;
    private bool _erreurPiece;

    private Guid _utilisateurId;
    private string _objet = string.Empty;
    private string _description = string.Empty;
    private IReadOnlyList<ChampFormulaireEnrolementVue> _champsFormulaire = [];
    private readonly Dictionary<string, string> _valeursChamps = new(StringComparer.OrdinalIgnoreCase);

    private static readonly ReglesDepotDocument ReglesPieces = new(
        ExtensionsAutorisees: ["pdf", "jpg", "jpeg", "png"], TailleMaxOctets: 10 * 1024 * 1024);

    private bool PeutSoumettre =>
        !string.IsNullOrWhiteSpace(_objet) &&
        !string.IsNullOrWhiteSpace(_description) &&
        _champsFormulaire.Where(c => c.EstObligatoire).All(c => !string.IsNullOrWhiteSpace(ObtenirValeurChamp(c.Code)));

    private string ObtenirValeurChamp(string code) => _valeursChamps.TryGetValue(code, out var v) ? v : string.Empty;

    private void DefinirValeurChamp(string code, string valeur) => _valeursChamps[code] = valeur;

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["Enrol.LoginRequired"].Value;
                return;
            }

            if (!contexte.Permissions.Contains(Permission.EnrolementSoumettre))
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["Enrol.NotAuthorized"].Value;
                return;
            }

            _utilisateurId = contexte.UtilisateurId;
            _champsFormulaire = await ListerChampsFormulaire.ListerPourSoumissionAsync(CIT.Plateforme.Domain.Enrolement.TypeObjetEnrolement.Chauffeur);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task SoumettreAsync()
    {
        if (!PeutSoumettre)
        {
            return;
        }

        _envoiEnCours = true;
        _erreur = null;
        try
        {
            var champsSoumis = _champsFormulaire
                .Select(c => new ValeurChampEnrolementSoumission(c.Code, ObtenirValeurChamp(c.Code)))
                .ToList();
            var resultat = await SoumettreEnrolement.ExecuterAsync(_utilisateurId, new SoumettreEnrolementRequete(_objet, _description, champsSoumis));

            _ticketCreeId = resultat.TicketId;
            _ticketCreeNumero = resultat.NumeroTicket;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _envoiEnCours = false;
        }
    }

    private async Task DeposerPieceAsync(InputFileChangeEventArgs e)
    {
        if (_ticketCreeId is not Guid ticketId)
        {
            return;
        }

        try
        {
            var fichiers = DepotFichiers.Lire(e);
            if (fichiers is null)
            {
                _messagePiece = Loc["Docs.TooManyFiles", DepotFichiers.MaxParDepot].Value;
                _erreurPiece = true;
                return;
            }

            var resultat = await DepotFichiers.DeposerTousAsync(fichiers, ReglesPieces.TailleMaxOctets, (nom, type, contenu) =>
                DeposerDocument.DeposerPourClientAsync(_utilisateurId, ticketId, nom, type, contenu, contenu.Length, ReglesPieces));

            _messagePiece = resultat.Message(Loc);
            _erreurPiece = resultat.Deposes == 0;
        }
        catch (Exception ex)
        {
            _messagePiece = MessagesUtilisateur.Pour(ex);
            _erreurPiece = true;
        }
    }
}
