@page "/enrolement/societe/soumettre"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Enrolement
@using CIT.Plateforme.Domain.Enrolement
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject SoumettreEnrolementSocieteCommand SoumettreEnrolementSociete
@inject Microsoft.Extensions.DependencyInjection.IServiceScopeFactory ScopeFactory

<PageTitle>@Loc["EnrolSoc.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title"><span>🚚</span> @Loc["EnrolSoc.Title"]</h1>
        <div class="cit-page-subtitle">@Loc["EnrolSoc.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0 d-flex gap-2">
        <a href="/enrolement/societe/retrait" class="btn btn-outline-danger btn-sm shadow-sm">@Loc["EnrolSoc.LinkRetrait"]</a>
        <a href="/enrolement/mes-enrolements" class="btn btn-outline-secondary btn-sm shadow-sm">@Loc["Enrol.MyEnrollments"]</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["Complaint.LoadingForm"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else if (_resultat is not null)
{
    <div class="cit-card border-success p-4 mb-4" style="max-width: 760px;">
        <div class="d-flex align-items-center gap-3 text-success mb-3">
            <span class="fs-2">✅</span>
            <div>
                <h5 class="fw-bold mb-0">@Loc["EnrolSoc.SuccessTitle"]</h5>
                <div class="text-muted small">
                    @Loc["EnrolSoc.SuccessDossier"] <strong class="font-monospace text-primary">@_resultat.NumeroDossier</strong>
                    — @string.Format(Loc["EnrolSoc.SuccessTicketsCount"].Value, _resultat.Tickets.Count)
                </div>
                @if (_messagePieces is not null)
                {
                    <div class="small mt-1">📎 @Loc["PJ.Attached"] @_messagePieces</div>
                }
                @if (_messageFormulaire is not null)
                {
                    <div class="small mt-1">📄 @_messageFormulaire</div>
                }
            </div>
        </div>
        <a href="/enrolement/mes-enrolements" class="btn btn-primary fw-bold px-4">@Loc["EnrolSoc.ViewMyEnrollments"]</a>
    </div>
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-4" role="alert">@_erreur</div>
    }

    <div class="cit-card mb-4 p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 160px;">@Loc["EnrolSoc.ColType"]</th>
                        <th>@Loc["EnrolSoc.ColObjet"]</th>
                        <th>@Loc["EnrolSoc.ColDesc"]</th>
                        <th style="width: 220px;">@Loc["EnrolSoc.ColEcheances"]</th>
                        <th style="width: 100px;">@Loc["EnrolSoc.ColActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ligne in _lignes)
                    {
                        <tr @key="ligne.Cle">
                            <td>
                                <select class="form-select form-select-sm" value="@ligne.Type"
                                        @onchange="e => ligne.Type = Enum.Parse<TypeObjetEnrolement>(e.Value?.ToString() ?? nameof(TypeObjetEnrolement.Chauffeur))">
                                    <option value="@nameof(TypeObjetEnrolement.Chauffeur)">@Loc["Enrol.Objet.Chauffeur"]</option>
                                    <option value="@nameof(TypeObjetEnrolement.Camion)">@Loc["Enrol.Objet.Camion"]</option>
                                </select>
                            </td>
                            <td>
                                <input class="form-control form-control-sm" @bind="ligne.Objet" @bind:event="oninput"
                                       placeholder="@(ligne.Type == TypeObjetEnrolement.Camion ? Loc["EnrolSoc.ObjectPlaceholderCamion"].Value : Loc["EnrolSoc.ObjectPlaceholderChauffeur"].Value)" maxlength="200" />
                            </td>
                            <td>
                                <input class="form-control form-control-sm" @bind="ligne.Description" @bind:event="oninput"
                                       placeholder="@Loc["EnrolSoc.DescPlaceholder"]" maxlength="500" />
                            </td>
                            <td>
                                @* Dates d'expiration facultatives : permis (chauffeur), assurance et visite technique (camion). *@
                                @foreach (var document in EcheanceDocumentEnrolement.DocumentsAttendus(ligne.Type))
                                {
                                    <label class="small text-muted d-block mb-0">@Loc[$"EnrolSoc.Doc.{document}"]</label>
                                    <input type="date" required class="form-control form-control-sm mb-1"
                                           value="@(ligne.Echeances.TryGetValue(document, out var d) ? d.ToString("yyyy-MM-dd") : string.Empty)"
                                           @onchange="e => ligne.DefinirEcheance(document, e.Value?.ToString())" />
                                }
                            </td>
                            <td>
                                <BoutonSupprimer Discret="true" Libelle="@Loc["EnrolSoc.RemoveObjectBtn"]" Desactive="@(_lignes.Count == 1)" OnSupprimer="() => RetirerLigne(ligne)" />
                            </td>
                        </tr>
                        @* Pièces justificatives de la ligne : photo (téléphone) ou scan PDF, une par face. *@
                        <tr @key="(ligne.Cle, 1)">
                            <td colspan="5" class="pt-0">
                                <div class="small fw-semibold text-muted mb-1">@Loc["EnrolSoc.PiecesTitle"]</div>
                                <div class="d-flex flex-wrap gap-3">
                                    @foreach (var exigee in PiecesEnrolement.Exigees(ligne.Type))
                                    {
                                        var piece = exigee.Piece;
                                        <div style="min-width: 220px;">
                                            <label class="small d-block mb-1">@Loc[$"EnrolSoc.Piece.{piece}"]@(exigee.Obligatoire ? " *" : string.Empty)</label>
                                            <InputFile class="form-control form-control-sm" accept="image/jpeg,image/png,.pdf"
                                                       OnChange="e => ligne.ChoisirPiece(piece, e.File)" />
                                            @if (ligne.Pieces.TryGetValue(piece, out var choisi))
                                            {
                                                <div class="small text-success mt-1">✅ @choisi.Name</div>
                                            }
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="p-3 border-top">
            <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" @onclick="AjouterLigne">@Loc["EnrolSoc.AddObjectBtn"]</button>
        </div>
    </div>

    <SignataireFlotteFormulaire Modele="_signataire" Modifie="StateHasChanged" />

    <div class="d-flex justify-content-end gap-2" style="max-width: 100%;">
        <button type="button" class="btn btn-primary px-4 fw-bold shadow-sm" @onclick="SoumettreAsync" disabled="@(!PeutSoumettre || _envoiEnCours)">
            @(_envoiEnCours ? Loc["EnrolSoc.Sending"].Value : Loc["EnrolSoc.Submit"].Value)
        </button>
    </div>
}

@code {
    private sealed class LigneObjet
    {
        public Guid Cle { get; } = Guid.NewGuid();
        public TypeObjetEnrolement Type { get; set; } = TypeObjetEnrolement.Chauffeur;
        public string Objet { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public Dictionary<DocumentEnrolement, DateOnly> Echeances { get; } = [];
        public Dictionary<PieceEnrolement, IBrowserFile> Pieces { get; } = [];

        public void ChoisirPiece(PieceEnrolement piece, IBrowserFile? fichier)
        {
            if (fichier is null) Pieces.Remove(piece); else Pieces[piece] = fichier;
        }

        /// <summary>Seules les pièces du type courant partent (la ligne a pu changer de type).</summary>
        public IReadOnlyList<(PieceEnrolement Piece, IBrowserFile Fichier)> PiecesPertinentes() =>
            [.. PiecesEnrolement.Exigees(Type).Where(e => Pieces.ContainsKey(e.Piece)).Select(e => (e.Piece, Pieces[e.Piece]))];

        public void DefinirEcheance(DocumentEnrolement document, string? valeur)
        {
            if (DateOnly.TryParse(valeur, System.Globalization.CultureInfo.InvariantCulture, out var date))
            {
                Echeances[document] = date;
            }
            else
            {
                Echeances.Remove(document);
            }
        }

        /// <summary>Seules les dates du type courant partent (la ligne a pu changer de type).</summary>
        public IReadOnlyList<EcheanceDocumentSaisie> EcheancesPertinentes() =>
            [.. Echeances.Where(e => EcheanceDocumentEnrolement.DocumentsAttendus(Type).Contains(e.Key))
                .Select(e => new EcheanceDocumentSaisie(e.Key, e.Value))];
    }

    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private bool _envoiEnCours;
    private SoumettreEnrolementSocieteResultat? _resultat;
    private string? _messagePieces;
    private string? _messageFormulaire;
    private readonly SignataireFlotte _signataire = new();
    private string _societeNom = string.Empty;
    private string _compte = string.Empty;

    private Guid _utilisateurId;
    private Guid _societeId;
    private readonly List<LigneObjet> _lignes = [new()];

    private bool PeutSoumettre =>
        _lignes.Count > 0 && _signataire.EstComplet &&
        _lignes.All(l => !string.IsNullOrWhiteSpace(l.Objet) && !string.IsNullOrWhiteSpace(l.Description)
                         // Dates d'expiration obligatoires pour chaque document attendu (03/10/2026).
                         && EcheanceDocumentEnrolement.DocumentsAttendus(l.Type).All(l.Echeances.ContainsKey)
                         // Pièces obligatoires (04/10/2026) : permis recto/verso et pièce d'identité ;
                         // carte grise recto/verso et assurance.
                         && PiecesEnrolement.Manquantes(l.Type, l.Pieces.Keys).Count == 0);

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["EnrolSoc.LoginRequired"].Value;
                return;
            }

            if (contexte.SocieteProfil != CIT.Plateforme.Domain.Comptes.TypeClient.Transporteur)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["EnrolSoc.TransporteurOnly"].Value;
                return;
            }

            if (contexte.DroitSoumission != true)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["EnrolSoc.NotAuthorized"].Value;
                return;
            }

            _utilisateurId = contexte.UtilisateurId;
            _societeId = contexte.SocieteId.Value;
            _societeNom = contexte.SocieteNom ?? string.Empty;
            _compte = contexte.Email;
            _signataire.Nom = contexte.NomAffiche is { } nom && !nom.Contains('@') ? nom : string.Empty;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    /// <summary>Formulaire officiel (F-0001 camions / F-0002 chauffeurs), un par type présent, joint
    /// à chaque ticket du type. Un échec n'annule pas la demande déjà enregistrée : il est signalé.</summary>
    private async Task<string?> JoindreFormulairesAsync(IReadOnlyList<(TypeObjetEnrolement Type, string Objet, Guid TicketId)> lignes, bool ajout)
    {
        var messages = new List<string>();
        foreach (var groupe in lignes.GroupBy(l => l.Type))
        {
            var type = (groupe.Key, ajout) switch
            {
                (TypeObjetEnrolement.Camion, true) => TypeFormulaireFlotte.AjoutCamion,
                (TypeObjetEnrolement.Camion, false) => TypeFormulaireFlotte.RetraitCamion,
                (_, true) => TypeFormulaireFlotte.AjoutChauffeur,
                _ => TypeFormulaireFlotte.RetraitChauffeur,
            };
            var demande = new DemandeFormulaireFlotte(type, _signataire.Nom.Trim(), _signataire.Qualite.Trim(), _societeNom,
                _signataire.Siege.Trim(), [.. groupe.Select(l => l.Objet)], DateTime.UtcNow, _compte);
            try
            {
                await FormulaireFlotteDepot.JoindreAsync(ScopeFactory, demande, groupe.Select(l => l.TicketId), _utilisateurId);
                messages.Add(string.Format(Loc["Signataire.Joint"].Value, FormulairesFlotte.Reference(type)));
            }
            catch (Exception ex)
            {
                messages.Add($"{FormulairesFlotte.Reference(type)} : {MessagesUtilisateur.Pour(ex)}");
            }
        }
        return messages.Count == 0 ? null : string.Join(" ", messages);
    }

    private void AjouterLigne() => _lignes.Add(new LigneObjet());

    private void RetirerLigne(LigneObjet ligne)
    {
        if (_lignes.Count > 1)
        {
            _lignes.Remove(ligne);
        }
    }

    private async Task SoumettreAsync()
    {
        if (!PeutSoumettre)
        {
            return;
        }

        _envoiEnCours = true;
        _erreur = null;
        try
        {
            var objets = _lignes
                .Select(l => new ObjetEnrolementSoumission(l.Type, l.Objet.Trim(), l.Description.Trim(), l.EcheancesPertinentes()))
                .ToList();
            var resultat = await SoumettreEnrolementSociete.ExecuterAsync(
                _utilisateurId,
                new SoumettreEnrolementSocieteRequete(_societeId, objets));

            // Chaque pièce rejoint le ticket de sa ligne (même ordre), sous un nom explicite pour
            // l'Agent Gate : « Permis de conduire (recto) — photo.jpg ».
            var bilans = new List<string>();
            foreach (var (ligne, ticket) in _lignes.Zip(resultat.Tickets))
            {
                var pieces = ligne.PiecesPertinentes();
                if (pieces.Count == 0) continue;
                var libelles = pieces.ToDictionary(p => p.Fichier, p => Loc[$"EnrolSoc.Piece.{p.Piece}"].Value);
                var bilan = await DepotFichiers.JoindreAsync(ScopeFactory, [.. pieces.Select(p => p.Fichier)], ticket.TicketId,
                    _utilisateurId, estClient: true, nommer: f => $"{libelles[f]} — {f.Name}");
                bilans.Add(bilan.Message(Loc));
            }
            _messagePieces = bilans.Count == 0 ? null : string.Join(" ", bilans.Distinct());
            _messageFormulaire = await JoindreFormulairesAsync(
                [.. _lignes.Zip(resultat.Tickets).Select(x => (x.First.Type, x.First.Objet.Trim(), x.Second.TicketId))], ajout: true);
            _resultat = resultat;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _envoiEnCours = false;
        }
    }
}
