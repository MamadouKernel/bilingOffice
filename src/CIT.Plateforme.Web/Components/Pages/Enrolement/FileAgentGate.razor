@page "/enrolement/file-agent-gate"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Abstractions
@using CIT.Plateforme.Application.Enrolement
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Tickets
@using CIT.Plateforme.Domain.Enrolement
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ConsulterFileAgentGateQuery ConsulterFileAgentGate
@inject PrendreEnChargeCommand PrendreEnCharge

<PageTitle>@Loc["AgentGate.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>🛂</span> @Loc["AgentGate.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["AgentGate.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="ChargerAsync">@Loc["Common.Refresh"]</button>
        <a href="/agent/dashboard" class="btn btn-outline-primary btn-sm shadow-sm">@Loc["AgentGate.LinkDashboard"]</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["AgentGate.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-3" role="alert">@_erreur</div>
    }

    @if (!string.IsNullOrWhiteSpace(_actionSuccess))
    {
        <div class="alert alert-success py-2 small mb-3" role="status">@_actionSuccess</div>
    }

    @if (_tickets.Count == 0)
    {
        <EtatVide Titre="@Loc["AgentGate.EmptyTitle"]" Description="@Loc["AgentGate.EmptyDesc"]" Icone="🚚" />
    }
    else
    {
        <div class="cit-card mb-4 p-0 overflow-hidden">
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["AgentGate.ColNumero"]</th>
                            <th>@Loc["AgentGate.ColObjet"]</th>
                            <th>@Loc["AgentGate.ColType"]</th>
                            <th>@Loc["AgentGate.ColStatut"]</th>
                            <th>@Loc["AgentGate.ColArrivee"]</th>
                            <th class="text-end">@Loc["AgentGate.ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _pagination1.Appliquer(_tickets))
                        {
                            <tr>
                                <td class="fw-bold text-decoration-none text-primary font-monospace">@t.Numero</td>
                                <td>
                                    <div class="fw-semibold text-dark">@(t.Objet ?? "—")</div>
                                    <ClientTicket DossierId="t.DossierId" />
                                    @if (_doublons.TryGetValue(t.Id, out var autres))
                                    {
                                        <div class="small text-warning-emphasis mt-1" title="@Loc["AgentGate.DoublonTitle"]">⚠️ @Loc["AgentGate.Doublon", string.Join(", ", autres)]</div>
                                    }
                                </td>
                                <td>
                                    @if (t.ObjetEnrolement is not null)
                                    {
                                        <span class="badge bg-primary-subtle text-primary me-1">@Loc[$"Enrol.Objet.{t.ObjetEnrolement}"]</span>
                                        <span class="badge @(t.SensEnrolement == SensEnrolement.Retrait ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success")">@Loc[$"Enrol.Sens.{t.SensEnrolement}"]</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><StatutBadge Statut="@t.Statut" /></td>
                                <td class="small text-muted font-monospace">@t.DateArriveeEnFileUtc.Horodate()</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/enrolement/@t.Id" class="btn btn-outline-secondary">@Loc["AgentGate.BtnFiche"]</a>
                                        @if (t.Statut == StatutTicket.EnAttenteDePriseEnCharge)
                                        {
                                            <button type="button" class="btn btn-outline-success fw-semibold" @onclick="() => PrendreEnChargeAsync(t.Id)">@Loc["AgentGate.BtnPrendreEnCharge"]</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private string? _actionSuccess;

    private Guid _agentId;
    private List<Ticket> _tickets = [];
    private IReadOnlyDictionary<Guid, IReadOnlyList<string>> _doublons = new Dictionary<Guid, IReadOnlyList<string>>();

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["AgentGate.LoginRequis"].Value;
                return;
            }

            _agentId = contexte.UtilisateurId;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _erreur = null;
        try
        {
            var ticketsDeLaFile = await ConsulterFileAgentGate.ExecuterAsync(_agentId);
            _tickets = ticketsDeLaFile.ToList();
            _doublons = DoublonsEnrolement.Detecter(_tickets);
        }
        catch (AccesRefuseException ex)
        {
            _tickets = [];
            _nonAutorise = true;
            _messageNonAutorise = MessagesUtilisateur.Texte(ex);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private async Task PrendreEnChargeAsync(Guid ticketId)
    {
        _erreur = null;
        _actionSuccess = null;
        try
        {
            await PrendreEnCharge.ExecuterAsync(_agentId, ticketId);
            _actionSuccess = Loc["AgentGate.Success"].Value;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }
}
