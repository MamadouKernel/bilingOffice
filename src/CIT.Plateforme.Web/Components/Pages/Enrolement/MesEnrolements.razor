@page "/enrolement/mes-enrolements"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Enrolement
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IContexteUtilisateurWeb ContexteService
@inject ListerMesEnrolementsQuery ListerMesEnrolements

<PageTitle>Mes enrôlements — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>🚚</span> Mes enrôlements
        </h2>
        <div class="cit-page-subtitle">Suivi de vos dossiers d'enrôlement soumis à l'Agent Gate CIT</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/enrolement/soumettre" class="btn btn-primary btn-sm shadow-sm fw-bold">➕ Nouvel enrôlement</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement de vos enrôlements..." />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger mb-4">@_erreur</div>
}
else if (_enrolements.Count == 0)
{
    <EtatVide Titre="Aucun enrôlement" Description="Vous n'avez soumis aucun enrôlement pour le moment." Icone="🚚"
              ActionLibelle="Nouvel enrôlement" ActionUrl="/enrolement/soumettre" />
}
else
{
    <div class="cit-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>N° Dossier</th>
                        <th>Objet</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _enrolements)
                    {
                        <tr>
                            <td class="fw-bold text-primary font-monospace">@t.Numero</td>
                            <td class="fw-semibold text-dark">@(t.Objet ?? "—")</td>
                            <td><StatutBadge Statut="@t.Statut" /></td>
                            <td class="text-end">
                                <a href="/enrolement/@t.Id" class="btn btn-outline-primary btn-sm">Détails ➔</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool _chargement = true;
    private string? _erreur;
    private IReadOnlyList<Ticket> _enrolements = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _erreur = "Session invalide.";
                return;
            }

            _enrolements = await ListerMesEnrolements.ExecuterAsync(contexte.UtilisateurId);
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }
}
