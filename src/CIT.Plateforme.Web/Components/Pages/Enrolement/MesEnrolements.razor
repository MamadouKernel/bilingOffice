@page "/enrolement/mes-enrolements"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Enrolement
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ListerMesEnrolementsQuery ListerMesEnrolements
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Navigation

<PageTitle>@Loc["EnrolList.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>🚚</span> @Loc["EnrolList.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["EnrolList.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/enrolement/soumettre" class="btn btn-primary btn-sm shadow-sm fw-bold">@Loc["EnrolList.New"]</a>
    </div>
</div>

@if (_messageRenouvellement is not null)
{
    @* Message local : _erreur remplace toute la page, et un renouvellement qui échoue ne doit
       pas faire disparaître la liste des enrôlements que le titulaire consultait. *@
    <div class="alert @(_renouvellementEchoue ? "alert-danger" : "alert-info") border-0 mb-3 rounded-3" role="status">
        @_messageRenouvellement
    </div>
}

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["EnrolList.Loading"]" />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger mb-4" role="alert">@_erreur</div>
}
else if (_enrolements.Count == 0)
{
    <EtatVide Titre="@Loc["EnrolList.EmptyTitle"]" Description="@Loc["EnrolList.EmptyDesc"]" Icone="🚚"
              ActionLibelle="@Loc["EnrolList.EmptyCta"]" ActionUrl="/enrolement/soumettre" />
}
else
{
    <div class="cit-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Loc["EnrolList.ColFile"]</th>
                        <th>@Loc["AvoirExoList.ColObject"]</th>
                        <th>@Loc["Societe.ColStatus"]</th>
                        <th class="text-end">@Loc["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _pagination1.Appliquer(_enrolements))
                    {
                        <tr>
                            <td class="fw-bold text-primary font-monospace">@t.Numero</td>
                            <td class="fw-semibold text-dark">@(t.Objet ?? "—")</td>
                            <td><StatutBadge Statut="@t.Statut" /></td>
                            <td class="text-end">
                                @if (t.Statut == StatutTicket.Cloture)
                                {
                                    @* ENR-05 — « demander le renouvellement d'un badge existant ». La commande
                                       était écrite et testée, et aucun écran ne l'appelait : le titulaire d'un
                                       badge délivré n'avait aucun moyen de le renouveler. Un renouvellement se
                                       demande sur un enrôlement abouti, jamais sur un dossier encore en cours. *@
                                    <button type="button" class="btn btn-outline-secondary btn-sm me-1"
                                            @onclick="() => DemanderRenouvellementAsync(t.DossierId)"
                                            disabled="@(_renouvellementEnCours == t.DossierId)">
                                        @(_renouvellementEnCours == t.DossierId ? Loc["EnrolList.Sending"].Value : Loc["EnrolList.Renew"].Value)
                                    </button>
                                }
                                <a href="/enrolement/@t.Id" class="btn btn-outline-primary btn-sm">@Loc["Demandes.Details"]</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
        </div>
    </div>
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargement = true;
    private string? _erreur;
    private IReadOnlyList<Ticket> _enrolements = [];
    private Guid _utilisateurId;
    private Guid? _renouvellementEnCours;
    private string? _messageRenouvellement;
    private bool _renouvellementEchoue;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _erreur = Loc["EnrolList.SessionInvalid"].Value;
                return;
            }

            _utilisateurId = contexte.UtilisateurId;
            _enrolements = await ListerMesEnrolements.ExecuterAsync(contexte.UtilisateurId);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task DemanderRenouvellementAsync(Guid dossierId)
    {
        _messageRenouvellement = null;
        _renouvellementEchoue = false;
        _renouvellementEnCours = dossierId;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var ticket = await scope.ServiceProvider
                .GetRequiredService<DemanderRenouvellementBadgeCommand>()
                .ExecuterPourDossierAsync(_utilisateurId, dossierId);

            _messageRenouvellement = string.Format(Loc["EnrolList.RenewalRegistered"].Value, ticket.Numero);
            _enrolements = await ListerMesEnrolements.ExecuterAsync(_utilisateurId);
        }
        catch (Exception ex)
        {
            _renouvellementEchoue = true;
            _messageRenouvellement = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _renouvellementEnCours = null;
        }
    }
}
