@page "/billing-import/facturation"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.BillingImport
@using CIT.Plateforme.Application.Documents
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Documents
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject EditerFactureCommand EditerFacture
@inject ConsulterFileBillingImportQuery ConsulterFile

<PageTitle>@Loc["FileFact.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>💳</span> @Loc["FileFact.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["FileFact.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="ChargerAsync">@Loc["File.Refresh"]</button>
        <a href="/agent/dashboard" class="btn btn-outline-primary btn-sm shadow-sm">@Loc["File.MyDashboard"]</a>
    </div>
</div>

<div class="cit-card mb-3 p-3 d-flex flex-wrap align-items-center gap-3">
    <div class="d-flex align-items-center gap-2">
        <label for="filtre-statut" class="form-label mb-0 small fw-semibold">@Loc["File.FilterStatus"]</label>
        <select id="filtre-statut" class="form-select form-select-sm w-auto" @bind="_filtreStatut" @bind:after="ChargerAsync">
            <option value="">@Loc["File.FilterStatusAll"]</option>
            @foreach (var statut in _statutsFiltrables)
            {
                <option value="@statut">@statut</option>
            }
        </select>
    </div>
    <div class="d-flex align-items-center gap-2">
        <label for="tri-file" class="form-label mb-0 small fw-semibold">@Loc["File.SortLabel"]</label>
        <select id="tri-file" class="form-select form-select-sm w-auto" @bind="_tri" @bind:after="ChargerAsync">
            <option value="@TriFileTicket.DateArriveeCroissante">@Loc["File.SortArrivalAsc"]</option>
            <option value="@TriFileTicket.DateArriveeDecroissante">@Loc["File.SortArrivalDesc"]</option>
            <option value="@TriFileTicket.PrioriteDecroissante">@Loc["File.SortPriorityDesc"]</option>
            <option value="@TriFileTicket.PrioriteCroissante">@Loc["File.SortPriorityAsc"]</option>
        </select>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["FileFact.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_message is not null)
    {
        <div class="alert @(_erreur ? "alert-danger" : "alert-success") mb-3">@_message</div>
    }

    @if (_tickets.Count == 0)
    {
        <EtatVide Titre="@Loc["FileFact.EmptyTitle"]"
                  Description="@Loc["FileFact.EmptyDesc"]"
                  Icone="🧾" />
    }
    else
    {
        <div class="cit-card mb-4 p-0 overflow-hidden">
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["AvoirExoList.ColTicket"]</th>
                            <th>@Loc["File.ColBl"]</th>
                            <th>@Loc["Societe.ColStatus"]</th>
                            <th>@Loc["File.ColArrival"]</th>
                            <th>@Loc["FileFact.ColUploadInvoice"]</th>
                            <th class="text-end">@Loc["SimHist.ColAction"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in _pagination1.Appliquer(_tickets))
                        {
                            var t = ticket;
                            <tr>
                                <td>
                                    <a href="/tickets/@t.Id" class="fw-bold text-decoration-none text-primary font-monospace">
                                        @t.Numero
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark font-monospace">@t.NumeroBl</span>
                                </td>
                                <td>
                                    <StatutBadge Statut="@t.Statut" />
                                </td>
                                <td class="small text-muted font-monospace">
                                    @t.DateArriveeEnFileUtc.Horodate()
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <InputFile class="form-control form-control-sm" OnChange="e => EditerFactureAsync(t.Id, e)" />
                                    </div>
                                </td>
                                <td class="text-end">
                                    <a href="/tickets/@t.Id" class="btn btn-outline-secondary btn-sm" title="@Loc["File.SheetTitle"]">
                                        @Loc["File.Sheet"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private static readonly ReglesDepotDocument ReglesDemonstration = new(
        ExtensionsAutorisees: ["pdf", "jpg", "jpeg", "png"], TailleMaxOctets: 10 * 1024 * 1024);

    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;

    private Guid _agentId;
    private List<Ticket> _tickets = [];
    private string? _message;
    private bool _erreur;
    private string _filtreStatut = string.Empty;
    private TriFileTicket _tri = TriFileTicket.DateArriveeCroissante;
    private static readonly StatutTicket[] _statutsFiltrables =
        [StatutTicket.EnAttenteDePriseEnCharge, StatutTicket.EnCours];

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["File.LoginRequired"].Value;
                return;
            }

            _agentId = contexte.UtilisateurId;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _message = MessagesUtilisateur.Pour(ex);
            _erreur = true;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _message = null;
        try
        {
            StatutTicket? statut = Enum.TryParse<StatutTicket>(_filtreStatut, out var s) ? s : null;
            var ticketsDeLaFile = await ConsulterFile.ExecuterAsync(
                _agentId, NomsFiles.Facturation, [Permission.BillingImportFacturationEditer], statut, _tri);
            _tickets = [.. ticketsDeLaFile.Where(t => statut is not null || t.Statut == StatutTicket.EnAttenteDePriseEnCharge || t.Statut == StatutTicket.EnCours)];
            _erreur = false;
        }
        catch (AccesRefuseException ex)
        {
            _tickets = [];
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _tickets = [];
            _message = MessagesUtilisateur.Pour(ex);
            _erreur = true;
        }
    }

    private async Task EditerFactureAsync(Guid ticketId, InputFileChangeEventArgs e)
    {
        _message = null;
        try
        {
            await using var flux = e.File.OpenReadStream(ReglesDemonstration.TailleMaxOctets);
            await using var memoire = new MemoryStream();
            await flux.CopyToAsync(memoire);

            await EditerFacture.ExecuterAsync(
                _agentId, ticketId, e.File.Name, e.File.ContentType, memoire, memoire.Length, ReglesDemonstration);

            _message = Loc["FileFact.InvoiceIssued"].Value;
            _erreur = false;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _message = MessagesUtilisateur.Pour(ex);
            _erreur = true;
        }
    }
}
