@page "/billing-import/soumettre"
@rendermode InteractiveServer
@using CIT.Plateforme.Application.BillingImport
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@inject IContexteUtilisateurWeb ContexteService
@inject SoumettreDemandeImportCommand Soumettre
@using Microsoft.Extensions.DependencyInjection
@inject Microsoft.Extensions.DependencyInjection.IServiceScopeFactory ScopeFactory
@inject NavigationManager Navigation

<PageTitle>@Loc["BillingImport.Title"] — @Loc["Common.AppTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>📥</span> @Loc["BillingImport.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["BillingImport.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/client/dashboard" class="btn btn-outline-secondary btn-sm">← @Loc["Common.Back"]</a>
    </div>
</div>

<div style="max-width: 900px;">
    @if (_chargement)
    {
        <IndicateurChargement Message="@Loc["BImp.CheckingPerms"]" />
    }
    else if (_nonAutorise)
    {
        <PermissionDenied Message="@_messageNonAutorise" />
    }
    else
    {
        <!-- Récapitulatif du compte émetteur -->
        <div class="cit-card mb-4 bg-light border">
            <h6 class="fw-bold text-dark mb-2">@Loc["BImp.IssuerAccount"]</h6>
            <div class="row g-2 small">
                <div class="col-12 col-md-6">
                    <span class="text-muted">@Loc["BImp.CompanyLabel"]</span>
                    <strong class="ms-1 text-dark">@_societeNom</strong>
                </div>
                <div class="col-12 col-md-6">
                    <span class="text-muted">@Loc["BImp.DepositorLabel"]</span>
                    <strong class="ms-1 text-dark">@_auteurNom</strong>
                </div>
            </div>
        </div>

        <EditForm Model="_modele" OnValidSubmit="SoumettreAsync">
            <div class="cit-card mb-4">
                <h6 class="fw-bold text-dark mb-3">@Loc["BImp.BlSection"]</h6>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark" for="numeros-bl">@Loc["BillingImport.BlNumber"]</label>
                    <InputTextArea id="numeros-bl" class="form-control font-monospace" rows="6"
                                   placeholder="@Loc["BImp.BlPlaceholder"]"
                                   @bind-Value="_modele.NumerosBl" />
                    <div class="form-text small text-muted">
                        @Loc["BImp.BlHint"]
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark" for="ref-simulation">@Loc["BImp.SimRefLabel"]</label>
                    <input id="ref-simulation" class="form-control" @bind="_modele.ReferenceSimulationProforma"
                           placeholder="@Loc["BImp.SimRefPlaceholder"]" />
                    <div class="form-text small text-muted">
                        @((MarkupString)Loc["BImp.SimRefHint"].Value)
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2">
                    <a href="/client/dashboard" class="btn btn-outline-secondary">@Loc["Common.Cancel"]</a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold" disabled="@(string.IsNullOrWhiteSpace(_modele.NumerosBl) || _soumissionEnCours)">
                        @if (_soumissionEnCours)
                        {
                            <span>@Loc["BImp.Submitting"]</span>
                        }
                        else
                        {
                            <span>@Loc["BImp.Submit"]</span>
                        }
                    </button>
                </div>
                @if (string.IsNullOrWhiteSpace(_modele.NumerosBl) && !_soumissionEnCours)
                {
                    <p class="form-text small text-muted text-end mt-2 mb-0">
                        @Loc["BImp.NeedBl"]
                    </p>
                }
            </div>
        </EditForm>

        <div @ref="_zoneRetour" tabindex="-1" class="cit-zone-retour">

        @if (_erreur is not null)
        {
            <div class="alert alert-danger mt-3" role="alert">@_erreur</div>
        }

        @* REMÉDIATION D-10 : une soumission entièrement en doublon ne crée plus de dossier et
           n'affiche plus « succès » — elle est présentée comme un refus, avec le détail. *@
        @if (_resultat is not null && !_resultat.EstRetenu)
        {
            <div class="cit-card border-warning mt-4">
                <div class="d-flex align-items-center gap-2 text-warning-emphasis mb-3">
                    <span class="fs-4">⚠️</span>
                    <h5 class="fw-bold mb-0">@Loc["BImp.NoneRetainedTitle"]</h5>
                </div>
                <p class="mb-2">
                    @Loc["BImp.NoneRetainedMsg"]
                </p>
                <div class="alert alert-warning mb-0">
                    <strong class="d-block mb-1">@Loc["BImp.DuplicatesLabel"]</strong>
                    <ul class="mb-0 small ps-3">
                        @foreach (var refus in _resultat.BlRefuses)
                        {
                            <li>
                                <strong>@refus.NumeroBl</strong> :
                                @if (refus.TicketExistantId is Guid ticketId)
                                {
                                    <span>@Loc["BImp.AlreadyExistsPre"]<a href="/tickets/@ticketId">@Loc["BImp.ViewTicketLink"]</a>@Loc["BImp.AlreadyExistsPost"]</span>
                                }
                                else
                                {
                                    <span>@Loc["BImp.AlreadyProcessing"]</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
        else if (_resultat is not null)
        {
            <div class="cit-card border-success mt-4">
                <div class="d-flex align-items-center gap-2 text-success mb-3">
                    <span class="fs-4">✅</span>
                    <h5 class="fw-bold mb-0">@Loc["BImp.SuccessTitle"]</h5>
                </div>

                <p class="mb-2">
                    @Loc["BImp.FilePre"] <a href="/dossiers/@_resultat.Dossier!.Id" class="fw-bold text-primary">@_resultat.Dossier!.Numero</a> @Loc["BImp.FilePost"]
                </p>

                @if (_resultat.TicketsCrees.Count > 0)
                {
                    <h6 class="fw-bold text-dark mt-3 mb-2">@Loc["BImp.TicketsCreated"]</h6>
                    <div class="list-group mb-3">
                        @foreach (var t in _resultat.TicketsCrees)
                        {
                            <a href="/tickets/@t.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center rounded-2 mb-1 border">
                                <div>
                                    <strong class="text-primary">BL @t.NumeroBl</strong>
                                    <span class="text-muted small ms-2">(@Loc["BImp.RefWord"] @t.Numero)</span>
                                </div>
                                <span class="badge bg-primary-subtle text-primary">@Loc["BImp.AwaitingPickup"]</span>
                            </a>
                        }
                    </div>
                }

                @if (_resultat.BlRefuses.Count > 0)
                {
                    <div class="alert alert-warning mt-3 mb-0">
                        <strong class="d-block mb-1">@Loc["BImp.DuplicatesIgnoredLabel"]</strong>
                        <ul class="mb-0 small ps-3">
                            @foreach (var refus in _resultat.BlRefuses)
                            {
                                <li>
                                    <strong>@refus.NumeroBl</strong> :
                                    @if (refus.TicketExistantId is Guid ticketId)
                                    {
                                        <span>@Loc["BImp.AlreadyExistsPre"]<a href="/tickets/@ticketId">@Loc["BImp.ViewTicketLink"]</a>@Loc["BImp.AlreadyExistsPost"]</span>
                                    }
                                    else
                                    {
                                        <span>@Loc["BImp.AlreadyProcessing"]</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
        </div>
    }
</div>

@if (_brouillonRestaure)
{
    <div class="alert alert-info border-0 bg-info bg-opacity-10 text-dark mb-4 rounded-3 p-3 small" role="status">
        <strong>@Loc["BImp.DraftRestoredTitle"]</strong> @Loc["BImp.DraftRestoredMsg"]
    </div>
}

@code {
    private static readonly SharedResourcesLocalizer Loc = new();
    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;
    private bool _soumissionEnCours = false;

    private Guid _societeId;
    private string _societeNom = string.Empty;
    private Guid _auteurId;
    private string _auteurNom = string.Empty;

    private ModeleFormulaire _modele = new();
    private SoumettreDemandeImportResultat? _resultat;
    private string? _erreur;

    // REMÉDIATION D-19 : le panneau de retour (succès, refus ou erreur) s'affichait sous le
    // formulaire, hors écran à faible hauteur. On déplace le focus dessus après la soumission :
    // le lecteur d'écran l'annonce, et le navigateur fait défiler la zone à l'écran.
    private ElementReference _zoneRetour;
    private bool _focusRetour;

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["BImp.LoginRequired"].Value;
                return;
            }

            if (contexte.DroitSoumission != true)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["BImp.NoSubmitRight"].Value;
                return;
            }

            _societeId = contexte.SocieteId.Value;
            _societeNom = contexte.SocieteNom ?? string.Empty;
            _auteurId = contexte.UtilisateurId;
            _auteurNom = contexte.NomAffiche ?? contexte.Email;

            await RestaurerBrouillonAsync();
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task SoumettreAsync()
    {
        if (string.IsNullOrWhiteSpace(_modele.NumerosBl)) return;

        _erreur = null;
        _resultat = null;
        _soumissionEnCours = true;

        var numerosBl = _modele.NumerosBl
            .Split(new[] { '\r', '\n', ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (numerosBl.Count == 0)
        {
            _erreur = Loc["BImp.NeedBlNumber"].Value;
            _soumissionEnCours = false;
            _focusRetour = true;
            return;
        }

        try
        {
            // ERR-01 — « Aucune perte de données saisies en cas d'incident LORS D'UNE SOUMISSION ».
            // Le brouillon est écrit AVANT l'envoi et n'est effacé qu'au succès : si la soumission
            // échoue, ou si le poste tombe pendant l'appel, la saisie est retrouvée au retour.
            // La commande existait et aucun écran ne l'appelait (audit du 2026-09-04, docs/89).
            await EnregistrerBrouillonCourantAsync();

            _resultat = await Soumettre.ExecuterAsync(new SoumettreDemandeImportRequete(
                _societeId, _auteurId, numerosBl,
                string.IsNullOrWhiteSpace(_modele.ReferenceSimulationProforma) ? null : _modele.ReferenceSimulationProforma.Trim()));

            using (var scope = ScopeFactory.CreateScope())
            {
                await scope.ServiceProvider
                    .GetRequiredService<CIT.Plateforme.Application.Formulaires.SupprimerBrouillonCommand>()
                    .ExecuterAsync(_auteurId, TypeFormulaire);
            }
            _brouillonRestaure = false;
            _modele.NumerosBl = string.Empty;
            _modele.ReferenceSimulationProforma = string.Empty;
        }
        catch (AccesRefuseException ex)
        {
            _erreur = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = $"{Loc["BImp.SubmitErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
        finally
        {
            _soumissionEnCours = false;
            _focusRetour = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool premierRendu)
    {
        if (!_focusRetour)
        {
            return;
        }

        _focusRetour = false;

        try
        {
            await _zoneRetour.FocusAsync();
        }
        catch (Exception)
        {
            // Rendu statique, circuit interrompu ou zone absente : l'absence de focus ne doit pas
            // faire échouer la page. Le retour reste affiché.
        }
    }

    private const string TypeFormulaire = "BillingImport.Soumission";
    private bool _brouillonRestaure;

    /// <summary>Sérialise la saisie courante. Le format est propre à cet écran : le brouillon
    /// n'est relu que par lui.</summary>
    private async Task EnregistrerBrouillonCourantAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        await scope.ServiceProvider
            .GetRequiredService<CIT.Plateforme.Application.Formulaires.EnregistrerBrouillonCommand>()
            .ExecuterAsync(_auteurId, _societeId, TypeFormulaire,
                System.Text.Json.JsonSerializer.Serialize(_modele));
    }

    /// <summary>Restaure une saisie interrompue. Un brouillon illisible — format changé depuis —
    /// est ignoré sans bruit : mieux vaut un formulaire vide qu'une page en erreur.</summary>
    private async Task RestaurerBrouillonAsync()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var brouillon = await scope.ServiceProvider
                .GetRequiredService<CIT.Plateforme.Application.Formulaires.ObtenirBrouillonQuery>()
                .ExecuterAsync(_auteurId, TypeFormulaire);
            if (brouillon is null)
            {
                return;
            }

            var restaure = System.Text.Json.JsonSerializer.Deserialize<ModeleFormulaire>(brouillon.DonneesJson);
            if (restaure is not null && !string.IsNullOrWhiteSpace(restaure.NumerosBl))
            {
                _modele = restaure;
                _brouillonRestaure = true;
            }
        }
        catch (System.Text.Json.JsonException)
        {
            // Format changé depuis : mieux vaut un formulaire vide qu'une page en erreur.
        }
        catch (InvalidOperationException)
        {
            // Brouillons non disponibles dans ce contexte : la soumission reste possible.
        }
    }

    private sealed class ModeleFormulaire
    {
        public string NumerosBl { get; set; } = string.Empty;
        public string ReferenceSimulationProforma { get; set; } = string.Empty;
    }
}
