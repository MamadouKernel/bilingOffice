@page "/billing-import/validation-paiement"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.BillingImport
@using CIT.Plateforme.Application.Documents
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Documents
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject DeposerPreuvePaiementCommand DeposerPreuve
@inject ValiderPreuvePaiementCommand ValiderPreuve
@inject ConsulterFileBillingImportQuery ConsulterFile

<PageTitle>@Loc["FilePay.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>💰</span> @Loc["FilePay.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["FilePay.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="ChargerAsync">@Loc["File.Refresh"]</button>
        <a href="/agent/dashboard" class="btn btn-outline-primary btn-sm shadow-sm">@Loc["File.MyDashboard"]</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["FilePay.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_message is not null)
    {
        <div class="alert @(_erreur ? "alert-danger" : "alert-success") mb-3">@_message</div>
    }

    @if (_tickets.Count == 0)
    {
        <EtatVide Titre="@Loc["FilePay.EmptyTitle"]"
                  Description="@Loc["FilePay.EmptyDesc"]"
                  Icone="💳" />
    }
    else
    {
        <div class="cit-card mb-4 p-0 overflow-hidden">
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["AvoirExoList.ColTicket"]</th>
                            <th>@Loc["File.ColBl"]</th>
                            <th>@Loc["Societe.ColStatus"]</th>
                            <th>@Loc["File.ColArrival"]</th>
                            <th class="text-end">@Loc["FilePay.ColDecision"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in _pagination1.Appliquer(_tickets))
                        {
                            var t = ticket;
                            <tr>
                                <td>
                                    <a href="/tickets/@t.Id" class="fw-bold text-decoration-none text-primary font-monospace">
                                        @t.Numero
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark font-monospace">@t.NumeroBl</span>
                                    <ClientTicket DossierId="t.DossierId" />
                                </td>
                                <td>
                                    <StatutBadge Statut="@t.Statut" />
                                </td>
                                <td class="small text-muted font-monospace">
                                    @t.DateArriveeEnFileUtc.Horodate()
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/tickets/@t.Id" class="btn btn-outline-secondary" title="@Loc["FilePay.SheetTitle"]">
                                            @Loc["File.Sheet"]
                                        </a>
                                        <button type="button" class="btn btn-outline-success" @onclick="() => ValiderPaiementAsync(t.Id)">
                                            @Loc["FilePay.Validate"]
                                        </button>
                                        <button type="button" class="btn btn-outline-danger" @onclick="() => OuvrirRefus(t.Id)">
                                            @Loc["FilePay.Refuse"]
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            @if (_ticketEnRefus == t.Id)
                            {
                                <tr class="table-danger">
                                    <td colspan="5" class="p-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <input class="form-control form-control-sm" placeholder="@Loc["FilePay.RefusePlaceholder"]" @bind="_motifRefus" />
                                            <button type="button" class="btn btn-danger btn-sm text-nowrap" @onclick="() => ConfirmerRefusAsync(t.Id)" disabled="@string.IsNullOrWhiteSpace(_motifRefus)">
                                                @Loc["FilePay.ConfirmRefuse"]
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AnnulerRefus">
                                                @Loc["Common.Cancel"]
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private static readonly ReglesDepotDocument ReglesDemonstration = new(
        ExtensionsAutorisees: ["pdf", "jpg", "jpeg", "png"], TailleMaxOctets: 10 * 1024 * 1024);

    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;

    private Guid _agentId;
    private List<Ticket> _tickets = [];
    private string? _message;
    private bool _erreur;
    private Guid? _ticketEnRefus;
    private string _motifRefus = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["File.LoginRequired"].Value;
                return;
            }

            _agentId = contexte.UtilisateurId;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _message = MessagesUtilisateur.Pour(ex);
            _erreur = true;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _message = null;
        try
        {
            var ticketsDeLaFile = await ConsulterFile.ExecuterAsync(
                _agentId, NomsFiles.ValidationPaiement, [Permission.BillingImportPaiementValider]);
            _tickets = [.. ticketsDeLaFile.Where(t => t.Statut == StatutTicket.EnAttenteDePriseEnCharge || t.Statut == StatutTicket.EnCours)];
            _erreur = false;
        }
        catch (AccesRefuseException ex)
        {
            _tickets = [];
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _tickets = [];
            _message = MessagesUtilisateur.Pour(ex);
            _erreur = true;
        }
    }

    private async Task ValiderPaiementAsync(Guid ticketId)
    {
        _message = null;
        try
        {
            await ValiderPreuve.ValiderAsync(_agentId, ticketId);
            _message = Loc["FilePay.MsgValidated"].Value;
            _erreur = false;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _message = MessagesUtilisateur.Pour(ex);
            _erreur = true;
        }
    }

    private void OuvrirRefus(Guid ticketId)
    {
        _ticketEnRefus = ticketId;
        _motifRefus = string.Empty;
    }

    private void AnnulerRefus()
    {
        _ticketEnRefus = null;
        _motifRefus = string.Empty;
    }

    private async Task ConfirmerRefusAsync(Guid ticketId)
    {
        if (string.IsNullOrWhiteSpace(_motifRefus)) return;

        _message = null;
        try
        {
            await ValiderPreuve.RefuserAsync(_agentId, ticketId, _motifRefus);
            _ticketEnRefus = null;
            _motifRefus = string.Empty;
            _message = Loc["FilePay.MsgRefused"].Value;
            _erreur = false;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _message = MessagesUtilisateur.Pour(ex);
            _erreur = true;
        }
    }
}
