@page "/billing-import/validation-paiement"
@rendermode InteractiveServer
@using CIT.Plateforme.Application.BillingImport
@using CIT.Plateforme.Application.Documents
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Documents
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IContexteUtilisateurWeb ContexteService
@inject DeposerPreuvePaiementCommand DeposerPreuve
@inject ValiderPreuvePaiementCommand ValiderPreuve
@inject ConsulterFileBillingImportQuery ConsulterFile

<PageTitle>Validation Paiement — CIT</PageTitle>

<div class="container-fluid py-3">
    <!-- En-tête -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-0 text-dark">File Validation Paiement</h2>
            <div class="text-muted small">Instruction des preuves de virement / chèque et validation des encaissements</div>
        </div>
        <div class="mt-2 mt-md-0 d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="ChargerAsync">🔄 Actualiser la file</button>
            <a href="/agent/dashboard" class="btn btn-outline-primary btn-sm">Mon tableau de bord</a>
        </div>
    </div>

    @if (_chargement)
    {
        <IndicateurChargement Message="Chargement des preuves de paiement en attente..." />
    }
    else if (_nonAutorise)
    {
        <PermissionDenied Message="@_messageNonAutorise" />
    }
    else
    {
        @if (_message is not null)
        {
            <div class="alert @(_erreur ? "alert-danger" : "alert-success") mb-3">@_message</div>
        }

        @if (_tickets.Count == 0)
        {
            <EtatVide Titre="Aucun paiement en attente"
                      Description="Toutes les preuves de paiement ont été validées ou instruites."
                      Icone="💳" />
        }
        else
        {
            <div class="cit-card p-0 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>N° Ticket</th>
                                <th>Numéro BL</th>
                                <th>Statut</th>
                                <th>Arrivée en file</th>
                                <th class="text-end">Décision de validation</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in _tickets)
                            {
                                var t = ticket;
                                <tr>
                                    <td>
                                        <a href="/tickets/@t.Id" class="fw-bold text-decoration-none">
                                            @t.Numero
                                        </a>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">@t.NumeroBl</span>
                                    </td>
                                    <td>
                                        <StatutBadge Statut="@t.Statut" />
                                    </td>
                                    <td class="small text-muted">
                                        @t.DateArriveeEnFileUtc.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a href="/tickets/@t.Id" class="btn btn-outline-secondary" title="Consulter la preuve sur la fiche">
                                                🔍 Fiche
                                            </a>
                                            <button class="btn btn-outline-success" @onclick="() => ValiderPaiementAsync(t.Id)">
                                                ✅ Valider encaissement
                                            </button>
                                            <button class="btn btn-outline-danger" @onclick="() => OuvrirRefus(t.Id)">
                                                ❌ Refuser preuve
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                @if (_ticketEnRefus == t.Id)
                                {
                                    <tr class="table-danger">
                                        <td colspan="5" class="p-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <input class="form-control form-control-sm" placeholder="Motif obligatoire de refus de la preuve..." @bind="_motifRefus" />
                                                <button class="btn btn-danger btn-sm text-nowrap" @onclick="() => ConfirmerRefusAsync(t.Id)" disabled="@string.IsNullOrWhiteSpace(_motifRefus)">
                                                    Confirmer le refus
                                                </button>
                                                <button class="btn btn-outline-secondary btn-sm" @onclick="AnnulerRefus">
                                                    Annuler
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private static readonly ReglesDepotDocument ReglesDemonstration = new(
        ExtensionsAutorisees: ["pdf", "jpg", "jpeg", "png"], TailleMaxOctets: 10 * 1024 * 1024);

    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;

    private Guid _agentId;
    private List<Ticket> _tickets = [];
    private string? _message;
    private bool _erreur;
    private Guid? _ticketEnRefus;
    private string _motifRefus = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Veuillez vous connecter pour accéder à cette file.";
                return;
            }

            _agentId = contexte.UtilisateurId;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _erreur = true;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _message = null;
        try
        {
            var ticketsDeLaFile = await ConsulterFile.ExecuterAsync(
                _agentId, NomsFiles.ValidationPaiement, [Permission.BillingImportPaiementValider]);
            _tickets = [.. ticketsDeLaFile.Where(t => t.Statut == StatutTicket.EnAttenteDePriseEnCharge || t.Statut == StatutTicket.EnCours)];
            _erreur = false;
        }
        catch (AccesRefuseException ex)
        {
            _tickets = [];
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _tickets = [];
            _message = ex.Message;
            _erreur = true;
        }
    }

    private async Task ValiderPaiementAsync(Guid ticketId)
    {
        _message = null;
        try
        {
            await ValiderPreuve.ValiderAsync(_agentId, ticketId);
            _message = "Paiement validé avec succès. Le ticket poursuit vers le Contrôle Documentaire.";
            _erreur = false;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _erreur = true;
        }
    }

    private void OuvrirRefus(Guid ticketId)
    {
        _ticketEnRefus = ticketId;
        _motifRefus = string.Empty;
    }

    private void AnnulerRefus()
    {
        _ticketEnRefus = null;
        _motifRefus = string.Empty;
    }

    private async Task ConfirmerRefusAsync(Guid ticketId)
    {
        if (string.IsNullOrWhiteSpace(_motifRefus)) return;

        _message = null;
        try
        {
            await ValiderPreuve.RefuserAsync(_agentId, ticketId, _motifRefus);
            _ticketEnRefus = null;
            _motifRefus = string.Empty;
            _message = "Preuve refusée. Le ticket repasse en attente client pour dépôt d'une nouvelle preuve.";
            _erreur = false;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _erreur = true;
        }
    }
}
