@page "/billing-import/controle-documentaire"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.BillingImport
@using CIT.Plateforme.Application.Documents
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Documents
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject DeposerDocumentsControleEtCloturerCommand ControleEtCloturer
@inject ConsulterFileBillingImportQuery ConsulterFile

<PageTitle>@Loc["FileCtrl.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>📑</span> @Loc["FileCtrl.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["FileCtrl.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="ChargerAsync">@Loc["File.Refresh"]</button>
        <a href="/agent/dashboard" class="btn btn-outline-primary btn-sm shadow-sm">@Loc["File.MyDashboard"]</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["FileCtrl.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_message is not null)
    {
        <div class="alert @(_erreur ? "alert-danger" : "alert-success") mb-3">@_message</div>
    }

    @if (_tickets.Count == 0)
    {
        <EtatVide Titre="@Loc["FileCtrl.EmptyTitle"]"
                  Description="@Loc["FileCtrl.EmptyDesc"]"
                  Icone="📑" />
    }
    else
    {
        <div class="cit-card mb-4 p-0 overflow-hidden">
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["AvoirExoList.ColTicket"]</th>
                            <th>@Loc["File.ColBl"]</th>
                            <th>@Loc["Societe.ColStatus"]</th>
                            <th>@Loc["File.ColArrival"]</th>
                            <th>@Loc["FileCtrl.ColUpload"]</th>
                            <th class="text-end">@Loc["SimHist.ColAction"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in _pagination1.Appliquer(_tickets))
                        {
                            var t = ticket;
                            <tr>
                                <td>
                                    <a href="/tickets/@t.Id" class="fw-bold text-decoration-none text-primary font-monospace">
                                        @t.Numero
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark font-monospace">@t.NumeroBl</span>
                                    <ClientTicket DossierId="t.DossierId" />
                                </td>
                                <td>
                                    <StatutBadge Statut="@t.Statut" />
                                </td>
                                <td class="small text-muted font-monospace">
                                    @t.DateArriveeEnFileUtc.Horodate()
                                </td>
                                <td>
                                    <InputFile class="form-control form-control-sm" OnChange="e => DemanderConfirmation(t, e, DeposerEtCloturerAsync)" />
                                </td>
                                <td class="text-end">
                                    <a href="/tickets/@t.Id" class="btn btn-outline-secondary btn-sm" title="@Loc["File.SheetTitle"]">
                                        @Loc["File.Sheet"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }
}

@* Le dépôt clôture ou facture le dossier — irréversible : on confirme le dossier et le fichier. *@
<ModaleConfirmation EstOuvert="@(_aConfirmer is not null)"
                    Titre="@Loc["FileAct.ConfirmTitle"]"
                    Message="@(_aConfirmer is { } c ? Loc["FileAct.ConfirmMessage", c.Ticket.Numero, c.Ticket.NumeroBl ?? c.Ticket.NumeroBooking ?? "—", c.Fichier.File.Name].Value : string.Empty)"
                    BoutonConfirmerLibelle="@Loc["FileAct.ConfirmButton"]"
                    BoutonConfirmerClass="btn-primary"
                    Desactive="@_confirmationEnCours"
                    OnConfirmer="ConfirmerDepotAsync"
                    OnAnnuler="() => _aConfirmer = null" />

@code {
    private sealed record DepotAConfirmer(Ticket Ticket, InputFileChangeEventArgs Fichier, Func<Guid, InputFileChangeEventArgs, Task> Action);
    private DepotAConfirmer? _aConfirmer;
    private bool _confirmationEnCours;

    private void DemanderConfirmation(Ticket ticket, InputFileChangeEventArgs e, Func<Guid, InputFileChangeEventArgs, Task> action) =>
        _aConfirmer = new DepotAConfirmer(ticket, e, action);

    private async Task ConfirmerDepotAsync()
    {
        if (_aConfirmer is not { } depot) return;
        _confirmationEnCours = true;
        try
        {
            await depot.Action(depot.Ticket.Id, depot.Fichier);
        }
        finally
        {
            _confirmationEnCours = false;
            _aConfirmer = null;
        }
    }

    private readonly EtatPagination _pagination1 = new();

    private static readonly ReglesDepotDocument ReglesDemonstration = new(
        ExtensionsAutorisees: ["pdf", "jpg", "jpeg", "png"], TailleMaxOctets: 10 * 1024 * 1024);

    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;

    private Guid _agentId;
    private List<Ticket> _tickets = [];
    private string? _message;
    private bool _erreur;

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["File.LoginRequired"].Value;
                return;
            }

            _agentId = contexte.UtilisateurId;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _message = MessagesUtilisateur.Pour(ex);
            _erreur = true;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _message = null;
        try
        {
            var ticketsDeLaFile = await ConsulterFile.ExecuterAsync(
                _agentId, NomsFiles.ControleDocumentaire, [Permission.BillingImportControleDocumentaireTraiter]);
            _tickets = [.. ticketsDeLaFile.Where(t => t.Statut == StatutTicket.EnAttenteDePriseEnCharge || t.Statut == StatutTicket.EnCours)];
            _erreur = false;
        }
        catch (AccesRefuseException ex)
        {
            _tickets = [];
            _nonAutorise = true;
            _messageNonAutorise = MessagesUtilisateur.Texte(ex);
        }
        catch (Exception ex)
        {
            _tickets = [];
            _message = MessagesUtilisateur.Pour(ex);
            _erreur = true;
        }
    }

    private async Task DeposerEtCloturerAsync(Guid ticketId, InputFileChangeEventArgs e)
    {
        _message = null;
        try
        {
            await using var flux = e.File.OpenReadStream(ReglesDemonstration.TailleMaxOctets);
            await using var memoire = new MemoryStream();
            await flux.CopyToAsync(memoire);

            await ControleEtCloturer.ExecuterAsync(
                _agentId, ticketId, e.File.Name, e.File.ContentType, memoire, memoire.Length, ReglesDemonstration);

            _message = Loc["FileCtrl.Closed"].Value;
            _erreur = false;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _message = MessagesUtilisateur.Pour(ex);
            _erreur = true;
        }
    }
}
