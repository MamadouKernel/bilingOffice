@page "/billing-import/comptabilite-client"
@rendermode InteractiveServer
@using CIT.Plateforme.Application.BillingImport
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@inject IContexteUtilisateurWeb ContexteService
@inject ConfirmerLettrageCommand ConfirmerLettrage
@inject ConsulterFileBillingImportQuery ConsulterFile

<PageTitle>File Comptabilité Client — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>💼</span> File Comptabilité Client
        </h2>
        <div class="cit-page-subtitle">Rapprochement et confirmation du lettrage des comptes clients Deposit</div>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="ChargerAsync">🔄 Actualiser la file</button>
        <a href="/agent/dashboard" class="btn btn-outline-primary btn-sm shadow-sm">Mon tableau de bord</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement des dossiers en attente de lettrage comptable..." />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_message is not null)
    {
        <div class="alert @(_erreur ? "alert-danger" : "alert-success") mb-3">@_message</div>
    }

    @if (_tickets.Count == 0)
    {
        <EtatVide Titre="Aucun compte en attente de lettrage"
                  Description="Tous les dossiers Deposit ont été lettrés."
                  Icone="💰" />
    }
    else
    {
        <div class="cit-card mb-4 p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>N° Ticket</th>
                            <th>Numéro BL</th>
                            <th>Statut</th>
                            <th>Arrivée en file</th>
                            <th class="text-end">Action Comptabilité</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in _tickets)
                        {
                            var t = ticket;
                            <tr>
                                <td>
                                    <a href="/tickets/@t.Id" class="fw-bold text-decoration-none text-primary font-monospace">
                                        @t.Numero
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark font-monospace">@t.NumeroBl</span>
                                </td>
                                <td>
                                    <StatutBadge Statut="@t.Statut" />
                                </td>
                                <td class="small text-muted font-monospace">
                                    @t.DateArriveeEnFileUtc.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/tickets/@t.Id" class="btn btn-outline-secondary" title="Consulter la fiche">
                                            🔍 Fiche
                                        </a>
                                        <button class="btn btn-outline-success" @onclick="() => ConfirmerAsync(t.Id)">
                                            ✅ Confirmer le lettrage
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;

    private Guid _agentId;
    private List<Ticket> _tickets = [];
    private string? _message;
    private bool _erreur;

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Veuillez vous connecter pour accéder à cette file.";
                return;
            }

            _agentId = contexte.UtilisateurId;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _erreur = true;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _message = null;
        try
        {
            var ticketsDeLaFile = await ConsulterFile.ExecuterAsync(
                _agentId, NomsFiles.ComptabiliteClient, [Permission.BillingImportComptabiliteConfirmerLettrage]);
            _tickets = [.. ticketsDeLaFile.Where(t => t.Statut == StatutTicket.EnAttenteDePriseEnCharge || t.Statut == StatutTicket.EnCours)];
            _erreur = false;
        }
        catch (AccesRefuseException ex)
        {
            _tickets = [];
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _tickets = [];
            _message = ex.Message;
            _erreur = true;
        }
    }

    private async Task ConfirmerAsync(Guid ticketId)
    {
        _message = null;
        try
        {
            await ConfirmerLettrage.ConfirmerAsync(_agentId, ticketId);
            _message = "Lettrage confirmé avec succès — ticket transféré au Contrôle Documentaire.";
            _erreur = false;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _erreur = true;
        }
    }
}
