@page "/billing-import/ticket-cloture"
@page "/billing-import/ticket-cloture/{TicketId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.BillingImport
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Documents
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ConsulterDocumentsTicketClotureQuery ConsulterDocuments
@inject NavigationManager Navigation

<PageTitle>@Loc["FileClot.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>📑</span> @Loc["FileClot.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["FileClot.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/client/demandes" class="btn btn-outline-secondary btn-sm">@Loc["FileClot.BackToRequests"]</a>
    </div>
</div>

<div class="cit-page-large">
    @if (_chargement)
    {
        <IndicateurChargement Message="@Loc["FileClot.Loading"]" />
    }
    else if (_nonAutorise)
    {
        <PermissionDenied Message="@_messageNonAutorise" />
    }
    else if (_erreur is not null)
    {
        <div class="alert alert-danger" role="alert">@_erreur</div>
    }
    else if (_documents is not null)
    {
        @if (_documents.Count == 0)
        {
            <EtatVide Titre="@Loc["FileClot.EmptyTitle"]"
                      Description="@Loc["FileClot.EmptyDesc"]"
                      Icone="📂" />
        }
        else
        {
            <div class="cit-card mb-4 p-0 overflow-hidden">
                <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Loc["Ticket.ColFileName"]</th>
                                <th>@Loc["Ticket.ColSize"]</th>
                                <th>@Loc["FileClot.ColDeliveryDate"]</th>
                                <th class="text-end">@Loc["SimHist.ColAction"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var document in _pagination1.Appliquer(_documents))
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold text-dark">📄 @document.NomFichier</span>
                                    </td>
                                    <td class="small text-muted font-monospace">@((document.TailleOctets / 1024.0).ToString("0.0")) @Loc["Common.KoUnit"]</td>
                                    <td class="small text-muted font-monospace">@document.DateDepotUtc.Horodate()</td>
                                    <td class="text-end">
                                        <ActionsDocument DocumentId="document.Id" NomFichier="@document.NomFichier" TypeContenu="@document.TypeContenu" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
                </div>
            </div>
        }
    }
</div>

@code {
    private readonly EtatPagination _pagination1 = new();

    [Parameter] public Guid? TicketId { get; set; }

    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;
    private IReadOnlyList<Document>? _documents;
    private string? _erreur;

    protected override async Task OnParametersSetAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["FileClot.LoginRequired"].Value;
                return;
            }

            if (!TicketId.HasValue)
            {
                Navigation.NavigateTo("/client/demandes");
                return;
            }

            // CONSOLIDATION SÉCURITÉ : l'identité transmise est celle de l'UTILISATEUR, résolue
            // côté serveur. Ce site passait `contexte.SocieteId` — une société n'est pas un compte,
            // elle ne s'authentifie pas et n'agit pas. Le contrôle central résout lui-même le
            // rattachement société de la personne, et applique ENT-03 (RG-CPT-07).
            _documents = await ConsulterDocuments.ExecuterAsync(contexte.UtilisateurId, TicketId.Value);
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = MessagesUtilisateur.Texte(ex);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

}
