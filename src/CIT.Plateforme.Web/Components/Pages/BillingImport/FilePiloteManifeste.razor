@page "/billing-import/manifeste"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.BillingImport
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ValiderTicketImportCommand Valider
@inject RejeterTicketImportCommand Rejeter
@inject GestionComplementManifesteCommand Complement
@inject ConsulterFileBillingImportQuery ConsulterFile

<PageTitle>@Loc["FileManif.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>📜</span> @Loc["FileManif.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["FileManif.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="ChargerAsync">@Loc["File.Refresh"]</button>
        <a href="/agent/dashboard" class="btn btn-outline-primary btn-sm shadow-sm">@Loc["File.MyDashboard"]</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["FileManif.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-3" role="alert">@_erreur</div>
    }

    @if (!string.IsNullOrWhiteSpace(_actionSuccess))
    {
        <div class="alert alert-success py-2 small mb-3" role="status">@_actionSuccess</div>
    }

    @if (_tickets.Count == 0)
    {
        <EtatVide Titre="@Loc["FileManif.EmptyTitle"]"
                  Description="@Loc["FileManif.EmptyDesc"]"
                  Icone="📋" />
    }
    else
    {
        <div class="cit-card mb-4 p-0 overflow-hidden">
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["AvoirExoList.ColTicket"]</th>
                            <th>@Loc["File.ColBl"]</th>
                            <th>@Loc["Societe.ColStatus"]</th>
                            <th>@Loc["File.ColArrival"]</th>
                            <th class="text-end">@Loc["FileIes.ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in _pagination1.Appliquer(_tickets))
                        {
                            var t = ticket;
                            <tr>
                                <td>
                                    <a href="/tickets/@t.Id" class="fw-bold text-decoration-none text-primary font-monospace">
                                        @t.Numero
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark font-monospace">@t.NumeroBl</span>
                                    @if (t.DeclarationPresentielle)
                                    {
                                        <span class="badge bg-dark ms-1 small">@Loc["FileManif.BadgePresentiel"]</span>
                                    }
                                </td>
                                <td>
                                    <StatutBadge Statut="@t.Statut" />
                                </td>
                                <td class="small text-muted font-monospace">
                                    @t.DateArriveeEnFileUtc.Horodate()
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/tickets/@t.Id" class="btn btn-outline-secondary" title="@Loc["File.SheetTitle"]">
                                            @Loc["File.Sheet"]
                                        </a>
                                        <button type="button" class="btn btn-outline-success" @onclick="() => ValiderAsync(t.Id)" title="@Loc["FileManif.ValidateTitle"]">
                                            @Loc["FileManif.Validate"]
                                        </button>
                                        <button type="button" class="btn btn-outline-warning" @onclick="() => DemanderComplementAsync(t.Id)" title="@Loc["FileManif.ComplementTitle"]">
                                            @Loc["FileManif.Complement"]
                                        </button>
                                        <button type="button" class="btn btn-outline-danger" @onclick="() => OuvrirModaleRejet(t.Id)" title="@Loc["FileManif.RejectTitle"]">
                                            @Loc["FileManif.Reject"]
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            @if (_ticketEnRejet == t.Id)
                            {
                                <tr class="table-danger">
                                    <td colspan="5" class="p-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <input class="form-control form-control-sm" placeholder="@Loc["FileManif.RejectPlaceholder"]" @bind="_motifRejet" />
                                            <button type="button" class="btn btn-danger btn-sm text-nowrap" @onclick="() => ConfirmerRejetAsync(t.Id)" disabled="@string.IsNullOrWhiteSpace(_motifRejet)">
                                                @Loc["FileManif.ConfirmReject"]
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AnnulerRejet">
                                                @Loc["Common.Cancel"]
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private string? _actionSuccess;

    private Guid _agentId;
    private List<Ticket> _tickets = [];
    private Guid? _ticketEnRejet;
    private string _motifRejet = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await InitialiserEtChargerAsync();
    }

    private async Task InitialiserEtChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["File.LoginRequired"].Value;
                return;
            }

            _agentId = contexte.UtilisateurId;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _erreur = null;
        try
        {
            var ticketsDeLaFile = await ConsulterFile.ExecuterAsync(
                _agentId, SoumettreDemandeImportCommand.FilePiloteManifeste, [Permission.BillingImportManifesteInstruire]);
            _tickets = ticketsDeLaFile
                .Where(t => t.Statut == StatutTicket.EnAttenteDePriseEnCharge || t.Statut == StatutTicket.EnCours)
                .OrderBy(t => t.DateArriveeEnFileUtc)
                .ToList();
        }
        catch (AccesRefuseException ex)
        {
            _tickets = [];
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private async Task ExecuterActionAsync(Func<Task> action, string messageSucces)
    {
        _erreur = null;
        _actionSuccess = null;
        try
        {
            await action();
            _actionSuccess = messageSucces;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private Task ValiderAsync(Guid ticketId) =>
        ExecuterActionAsync(() => Valider.ExecuterAsync(_agentId, ticketId), Loc["FileManif.MsgValidated"].Value);

    private Task DemanderComplementAsync(Guid ticketId) =>
        ExecuterActionAsync(() => Complement.DemanderComplementAsync(_agentId, ticketId, Loc["Ticket.HoldReason"].Value), Loc["FileManif.MsgComplement"].Value);

    private void OuvrirModaleRejet(Guid ticketId)
    {
        _ticketEnRejet = ticketId;
        _motifRejet = string.Empty;
    }

    private void AnnulerRejet()
    {
        _ticketEnRejet = null;
        _motifRejet = string.Empty;
    }

    private async Task ConfirmerRejetAsync(Guid ticketId)
    {
        if (string.IsNullOrWhiteSpace(_motifRejet)) return;

        await ExecuterActionAsync(async () =>
        {
            await Rejeter.ExecuterAsync(_agentId, ticketId, _motifRejet);
            _ticketEnRejet = null;
            _motifRejet = string.Empty;
        }, Loc["FileManif.MsgRejected"].Value);
    }
}
