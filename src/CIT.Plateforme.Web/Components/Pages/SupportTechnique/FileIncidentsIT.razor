@page "/support/incidents/file"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.SupportTechnique
@using CIT.Plateforme.Application.Tickets
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Incidents
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IContexteUtilisateurWeb ContexteService
@inject ConsulterFileIncidentsQuery ConsulterFile
@inject PrendreEnChargeCommand PrendreEnCharge
@inject ResoudreIncidentCommand ResoudreIncident
@inject EscaladerIncidentCommand EscaladerIncident

<PageTitle>@Loc["IncidentFile.Title"] — @Loc["Common.AppTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title"><span>🎧</span> @Loc["IncidentFile.Title"]</h1>
        <div class="cit-page-subtitle">@Loc["IncidentFile.Subtitle"]</div>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["Common.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-4" role="alert">@_erreur</div>
    }

    @if (_incidents.Count == 0)
    {
        <div class="cit-card p-5 text-center">
            <div class="fs-1 mb-3">✅</div>
            <h5 class="fw-bold">@Loc["IncidentFile.EmptyTitle"]</h5>
            <p class="text-muted mb-0">@Loc["IncidentFile.EmptyDesc"]</p>
        </div>
    }
    else
    {
        <div class="cit-card overflow-hidden p-0">
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light small text-muted">
                        <tr>
                            <th class="ps-4 py-3">@Loc["Incident.ColNumber"]</th>
                            <th class="py-3">@Loc["Incident.ColSubject"]</th>
                            <th class="py-3">@Loc["Incident.Severity"]</th>
                            <th class="py-3">@Loc["Incident.ColState"]</th>
                            <th class="py-3 pe-4 text-end">@Loc["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _pagination1.Appliquer(_incidents))
                        {
                            <tr>
                                <td class="ps-4 py-3 font-monospace">@t.Numero</td>
                                <td class="py-3">@t.Objet</td>
                                <td class="py-3">@LibelleGravite(t.Gravite)</td>
                                <td class="py-3">@t.Statut</td>
                                <td class="py-3 pe-4 text-end">
                                    @if (t.Statut == StatutTicket.EnAttenteDePriseEnCharge)
                                    {
                                        <button class="btn btn-outline-success btn-sm fw-semibold" disabled="@_enCours"
                                                @onclick="() => PrendreEnChargeAsync(t.Id)">@Loc["IncidentFile.TakeCharge"]</button>
                                    }
                                    else
                                    {
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-success fw-semibold" disabled="@_enCours"
                                                    @onclick="() => OuvrirAction(t.Id, ActionType.Resoudre)">@Loc["IncidentFile.Resolve"]</button>
                                            <button class="btn btn-outline-warning fw-semibold" disabled="@_enCours"
                                                    @onclick="() => OuvrirAction(t.Id, ActionType.Escalader)">@Loc["IncidentFile.Escalate"]</button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }

    @if (_actionTicketId is not null)
    {
        <div class="cit-card mt-3 p-3" style="border-left:4px solid var(--azure-600);">
            <h6 class="fw-bold mb-2">
                @(_actionType == ActionType.Resoudre ? Loc["IncidentFile.ResolveTitle"] : Loc["IncidentFile.EscalateTitle"])
            </h6>
            <textarea class="form-control mb-2" rows="3"
                      placeholder="@(_actionType == ActionType.Resoudre ? Loc["IncidentFile.ResolvePlaceholder"] : Loc["IncidentFile.EscalatePlaceholder"])"
                      @bind="_actionTexte" @bind:event="oninput"></textarea>
            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-outline-secondary btn-sm" @onclick="FermerAction">@Loc["Common.Cancel"]</button>
                <button class="btn btn-primary btn-sm fw-bold" disabled="@(_enCours || string.IsNullOrWhiteSpace(_actionTexte))"
                        @onclick="ConfirmerActionAsync">@Loc["Common.Submit"]</button>
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private enum ActionType { Resoudre, Escalader }
    private Guid? _actionTicketId;
    private ActionType _actionType;
    private string _actionTexte = string.Empty;

    private void OuvrirAction(Guid ticketId, ActionType type)
    {
        _actionTicketId = ticketId;
        _actionType = type;
        _actionTexte = string.Empty;
    }

    private void FermerAction()
    {
        _actionTicketId = null;
        _actionTexte = string.Empty;
    }

    private async Task ConfirmerActionAsync()
    {
        if (_enCours || _actionTicketId is null || string.IsNullOrWhiteSpace(_actionTexte)) return;
        _enCours = true;
        try
        {
            if (_actionType == ActionType.Resoudre)
            {
                await ResoudreIncident.ExecuterAsync(new ResoudreIncidentRequete(_agentId, _actionTicketId.Value, _actionTexte));
            }
            else
            {
                await EscaladerIncident.ExecuterAsync(new EscaladerIncidentRequete(_agentId, _actionTicketId.Value, _actionTexte));
            }
            FermerAction();
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _enCours = false;
        }
    }

    private static readonly SharedResourcesLocalizer Loc = new();
    private bool _chargement = true;
    private bool _nonAutorise;
    private bool _enCours;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private Guid _agentId;
    private IReadOnlyList<Ticket> _incidents = [];

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            _agentId = contexte.UtilisateurId;
            _incidents = await ConsulterFile.ExecuterAsync(_agentId);
            _nonAutorise = false;
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task PrendreEnChargeAsync(Guid ticketId)
    {
        if (_enCours) return;
        _enCours = true;
        try
        {
            await PrendreEnCharge.ExecuterAsync(_agentId, ticketId);
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _enCours = false;
        }
    }

    private string LibelleGravite(GraviteIncident? g) => g switch
    {
        GraviteIncident.Mineure => Loc["Incident.SeverityMinor"].Value,
        GraviteIncident.Majeure => Loc["Incident.SeverityMajor"].Value,
        GraviteIncident.Critique => Loc["Incident.SeverityCritical"].Value,
        _ => "—",
    };
}
