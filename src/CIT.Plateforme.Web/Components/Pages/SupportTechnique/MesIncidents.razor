@page "/support/incidents/mes-incidents"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.SupportTechnique
@using CIT.Plateforme.Domain.Incidents
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IContexteUtilisateurWeb ContexteService
@inject MesIncidentsQuery MesIncidentsQuery

<PageTitle>@Loc["Incident.MyIncidentsTitle"] — @Loc["Common.AppTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title"><span>📋</span> @Loc["Incident.MyIncidentsTitle"]</h1>
        <div class="cit-page-subtitle">@Loc["Incident.MyIncidentsSubtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/support/incidents/signaler" class="btn btn-primary btn-sm shadow-sm">🛠️ @Loc["Incident.Title"]</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["Common.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else if (_incidents.Count == 0)
{
    <div class="cit-card p-5 text-center">
        <div class="fs-1 mb-3">🗂️</div>
        <h5 class="fw-bold">@Loc["Incident.EmptyTitle"]</h5>
        <p class="text-muted mb-0">@Loc["Incident.EmptyDesc"]</p>
    </div>
}
else
{
    <div class="cit-card overflow-hidden p-0">
        <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light small text-muted">
                    <tr>
                        <th class="ps-4 py-3">@Loc["Incident.ColNumber"]</th>
                        <th class="py-3">@Loc["Incident.ColSubject"]</th>
                        <th class="py-3">@Loc["Incident.Severity"]</th>
                        <th class="py-3">@Loc["Incident.ColState"]</th>
                        <th class="py-3">@Loc["Incident.ColResponse"]</th>
                        <th class="py-3 pe-4">@Loc["Incident.ColDate"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _pagination1.Appliquer(_incidents))
                    {
                        <tr>
                            <td class="ps-4 py-3 font-monospace">@t.Numero</td>
                            <td class="py-3">@t.Objet</td>
                            <td class="py-3">@LibelleGravite(t.Gravite)</td>
                            <td class="py-3">@t.Statut</td>
                            <td class="py-3 small">
                                @if (!string.IsNullOrWhiteSpace(t.ReponseFormalisee))
                                {
                                    <span class="text-dark">@t.ReponseFormalisee</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="py-3 pe-4 small text-muted">@t.DateArriveeEnFileUtc.Horodate()</td>
                        </tr>
                    }
                </tbody>
            </table>
            <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
        </div>
    </div>
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private static readonly SharedResourcesLocalizer Loc = new();
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private IReadOnlyList<Ticket> _incidents = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["Incident.LoginRequired"].Value;
                return;
            }

            _incidents = await MesIncidentsQuery.ExecuterAsync(contexte.UtilisateurId);
        }
        finally
        {
            _chargement = false;
        }
    }

    private string LibelleGravite(GraviteIncident? g) => g switch
    {
        GraviteIncident.Mineure => Loc["Incident.SeverityMinor"].Value,
        GraviteIncident.Majeure => Loc["Incident.SeverityMajor"].Value,
        GraviteIncident.Critique => Loc["Incident.SeverityCritical"].Value,
        _ => "—",
    };
}
