@page "/reclamations/file"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Abstractions
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Tickets
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IContexteUtilisateurWeb ContexteService
@inject IFileDeTraitementRepository FileRepo
@inject ConsulterFileQuery ConsulterFile
@inject PrendreEnChargeCommand PrendreEnCharge

<PageTitle>File Réclamations — CIT</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-0 text-dark">File Réclamations — Support Opérationnel</h2>
            <div class="text-muted small">Réclamations clients à instruire (REC-03)</div>
        </div>
        <div class="mt-2 mt-md-0 d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick="ChargerAsync">🔄 Actualiser</button>
            <a href="/agent/dashboard" class="btn btn-outline-primary btn-sm">Mon tableau de bord</a>
        </div>
    </div>

    @if (_chargement)
    {
        <IndicateurChargement Message="Chargement de la file Réclamations..." />
    }
    else if (_nonAutorise)
    {
        <PermissionDenied Message="@_messageNonAutorise" />
    }
    else
    {
        @if (_erreur is not null)
        {
            <div class="alert alert-danger mb-3">@_erreur</div>
        }

        @if (!string.IsNullOrWhiteSpace(_actionSuccess))
        {
            <div class="alert alert-success py-2 small mb-3">@_actionSuccess</div>
        }

        @if (_tickets.Count == 0)
        {
            <EtatVide Titre="Aucune réclamation en instance" Description="Toutes les réclamations ont été prises en charge." Icone="📝" />
        }
        else
        {
            <div class="cit-card p-0 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>N° Ticket</th>
                                <th>Objet</th>
                                <th>Statut</th>
                                <th>Arrivée en file</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in _tickets)
                            {
                                <tr>
                                    <td><a href="/tickets/@t.Id" class="fw-bold text-decoration-none">@t.Numero</a></td>
                                    <td>@(t.Objet ?? "—")</td>
                                    <td><StatutBadge Statut="@t.Statut" /></td>
                                    <td class="small text-muted">@t.DateArriveeEnFileUtc.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a href="/tickets/@t.Id" class="btn btn-outline-secondary">🔍 Fiche</a>
                                            @if (t.Statut == StatutTicket.EnAttenteDePriseEnCharge)
                                            {
                                                <button class="btn btn-outline-success" @onclick="() => PrendreEnChargeAsync(t.Id)">📥 Prendre en charge</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private string? _actionSuccess;

    private Guid _agentId;
    private Guid _fileSupportId;
    private List<Ticket> _tickets = [];

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Veuillez vous connecter pour accéder à cette file.";
                return;
            }

            _agentId = contexte.UtilisateurId;

            var files = await FileRepo.ListerAsync();
            var fileSupport = files.FirstOrDefault(f => f.Nom == "Support Opérationnel");
            if (fileSupport is null)
            {
                _erreur = "La file \"Support Opérationnel\" n'est pas configurée.";
                return;
            }

            _fileSupportId = fileSupport.Id;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _erreur = null;
        try
        {
            var ticketsDeLaFile = await ConsulterFile.ExecuterAsync(_agentId, _fileSupportId);
            _tickets = ticketsDeLaFile
                .Where(t => t.Statut == StatutTicket.EnAttenteDePriseEnCharge || t.Statut == StatutTicket.EnCours)
                .OrderBy(t => t.DateArriveeEnFileUtc)
                .ToList();
        }
        catch (AccesRefuseException ex)
        {
            _tickets = [];
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
    }

    private async Task PrendreEnChargeAsync(Guid ticketId)
    {
        _erreur = null;
        _actionSuccess = null;
        try
        {
            await PrendreEnCharge.ExecuterAsync(_agentId, ticketId);
            _actionSuccess = "Réclamation prise en charge avec succès.";
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
    }
}
