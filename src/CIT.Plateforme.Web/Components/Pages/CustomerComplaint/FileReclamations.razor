@page "/reclamations/file"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Abstractions
@using CIT.Plateforme.Application.CustomerComplaint
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Tickets
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IContexteUtilisateurWeb ContexteService
@inject ConsulterFileReclamationsQuery ConsulterFileReclamations
@inject PrendreEnChargeCommand PrendreEnCharge

<PageTitle>File Réclamations — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>📢</span> File Réclamations — Support Opérationnel
        </h2>
        <div class="cit-page-subtitle">Réclamations clients à instruire et réponses formalisées</div>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="ChargerAsync">🔄 Actualiser</button>
        <a href="/agent/dashboard" class="btn btn-outline-primary btn-sm shadow-sm">Mon tableau de bord</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement de la file Réclamations..." />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-3">@_erreur</div>
    }

    @if (!string.IsNullOrWhiteSpace(_actionSuccess))
    {
        <div class="alert alert-success py-2 small mb-3">@_actionSuccess</div>
    }

    @if (_tickets.Count == 0)
    {
        <EtatVide Titre="Aucune réclamation en instance" Description="Toutes les réclamations ont été prises en charge." Icone="📝" />
    }
    else
    {
        <div class="cit-card mb-4 p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>N° Ticket</th>
                            <th>Objet</th>
                            <th>Statut</th>
                            <th>Arrivée en file</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _tickets)
                        {
                            <tr>
                                <td><a href="/tickets/@t.Id" class="fw-bold text-decoration-none text-primary font-monospace">@t.Numero</a></td>
                                <td class="fw-semibold text-dark">@(t.Objet ?? "—")</td>
                                <td><StatutBadge Statut="@t.Statut" /></td>
                                <td class="small text-muted font-monospace">@t.DateArriveeEnFileUtc.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/tickets/@t.Id" class="btn btn-outline-secondary">🔍 Fiche</a>
                                        @if (t.Statut == StatutTicket.EnAttenteDePriseEnCharge)
                                        {
                                            <button class="btn btn-outline-success fw-semibold" @onclick="() => PrendreEnChargeAsync(t.Id)">📥 Prendre en charge</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private string? _actionSuccess;

    private Guid _agentId;
    private List<Ticket> _tickets = [];

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Veuillez vous connecter pour accéder à cette file.";
                return;
            }

            _agentId = contexte.UtilisateurId;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _erreur = null;
        try
        {
            var ticketsDeLaFile = await ConsulterFileReclamations.ExecuterAsync(_agentId);
            _tickets = ticketsDeLaFile.ToList();
        }
        catch (AccesRefuseException ex)
        {
            _tickets = [];
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
    }

    private async Task PrendreEnChargeAsync(Guid ticketId)
    {
        _erreur = null;
        _actionSuccess = null;
        try
        {
            await PrendreEnCharge.ExecuterAsync(_agentId, ticketId);
            _actionSuccess = "Réclamation prise en charge avec succès.";
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
    }
}
