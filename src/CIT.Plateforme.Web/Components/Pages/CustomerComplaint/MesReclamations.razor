@page "/reclamations/mes-reclamations"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Client
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirDashboardClientQuery DashboardQuery

<PageTitle>Mes réclamations — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>📋</span> Mes réclamations
        </h2>
        <div class="cit-page-subtitle">Suivi de vos réclamations soumises au Support Opérationnel CIT</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/reclamations/soumettre" class="btn btn-primary btn-sm shadow-sm fw-bold">➕ Nouvelle réclamation</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement de vos réclamations..." />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger mb-4">@_erreur</div>
}
else
{
    var reclamations = _dashboard?.DemandesRecentes.Where(d => d.Module == "CustomerComplaint").ToList() ?? [];

    if (reclamations.Count == 0)
    {
        <EtatVide Titre="Aucune réclamation" Message="Vous n'avez soumis aucune réclamation pour le moment." Icone="📝"
                  ActionLibelle="Soumettre une réclamation" ActionUrl="/reclamations/soumettre" />
    }
    else
    {
        <div class="cit-card p-0 overflow-hidden mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>N° Ticket</th>
                            <th>Date de soumission</th>
                            <th>Statut</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in reclamations)
                        {
                            @foreach (var t in d.Tickets)
                            {
                                <tr>
                                    <td>
                                        <a href="/tickets/@t.TicketId" class="fw-bold text-primary font-monospace text-decoration-none">
                                            @t.NumeroTicket
                                        </a>
                                    </td>
                                    <td class="text-muted small font-monospace">@d.DateCreationUtc.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="badge @BadgeClasse(d.EtatGlobal)">@Libelle(d.EtatGlobal)</span></td>
                                    <td class="text-end">
                                        <a href="/tickets/@t.TicketId" class="btn btn-outline-primary btn-sm">
                                            Détails ➔
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private bool _chargement = true;
    private string? _erreur;
    private DashboardClientVue? _dashboard;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue)
            {
                _erreur = "Session invalide ou compte non rattaché.";
                return;
            }

            _dashboard = await DashboardQuery.ExecuterAsync(contexte.UtilisateurId, contexte.SocieteId.Value);
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private static string BadgeClasse(StatutVisuelDossier etat) => etat switch
    {
        StatutVisuelDossier.ClotureTermine => "bg-success text-white",
        StatutVisuelDossier.EnAttenteClient => "bg-warning text-dark",
        StatutVisuelDossier.EnCoursTraitement => "bg-primary text-white",
        StatutVisuelDossier.Annule => "bg-secondary text-white",
        StatutVisuelDossier.Rejete => "bg-danger text-white",
        _ => "bg-info text-dark"
    };

    private static string Libelle(StatutVisuelDossier etat) => etat switch
    {
        StatutVisuelDossier.ClotureTermine => "Clôturée",
        StatutVisuelDossier.EnAttenteClient => "Action requise",
        StatutVisuelDossier.EnCoursTraitement => "En cours",
        StatutVisuelDossier.Annule => "Annulée",
        StatutVisuelDossier.Rejete => "Rejetée",
        _ => "En attente"
    };
}
