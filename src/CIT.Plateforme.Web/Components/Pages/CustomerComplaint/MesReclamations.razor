@page "/reclamations/mes-reclamations"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Client
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirDashboardClientQuery DashboardQuery

<PageTitle>@Loc["ReclamList.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>📋</span> @Loc["ReclamList.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["ReclamList.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/reclamations/soumettre" class="btn btn-primary btn-sm shadow-sm fw-bold">@Loc["ReclamList.New"]</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["ReclamList.Loading"]" />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger mb-4" role="alert">@_erreur</div>
}
else
{
    var reclamations = _dashboard?.DemandesRecentes.Where(d => d.Module == "CustomerComplaint").ToList() ?? [];

    if (reclamations.Count == 0)
    {
        <EtatVide Titre="@Loc["ReclamList.EmptyTitle"]" Message="@Loc["ReclamList.EmptyMsg"]" Icone="📝"
                  ActionLibelle="@Loc["ReclamList.EmptyCta"]" ActionUrl="/reclamations/soumettre" />
    }
    else
    {
        <div class="cit-card p-0 overflow-hidden mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["AvoirExoList.ColTicket"]</th>
                            <th>@Loc["Demandes.ColSubmitDate"]</th>
                            <th>@Loc["Societe.ColStatus"]</th>
                            <th class="text-end">@Loc["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in reclamations)
                        {
                            @foreach (var t in d.Tickets)
                            {
                                <tr>
                                    <td>
                                        <a href="/tickets/@t.TicketId" class="fw-bold text-primary font-monospace text-decoration-none">
                                            @t.NumeroTicket
                                        </a>
                                    </td>
                                    <td class="text-muted small font-monospace">@d.DateCreationUtc.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="badge @BadgeClasse(d.EtatGlobal)">@Libelle(d.EtatGlobal)</span></td>
                                    <td class="text-end">
                                        <a href="/tickets/@t.TicketId" class="btn btn-outline-primary btn-sm">
                                            @Loc["Demandes.Details"]
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private bool _chargement = true;
    private string? _erreur;
    private DashboardClientVue? _dashboard;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue)
            {
                _erreur = Loc["Demandes.SessionInvalid"].Value;
                return;
            }

            _dashboard = await DashboardQuery.ExecuterAsync(contexte.UtilisateurId, contexte.SocieteId.Value);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private static string BadgeClasse(StatutVisuelDossier etat) => etat switch
    {
        StatutVisuelDossier.ClotureTermine => "bg-success text-white",
        StatutVisuelDossier.EnAttenteClient => "bg-warning text-dark",
        StatutVisuelDossier.EnCoursTraitement => "bg-primary text-white",
        StatutVisuelDossier.Annule => "bg-secondary text-white",
        StatutVisuelDossier.Rejete => "bg-danger text-white",
        _ => "bg-info text-dark"
    };

    private static string Libelle(StatutVisuelDossier etat) => etat switch
    {
        StatutVisuelDossier.ClotureTermine => SharedResourcesLocalizer.Get("ReclamList.EtatCloturee"),
        StatutVisuelDossier.EnAttenteClient => SharedResourcesLocalizer.Get("ReclamList.EtatActionRequise"),
        StatutVisuelDossier.EnCoursTraitement => SharedResourcesLocalizer.Get("ReclamList.EtatEnCours"),
        StatutVisuelDossier.Annule => SharedResourcesLocalizer.Get("ReclamList.EtatAnnulee"),
        StatutVisuelDossier.Rejete => SharedResourcesLocalizer.Get("ReclamList.EtatRejetee"),
        _ => SharedResourcesLocalizer.Get("ReclamList.EtatEnAttente")
    };
}
