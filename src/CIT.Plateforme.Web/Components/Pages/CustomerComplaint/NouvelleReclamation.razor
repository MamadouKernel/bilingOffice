@page "/reclamations/soumettre"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.CustomerComplaint
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IContexteUtilisateurWeb ContexteService
@inject SoumettreReclamationCommand SoumettreReclamation
@inject Microsoft.Extensions.DependencyInjection.IServiceScopeFactory ScopeFactory
@inject ListerCategoriesReclamationQuery ListerCategories
@inject NavigationManager Navigation

<PageTitle>@Loc["Complaint.Title"] — @Loc["Common.AppTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>📢</span> @Loc["Complaint.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["Complaint.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/reclamations/mes-reclamations" class="btn btn-outline-secondary btn-sm shadow-sm">← @Loc["Common.Back"]</a>
    </div>
</div>

<div class="cit-page-etroite">
    @if (_chargement)
    {
        <IndicateurChargement Message="@Loc["Complaint.LoadingForm"]" />
    }
    else if (_nonAutorise)
    {
        <PermissionDenied Message="@_messageNonAutorise" />
    }
    else if (_ticketCreeNumero is not null)
    {
        <div class="cit-card border-success p-4 mb-4">
            <div class="d-flex align-items-center gap-3 text-success mb-3">
                <span class="fs-2">✅</span>
                <div>
                    <h5 class="fw-bold mb-0">@Loc["Complaint.SubmitSuccess"]</h5>
                    <div class="text-muted small">@Loc["Complaint.TrackingNumber"] <strong class="font-monospace text-primary">@_ticketCreeNumero</strong></div>
                    @if (_messagePieces is not null)
                    {
                        <div class="small mt-1">📎 @Loc["PJ.Attached"] @_messagePieces</div>
                    }
                </div>
            </div>
            <a href="/reclamations/mes-reclamations" class="btn btn-primary fw-bold px-4">@Loc["Complaint.MyComplaintsTitle"] ➔</a>
        </div>
    }
    else
    {
        @if (_erreur is not null)
        {
            <div class="alert alert-danger mb-4" role="alert">@_erreur</div>
        }

        <div class="cit-card mb-4">
            <div class="mb-3">
                <label class="form-label small fw-semibold text-dark" for="categorie">@Loc["Complaint.Category"]</label>
                <select id="categorie" class="form-select" @bind="_categorieId">
                    <option value="">@Loc["Complaint.SelectCategory"]</option>
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id">@cat.Libelle</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold text-dark" for="objet">@Loc["Complaint.Subject"]</label>
                <input id="objet" class="form-control" placeholder="@Loc["Complaint.SubjectPlaceholder"]" @bind="_objet" @bind:event="oninput" maxlength="200" />
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold text-dark" for="description">@Loc["Complaint.Description"]</label>
                <textarea id="description" class="form-control" rows="5" placeholder="@Loc["Complaint.DescPlaceholder"]" @bind="_description" @bind:event="oninput"></textarea>
            </div>

            <PiecesJointesFormulaire Fichiers="_pieces" />

            <div class="d-flex justify-content-end gap-2">
                <a href="/reclamations/mes-reclamations" class="btn btn-outline-secondary">@Loc["Common.Cancel"]</a>
                <div class="d-flex flex-column align-items-end">
                    <button type="button" class="btn btn-primary px-4 fw-bold shadow-sm" @onclick="SoumettreAsync" disabled="@(!PeutSoumettre || _envoiEnCours)">
                        @(_envoiEnCours ? Loc["Common.Loading"].Value : "🚀 " + Loc["Common.Submit"].Value)
                    </button>
                    @* REMÉDIATION D-21 : un bouton désactivé explique désormais sa condition. *@
                    @if (!PeutSoumettre && !_envoiEnCours)
                    {
                        <span class="form-text small text-muted mt-1">@Loc["Complaint.DisabledHint"]</span>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly SharedResourcesLocalizer Loc = new();
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private bool _envoiEnCours;
    private string? _ticketCreeNumero;
    private readonly List<Microsoft.AspNetCore.Components.Forms.IBrowserFile> _pieces = [];
    private string? _messagePieces;

    private Guid _utilisateurId;
    private Guid _societeId;
    private IReadOnlyList<CategorieReclamationVue> _categories = [];
    private string _categorieId = string.Empty;
    private string _objet = string.Empty;
    private string _description = string.Empty;

    private bool PeutSoumettre =>
        Guid.TryParse(_categorieId, out _) && !string.IsNullOrWhiteSpace(_objet) && !string.IsNullOrWhiteSpace(_description);

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["Complaint.LoginRequired"].Value;
                return;
            }

            _utilisateurId = contexte.UtilisateurId;
            _societeId = contexte.SocieteId.Value;
            _categories = await ListerCategories.ExecuterAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task SoumettreAsync()
    {
        if (!PeutSoumettre || !Guid.TryParse(_categorieId, out var categorieId))
        {
            return;
        }

        _envoiEnCours = true;
        _erreur = null;
        try
        {
            var resultat = await SoumettreReclamation.ExecuterAsync(
                _utilisateurId,
                new SoumettreReclamationRequete(_societeId, categorieId, _objet, _description));

            _ticketCreeNumero = resultat.NumeroTicket;
            if (_pieces.Count > 0)
            {
                _messagePieces = (await DepotFichiers.JoindreAsync(ScopeFactory, _pieces, resultat.TicketId, _utilisateurId, estClient: true)).Message(Loc);
                _pieces.Clear();
            }
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _envoiEnCours = false;
        }
    }
}
