@page "/administration/matrice-transitions"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Administration
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>@Loc["AdmMatrice.PageTitle"]</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span>🔀</span> @Loc["AdmMatrice.Pill"]
        </div>
        <h1 class="cit-page-title fw-bold text-dark mb-1">@Loc["AdmMatrice.Title"]</h1>
        <div class="cit-page-subtitle text-muted">
            @Loc["AdmMatrice.Subtitle"]
        </div>
    </div>
    <div>
        <button class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold shadow-sm" @onclick="ChargerAsync" disabled="@_chargement">
            @Loc["Common.Refresh"]
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["AdmMatrice.Loading"]" />
}
else if (_refuse)
{
    <PermissionDenied Message="@_messageRefus" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger border-0 bg-danger bg-opacity-10 mb-4 rounded-3 p-3 shadow-sm" role="alert">
            <span class="me-2">⚠️</span> @_erreur
        </div>
    }

    @if (_vue is not null && _vue.Files.Count < 2)
    {
        @* Sans au moins deux files administrées, une transition n'a pas d'objet. Le dire ici
           évite deux listes déroulantes vides que rien n'explique. *@
        <div class="cit-card p-4 mb-4 border-0 shadow-sm">
            <div class="fw-semibold text-dark mb-1">@Loc["AdmMatrice.TwoFilesTitle"]</div>
            <div class="text-muted small">
                @Loc["AdmMatrice.TwoFilesDesc"]
            </div>
        </div>
    }
    else if (_vue is not null)
    {
        <div class="cit-card p-4 mb-4 border-0 shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="fs-4">➕</span>
                <h4 class="fw-bold text-dark mb-0 fs-5">@Loc["AdmMatrice.AddTitle"]</h4>
            </div>

            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-bold text-dark" for="source">@Loc["AdmMatrice.SourceLabel"]</label>
                    <select id="source" class="form-select" @bind="_source">
                        <option value="">@Loc["AdmComp.ChooseOption"]</option>
                        @foreach (var f in _vue.Files)
                        {
                            <option value="@f.Id">@f.Nom (@f.Module)</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-bold text-dark" for="cible">@Loc["AdmMatrice.CibleLabel"]</label>
                    <select id="cible" class="form-select" @bind="_cible">
                        <option value="">@Loc["AdmComp.ChooseOption"]</option>
                        @foreach (var f in _vue.Files)
                        {
                            <option value="@f.Id">@f.Nom (@f.Module)</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-bold text-dark" for="motifs">@Loc["AdmMatrice.MotifsLabel"]</label>
                    <input id="motifs" class="form-control" @bind="_motifs"
                           placeholder="@Loc["AdmMatrice.MotifsPlaceholder"]" />
                </div>
                <div class="col-12 col-md-1 d-grid">
                    <button class="btn btn-primary py-2 fw-semibold rounded-3 shadow-sm" @onclick="DefinirAsync">
                        @Loc["AdmMatrice.Define"]
                    </button>
                </div>
            </div>
            <div class="form-text small">
                @((MarkupString)Loc["AdmMatrice.MotifsHint"].Value)
            </div>
        </div>

        @if (_vue.Transitions.Count == 0)
        {
            <div class="cit-card p-5 text-center my-4 border-0 shadow-sm">
                <div class="fs-1 mb-3">🔀</div>
                <h4 class="fw-bold text-dark mb-2">@Loc["AdmMatrice.EmptyTitle"]</h4>
                <p class="text-muted mb-0">
                    @Loc["AdmMatrice.EmptyDesc"]
                </p>
            </div>
        }
        else
        {
            <div class="cit-card border-0 shadow-sm overflow-hidden">
                <div class="p-3 bg-light border-bottom">
                    <span class="fw-bold text-dark small">@Loc["AdmMatrice.ListTitle", _vue.Transitions.Count]</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <caption class="visually-hidden">@Loc["AdmMatrice.TableCaption"]</caption>
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-4">@Loc["AdmMatrice.ColSource"]</th>
                                <th scope="col">@Loc["AdmMatrice.ColCible"]</th>
                                <th scope="col">@Loc["AdmMatrice.ColMotifs"]</th>
                                <th scope="col" class="text-end pe-4">@Loc["AdmPieceC.ColActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in _vue.Transitions)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">@t.FileSourceNom</td>
                                    <td class="fw-semibold text-dark">@t.FileCibleNom</td>
                                    <td>
                                        @if (t.MotifsAutorises.Count == 0)
                                        {
                                            <span class="badge bg-secondary-subtle text-dark">@Loc["AdmMatrice.AllMotifs"]</span>
                                        }
                                        else
                                        {
                                            @foreach (var motif in t.MotifsAutorises)
                                            {
                                                <span class="badge bg-primary bg-opacity-10 text-primary font-monospace me-1">@motif</span>
                                            }
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                @onclick="() => DemanderConfirmationSuppression(t.FileSourceId, t.FileCibleId)">
                                            @Loc["AdmMatrice.Delete"]
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}

<ModaleConfirmation EstOuvert="@(_confirmation is not null)"
                    Titre="@(_confirmation?.Titre ?? string.Empty)"
                    Message="@(_confirmation?.Message ?? string.Empty)"
                    BoutonConfirmerLibelle="@(_confirmation?.LibelleConfirmer ?? Loc["AdmMatrice.Delete"].Value)"
                    BoutonConfirmerClass="@(_confirmation?.ClasseConfirmer ?? "btn-danger")"
                    Desactive="@_enCours"
                    OnConfirmer="@(async () => { if (_confirmation is not null) await _confirmation.Action(); })"
                    OnAnnuler="AnnulerConfirmation" />

@code {
    private MatriceTransitionsVue? _vue;
    private Guid _appelantId;
    private bool _chargement = true;
    private bool _refuse;
    private string _messageRefus = string.Empty;
    private string? _erreur;

    // AM-03 — la suppression d'une transition est irréversible : elle passe par une confirmation.
    private ConfirmationEnAttente? _confirmation;
    private bool _enCours;

    private string _source = string.Empty;
    private string _cible = string.Empty;
    private string _motifs = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _messageRefus = Loc["AdmMatrice.Refuse"].Value;
        var contexte = await ContexteService.ObtenirContexteAsync();
        _appelantId = contexte.UtilisateurId;
        _refuse = !contexte.Permissions.Contains(CIT.Plateforme.Domain.Securite.Permission.AdministrationFiles);

        if (!_refuse)
        {
            await ChargerAsync();
        }
        else
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            _vue = await scope.ServiceProvider
                .GetRequiredService<GererMatriceTransitionsCommand>()
                .ListerAsync(_appelantId);
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task DefinirAsync()
    {
        _erreur = null;

        if (!Guid.TryParse(_source, out var source) || !Guid.TryParse(_cible, out var cible))
        {
            _erreur = Loc["AdmMatrice.ErrorChoose"].Value;
            return;
        }

        var motifs = _motifs
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider
                .GetRequiredService<GererMatriceTransitionsCommand>()
                .DefinirTransitionAsync(_appelantId, source, cible, motifs);

            _source = string.Empty;
            _cible = string.Empty;
            _motifs = string.Empty;
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private void DemanderConfirmationSuppression(Guid source, Guid cible)
    {
        _confirmation = new ConfirmationEnAttente(
            Loc["AdmMatrice.ConfirmTitle"].Value,
            Loc["AdmMatrice.ConfirmMsg"].Value,
            Loc["AdmMatrice.Delete"].Value,
            "btn-danger",
            () => ExecuterSuppressionAsync(source, cible));
    }

    private void AnnulerConfirmation() => _confirmation = null;

    private async Task ExecuterSuppressionAsync(Guid source, Guid cible)
    {
        _enCours = true;
        try
        {
            await SupprimerAsync(source, cible);
        }
        finally
        {
            _enCours = false;
            _confirmation = null;
        }
    }

    private async Task SupprimerAsync(Guid source, Guid cible)
    {
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider
                .GetRequiredService<GererMatriceTransitionsCommand>()
                .SupprimerTransitionAsync(_appelantId, source, cible);

            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }
}
