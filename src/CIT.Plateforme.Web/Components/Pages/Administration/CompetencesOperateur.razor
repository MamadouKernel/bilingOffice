@page "/administration/competences-operateur"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Affectation
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Compétences des opérateurs — CIT</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span>🎯</span> Affectation
        </div>
        <h1 class="cit-page-title fw-bold text-dark mb-1">Compétences des opérateurs</h1>
        <div class="cit-page-subtitle text-muted">
            Les compétences sur lesquelles s'appuie la stratégie de distribution automatique par
            compétence (AFF-06).
        </div>
    </div>
    <div>
        <button class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold shadow-sm" @onclick="ChargerAsync" disabled="@_chargement">
            🔄 Actualiser
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement des compétences..." />
}
else if (_refuse)
{
    <PermissionDenied Message="@_messageRefus" />
}
else if (_vue is not null)
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger border-0 bg-danger bg-opacity-10 mb-4 rounded-3 p-3 shadow-sm" role="alert">
            <span class="me-2">⚠️</span> @_erreur
        </div>
    }

    <div class="cit-card p-4 mb-4 border-0 shadow-sm">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label small fw-bold text-dark" for="operateur">Opérateur</label>
                <select id="operateur" class="form-select" @bind="_operateur" @bind:after="ChargerAsync">
                    <option value="">— choisir —</option>
                    @foreach (var op in _vue.Operateurs)
                    {
                        <option value="@op.Id">@op.Nom</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-5">
                <label class="form-label small fw-bold text-dark" for="code">Compétence à attribuer</label>
                <input id="code" class="form-control" @bind="_code" list="codes-employes"
                       placeholder="code administré, ex. manifeste" />
                @* Aucun catalogue n'est codé en dur (Principe VI, PC-12) : la liste ne propose que
                   les codes que l'administration a elle-même déjà employés. *@
                <datalist id="codes-employes">
                    @foreach (var codeEmploye in _vue.CodesDejaEmployes)
                    {
                        <option value="@codeEmploye"></option>
                    }
                </datalist>
            </div>
            <div class="col-12 col-md-2 d-grid">
                <button class="btn btn-primary py-2 fw-semibold rounded-3 shadow-sm" @onclick="AttribuerAsync"
                        disabled="@(string.IsNullOrWhiteSpace(_operateur) || string.IsNullOrWhiteSpace(_code))">
                    Attribuer
                </button>
            </div>
        </div>
    </div>

    @if (string.IsNullOrWhiteSpace(_operateur))
    {
        <div class="cit-card p-5 text-center my-4 border-0 shadow-sm">
            <div class="fs-1 mb-3">🎯</div>
            <h4 class="fw-bold text-dark mb-2">Choisissez un opérateur</h4>
            <p class="text-muted mb-0">Ses compétences s'afficheront ici.</p>
        </div>
    }
    else if (_vue.Codes.Count == 0)
    {
        <div class="cit-card p-5 text-center my-4 border-0 shadow-sm">
            <div class="fs-1 mb-3">🎯</div>
            <h4 class="fw-bold text-dark mb-2">Aucune compétence attribuée</h4>
            <p class="text-muted mb-0">
                La distribution par compétence ne retiendra jamais cet opérateur tant qu'il n'en a
                aucune.
            </p>
        </div>
    }
    else
    {
        <div class="cit-card border-0 shadow-sm overflow-hidden">
            <div class="p-3 bg-light border-bottom">
                <span class="fw-bold text-dark small">Compétences attribuées (@_vue.Codes.Count)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <caption class="visually-hidden">Compétences attribuées à l'opérateur sélectionné</caption>
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Code de compétence</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var codeAttribue in _vue.Codes)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-primary bg-opacity-10 text-primary font-monospace px-2 py-1 rounded-pill">@codeAttribue</span>
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                            @onclick="() => RetirerAsync(codeAttribue)">
                                        Retirer
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private CompetencesOperateurVue? _vue;
    private Guid _appelantId;
    private bool _chargement = true;
    private bool _refuse;
    private string _messageRefus = "Vous devez disposer de la permission de gestion des compétences pour accéder à cette interface.";
    private string? _erreur;

    private string _operateur = string.Empty;
    private string _code = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var contexte = await ContexteService.ObtenirContexteAsync();
        _appelantId = contexte.UtilisateurId;
        _refuse = !contexte.Permissions.Contains(CIT.Plateforme.Domain.Securite.Permission.CompetenceGerer);

        if (!_refuse)
        {
            await ChargerAsync();
        }
        else
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            Guid? operateurId = Guid.TryParse(_operateur, out var id) ? id : null;

            using var scope = ScopeFactory.CreateScope();
            _vue = await scope.ServiceProvider
                .GetRequiredService<ListerCompetencesOperateurQuery>()
                .ExecuterAsync(_appelantId, operateurId);
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task AttribuerAsync()
    {
        _erreur = null;

        if (!Guid.TryParse(_operateur, out var operateurId))
        {
            _erreur = "Choisissez l'opérateur à qui attribuer la compétence.";
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider
                .GetRequiredService<GererCompetencesOperateurCommand>()
                .AttribuerAsync(_appelantId, operateurId, _code);

            _code = string.Empty;
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private async Task RetirerAsync(string code)
    {
        _erreur = null;

        if (!Guid.TryParse(_operateur, out var operateurId))
        {
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider
                .GetRequiredService<GererCompetencesOperateurCommand>()
                .RetirerAsync(_appelantId, operateurId, code);

            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }
}
