@page "/administration/libelles-statut"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Administration
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>@Loc["AdmLibStatut.PageTitle"]</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span>🏷️</span> @Loc["AdmLibStatut.Pill"]
        </div>
        <h1 class="cit-page-title fw-bold text-dark mb-1">@Loc["AdmLibStatut.Title"]</h1>
        <div class="cit-page-subtitle text-muted">@Loc["AdmLibStatut.Subtitle"]</div>
    </div>
    <div>
        <button class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold shadow-sm" @onclick="ChargerAsync" disabled="@_chargement">
            @Loc["Common.Refresh"]
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["AdmLibStatut.Loading"]" />
}
else if (_refuse)
{
    <PermissionDenied Message="@_messageRefus" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger border-0 bg-danger bg-opacity-10 mb-4 rounded-3 p-3 shadow-sm" role="alert">
            <span class="me-2">⚠️</span> @_erreur
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_succes))
    {
        <div class="alert alert-success border-0 bg-success bg-opacity-10 py-2 small mb-4 rounded-3" role="status">@_succes</div>
    }

    <div class="form-text small mb-3">@Loc["AdmLibStatut.EngageantHint"]</div>

    @if (_libelles.Count == 0)
    {
        <EtatVide Titre="@Loc["AdmLibStatut.EmptyTitle"]" Description="@Loc["AdmLibStatut.EmptyDesc"]" Icone="🏷️" />
    }
    else
    {
        <div class="cit-card border-0 shadow-sm overflow-hidden">
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@Loc["AdmLibStatut.ColCode"]</th>
                            <th>@Loc["AdmLibStatut.ColFr"]</th>
                            <th>@Loc["AdmLibStatut.ColEn"]</th>
                            <th class="text-end">@Loc["AdmLibStatut.ColOrdre"]</th>
                            <th>@Loc["AdmLibStatut.ColEngageant"]</th>
                            <th>@Loc["AdmLibStatut.ColActif"]</th>
                            <th class="text-end pe-4">@Loc["AdmLibStatut.ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in _pagination1.Appliquer(_libelles))
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary font-monospace">@l.Code</td>
                                @if (_codeEnEdition == l.Code)
                                {
                                    <td><input class="form-control form-control-sm" @bind="_editFr" /></td>
                                    <td><input class="form-control form-control-sm" @bind="_editEn" /></td>
                                    <td class="text-end" style="max-width: 6rem;"><input type="number" class="form-control form-control-sm" @bind="_editOrdre" /></td>
                                    <td><input type="checkbox" class="form-check-input" @bind="_editEngageant" /></td>
                                    <td><input type="checkbox" class="form-check-input" @bind="_editActif" /></td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-primary" @onclick="() => EnregistrerAsync(l.Code)">@Loc["AdmLibStatut.BtnEnregistrer"]</button>
                                            <button class="btn btn-outline-secondary" @onclick="() => _codeEnEdition = null">@Loc["AdmLibStatut.BtnAnnuler"]</button>
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td class="text-dark">@l.LibelleFr</td>
                                    <td class="text-dark">@l.LibelleEn</td>
                                    <td class="text-end font-monospace">@l.Ordre</td>
                                    <td>@(l.EstEngageant ? Loc["AdmLibStatut.Oui"] : Loc["AdmLibStatut.Non"])</td>
                                    <td>
                                        <span class="badge @(l.Actif ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                            @(l.Actif ? Loc["AdmLibStatut.Oui"] : Loc["AdmLibStatut.Non"])
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => CommencerEdition(l)">@Loc["AdmLibStatut.BtnModifier"]</button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private IReadOnlyList<LibelleStatutVue> _libelles = [];
    private Guid _appelantId;
    private bool _chargement = true;
    private bool _refuse;
    private string _messageRefus = string.Empty;
    private string? _erreur;
    private string? _succes;

    private string? _codeEnEdition;
    private string _editFr = string.Empty;
    private string _editEn = string.Empty;
    private int _editOrdre;
    private bool _editEngageant;
    private bool _editActif;

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _refuse = true;
                _messageRefus = Loc["AdmLibStatut.LoginRequis"].Value;
                return;
            }

            _appelantId = contexte.UtilisateurId;

            using var scope = ScopeFactory.CreateScope();
            _libelles = await scope.ServiceProvider
                .GetRequiredService<ListerLibellesStatutQuery>()
                .ExecuterAsync(_appelantId);
            _refuse = false;
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private void CommencerEdition(LibelleStatutVue l)
    {
        _codeEnEdition = l.Code;
        _editFr = l.LibelleFr;
        _editEn = l.LibelleEn;
        _editOrdre = l.Ordre;
        _editEngageant = l.EstEngageant;
        _editActif = l.Actif;
    }

    private async Task EnregistrerAsync(string code)
    {
        _erreur = null;
        _succes = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider
                .GetRequiredService<GererLibellesStatutCommand>()
                .ModifierAsync(_appelantId, code, _editFr, _editEn, _editOrdre, _editEngageant, _editActif);

            _codeEnEdition = null;
            _succes = Loc["AdmLibStatut.SuccessMaj"].Value;
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }
}
