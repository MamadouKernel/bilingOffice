@page "/administration/pieces-exigees-compte"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Comptes
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Pièces exigées à l'ouverture d'un compte — CIT</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span>📎</span> Référentiel Réglementaire
        </div>
        <h1 class="cit-page-title fw-bold text-dark mb-1">
            Pièces Exigées à l'Ouverture de Compte
        </h1>
        <div class="cit-page-subtitle text-muted">
            Paramétrage des documents légaux obligatoires et facultatifs exigés des entreprises lors de leur inscription.
        </div>
    </div>
    <div>
        <button class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold shadow-sm d-flex align-items-center gap-2" @onclick="ChargerAsync" disabled="@_chargement">
            <span>🔄</span> Actualiser
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement des pièces justificatives paramétrées..." />
}
else if (_refuse)
{
    <PermissionDenied Message="@_messageRefus" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger border-0 text-danger bg-danger bg-opacity-10 mb-4 rounded-3 p-3 d-flex align-items-center shadow-sm" role="alert">
            <span class="me-2 fs-5">⚠️</span> @_erreur
        </div>
    }

    <!-- 1. Formulaire d'Ajout d'une Pièce -->
    <div class="cit-card p-4 mb-4 border-0 shadow-sm" style="border-radius: 1.25rem; background-color: var(--surface);">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="fs-4">➕</span>
            <h4 class="fw-bold text-dark mb-0 fs-5">Ajouter ou modifier une pièce exigée</h4>
        </div>

        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-2">
                <label class="form-label small fw-bold text-dark" for="code">Code unique</label>
                <input id="code" class="form-control" @bind="_code" placeholder="ex. RCCM" />
            </div>
            <div class="col-12 col-md-5">
                <label class="form-label small fw-bold text-dark" for="libelle">Libellé descriptif</label>
                <input id="libelle" class="form-control" @bind="_libelle" placeholder="Registre du Commerce et du Crédit Mobilier" />
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label small fw-bold text-dark" for="ordre">Ordre d'affichage</label>
                <input id="ordre" type="number" class="form-control" @bind="_ordre" />
            </div>
            <div class="col-12 col-md-2 d-flex align-items-center" style="height: 38px;">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="obligatoire" @bind="_obligatoire" />
                    <label class="form-check-label small fw-bold text-dark" for="obligatoire">Obligatoire</label>
                </div>
            </div>
            <div class="col-12 col-md-1">
                <button class="btn btn-primary w-100 py-2 fw-semibold rounded-3 shadow-sm" @onclick="AjouterAsync">
                    Ajouter
                </button>
            </div>
        </div>
        <div class="form-text text-muted mt-2 small">
            💡 Les pièces définies ici apparaissent immédiatement sur le formulaire public de soumission d'un compte entreprise.
        </div>
    </div>

    <!-- 2. Liste des Pièces Exigées -->
    @if (_pieces is null || _pieces.Count == 0)
    {
        <div class="cit-card p-5 text-center my-4 border-0 shadow-sm" style="border-radius: 1rem; background-color: var(--surface);">
            <div class="fs-1 mb-3">📂</div>
            <h4 class="fw-bold text-dark mb-2">Aucune pièce paramétrée</h4>
            <p class="text-muted mb-0">Utilisez le formulaire ci-dessus pour configurer les justificatifs requis.</p>
        </div>
    }
    else
    {
        <div class="cit-card border-0 shadow-sm overflow-hidden" style="border-radius: 1.25rem; background-color: var(--surface);">
            <div class="p-3 bg-light border-bottom d-flex align-items-center justify-content-between">
                <span class="fw-bold text-dark small">Référentiel des Justificatifs (@_pieces.Count)</span>
                <span class="badge bg-secondary-subtle text-dark">Paramétrage Sans Développement</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 80px;">Ordre</th>
                            <th>Code</th>
                            <th>Libellé officiel</th>
                            <th>Caractère légal</th>
                            <th>État</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var piece in _pieces.OrderBy(p => p.Ordre))
                        {
                            <tr>
                                <td class="ps-4 font-monospace fw-bold text-muted">#@piece.Ordre</td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary font-monospace px-2 py-1 rounded-pill">
                                        @piece.Code
                                    </span>
                                </td>
                                <td class="fw-semibold text-dark">@piece.Libelle</td>
                                <td>
                                    @if (piece.Obligatoire)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-1 rounded-pill">
                                            Obligatoire
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-3 py-1 rounded-pill">
                                            Facultatif
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(piece.EstActif ? "bg-success bg-opacity-10 text-success" : "bg-danger bg-opacity-10 text-danger") px-3 py-1 rounded-pill">
                                        @(piece.EstActif ? "Actif" : "Désactivé")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    @if (piece.EstActif)
                                    {
                                        <button class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                @onclick="() => BasculerAsync(piece.Id, false)">
                                            Désactiver
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-success btn-sm rounded-pill px-3"
                                                @onclick="() => BasculerAsync(piece.Id, true)">
                                            Réactiver
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private IReadOnlyList<PieceExigeeVue>? _pieces;
    private Guid _appelantId;
    private bool _chargement = true;
    private bool _refuse;
    private string _messageRefus = "Vous devez disposer de la permission d'administration des comptes pour accéder au paramétrage des pièces exigées.";
    private string? _erreur;

    private string _code = string.Empty;
    private string _libelle = string.Empty;
    private bool _obligatoire = true;
    private int _ordre = 1;

    protected override async Task OnInitializedAsync()
    {
        var contexte = await ContexteService.ObtenirContexteAsync();
        _appelantId = contexte.UtilisateurId;
        _refuse = !contexte.Permissions.Contains(CIT.Plateforme.Domain.Securite.Permission.AdministrationComptes);
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var listerPieces = scope.ServiceProvider.GetRequiredService<ListerPiecesExigeesQuery>();
            _pieces = await listerPieces.ExecuterAsync(activesUniquement: false);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ExecuterAsync(Func<IServiceProvider, Task> action)
    {
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await action(scope.ServiceProvider);
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private Task AjouterAsync() => ExecuterAsync(async sp =>
    {
        var gererPieces = sp.GetRequiredService<GererPiecesExigeesCommand>();
        await gererPieces.DefinirAsync(_appelantId, _code, _libelle, _obligatoire, _ordre);
        _code = string.Empty;
        _libelle = string.Empty;
        _obligatoire = true;
        _ordre = (_pieces?.Count ?? 0) + 1;
    });

    private Task BasculerAsync(Guid pieceId, bool actif) => ExecuterAsync(sp =>
    {
        var gererPieces = sp.GetRequiredService<GererPiecesExigeesCommand>();
        return gererPieces.DefinirActivationAsync(_appelantId, pieceId, actif);
    });
}
