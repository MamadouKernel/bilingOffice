@page "/administration/archives"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Administration
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>@Loc["Archives.PageTitle"]</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span>🗄️</span> @Loc["Archives.Pill"]
        </div>
        <h1 class="cit-page-title fw-bold text-dark mb-1">@Loc["Archives.Title"]</h1>
        <div class="cit-page-subtitle text-muted">@Loc["Archives.Subtitle"]</div>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["Archives.Loading"]" />
}
else if (_refuse)
{
    <PermissionDenied Message="@_messageRefus" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger border-0 text-danger bg-danger bg-opacity-10 mb-4 rounded-3 p-3 shadow-sm" role="alert">
            <span class="me-2 fs-5">⚠️</span> @_erreur
        </div>
    }

    <div class="cit-card p-4 mb-4 border-0 shadow-sm" style="border-radius: 1.25rem; background-color: var(--surface);">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-dark">@Loc["Archives.FilterModule"]</label>
                <input class="form-control" @bind="_filtreModule" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-dark">@Loc["Archives.FilterNumero"]</label>
                <input class="form-control" @bind="_filtreNumero" />
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label small fw-bold text-dark">@Loc["Archives.FilterDateDebut"]</label>
                <input type="date" class="form-control" @bind="_filtreDateDebut" />
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label small fw-bold text-dark">@Loc["Archives.FilterDateFin"]</label>
                <input type="date" class="form-control" @bind="_filtreDateFin" />
            </div>
            <div class="col-12 col-md-2">
                <button class="btn btn-primary w-100 fw-semibold rounded-3" @onclick="ChargerAsync">@Loc["Archives.FilterBtn"]</button>
            </div>
        </div>
    </div>

    @if (_archives is null || _archives.Count == 0)
    {
        <div class="cit-card p-5 text-center my-4 border-0 shadow-sm" style="border-radius: 1rem; background-color: var(--surface);">
            <div class="fs-1 mb-3">🗄️</div>
            <h4 class="fw-bold text-dark mb-2">@Loc["Archives.EmptyTitle"]</h4>
            <p class="text-muted mb-0">@Loc["Archives.EmptyDesc"]</p>
        </div>
    }
    else
    {
        <div class="cit-card border-0 shadow-sm overflow-hidden" style="border-radius: 1.25rem; background-color: var(--surface);">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@Loc["Archives.ColNumero"]</th>
                            <th>@Loc["Archives.ColModule"]</th>
                            <th>@Loc["Archives.ColStatut"]</th>
                            <th>@Loc["Archives.ColDateArchivage"]</th>
                            <th class="text-end pe-4">@Loc["Archives.ColAnonymise"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var archive in _archives)
                        {
                            <tr>
                                <td class="ps-4 font-monospace fw-bold text-muted">@archive.Numero</td>
                                <td>@archive.Module</td>
                                <td>@archive.Statut</td>
                                <td>@archive.DateArchivageUtc.ToString("dd/MM/yyyy")</td>
                                <td class="text-end pe-4">
                                    @if (archive.EstAnonymise)
                                    {
                                        <span class="badge bg-secondary-subtle text-dark">✓</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private IReadOnlyList<TicketArchiveVue>? _archives;
    private Guid _appelantId;
    private bool _chargement = true;
    private bool _refuse;
    private string _messageRefus = string.Empty;
    private string? _erreur;

    private string _filtreModule = string.Empty;
    private string _filtreNumero = string.Empty;
    private DateTime? _filtreDateDebut;
    private DateTime? _filtreDateFin;

    protected override async Task OnInitializedAsync()
    {
        _messageRefus = Loc["Archives.Refuse"].Value;
        var contexte = await ContexteService.ObtenirContexteAsync();
        _appelantId = contexte.UtilisateurId;
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var consulter = scope.ServiceProvider.GetRequiredService<ConsulterArchivesQuery>();
            var filtre = new FiltreArchives(
                string.IsNullOrWhiteSpace(_filtreModule) ? null : _filtreModule,
                _filtreDateDebut,
                _filtreDateFin,
                string.IsNullOrWhiteSpace(_filtreNumero) ? null : _filtreNumero);
            _archives = await consulter.ExecuterAsync(_appelantId, filtre);
            _refuse = false;
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }
}
