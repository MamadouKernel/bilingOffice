@page "/administration/pieces-exigees-etape"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Administration
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Pièces exigées par étape — CIT</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span aria-hidden="true">📎</span> Documents &amp; justificatifs
        </div>
        <h2 class="cit-page-title fw-bold text-dark mb-1">Pièces exigées par étape</h2>
        <div class="cit-page-subtitle text-muted">
            Documents attendus à chaque étape du parcours, distincts des pièces d'ouverture de
            compte. Une pièce sans module est attendue partout.
        </div>
    </div>
    <div>
        <button class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold shadow-sm d-flex align-items-center gap-2" @onclick="ChargerAsync" disabled="@_chargement">
            <span aria-hidden="true">🔄</span> Actualiser
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement des pièces exigées..." />
}
else if (_refuse)
{
    <PermissionDenied Message="@_messageRefus" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger border-0 text-danger bg-danger bg-opacity-10 mb-4 rounded-3 p-3 d-flex align-items-center shadow-sm" role="alert">
            <span class="me-2 fs-5" aria-hidden="true">⚠️</span> @_erreur
        </div>
    }

    <div class="cit-card p-4 mb-4 border-0 shadow-sm">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="fs-4" aria-hidden="true">➕</span>
            <h4 class="fw-bold text-dark mb-0 fs-5">Ajouter une pièce attendue</h4>
        </div>

        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-2">
                <label class="form-label small fw-bold text-dark" for="code">Code</label>
                <input id="code" class="form-control" @bind="_code" placeholder="ex. bl_original" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-dark" for="libelle">Libellé</label>
                <input id="libelle" class="form-control" @bind="_libelle" placeholder="Connaissement original" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-dark" for="etape">Étape</label>
                <select id="etape" class="form-select" @bind="_fileId">
                    <option value="">— choisir —</option>
                    @foreach (var f in _files)
                    {
                        <option value="@f.Item1">@f.Item2</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-bold text-dark" for="module">Module</label>
                <input id="module" class="form-control" @bind="_module" placeholder="tous" />
            </div>
            <div class="col-6 col-md-1">
                <label class="form-label small fw-bold text-dark" for="oblig">Obligatoire</label>
                <select id="oblig" class="form-select" @bind="_obligatoire">
                    <option value="true">Oui</option>
                    <option value="false">Non</option>
                </select>
            </div>
            <div class="col-12 col-md-1">
                <button class="btn btn-primary w-100 py-2 fw-semibold rounded-3 shadow-sm" @onclick="AjouterAsync">
                    Ajouter
                </button>
            </div>
        </div>
    </div>

    @if (_pieces is null || _pieces.Count == 0)
    {
        <div class="cit-card p-5 text-center text-muted border-0 shadow-sm">
            <div class="fs-1 mb-2" aria-hidden="true">📎</div>
            <div class="fw-semibold">Aucune pièce exigée par étape</div>
            <div class="small">Aucune exigence documentaire d'étape ne s'applique.</div>
        </div>
    }
    else
    {
        <div class="cit-card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <caption class="visually-hidden">Pièces exigées par étape du parcours</caption>
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="small fw-bold">Code</th>
                            <th scope="col" class="small fw-bold">Libellé</th>
                            <th scope="col" class="small fw-bold">Étape</th>
                            <th scope="col" class="small fw-bold">Module</th>
                            <th scope="col" class="small fw-bold">Obligatoire</th>
                            <th scope="col" class="small fw-bold">État</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _pieces)
                        {
                            <tr class="@(p.EstActif ? "" : "opacity-50")">
                                <td><code>@p.Code</code></td>
                                <td class="fw-semibold">@p.Libelle</td>
                                <td>@p.NomEtape</td>
                                <td>@(p.Module ?? "Tous")</td>
                                <td>@(p.Obligatoire ? "Oui" : "Non")</td>
                                <td>
                                    @if (p.EstActif)
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success-emphasis">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-dark">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => BasculerAsync(p.Id, !p.EstActif)">
                                        @(p.EstActif ? "Désactiver" : "Activer")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private IReadOnlyList<PieceExigeeEtapeVue>? _pieces;
    private IReadOnlyList<(Guid, string)> _files = [];
    private Guid _appelantId;
    private bool _chargement = true;
    private bool _refuse;
    private string _messageRefus = "Vous devez disposer de la permission d'administration des files (administration.files) pour accéder à cette interface.";
    private string? _erreur;

    private string _code = string.Empty;
    private string _libelle = string.Empty;
    private string _fileId = string.Empty;
    private string _module = string.Empty;
    private bool _obligatoire = true;

    protected override async Task OnInitializedAsync()
    {
        var contexte = await ContexteService.ObtenirContexteAsync();
        _appelantId = contexte.UtilisateurId;
        _refuse = !contexte.Permissions.Contains(CIT.Plateforme.Domain.Securite.Permission.AdministrationFiles);

        if (!_refuse)
        {
            await ChargerAsync();
        }
        else
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            _pieces = await scope.ServiceProvider.GetRequiredService<GererPiecesExigeesEtapeCommand>().ListerAsync(_appelantId);
            var lister = scope.ServiceProvider.GetRequiredService<ListerFilesQuery>();
            _files = (await lister.ExecuterAsync(_appelantId)).Select(f => (f.Id, f.Nom)).ToList();
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ExecuterAsync(Func<IServiceProvider, Task> action)
    {
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await action(scope.ServiceProvider);
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
    }

    private Task AjouterAsync() => ExecuterAsync(async sp =>
    {
        if (!Guid.TryParse(_fileId, out var file))
        {
            throw new InvalidOperationException("L'étape est obligatoire : une pièce exigée par étape sans étape ne serait exigée nulle part.");
        }

        await sp.GetRequiredService<GererPiecesExigeesEtapeCommand>().DefinirAsync(
            _appelantId, _code, _libelle, file, _obligatoire, (_pieces?.Count ?? 0) + 1,
            string.IsNullOrWhiteSpace(_module) ? null : _module);

        _code = string.Empty;
        _libelle = string.Empty;
        _module = string.Empty;
    });

    private Task BasculerAsync(Guid pieceId, bool active) => ExecuterAsync(sp =>
        sp.GetRequiredService<GererPiecesExigeesEtapeCommand>().DefinirActivationAsync(_appelantId, pieceId, active));
}
