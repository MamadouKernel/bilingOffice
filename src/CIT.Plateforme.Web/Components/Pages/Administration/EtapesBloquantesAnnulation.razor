@page "/administration/etapes-bloquantes-annulation"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Administration
@using CIT.Plateforme.Application.Abstractions
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>@Loc["AdmSeuil.PageTitle"]</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span>🛑</span> @Loc["AdmSeuil.Pill"]
        </div>
        <h1 class="cit-page-title fw-bold text-dark mb-1">
            @Loc["AdmSeuil.Title"]
        </h1>
        <div class="cit-page-subtitle text-muted">
            @Loc["AdmSeuil.Subtitle"]
        </div>
    </div>
    <div>
        <button class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold shadow-sm d-flex align-items-center gap-2" @onclick="ChargerAsync" disabled="@_chargement">
            @Loc["Common.Refresh"]
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["AdmSeuil.Loading"]" />
}
else if (_refuse)
{
    <PermissionDenied Message="@_messageRefus" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger border-0 text-danger bg-danger bg-opacity-10 mb-4 rounded-3 p-3 d-flex align-items-center shadow-sm" role="alert">
            <span class="me-2 fs-5">⚠️</span> @_erreur
        </div>
    }

    <div class="cit-card mb-4">
        <h6 class="fw-bold text-dark mb-3">@Loc["AdmSeuil.AddTitle"]</h6>
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="module" class="form-label small fw-semibold text-dark">@Loc["AdmSeuil.ModuleLabel"]</label>
                <input id="module" class="form-control form-control-sm" placeholder="@Loc["AdmSeuil.ModulePlaceholder"]" @bind="_module" />
            </div>
            <div class="col-md-2">
                <label for="type-demande" class="form-label small fw-semibold text-dark">@Loc["AdmSeuil.TypeLabel"]</label>
                <input id="type-demande" class="form-control form-control-sm" placeholder="@Loc["AdmSeuil.TypePlaceholder"]" @bind="_typeDemande" />
            </div>
            <div class="col-md-3">
                <label for="file-bloquante" class="form-label small fw-semibold text-dark">@Loc["AdmSeuil.FileLabel"]</label>
                <select id="file-bloquante" class="form-select form-select-sm" @bind="_fileId">
                    <option value="@Guid.Empty">@Loc["AdmSeuil.ChooseOption"]</option>
                    @foreach (var f in _files)
                    {
                        <option value="@f.Id">@f.Module — @f.Nom</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label for="motif-blocage" class="form-label small fw-semibold text-dark">@Loc["AdmSeuil.MotifLabel"]</label>
                <input id="motif-blocage" class="form-control form-control-sm" placeholder="@Loc["AdmSeuil.MotifPlaceholder"]" @bind="_motif" />
            </div>
            <div class="col-md-1">
                <button class="btn btn-primary btn-sm w-100 fw-semibold" @onclick="DefinirAsync" disabled="@_enregistrement">@Loc["Common.Add"]</button>
            </div>
        </div>
    </div>

    <div class="cit-card">
        <h6 class="fw-bold text-dark mb-3">@Loc["AdmSeuil.DeclaredTitle", _seuils.Count]</h6>

        @if (_seuils.Count == 0)
        {
            <EtatVide Titre="@Loc["AdmSeuil.EmptyTitle"]" Icone="🛑"
                      Message="@Loc["AdmSeuil.EmptyMsg"]" />
        }
        else
        {
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>@Loc["AdmSeuil.ColModule"]</th>
                            <th>@Loc["AdmSeuil.ColType"]</th>
                            <th>@Loc["AdmSeuil.ColFile"]</th>
                            <th>@Loc["AdmSeuil.ColMotif"]</th>
                            <th>@Loc["AdmSeuil.ColState"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _pagination1.Appliquer(_seuils))
                        {
                            <tr>
                                <td class="fw-semibold">@s.Module</td>
                                <td>@(s.TypeDemande ?? Loc["AdmSeuil.TypeAll"].Value)</td>
                                <td>@s.FileNom</td>
                                <td class="text-muted small">@s.Motif</td>
                                <td>
                                    @if (s.EstActif)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success">@Loc["AdmSeuil.StateActive"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary">@Loc["AdmSeuil.StateInactive"]</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-secondary btn-sm"
                                            @onclick="() => BasculerAsync(s.Id, !s.EstActif)" disabled="@_enregistrement">
                                        @(s.EstActif ? Loc["Common.Deactivate"] : Loc["Common.Activate"])
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        }
    </div>
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargement = true;
    private bool _refuse;
    private bool _enregistrement;
    private string _messageRefus = string.Empty;
    private string? _erreur;
    private Guid _appelantId;

    private IReadOnlyList<EtapeBloquanteAnnulationVue> _seuils = [];
    private IReadOnlyList<CIT.Plateforme.Domain.Files.FileDeTraitement> _files = [];

    private string _module = string.Empty;
    private string _typeDemande = string.Empty;
    private Guid _fileId = Guid.Empty;
    private string _motif = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var contexte = await ContexteService.ObtenirContexteAsync();
        _appelantId = contexte.UtilisateurId;
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            // Scope isolé par opération : évite les collisions de DbContext en Blazor Server.
            using var scope = ScopeFactory.CreateScope();
            var commande = scope.ServiceProvider.GetRequiredService<GererEtapesBloquantesAnnulationCommand>();
            var files = scope.ServiceProvider.GetRequiredService<IFileDeTraitementRepository>();

            _seuils = await commande.ListerAsync(_appelantId);
            _files = await files.ListerAsync();
            _refuse = false;
        }
        catch (AccesRefuseException)
        {
            _refuse = true;
            _messageRefus = Loc["AdmSeuil.Refuse"].Value;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task DefinirAsync()
    {
        _erreur = null;
        _enregistrement = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var commande = scope.ServiceProvider.GetRequiredService<GererEtapesBloquantesAnnulationCommand>();
            await commande.DefinirAsync(_appelantId, _module, _typeDemande, _fileId, _motif);

            _module = string.Empty;
            _typeDemande = string.Empty;
            _fileId = Guid.Empty;
            _motif = string.Empty;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _enregistrement = false;
        }
    }

    private async Task BasculerAsync(Guid etapeId, bool actif)
    {
        _erreur = null;
        _enregistrement = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var commande = scope.ServiceProvider.GetRequiredService<GererEtapesBloquantesAnnulationCommand>();
            await commande.BasculerActivationAsync(_appelantId, etapeId, actif);
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _enregistrement = false;
        }
    }
}
