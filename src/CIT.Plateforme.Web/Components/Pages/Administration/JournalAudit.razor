@page "/administration/audit"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Journal d'audit — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>🛡️</span> Journal d'audit de sécurité
        </h2>
        <div class="cit-page-subtitle">Registre d'imputabilité immuable, distinct de l'historique métier — réservé à l'administrateur technique</div>
    </div>
    <div class="mt-3 mt-md-0">
        <button class="btn btn-outline-secondary btn-sm" @onclick="ChargerAsync" disabled="@_chargement">
            🔄 Actualiser
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement du journal d'audit..." />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-3">@_erreur</div>
    }

    @if (_entrees is null || _entrees.Count == 0)
    {
        <EtatVide Titre="Aucun événement audité" Description="Le journal d'audit ne contient encore aucune entrée." Icone="🛡️" />
    }
    else
    {
        <div class="cit-card p-0 overflow-hidden mb-4">
            <div class="p-3 bg-light border-bottom">
                <h6 class="fw-bold text-dark mb-0">Événements audités (@_entrees.Count)</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date et heure (UTC)</th>
                            <th>Auteur</th>
                            <th>Action</th>
                            <th>Élément concerné</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entree in _entrees)
                        {
                            <tr>
                                <td class="small text-muted font-monospace">@entree.HorodatageUtc.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td class="small fw-semibold text-dark">@(entree.AuteurId is null ? "Système CIT" : "Utilisateur")</td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@entree.Action</span></td>
                                <td class="small text-dark">@entree.EntiteType</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private IReadOnlyList<EntreeJournalAuditVue>? _entrees;

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Veuillez vous connecter pour consulter le journal d'audit.";
                return;
            }

            // L'identité provient du contexte authentifié : l'utilisateur n'a aucun
            // identifiant technique à saisir. L'habilitation reste vérifiée côté serveur.
            using var scope = ScopeFactory.CreateScope();
            var consulterAudit = scope.ServiceProvider.GetRequiredService<ConsulterJournalAuditQuery>();
            _entrees = await consulterAudit.ExecuterAsync(contexte.UtilisateurId);
            _nonAutorise = false;
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }
}
