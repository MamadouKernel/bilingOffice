@page "/administration/perimetres-supervision"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Administration
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Périmètres de supervision — CIT</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span>👁️</span> Supervision
        </div>
        <h2 class="cit-page-title fw-bold text-dark mb-1">Périmètres de supervision</h2>
        <div class="cit-page-subtitle text-muted">
            Quelles files chaque superviseur est habilité à voir et à piloter (CLAR-05, SUP-05).
        </div>
    </div>
    <div>
        <button class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold shadow-sm" @onclick="ChargerAsync" disabled="@_chargement">
            🔄 Actualiser
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement des périmètres de supervision..." />
}
else if (_refuse)
{
    <PermissionDenied Message="@_messageRefus" />
}
else if (_vue is not null)
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger border-0 bg-danger bg-opacity-10 mb-4 rounded-3 p-3 shadow-sm" role="alert">
            <span class="me-2">⚠️</span> @_erreur
        </div>
    }

    <div class="cit-card p-4 mb-4 border-0 shadow-sm">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="fs-4">➕</span>
            <h4 class="fw-bold text-dark mb-0 fs-5">Définir ou corriger un périmètre</h4>
        </div>

        <div class="row g-3">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-bold text-dark" for="superviseur">Superviseur</label>
                <select id="superviseur" class="form-select" @bind="_superviseur" @bind:after="PreremplirAsync">
                    <option value="">— choisir —</option>
                    @foreach (var agent in _vue.Agents)
                    {
                        <option value="@agent.Id">@agent.Nom</option>
                    }
                </select>
                <div class="form-text small">
                    Choisir un superviseur déjà administré recharge son périmètre actuel : la
                    définition <strong>remplace</strong> l'ancienne, elle ne s'y ajoute pas.
                </div>
            </div>

            <div class="col-12 col-md-8">
                <span class="form-label small fw-bold text-dark d-block">Files couvertes</span>
                @if (_vue.Files.Count == 0)
                {
                    <div class="text-muted small">Aucune file n'est encore administrée.</div>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var f in _vue.Files)
                        {
                            <div class="col-12 col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="@($"file-{f.Id}")"
                                           checked="@_selection.Contains(f.Id)"
                                           @onchange="e => BasculerFile(f.Id, (bool?)e.Value == true)" />
                                    <label class="form-check-label small" for="@($"file-{f.Id}")">
                                        @f.Nom <span class="text-muted">· @f.Module</span>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="form-text small">
                        Ne cocher <strong>aucune</strong> file donne un périmètre global : le superviseur
                        voit toutes les files. C'est ce que signifie une liste vide dans le domaine —
                        autant que ce soit dit ici plutôt que découvert en production.
                    </div>
                }
            </div>

            <div class="col-12">
                <button class="btn btn-primary px-4 py-2 fw-semibold rounded-3 shadow-sm" @onclick="DefinirAsync">
                    Enregistrer le périmètre
                </button>
            </div>
        </div>
    </div>

    @if (_vue.Perimetres.Count == 0)
    {
        <div class="cit-card p-5 text-center my-4 border-0 shadow-sm">
            <div class="fs-1 mb-3">👁️</div>
            <h4 class="fw-bold text-dark mb-2">Aucun périmètre administré</h4>
            <p class="text-muted mb-0">
                Tant qu'aucun périmètre n'est défini, l'écran de supervision refuse l'accès :
                le socle n'accorde jamais « tout » par défaut.
            </p>
        </div>
    }
    else
    {
        <div class="cit-card border-0 shadow-sm overflow-hidden">
            <div class="p-3 bg-light border-bottom">
                <span class="fw-bold text-dark small">Périmètres administrés (@_vue.Perimetres.Count)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <caption class="visually-hidden">Périmètres de supervision administrés</caption>
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Superviseur</th>
                            <th scope="col">Files couvertes</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _vue.Perimetres)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@p.SuperviseurNom</td>
                                <td>
                                    @if (p.ToutesLesFiles)
                                    {
                                        <span class="badge bg-warning bg-opacity-25 text-dark">Toutes les files</span>
                                    }
                                    else
                                    {
                                        @foreach (var fileId in p.FilesCouvertes)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary me-1">@NomDeLaFile(fileId)</span>
                                        }
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3"
                                            @onclick="() => ModifierAsync(p)">
                                        Modifier
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private PerimetresSupervisionVue? _vue;
    private Guid _appelantId;
    private bool _chargement = true;
    private bool _refuse;
    private string _messageRefus = "Vous devez disposer de la permission d'administration des périmètres de supervision pour accéder à cette interface.";
    private string? _erreur;

    private string _superviseur = string.Empty;
    private readonly HashSet<Guid> _selection = [];

    protected override async Task OnInitializedAsync()
    {
        var contexte = await ContexteService.ObtenirContexteAsync();
        _appelantId = contexte.UtilisateurId;
        _refuse = !contexte.Permissions.Contains(
            CIT.Plateforme.Domain.Securite.Permission.AdministrationPerimetresSupervision);

        if (!_refuse)
        {
            await ChargerAsync();
        }
        else
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            _vue = await scope.ServiceProvider
                .GetRequiredService<ListerPerimetresSupervisionQuery>()
                .ExecuterAsync(_appelantId);
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private string NomDeLaFile(Guid fileId)
    {
        var file = _vue?.Files.FirstOrDefault(f => f.Id == fileId);
        return file is null || file.Value.Id == Guid.Empty ? fileId.ToString() : file.Value.Nom;
    }

    private void BasculerFile(Guid fileId, bool coche)
    {
        if (coche)
        {
            _selection.Add(fileId);
        }
        else
        {
            _selection.Remove(fileId);
        }
    }

    /// <summary>
    /// Recharge les files déjà couvertes quand on choisit un superviseur : sans cela, enregistrer
    /// après avoir seulement ajouté une file effacerait toutes les autres, puisque la définition
    /// remplace le périmètre.
    /// </summary>
    private Task PreremplirAsync()
    {
        _selection.Clear();

        if (Guid.TryParse(_superviseur, out var superviseurId))
        {
            var existant = _vue?.Perimetres.FirstOrDefault(p => p.SuperviseurId == superviseurId);
            if (existant is not null)
            {
                foreach (var fileId in existant.FilesCouvertes)
                {
                    _selection.Add(fileId);
                }
            }
        }

        return Task.CompletedTask;
    }

    private async Task ModifierAsync(PerimetreAdministre perimetre)
    {
        _superviseur = perimetre.SuperviseurId.ToString();
        await PreremplirAsync();
    }

    private async Task DefinirAsync()
    {
        _erreur = null;

        if (!Guid.TryParse(_superviseur, out var superviseurId))
        {
            _erreur = "Choisissez le superviseur dont vous définissez le périmètre.";
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider
                .GetRequiredService<GererPerimetresSupervisionCommand>()
                .DefinirAsync(_appelantId, superviseurId, _selection.ToList());

            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
    }
}
