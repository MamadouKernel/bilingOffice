@page "/administration/perimetres-supervision"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Administration
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>@Loc["AdmPerim.PageTitle"]</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span>👁️</span> @Loc["AdmPerim.Pill"]
        </div>
        <h1 class="cit-page-title fw-bold text-dark mb-1">@Loc["AdmPerim.Title"]</h1>
        <div class="cit-page-subtitle text-muted">
            @Loc["AdmPerim.Subtitle"]
        </div>
    </div>
    <div>
        <button class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold shadow-sm" @onclick="ChargerAsync" disabled="@_chargement">
            @Loc["Common.Refresh"]
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["AdmPerim.Loading"]" />
}
else if (_refuse)
{
    <PermissionDenied Message="@_messageRefus" />
}
else if (_vue is not null)
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger border-0 bg-danger bg-opacity-10 mb-4 rounded-3 p-3 shadow-sm" role="alert">
            <span class="me-2">⚠️</span> @_erreur
        </div>
    }

    <div class="cit-card p-4 mb-4 border-0 shadow-sm">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="fs-4">➕</span>
            <h4 class="fw-bold text-dark mb-0 fs-5">@Loc["AdmPerim.AddTitle"]</h4>
        </div>

        <div class="row g-3">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-bold text-dark" for="superviseur">@Loc["AdmPerim.SuperviseurLabel"]</label>
                <select id="superviseur" class="form-select" @bind="_superviseur" @bind:after="PreremplirAsync">
                    <option value="">@Loc["AdmComp.ChooseOption"]</option>
                    @foreach (var agent in _vue.Agents)
                    {
                        <option value="@agent.Id">@agent.Nom</option>
                    }
                </select>
                <div class="form-text small">
                    @((MarkupString)Loc["AdmPerim.SuperviseurHint"].Value)
                </div>
            </div>

            <div class="col-12 col-md-8">
                <span class="form-label small fw-bold text-dark d-block">@Loc["AdmPerim.FilesLabel"]</span>
                @if (_vue.Files.Count == 0)
                {
                    <div class="text-muted small">@Loc["AdmPerim.NoFiles"]</div>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var f in _vue.Files)
                        {
                            <div class="col-12 col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="@($"file-{f.Id}")"
                                           checked="@_selection.Contains(f.Id)"
                                           @onchange="e => BasculerFile(f.Id, (bool?)e.Value == true)" />
                                    <label class="form-check-label small" for="@($"file-{f.Id}")">
                                        @f.Nom <span class="text-muted">· @f.Module</span>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="form-text small">
                        @((MarkupString)Loc["AdmPerim.FilesHint"].Value)
                    </div>
                }
            </div>

            <div class="col-12">
                <button class="btn btn-primary px-4 py-2 fw-semibold rounded-3 shadow-sm" @onclick="DefinirAsync">
                    @Loc["AdmPerim.Save"]
                </button>
            </div>
        </div>
    </div>

    @if (_vue.Perimetres.Count == 0)
    {
        <div class="cit-card p-5 text-center my-4 border-0 shadow-sm">
            <div class="fs-1 mb-3">👁️</div>
            <h4 class="fw-bold text-dark mb-2">@Loc["AdmPerim.EmptyTitle"]</h4>
            <p class="text-muted mb-0">
                @Loc["AdmPerim.EmptyDesc"]
            </p>
        </div>
    }
    else
    {
        <div class="cit-card border-0 shadow-sm overflow-hidden">
            <div class="p-3 bg-light border-bottom">
                <span class="fw-bold text-dark small">@Loc["AdmPerim.ListTitle", _vue.Perimetres.Count]</span>
            </div>
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <caption class="visually-hidden">@Loc["AdmPerim.TableCaption"]</caption>
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">@Loc["AdmPerim.ColSuperviseur"]</th>
                            <th scope="col">@Loc["AdmPerim.ColFiles"]</th>
                            <th scope="col" class="text-end pe-4">@Loc["AdmPieceC.ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _pagination1.Appliquer(_vue.Perimetres))
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@p.SuperviseurNom</td>
                                <td>
                                    @if (p.ToutesLesFiles)
                                    {
                                        <span class="badge bg-warning bg-opacity-25 text-dark">@Loc["AdmPerim.AllFiles"]</span>
                                    }
                                    else
                                    {
                                        @foreach (var fileId in p.FilesCouvertes)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary me-1">@NomDeLaFile(fileId)</span>
                                        }
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3"
                                            @onclick="() => ModifierAsync(p)">
                                        @Loc["AdmPerim.Edit"]
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private PerimetresSupervisionVue? _vue;
    private Guid _appelantId;
    private bool _chargement = true;
    private bool _refuse;
    private string _messageRefus = string.Empty;
    private string? _erreur;

    private string _superviseur = string.Empty;
    private readonly HashSet<Guid> _selection = [];

    protected override async Task OnInitializedAsync()
    {
        _messageRefus = Loc["AdmPerim.Refuse"].Value;
        var contexte = await ContexteService.ObtenirContexteAsync();
        _appelantId = contexte.UtilisateurId;
        _refuse = !contexte.Permissions.Contains(
            CIT.Plateforme.Domain.Securite.Permission.AdministrationPerimetresSupervision);

        if (!_refuse)
        {
            await ChargerAsync();
        }
        else
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            _vue = await scope.ServiceProvider
                .GetRequiredService<ListerPerimetresSupervisionQuery>()
                .ExecuterAsync(_appelantId);
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private string NomDeLaFile(Guid fileId)
    {
        var file = _vue?.Files.FirstOrDefault(f => f.Id == fileId);
        return file is null || file.Value.Id == Guid.Empty ? fileId.ToString() : file.Value.Nom;
    }

    private void BasculerFile(Guid fileId, bool coche)
    {
        if (coche)
        {
            _selection.Add(fileId);
        }
        else
        {
            _selection.Remove(fileId);
        }
    }

    /// <summary>
    /// Recharge les files déjà couvertes quand on choisit un superviseur : sans cela, enregistrer
    /// après avoir seulement ajouté une file effacerait toutes les autres, puisque la définition
    /// remplace le périmètre.
    /// </summary>
    private Task PreremplirAsync()
    {
        _selection.Clear();

        if (Guid.TryParse(_superviseur, out var superviseurId))
        {
            var existant = _vue?.Perimetres.FirstOrDefault(p => p.SuperviseurId == superviseurId);
            if (existant is not null)
            {
                foreach (var fileId in existant.FilesCouvertes)
                {
                    _selection.Add(fileId);
                }
            }
        }

        return Task.CompletedTask;
    }

    private async Task ModifierAsync(PerimetreAdministre perimetre)
    {
        _superviseur = perimetre.SuperviseurId.ToString();
        await PreremplirAsync();
    }

    private async Task DefinirAsync()
    {
        _erreur = null;

        if (!Guid.TryParse(_superviseur, out var superviseurId))
        {
            _erreur = Loc["AdmPerim.ErrorChoose"].Value;
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider
                .GetRequiredService<GererPerimetresSupervisionCommand>()
                .DefinirAsync(_appelantId, superviseurId, _selection.ToList());

            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }
}
