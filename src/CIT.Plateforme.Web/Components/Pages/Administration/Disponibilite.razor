@page "/administration/disponibilite"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Affectation
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Supervision
@using CIT.Plateforme.Domain.Affectation
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IContexteUtilisateurWeb ContexteService
@inject VueChargeQuery VueCharge
@inject GererDisponibiliteCommand GererDisponibilite

<PageTitle>Disponibilité des agents — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>⏱️</span> Disponibilité des agents (DIS-01, C-07)
        </h2>
        <div class="cit-page-subtitle">Modification administrative et traçabilité des statuts de présence des opérateurs</div>
    </div>
    <div class="mt-3 mt-md-0">
        <button class="btn btn-outline-secondary btn-sm" @onclick="ChargerAsync" disabled="@_chargement">
            🔄 Actualiser
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement des opérateurs..." />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-3">@_erreur</div>
    }

    @if (_message is not null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-3">
            <span class="fs-4">✅</span>
            <div>@_message</div>
        </div>
    }

    @if (_operateurs is null || _operateurs.Count == 0)
    {
        <EtatVide Titre="Aucun opérateur enregistré"
                  Description="Aucun opérateur n'a encore de statut de disponibilité à administrer."
                  Icone="⏱️" />
    }
    else
    {
        <div class="cit-card mb-4" style="max-width: 800px;">
            <h6 class="fw-bold text-dark mb-3">Mise à jour du statut opérationnel</h6>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label small fw-semibold text-dark" for="operateur">Opérateur concerné</label>
                    <select id="operateur" class="form-select form-select-sm" @bind="_operateurSelectionne">
                        @foreach (var operateur in _operateurs)
                        {
                            <option value="@operateur.OperateurId">@NomLisible(operateur)</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label small fw-semibold text-dark" for="statut">Nouveau statut de disponibilité</label>
                    <select id="statut" class="form-select form-select-sm" @bind="_statutSelectionne">
                        @foreach (var statut in Enum.GetValues<StatutDisponibilite>())
                        {
                            <option value="@statut">@statut</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <button class="btn btn-primary btn-sm fw-bold shadow-sm" @onclick="DefinirAsync">
                        💾 Mettre à jour la disponibilité
                    </button>
                </div>
            </div>
        </div>

        <div class="cit-card p-0 overflow-hidden" style="max-width: 800px;">
            <div class="p-3 bg-light border-bottom">
                <h6 class="fw-bold text-dark mb-0">Statuts actuels (@_operateurs.Count)</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Opérateur</th>
                            <th>Disponibilité</th>
                            <th class="text-end">Tickets en cours</th>
                            <th>Dernière activité</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var operateur in _operateurs)
                        {
                            <tr>
                                <td class="text-dark fw-semibold">@NomLisible(operateur)</td>
                                <td>
                                    <span class="badge @(operateur.Disponibilite == StatutDisponibilite.Disponible ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                                        @operateur.Disponibilite
                                    </span>
                                </td>
                                <td class="text-end font-monospace fw-bold text-primary">@operateur.TicketsEnCours</td>
                                <td class="small text-muted">@operateur.DerniereActiviteUtc.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private string? _message;

    private Guid _appelantId;
    private IReadOnlyList<VueOperateur>? _operateurs;
    private Guid _operateurSelectionne;
    private StatutDisponibilite _statutSelectionne = StatutDisponibilite.Disponible;

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    /// <summary>Un opérateur est désigné par son nom : l'identifiant technique reste interne et
    /// n'est jamais saisi à la main (anti-usurpation, ergonomie).</summary>
    private static string NomLisible(VueOperateur operateur) =>
        string.IsNullOrWhiteSpace(operateur.NomOperateur) ? "Opérateur non identifié" : operateur.NomOperateur;

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Veuillez vous connecter pour administrer les disponibilités.";
                return;
            }

            // L'appelant est l'utilisateur authentifié : son habilitation est vérifiée côté serveur
            // par GererDisponibiliteCommand, aucun identifiant n'est accepté depuis le navigateur.
            _appelantId = contexte.UtilisateurId;
            _operateurs = await VueCharge.ExecuterAsync(_appelantId);

            if (_operateurs.Count > 0 && !_operateurs.Any(o => o.OperateurId == _operateurSelectionne))
            {
                _operateurSelectionne = _operateurs[0].OperateurId;
            }
            _nonAutorise = false;
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task DefinirAsync()
    {
        _erreur = null;
        _message = null;

        if (_operateurSelectionne == Guid.Empty)
        {
            _erreur = "Veuillez sélectionner un opérateur.";
            return;
        }

        try
        {
            await GererDisponibilite.DefinirAsync(_appelantId, _operateurSelectionne, _statutSelectionne);
            _message = $"Disponibilité mise à jour : {_statutSelectionne} (DIS-03 : tracée).";
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _erreur = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
    }
}
