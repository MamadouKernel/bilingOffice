@page "/administration/disponibilite"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Affectation
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Supervision
@using CIT.Plateforme.Domain.Affectation
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>@Loc["AdmDispo.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>⏱️</span> @Loc["AdmDispo.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["AdmDispo.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0">
        <button class="btn btn-outline-secondary btn-sm" @onclick="ChargerAsync" disabled="@_chargement">
            @Loc["Common.Refresh"]
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["AdmDispo.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-3" role="alert">@_erreur</div>
    }

    @if (_message is not null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-3" role="status">
            <span class="fs-4">✅</span>
            <div>@_message</div>
        </div>
    }

    @if (_operateurs is null || _operateurs.Count == 0)
    {
        <EtatVide Titre="@Loc["AdmDispo.EmptyTitle"]"
                  Description="@Loc["AdmDispo.EmptyDesc"]"
                  Icone="⏱️" />
    }
    else
    {
        <div class="cit-card mb-4" style="max-width: 800px;">
            <h6 class="fw-bold text-dark mb-3">@Loc["AdmDispo.UpdateTitle"]</h6>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label small fw-semibold text-dark" for="operateur">@Loc["AdmDispo.OperatorLabel"]</label>
                    <select id="operateur" class="form-select form-select-sm" @bind="_operateurSelectionne">
                        @foreach (var operateur in _operateurs)
                        {
                            <option value="@operateur.OperateurId">@NomLisible(operateur)</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label small fw-semibold text-dark" for="statut">@Loc["AdmDispo.StatusLabel"]</label>
                    <select id="statut" class="form-select form-select-sm" @bind="_statutSelectionne">
                        @foreach (var statut in Enum.GetValues<StatutDisponibilite>())
                        {
                            <option value="@statut">@LibelleStatut(statut)</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <button class="btn btn-primary btn-sm fw-bold shadow-sm" @onclick="DefinirAsync">
                        @Loc["AdmDispo.UpdateBtn"]
                    </button>
                </div>
            </div>
        </div>

        <div class="cit-card p-0 overflow-hidden" style="max-width: 800px;">
            <div class="p-3 bg-light border-bottom">
                <h6 class="fw-bold text-dark mb-0">@Loc["AdmDispo.CurrentTitle", _operateurs.Count]</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["AdmDispo.ColOperator"]</th>
                            <th>@Loc["AdmDispo.ColAvailability"]</th>
                            <th class="text-end">@Loc["AdmDispo.ColTickets"]</th>
                            <th>@Loc["AdmDispo.ColLastActivity"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var operateur in _pagination1.Appliquer(_operateurs))
                        {
                            <tr>
                                <td class="text-dark fw-semibold">@NomLisible(operateur)</td>
                                <td>
                                    <span class="badge @(operateur.Disponibilite == StatutDisponibilite.Disponible ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                                        @LibelleStatut(operateur.Disponibilite)
                                    </span>
                                </td>
                                <td class="text-end font-monospace fw-bold text-primary">@operateur.TicketsEnCours</td>
                                <td class="small text-muted">@operateur.DerniereActiviteUtc.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private string? _message;

    private Guid _appelantId;
    private IReadOnlyList<VueOperateur>? _operateurs;
    private Guid _operateurSelectionne;
    private StatutDisponibilite _statutSelectionne = StatutDisponibilite.Disponible;

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    /// <summary>Un opérateur est désigné par son nom : l'identifiant technique reste interne et
    /// n'est jamais saisi à la main (anti-usurpation, ergonomie).</summary>
    private string NomLisible(VueOperateur operateur) =>
        string.IsNullOrWhiteSpace(operateur.NomOperateur) ? Loc["AdmDispo.UnknownOperator"].Value : operateur.NomOperateur;

    /// <summary>Les statuts de disponibilité sont traduits pour l'administrateur fonctionnel.</summary>
    private string LibelleStatut(StatutDisponibilite statut) => statut switch
    {
        StatutDisponibilite.Disponible => Loc["AdmDispo.StatDisponible"].Value,
        StatutDisponibilite.Indisponible => Loc["AdmDispo.StatIndisponible"].Value,
        StatutDisponibilite.Absent => Loc["AdmDispo.StatAbsent"].Value,
        _ => statut.ToString()
    };

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["AdmDispo.LoginRequired"].Value;
                return;
            }

            // L'appelant est l'utilisateur authentifié : son habilitation est vérifiée côté serveur
            // par GererDisponibiliteCommand, aucun identifiant n'est accepté depuis le navigateur.
            _appelantId = contexte.UtilisateurId;
            using var scope = ScopeFactory.CreateScope();
            var vueCharge = scope.ServiceProvider.GetRequiredService<VueChargeQuery>();
            _operateurs = await vueCharge.ExecuterAsync(_appelantId);

            if (_operateurs.Count > 0 && !_operateurs.Any(o => o.OperateurId == _operateurSelectionne))
            {
                _operateurSelectionne = _operateurs[0].OperateurId;
            }
            _nonAutorise = false;
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task DefinirAsync()
    {
        _erreur = null;
        _message = null;

        if (_operateurSelectionne == Guid.Empty)
        {
            _erreur = Loc["AdmDispo.SelectOperator"].Value;
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var gererDisponibilite = scope.ServiceProvider.GetRequiredService<GererDisponibiliteCommand>();
            await gererDisponibilite.DefinirAsync(_appelantId, _operateurSelectionne, _statutSelectionne);
            _message = string.Format(Loc["AdmDispo.Updated"].Value, LibelleStatut(_statutSelectionne));
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _erreur = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }
}
