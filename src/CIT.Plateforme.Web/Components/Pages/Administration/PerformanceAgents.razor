@page "/administration/performance-agents"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Supervision
@using CIT.Plateforme.Domain.Affectation
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject RapportPerformanceAgentsQuery Rapport
@inject RapportActiviteOperateurQuery RapportActivite
@inject RapportDetailTicketsOperateurQuery RapportDetail

<PageTitle>@Loc["Perf.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title"><span>📊</span> @Loc["Perf.Title"]</h1>
        <div class="cit-page-subtitle">@Loc["Perf.Subtitle"]</div>
    </div>
</div>

<div class="cit-card mb-4 p-3">
    <div class="row g-2 align-items-end">
        <div class="col-6 col-md-3">
            <label class="form-label small fw-bold text-dark" for="perf-debut">@Loc["Perf.Debut"]</label>
            <input id="perf-debut" type="date" class="form-control form-control-sm" @bind="_debut" @bind:format="yyyy-MM-dd" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small fw-bold text-dark" for="perf-fin">@Loc["Perf.Fin"]</label>
            <input id="perf-fin" type="date" class="form-control form-control-sm" @bind="_fin" @bind:format="yyyy-MM-dd" />
        </div>
        <div class="col-12 col-md-3 d-grid">
            <button type="button" class="btn btn-sm btn-primary" @onclick="ChargerAsync" disabled="@_chargement">
                @Loc["Perf.Appliquer"]
            </button>
        </div>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["Perf.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-3" role="alert">@_erreur</div>
    }

    @if (_lignes is not null)
    {
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="cit-stat-card">
                    <div class="cit-stat-valeur">@_lignes.Count</div>
                    <div class="cit-stat-libelle">@Loc["Perf.KpiAgents"]</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="cit-stat-card">
                    <div class="cit-stat-valeur">@_lignes.Sum(l => l.NombreIndisponibilites)</div>
                    <div class="cit-stat-libelle">@Loc["Perf.KpiTotalIndispos"]</div>
                </div>
            </div>
        </div>

        @if (_lignes.Count == 0)
        {
            <div class="cit-card p-5 text-center text-muted">
                <div class="fs-1 mb-2" aria-hidden="true">🗂️</div>
                <div class="fw-semibold text-dark">@Loc["Perf.VideTitre"]</div>
                <div class="small">@Loc["Perf.VideDesc"]</div>
            </div>
        }
        else
        {
            <div class="cit-card p-0 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Loc["Perf.ColAgent"]</th>
                                <th>@Loc["Perf.ColStatut"]</th>
                                <th class="text-end">@Loc["Perf.ColNbIndispos"]</th>
                                <th class="text-end">@Loc["Perf.ColTempsIndispo"]</th>
                                <th class="text-end">@Loc["Perf.ColTempsAbsent"]</th>
                                <th class="text-end">@Loc["Perf.ColPctDispo"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ligne in _lignes)
                            {
                                <tr>
                                    <td class="text-dark fw-semibold">@(string.IsNullOrWhiteSpace(ligne.Nom) ? Loc["Perf.AgentNonId"].Value : ligne.Nom)</td>
                                    <td>
                                        <span class="badge @(ligne.StatutActuel == StatutDisponibilite.Disponible ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                                            @ligne.StatutActuel
                                        </span>
                                    </td>
                                    <td class="text-end font-monospace @(ligne.NombreIndisponibilites > 0 ? "text-warning fw-bold" : "text-muted")">@ligne.NombreIndisponibilites</td>
                                    <td class="text-end small text-muted font-monospace">@FormaterDuree(ligne.TempsIndisponible)</td>
                                    <td class="text-end small text-muted font-monospace">@FormaterDuree(ligne.TempsAbsent)</td>
                                    <td class="text-end font-monospace fw-bold @(ligne.PourcentageDisponible >= 80 ? "text-success" : "text-danger")">@ligne.PourcentageDisponible.ToString("0.0")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (_activite is not null)
        {
            <h2 class="h5 mt-4 mb-3"><span>🎯</span> @Loc["Perf.ActiviteTitle"]</h2>
            <div class="cit-page-subtitle small mb-2">@Loc["Perf.ActiviteSubtitle"]</div>
            @if (_activite.Count == 0)
            {
                <div class="cit-card p-4 text-center text-muted small">@Loc["Perf.VideDesc"]</div>
            }
            else
            {
                <div class="cit-card p-0 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Loc["Perf.ColAgent"]</th>
                                    <th class="text-end">@Loc["Perf.ColPrisEnCharge"]</th>
                                    <th class="text-end">@Loc["Perf.ColTraites"]</th>
                                    <th class="text-end">@Loc["Perf.ColDelaiPEC"]</th>
                                    <th class="text-end">@Loc["Perf.ColDelaiTrait"]</th>
                                    <th class="text-end">@Loc["Perf.ColDerniereActivite"]</th>
                                    <th class="text-end"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in _activite)
                                {
                                    <tr>
                                        <td class="text-dark fw-semibold">@(string.IsNullOrWhiteSpace(a.Nom) ? Loc["Perf.AgentNonId"].Value : a.Nom)</td>
                                        <td class="text-end font-monospace">@a.TicketsPrisEnCharge</td>
                                        <td class="text-end font-monospace fw-bold">@a.TicketsTraites</td>
                                        <td class="text-end small text-muted font-monospace">@FormaterDuree(a.DelaiMoyenPriseEnCharge)</td>
                                        <td class="text-end small text-muted font-monospace">@FormaterDuree(a.DelaiMoyenTraitement)</td>
                                        <td class="text-end small text-muted font-monospace">@(a.DerniereActiviteUtc?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => BasculerDetailAsync(a.OperateurId)">
                                                @(_detailOperateur == a.OperateurId ? Loc["Perf.Masquer"] : Loc["Perf.Voir"])
                                            </button>
                                        </td>
                                    </tr>
                                    @if (_detailOperateur == a.OperateurId)
                                    {
                                        <tr>
                                            <td colspan="7" class="bg-light">
                                                <div class="fw-semibold small mb-2">@Loc["Perf.DetailTitle"] — @a.Nom</div>
                                                @if (_detailEnCours)
                                                {
                                                    <div class="small text-muted py-2">@Loc["Perf.Loading"]</div>
                                                }
                                                else if (_detailLignes is null || _detailLignes.Count == 0)
                                                {
                                                    <div class="small text-muted py-2">@Loc["Perf.DetailVide"]</div>
                                                }
                                                else
                                                {
                                                    <div class="table-responsive">
                                                        <table class="table table-sm align-middle mb-0 bg-white">
                                                            <thead><tr>
                                                                <th>@Loc["Perf.DetTicket"]</th>
                                                                <th>@Loc["Perf.DetModule"]</th>
                                                                <th>@Loc["Perf.DetObjet"]</th>
                                                                <th>@Loc["Perf.DetStatut"]</th>
                                                                <th class="text-end">@Loc["Perf.DetPriseEnCharge"]</th>
                                                                <th class="text-end">@Loc["Perf.DetSortie"]</th>
                                                                <th class="text-end">@Loc["Perf.DetAttente"]</th>
                                                                <th class="text-end">@Loc["Perf.DetTraitement"]</th>
                                                            </tr></thead>
                                                            <tbody>
                                                                @foreach (var d in _detailLignes)
                                                                {
                                                                    <tr>
                                                                        <td class="font-monospace"><a href="@($"/tickets/{d.TicketId}")">@d.NumeroTicket</a></td>
                                                                        <td class="small">@d.Module</td>
                                                                        <td class="small">@(d.Objet ?? "—")</td>
                                                                        <td class="small">@d.Statut</td>
                                                                        <td class="text-end small font-monospace">@(d.DatePriseEnChargeUtc?.ToString("dd/MM HH:mm") ?? "—")</td>
                                                                        <td class="text-end small font-monospace">@(d.DateSortieUtc?.ToString("dd/MM HH:mm") ?? "—")</td>
                                                                        <td class="text-end small font-monospace">@FormaterDuree(d.TempsAttente)</td>
                                                                        <td class="text-end small font-monospace fw-semibold">@FormaterDuree(d.TempsTraitement)</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    }
}

@code {
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private IReadOnlyList<LignePerformanceAgent>? _lignes;
    private IReadOnlyList<LigneActiviteOperateurVue>? _activite;

    // Détail « tickets traités » d'un agent (dépliable à la demande).
    private Guid _superviseurId;
    private DateTime _debutUtcCourant;
    private DateTime _finUtcCourant;
    private Guid? _detailOperateur;
    private IReadOnlyList<LigneTicketTraiteVue>? _detailLignes;
    private bool _detailEnCours;

    // Période par défaut : les 30 derniers jours.
    private DateTime _debut = DateTime.UtcNow.Date.AddDays(-30);
    private DateTime _fin = DateTime.UtcNow.Date;

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["Perf.LoginRequis"].Value;
                return;
            }

            // Fin incluse : on borne au dernier instant de la journée choisie.
            var debutUtc = DateTime.SpecifyKind(_debut.Date, DateTimeKind.Utc);
            var finUtc = DateTime.SpecifyKind(_fin.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc);

            _lignes = await Rapport.ExecuterAsync(contexte.UtilisateurId, debutUtc, finUtc);
            _activite = await RapportActivite.ExecuterAsync(contexte.UtilisateurId, debutUtc, finUtc);
            // Mémorisé pour le chargement à la demande du détail par agent (même périmètre/période).
            _superviseurId = contexte.UtilisateurId;
            _debutUtcCourant = debutUtc;
            _finUtcCourant = finUtc;
            _detailOperateur = null;
            _detailLignes = null;
            _nonAutorise = false;
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = MessagesUtilisateur.Texte(ex);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task BasculerDetailAsync(Guid operateurId)
    {
        if (_detailOperateur == operateurId)
        {
            _detailOperateur = null;
            _detailLignes = null;
            return;
        }

        _detailOperateur = operateurId;
        _detailLignes = null;
        _detailEnCours = true;
        try
        {
            _detailLignes = await RapportDetail.ExecuterAsync(_superviseurId, operateurId, _debutUtcCourant, _finUtcCourant);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _detailEnCours = false;
        }
    }

    private static string FormaterDuree(TimeSpan duree)
    {
        if (duree <= TimeSpan.Zero) return "—";
        return duree.TotalDays >= 1
            ? $"{(int)duree.TotalDays}j {duree.Hours}h"
            : $"{(int)duree.TotalHours}h {duree.Minutes}min";
    }
}
