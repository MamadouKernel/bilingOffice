    private IEnumerable<GroupePermissions> CategoriesFiltrees
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_filtreModalPermission))
                return TousLesGroupes;

            var q = _filtreModalPermission.Trim();
            return TousLesGroupes
                .Select(g => new GroupePermissions(
                    g.Nom,
                    g.Icone,
                    g.Permissions.Where(p => p.Libelle.Contains(q, StringComparison.OrdinalIgnoreCase)
                                          || p.Code.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList()))
                .Where(g => g.Permissions.Count > 0);
        }
    }

    private static IEnumerable<ResumeCategorie> ObtenirCategoriesAgent(IReadOnlyList<string> permissionsAgent)
    {
        var set = new HashSet<string>(permissionsAgent, StringComparer.Ordinal);
        foreach (var groupe in TousLesGroupes)
        {
            var nb = groupe.Permissions.Count(p => set.Contains(p.Code));
            if (nb > 0)
            {
                yield return new ResumeCategorie(groupe.Nom, groupe.Icone, nb);
            }
        }
    }
