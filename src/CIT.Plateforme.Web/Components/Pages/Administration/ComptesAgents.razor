@page "/administration/comptes-agents"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Comptes
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Comptes agents — CIT</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span>🛡️</span> Administration des Rôles & Comptes Internes • SEC-11
        </div>
        <h2 class="cit-page-title fw-bold text-dark mb-1">
            Gestion des Comptes Agents
        </h2>
        <div class="cit-page-subtitle text-muted">
            Création des collaborateurs internes CIT, attribution des permissions d'exploitation et gestion des accès.
        </div>
    </div>
    <div>
        <button class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold shadow-sm d-flex align-items-center gap-2" @onclick="ChargerAsync" disabled="@_chargement">
            <span>🔄</span> Actualiser
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement des comptes agents et vérification des habilitations..." />
}
else if (_refuse)
{
    <PermissionDenied Message="@_messageRefus" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger border-0 text-danger bg-danger bg-opacity-10 mb-4 rounded-3 p-3 d-flex align-items-center shadow-sm">
            <span class="me-2 fs-5">⚠️</span> @_erreur
        </div>
    }
    @if (_succes is not null)
    {
        <div class="alert alert-success border-0 text-success bg-success bg-opacity-10 mb-4 rounded-3 p-3 d-flex align-items-center shadow-sm">
            <span class="me-2 fs-5">✅</span> @_succes
        </div>
    }

    <!-- 1. Formulaire de Création d'Agent -->
    <div class="cit-card p-4 mb-4 border-0 shadow-sm" style="border-radius: 1.25rem; background-color: var(--surface);">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="fs-4">➕</span>
            <h4 class="fw-bold text-dark mb-0 fs-5">Créer un nouveau compte agent CIT</h4>
        </div>
        
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-bold text-dark" for="email">Adresse e-mail professionnelle</label>
                <input id="email" type="email" class="form-control" placeholder="agent@cotedivoireterminal.com" @bind="_email" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-dark" for="nom">Nom complet affiché</label>
                <input id="nom" type="text" class="form-control" placeholder="Prénom NOM" @bind="_nomAffiche" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-dark" for="mdp">Mot de passe initial</label>
                <ChampMotDePasse>
                    <input id="mdp" type="password" class="form-control" placeholder="Minimum 10 caractères" @bind="_motDePasse" />
                </ChampMotDePasse>
            </div>
            <div class="col-12 col-md-2">
                <button class="btn btn-primary w-100 py-2 fw-semibold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2" @onclick="CreerAsync">
                    <span>✨</span> Créer
                </button>
            </div>
        </div>
        <div class="form-text text-muted mt-2 small">
            🔒 Le mot de passe initial doit être communiqué de manière sécurisée à l'agent.
        </div>
    </div>

    <!-- 2. Liste des Comptes Agents Existants -->
    @if (_comptes is null || _comptes.Count == 0)
    {
        <div class="cit-card p-5 text-center my-4 border-0 shadow-sm" style="border-radius: 1rem; background-color: var(--surface);">
            <div class="fs-1 mb-3">👥</div>
            <h4 class="fw-bold text-dark mb-2">Aucun compte agent enregistré</h4>
            <p class="text-muted mb-0">Utilisez le formulaire ci-dessus pour créer le premier collaborateur interne.</p>
        </div>
    }
    else
    {
        <div class="cit-card border-0 shadow-sm overflow-hidden" style="border-radius: 1.25rem; background-color: var(--surface);">
            <div class="p-3 bg-light border-bottom d-flex align-items-center justify-content-between">
                <span class="fw-bold text-dark small">Collaborateurs Internes (@_comptes.Count)</span>
                <span class="badge bg-secondary-subtle text-dark">Supervision CIT</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Collaborateur</th>
                            <th>État</th>
                            <th>Rôles & Permissions Accordés</th>
                            <th class="text-end pe-4">Actions d'Administration</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var compte in _comptes)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@compte.NomAffiche</div>
                                    <div class="small text-muted font-monospace">@compte.Email</div>
                                </td>
                                <td>
                                    <span class="badge @(compte.EstActif ? "bg-success bg-opacity-10 text-success" : "bg-danger bg-opacity-10 text-danger") px-3 py-1 rounded-pill">
                                        @(compte.EstActif ? "Actif" : "Désactivé")
                                    </span>
                                </td>
                                <td>
                                    @if (compte.Permissions.Count == 0)
                                    {
                                        <span class="small text-muted fst-italic">Aucune permission attribuée</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-wrap gap-1" style="max-width: 500px;">
                                            @foreach (var permission in compte.Permissions)
                                            {
                                                <span class="badge bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill small">
                                                    @permission
                                                    <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.55rem;"
                                                            title="Retirer cette permission"
                                                            @onclick="() => RetirerAsync(compte.Id, permission)"></button>
                                                </span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2 align-items-center">
                                        <select class="form-select form-select-sm" style="width: 14rem;"
                                                @onchange="e => AttribuerAsync(compte.Id, e.Value?.ToString())">
                                            <option value="">+ Attribuer une permission…</option>
                                            @foreach (var permission in _permissionsDisponibles)
                                            {
                                                <option value="@permission">@permission</option>
                                            }
                                        </select>
                                        @if (compte.EstActif)
                                        {
                                            <button class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                    @onclick="() => BasculerActivationAsync(compte.Id, false)">
                                                Désactiver
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-success btn-sm rounded-pill px-3"
                                                    @onclick="() => BasculerActivationAsync(compte.Id, true)">
                                                Réactiver
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private IReadOnlyList<CompteAgentVue>? _comptes;
    private Guid _appelantId;
    private bool _chargement = true;
    private bool _refuse;
    private string _messageRefus = "Vous devez disposer de la permission d'administration des comptes (administration.comptes) pour accéder à cette interface.";
    private string? _erreur;
    private string? _succes;

    private string _email = string.Empty;
    private string _nomAffiche = string.Empty;
    private string _motDePasse = string.Empty;

    private static readonly IReadOnlyList<string> _permissionsDisponibles =
        Permission.Tous.OrderBy(p => p, StringComparer.Ordinal).ToList();

    protected override async Task OnInitializedAsync()
    {
        var contexte = await ContexteService.ObtenirContexteAsync();
        _appelantId = contexte.UtilisateurId;
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var listerComptes = scope.ServiceProvider.GetRequiredService<ListerComptesAgentsQuery>();
            _comptes = await listerComptes.ExecuterAsync(_appelantId);
            _refuse = false;
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ExecuterAsync(Func<IServiceProvider, Task> action, string messageSucces)
    {
        _erreur = null;
        _succes = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await action(scope.ServiceProvider);
            _succes = messageSucces;
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
    }

    private Task CreerAsync() => ExecuterAsync(async sp =>
    {
        var creerCompte = sp.GetRequiredService<CreerCompteAgentCommand>();
        var resultat = await creerCompte.ExecuterAsync(_appelantId, _email, _nomAffiche, _motDePasse);
        if (!resultat.Succes)
        {
            throw new InvalidOperationException(string.Join(" ", resultat.Erreurs));
        }

        _email = string.Empty;
        _nomAffiche = string.Empty;
        _motDePasse = string.Empty;
    }, "Compte agent créé avec succès.");

    private Task BasculerActivationAsync(Guid cibleId, bool actif) => ExecuterAsync(
        sp =>
        {
            var definirActivation = sp.GetRequiredService<DefinirActivationCompteCommand>();
            return definirActivation.ExecuterAsync(_appelantId, cibleId, actif);
        },
        actif ? "Compte réactivé avec succès." : "Compte désactivé — son historique et ses actions passées sont conservés.");

    private Task AttribuerAsync(Guid cibleId, string? permissionCode) =>
        string.IsNullOrWhiteSpace(permissionCode)
            ? Task.CompletedTask
            : ExecuterAsync(
                sp =>
                {
                    var gererHabilitation = sp.GetRequiredService<GererHabilitationAgentCommand>();
                    return gererHabilitation.AttribuerAsync(_appelantId, cibleId, permissionCode);
                },
                "Rôle / Permission attribué avec succès.");

    private Task RetirerAsync(Guid cibleId, string permissionCode) => ExecuterAsync(
        sp =>
        {
            var gererHabilitation = sp.GetRequiredService<GererHabilitationAgentCommand>();
            return gererHabilitation.RetirerAsync(_appelantId, cibleId, permissionCode);
        },
        "Rôle / Permission retiré avec succès.");
}
