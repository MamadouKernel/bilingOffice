@page "/administration/assistant"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Administration
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["AssistAdm.Titre"]</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="cit-page-title fw-bold text-dark mb-1">🤖 @Loc["AssistAdm.Titre"]</h1>
        <div class="cit-page-subtitle text-muted">
            @Loc["AssistAdm.SousTitre"]
        </div>
    </div>
    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ChargerAsync" disabled="@_chargement">@Loc["AssistAdm.Actualiser"]</button>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["AssistAdm.Chargement"]" />
}
else if (_refuse)
{
    <PermissionDenied Message="@_messageRefus" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-3" role="alert">@_erreur</div>
    }

    <div class="cit-card p-4 mb-4">
        <h4 class="fw-bold text-dark mb-3">@Loc["AssistAdm.Ajouter"]</h4>
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-bold" for="mots-cles">@Loc["AssistAdm.MotsCles"]</label>
                <input id="mots-cles" class="form-control" @bind="_motsCles" />
            </div>
            <div class="col-12 col-md-5">
                <label class="form-label small fw-bold" for="reponse">@Loc["AssistAdm.ReponseFr"]</label>
                <textarea id="reponse" class="form-control" rows="2" @bind="_reponse"></textarea>
            </div>
            <div class="col-12 col-md-8">
                <label class="form-label small fw-bold" for="reponse-en">@Loc["AssistAdm.ReponseEn"]</label>
                <textarea id="reponse-en" class="form-control" rows="2" @bind="_reponseEn"></textarea>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label small fw-bold" for="ordre">@Loc["AssistAdm.Ordre"]</label>
                <input id="ordre" type="number" class="form-control" @bind="_ordre" />
            </div>
            <div class="col-12 col-md-1 d-grid">
                <button type="button" class="btn btn-primary" @onclick="AjouterAsync">@Loc["AssistAdm.BoutonAjouter"]</button>
            </div>
        </div>
    </div>

    @if (_sujets is null || _sujets.Count == 0)
    {
        <div class="cit-card p-5 text-center text-muted">
            <div class="fs-1 mb-2">🤖</div>
            <div class="fw-semibold text-dark">@Loc["AssistAdm.Aucun"]</div>
        </div>
    }
    else
    {
        <div class="cit-card p-0 overflow-hidden">
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["AssistAdm.Ordre"]</th>
                            <th>@Loc["AssistAdm.ColMotsCles"]</th>
                            <th>@Loc["AssistAdm.ColReponse"]</th>
                            <th>@Loc["AssistAdm.ColEtat"]</th>
                            <th class="text-end">@Loc["AssistAdm.ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sujet in _pagination1.Appliquer(_sujets))
                        {
                            <tr>
                                <td class="font-monospace">#@sujet.Ordre</td>
                                <td>@sujet.MotsCles</td>
                                <td class="small">@sujet.Reponse</td>
                                <td>
                                    <span class="badge @(sujet.EstActif ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                        @(sujet.EstActif ? Loc["AssistAdm.Actif"] : Loc["AssistAdm.Desactive"])
                                    </span>
                                </td>
                                <td class="text-end">
                                    @if (sujet.EstActif)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => BasculerAsync(sujet.Id, false)">@Loc["AssistAdm.Desactiver"]</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => BasculerAsync(sujet.Id, true)">@Loc["AssistAdm.Reactiver"]</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private IReadOnlyList<SujetAssistantVue>? _sujets;
    private Guid _appelantId;
    private bool _chargement = true;
    private bool _refuse;
    private string _messageRefus = SharedResourcesLocalizer.Get("AssistAdm.Refus");
    private string? _erreur;

    private string _motsCles = string.Empty;
    private string _reponse = string.Empty;
    private string _reponseEn = string.Empty;
    private int _ordre = 1;

    protected override async Task OnInitializedAsync()
    {
        var contexte = await ContexteService.ObtenirContexteAsync();
        _appelantId = contexte.UtilisateurId;
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var lister = scope.ServiceProvider.GetRequiredService<ListerSujetsAssistantQuery>();
            _sujets = await lister.ExecuterAsync(_appelantId);
            _refuse = false;
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = MessagesUtilisateur.Texte(ex);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ExecuterAsync(Func<IServiceProvider, Task> action)
    {
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await action(scope.ServiceProvider);
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = MessagesUtilisateur.Texte(ex);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private Task AjouterAsync() => ExecuterAsync(async sp =>
    {
        var gerer = sp.GetRequiredService<GererSujetsAssistantCommand>();
        await gerer.DefinirAsync(_appelantId, _motsCles, _reponse, _ordre,
            reponseEn: string.IsNullOrWhiteSpace(_reponseEn) ? null : _reponseEn);
        _motsCles = string.Empty;
        _reponse = string.Empty;
        _reponseEn = string.Empty;
        _ordre = (_sujets?.Count ?? 0) + 1;
    });

    private Task BasculerAsync(Guid sujetId, bool actif) => ExecuterAsync(sp =>
    {
        var gerer = sp.GetRequiredService<GererSujetsAssistantCommand>();
        return gerer.DefinirActivationAsync(_appelantId, sujetId, actif);
    });
}
