@page "/administration/assistant"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Administration
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Assistant virtuel — Base de connaissances</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="cit-page-title fw-bold text-dark mb-1">🤖 Assistant virtuel — Base de connaissances</h1>
        <div class="cit-page-subtitle text-muted">
            Sujets, mots-clés et réponses de premier niveau (IA-04) — administrable sans développement.
        </div>
    </div>
    <button class="btn btn-outline-primary btn-sm" @onclick="ChargerAsync" disabled="@_chargement">Actualiser</button>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement…" />
}
else if (_refuse)
{
    <PermissionDenied Message="@_messageRefus" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-3" role="alert">@_erreur</div>
    }

    <div class="cit-card p-4 mb-4">
        <h4 class="fw-bold text-dark mb-3">Ajouter un sujet</h4>
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-bold" for="mots-cles">Mots-clés (séparés par des virgules)</label>
                <input id="mots-cles" class="form-control" @bind="_motsCles" />
            </div>
            <div class="col-12 col-md-5">
                <label class="form-label small fw-bold" for="reponse">Réponse</label>
                <textarea id="reponse" class="form-control" rows="2" @bind="_reponse"></textarea>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label small fw-bold" for="ordre">Ordre</label>
                <input id="ordre" type="number" class="form-control" @bind="_ordre" />
            </div>
            <div class="col-12 col-md-1 d-grid">
                <button class="btn btn-primary" @onclick="AjouterAsync">Ajouter</button>
            </div>
        </div>
    </div>

    @if (_sujets is null || _sujets.Count == 0)
    {
        <div class="cit-card p-5 text-center text-muted">
            <div class="fs-1 mb-2">🤖</div>
            <div class="fw-semibold text-dark">Aucun sujet enregistré</div>
        </div>
    }
    else
    {
        <div class="cit-card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ordre</th>
                            <th>Mots-clés</th>
                            <th>Réponse</th>
                            <th>État</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sujet in _sujets)
                        {
                            <tr>
                                <td class="font-monospace">#@sujet.Ordre</td>
                                <td>@sujet.MotsCles</td>
                                <td class="small">@sujet.Reponse</td>
                                <td>
                                    <span class="badge @(sujet.EstActif ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                        @(sujet.EstActif ? "Actif" : "Désactivé")
                                    </span>
                                </td>
                                <td class="text-end">
                                    @if (sujet.EstActif)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => BasculerAsync(sujet.Id, false)">Désactiver</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => BasculerAsync(sujet.Id, true)">Réactiver</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private IReadOnlyList<SujetAssistantVue>? _sujets;
    private Guid _appelantId;
    private bool _chargement = true;
    private bool _refuse;
    private string _messageRefus = "Vous n'avez pas l'habilitation requise pour accéder à cette ressource.";
    private string? _erreur;

    private string _motsCles = string.Empty;
    private string _reponse = string.Empty;
    private int _ordre = 1;

    protected override async Task OnInitializedAsync()
    {
        var contexte = await ContexteService.ObtenirContexteAsync();
        _appelantId = contexte.UtilisateurId;
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var lister = scope.ServiceProvider.GetRequiredService<ListerSujetsAssistantQuery>();
            _sujets = await lister.ExecuterAsync(_appelantId);
            _refuse = false;
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ExecuterAsync(Func<IServiceProvider, Task> action)
    {
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await action(scope.ServiceProvider);
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private Task AjouterAsync() => ExecuterAsync(async sp =>
    {
        var gerer = sp.GetRequiredService<GererSujetsAssistantCommand>();
        await gerer.DefinirAsync(_appelantId, _motsCles, _reponse, _ordre);
        _motsCles = string.Empty;
        _reponse = string.Empty;
        _ordre = (_sujets?.Count ?? 0) + 1;
    });

    private Task BasculerAsync(Guid sujetId, bool actif) => ExecuterAsync(sp =>
    {
        var gerer = sp.GetRequiredService<GererSujetsAssistantCommand>();
        return gerer.DefinirActivationAsync(_appelantId, sujetId, actif);
    });
}
