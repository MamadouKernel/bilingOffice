@page "/administration/motifs-transfert"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Administration
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Motifs de transfert — CIT</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span>🔀</span> Gestion des Files & Réorientations
        </div>
        <h2 class="cit-page-title fw-bold text-dark mb-1">
            Motifs de Transfert Inter-Files
        </h2>
        <div class="cit-page-subtitle text-muted">
            Référentiel des justifications proposées aux opérateurs lors du transfert ou de la réorientation d'un dossier.
        </div>
    </div>
    <div>
        <button class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold shadow-sm d-flex align-items-center gap-2" @onclick="ChargerAsync" disabled="@_chargement">
            <span>🔄</span> Actualiser
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement des motifs de transfert..." />
}
else if (_refuse)
{
    <PermissionDenied Message="@_messageRefus" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger border-0 text-danger bg-danger bg-opacity-10 mb-4 rounded-3 p-3 d-flex align-items-center shadow-sm">
            <span class="me-2 fs-5">⚠️</span> @_erreur
        </div>
    }

    <!-- 1. Formulaire d'Ajout d'un Motif -->
    <div class="cit-card p-4 mb-4 border-0 shadow-sm" style="border-radius: 1.25rem; background-color: var(--surface);">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="fs-4">➕</span>
            <h4 class="fw-bold text-dark mb-0 fs-5">Ajouter un nouveau motif de transfert</h4>
        </div>

        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-dark" for="code">Code technique</label>
                <input id="code" class="form-control" @bind="_code" placeholder="ex. erreur_orientation" />
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label small fw-bold text-dark" for="libelle">Libellé explicatif</label>
                <input id="libelle" class="form-control" @bind="_libelle" placeholder="Dossier orienté par erreur vers cette file" />
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label small fw-bold text-dark" for="ordre">Ordre</label>
                <input id="ordre" type="number" class="form-control" @bind="_ordre" />
            </div>
            <div class="col-12 col-md-1">
                <button class="btn btn-primary w-100 py-2 fw-semibold rounded-3 shadow-sm" @onclick="AjouterAsync">
                    Ajouter
                </button>
            </div>
        </div>
    </div>

    <!-- 2. Liste des Motifs Existants -->
    @if (_motifs is null || _motifs.Count == 0)
    {
        <div class="cit-card p-5 text-center my-4 border-0 shadow-sm" style="border-radius: 1rem; background-color: var(--surface);">
            <div class="fs-1 mb-3">🔀</div>
            <h4 class="fw-bold text-dark mb-2">Aucun motif enregistré</h4>
            <p class="text-muted mb-0">Utilisez le formulaire ci-dessus pour configurer les motifs de réorientation.</p>
        </div>
    }
    else
    {
        <div class="cit-card border-0 shadow-sm overflow-hidden" style="border-radius: 1.25rem; background-color: var(--surface);">
            <div class="p-3 bg-light border-bottom d-flex align-items-center justify-content-between">
                <span class="fw-bold text-dark small">Référentiel des Motifs de Réorientation (@_motifs.Count)</span>
                <span class="badge bg-secondary-subtle text-dark">Traçabilité Immuable</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 80px;">Ordre</th>
                            <th>Code</th>
                            <th>Libellé affiché aux opérateurs</th>
                            <th>État</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var motif in _motifs.OrderBy(m => m.Ordre))
                        {
                            <tr>
                                <td class="ps-4 font-monospace fw-bold text-muted">#@motif.Ordre</td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary font-monospace px-2 py-1 rounded-pill">
                                        @motif.Code
                                    </span>
                                </td>
                                <td class="fw-semibold text-dark">@motif.Libelle</td>
                                <td>
                                    <span class="badge @(motif.EstActif ? "bg-success bg-opacity-10 text-success" : "bg-danger bg-opacity-10 text-danger") px-3 py-1 rounded-pill">
                                        @(motif.EstActif ? "Actif" : "Désactivé")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    @if (motif.EstActif)
                                    {
                                        <button class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                @onclick="() => BasculerAsync(motif.Id, false)">
                                            Désactiver
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-success btn-sm rounded-pill px-3"
                                                @onclick="() => BasculerAsync(motif.Id, true)">
                                            Réactiver
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private IReadOnlyList<MotifTransfertVue>? _motifs;
    private Guid _appelantId;
    private bool _chargement = true;
    private bool _refuse;
    private string _messageRefus = "Vous devez disposer de la permission d'administration des files (administration.files) pour accéder à cette interface.";
    private string? _erreur;

    private string _code = string.Empty;
    private string _libelle = string.Empty;
    private int _ordre = 1;

    protected override async Task OnInitializedAsync()
    {
        var contexte = await ContexteService.ObtenirContexteAsync();
        _appelantId = contexte.UtilisateurId;
        _refuse = !contexte.Permissions.Contains(CIT.Plateforme.Domain.Securite.Permission.AdministrationFiles);

        if (!_refuse)
        {
            await ChargerAsync();
        }
        else
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var listerMotifs = scope.ServiceProvider.GetRequiredService<ListerMotifsTransfertQuery>();
            _motifs = await listerMotifs.ExecuterAsync(_appelantId);
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ExecuterAsync(Func<IServiceProvider, Task> action)
    {
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await action(scope.ServiceProvider);
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
    }

    private Task AjouterAsync() => ExecuterAsync(async sp =>
    {
        var gererMotifs = sp.GetRequiredService<GererMotifsTransfertCommand>();
        await gererMotifs.DefinirAsync(_appelantId, _code, _libelle, _ordre);
        _code = string.Empty;
        _libelle = string.Empty;
        _ordre = (_motifs?.Count ?? 0) + 1;
    });

    private Task BasculerAsync(Guid motifId, bool actif) => ExecuterAsync(sp =>
    {
        var gererMotifs = sp.GetRequiredService<GererMotifsTransfertCommand>();
        return gererMotifs.DefinirActivationAsync(_appelantId, motifId, actif);
    });
}
