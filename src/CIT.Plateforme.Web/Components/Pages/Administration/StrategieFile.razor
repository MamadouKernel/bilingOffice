@page "/administration/strategie-file"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Administration
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Files
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>@Loc["AdmStrat.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>⚙️</span> @Loc["AdmStrat.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["AdmStrat.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0">
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ChargerAsync" disabled="@_chargement">
            @Loc["Common.Refresh"]
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["AdmStrat.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-3" role="alert">@_erreur</div>
    }

    @if (_message is not null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-3" role="status">
            <span class="fs-4">✅</span>
            <div>@_message</div>
        </div>
    }

    @if (_files is null || _files.Count == 0)
    {
        <EtatVide Titre="@Loc["AdmStrat.EmptyTitle"]"
                  Description="@Loc["AdmStrat.EmptyDesc"]"
                  Icone="⚙️" />
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="cit-stat-card p-3 shadow-sm d-flex align-items-center gap-3">
                    <div class="cit-stat-icon bg-primary bg-opacity-10 text-primary">🗂️</div>
                    <div>
                        <div class="cit-stat-label">@Loc["AdmStrat.KpiFiles"]</div>
                        <div class="cit-stat-value">@_files.Count</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="cit-stat-card p-3 shadow-sm d-flex align-items-center gap-3">
                    <div class="cit-stat-icon bg-info bg-opacity-10 text-info">🧩</div>
                    <div>
                        <div class="cit-stat-label">@Loc["AdmStrat.KpiModules"]</div>
                        <div class="cit-stat-value">@_files.Select(f => f.Module).Distinct().Count()</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="cit-stat-card p-3 shadow-sm d-flex align-items-center gap-3">
                    <div class="cit-stat-icon bg-warning bg-opacity-10 text-warning">🎯</div>
                    <div>
                        <div class="cit-stat-label">@Loc["AdmStrat.KpiSkill"]</div>
                        <div class="cit-stat-value">@_files.Count(f => !string.IsNullOrWhiteSpace(f.CompetenceRequise))</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="cit-stat-card p-3 shadow-sm d-flex align-items-center gap-3">
                    <div class="cit-stat-icon bg-success bg-opacity-10 text-success">@IconeStrategie(StrategieDominante)</div>
                    <div>
                        <div class="cit-stat-label">@Loc["AdmStrat.KpiDominant"]</div>
                        <div class="fw-bold text-dark" style="line-height:1.2;">@LibelleStrategie(StrategieDominante)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-xl-5">
                <div class="cit-card h-100">
                    <h6 class="fw-bold text-dark mb-3">@Loc["AdmStrat.ConfigTitle"]</h6>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark" for="file">@Loc["AdmStrat.FileLabel"]</label>
                        <select id="file" class="form-select form-select-sm" @bind="_fileSelectionnee">
                            @foreach (var file in _files)
                            {
                                <option value="@file.Id">@Loc.File(file.Nom) — @file.Module</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark" for="strategie">@Loc["AdmStrat.StrategyLabel"]</label>
                        <select id="strategie" class="form-select form-select-sm" @bind="_strategieSelectionnee">
                            @foreach (var strategie in Enum.GetValues<StrategieAffectation>())
                            {
                                <option value="@strategie">@IconeStrategie(strategie) @LibelleStrategie(strategie)</option>
                            }
                        </select>
                    </div>

                    <div class="rounded-3 p-3 mb-3 border bg-light d-flex gap-3">
                        <span class="fs-3 lh-1">@IconeStrategie(_strategieSelectionnee)</span>
                        <div>
                            <div class="text-uppercase fw-bold text-muted" style="font-size:.68rem;letter-spacing:.06em;">@Loc["AdmStrat.HowTitle"]</div>
                            <div class="small text-dark">@DescriptionStrategie(_strategieSelectionnee)</div>
                        </div>
                    </div>

                    <button type="button" class="btn btn-primary btn-sm fw-bold shadow-sm w-100" @onclick="ChangerAsync">
                        @Loc["AdmStrat.Apply"]
                    </button>
                </div>
            </div>

            <div class="col-12 col-xl-7">
                <div class="cit-card p-0 overflow-hidden h-100">
                    <div class="p-3 bg-light border-bottom">
                        <h6 class="fw-bold text-dark mb-0">@Loc["AdmStrat.ConfiguredFiles", _files.Count]</h6>
                    </div>
                    <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Loc["AdmStrat.ColFile"]</th>
                                    <th>@Loc["AdmStrat.ColModule"]</th>
                                    <th>@Loc["AdmStrat.ColActiveStrategy"]</th>
                                    <th>@Loc["AdmStrat.ColSkill"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var file in _pagination1.Appliquer(_files))
                                {
                                    <tr>
                                        <td class="text-dark fw-semibold">@Loc.File(file.Nom)</td>
                                        <td class="small text-muted">@Loc.Module(file.Module)</td>
                                        <td>
                                            <span class="cit-badge @ClasseBadge(file.StrategieActive)">
                                                @IconeStrategie(file.StrategieActive) @LibelleStrategie(file.StrategieActive)
                                            </span>
                                        </td>
                                        <td class="small">
                                            @if (file.StrategieActive == StrategieAffectation.Competence && string.IsNullOrWhiteSpace(file.CompetenceRequise))
                                            {
                                                <span class="cit-badge cit-badge-warning" title="@Loc["AdmStrat.SkillMissingHint"]">
                                                    ⚠️ @Loc["AdmStrat.SkillMissing"]
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@(string.IsNullOrWhiteSpace(file.CompetenceRequise) ? "—" : file.CompetenceRequise)</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private string? _message;

    private Guid _administrateurId;
    private IReadOnlyList<FileAdministrable>? _files;
    private Guid _fileSelectionnee;
    private StrategieAffectation _strategieSelectionnee = StrategieAffectation.PriseLibre;

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    /// <summary>Les valeurs d'énumération sont traduites : l'écran s'adresse à un administrateur
    /// fonctionnel, pas à un développeur.</summary>
    private string LibelleStrategie(StrategieAffectation strategie) => strategie switch
    {
        StrategieAffectation.PriseLibre => Loc["AdmStrat.StratPriseLibre"].Value,
        StrategieAffectation.AffectationManuelle => Loc["AdmStrat.StratManuelle"].Value,
        StrategieAffectation.RoundRobin => Loc["AdmStrat.StratRoundRobin"].Value,
        StrategieAffectation.Charge => Loc["AdmStrat.StratCharge"].Value,
        StrategieAffectation.Disponibilite => Loc["AdmStrat.StratDispo"].Value,
        StrategieAffectation.Competence => Loc["AdmStrat.StratCompetence"].Value,
        _ => strategie.ToString()
    };

    private string IconeStrategie(StrategieAffectation strategie) => strategie switch
    {
        StrategieAffectation.PriseLibre => "🙋",
        StrategieAffectation.AffectationManuelle => "👤",
        StrategieAffectation.RoundRobin => "🔄",
        StrategieAffectation.Charge => "⚖️",
        StrategieAffectation.Disponibilite => "🟢",
        StrategieAffectation.Competence => "🎯",
        _ => "⚙️"
    };

    private string ClasseBadge(StrategieAffectation strategie) => strategie switch
    {
        StrategieAffectation.PriseLibre => "cit-badge-info",
        StrategieAffectation.AffectationManuelle => "cit-badge-dark",
        StrategieAffectation.RoundRobin => "cit-badge-primary",
        StrategieAffectation.Charge => "cit-badge-warning",
        StrategieAffectation.Disponibilite => "cit-badge-success",
        StrategieAffectation.Competence => "cit-badge-primary",
        _ => "cit-badge"
    };

    private string DescriptionStrategie(StrategieAffectation strategie) => strategie switch
    {
        StrategieAffectation.PriseLibre => Loc["AdmStrat.DescPriseLibre"].Value,
        StrategieAffectation.AffectationManuelle => Loc["AdmStrat.DescManuelle"].Value,
        StrategieAffectation.RoundRobin => Loc["AdmStrat.DescRoundRobin"].Value,
        StrategieAffectation.Charge => Loc["AdmStrat.DescCharge"].Value,
        StrategieAffectation.Disponibilite => Loc["AdmStrat.DescDispo"].Value,
        StrategieAffectation.Competence => Loc["AdmStrat.DescCompetence"].Value,
        _ => string.Empty
    };

    /// <summary>Stratégie la plus fréquente parmi les files configurées (pour le KPI).</summary>
    private StrategieAffectation StrategieDominante =>
        _files is null || _files.Count == 0
            ? StrategieAffectation.PriseLibre
            : _files.GroupBy(f => f.StrategieActive)
                    .OrderByDescending(g => g.Count())
                    .First().Key;

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["AdmStrat.LoginRequired"].Value;
                return;
            }

            // L'administrateur est l'utilisateur authentifié ; son habilitation
            // (Permission.AdministrationFiles) est vérifiée côté serveur par la requête elle-même.
            _administrateurId = contexte.UtilisateurId;
            using var scope = ScopeFactory.CreateScope();
            var listerFiles = scope.ServiceProvider.GetRequiredService<ListerFilesQuery>();
            _files = await listerFiles.ExecuterAsync(_administrateurId);

            var courante = _files.FirstOrDefault(f => f.Id == _fileSelectionnee) ?? _files.FirstOrDefault();
            if (courante is not null)
            {
                _fileSelectionnee = courante.Id;
                _strategieSelectionnee = courante.StrategieActive;
            }
            _nonAutorise = false;
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = MessagesUtilisateur.Texte(ex);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ChangerAsync()
    {
        _erreur = null;
        _message = null;

        if (_fileSelectionnee == Guid.Empty)
        {
            _erreur = Loc["AdmStrat.SelectFile"].Value;
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var gererFiles = scope.ServiceProvider.GetRequiredService<GererFilesCommand>();
            await gererFiles.ChangerStrategieAsync(_administrateurId, _fileSelectionnee, _strategieSelectionnee);
            _message = string.Format(Loc["AdmStrat.Applied"].Value, LibelleStrategie(_strategieSelectionnee));
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _erreur = MessagesUtilisateur.Texte(ex);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }
}
