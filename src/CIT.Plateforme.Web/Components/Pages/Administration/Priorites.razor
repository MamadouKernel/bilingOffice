@page "/administration/priorites"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Administration
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>@Loc["AdmPriorite.PageTitle"]</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span>🎚️</span> @Loc["AdmPriorite.Pill"]
        </div>
        <h1 class="cit-page-title fw-bold text-dark mb-1">@Loc["AdmPriorite.Title"]</h1>
        <div class="cit-page-subtitle text-muted">@Loc["AdmPriorite.Subtitle"]</div>
    </div>
    <div>
        <button class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold shadow-sm" @onclick="ChargerAsync" disabled="@_chargement">
            @Loc["Common.Refresh"]
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["AdmPriorite.Loading"]" />
}
else if (_refuse)
{
    <PermissionDenied Message="@_messageRefus" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger border-0 bg-danger bg-opacity-10 mb-4 rounded-3 p-3 shadow-sm" role="alert">
            <span class="me-2">⚠️</span> @_erreur
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_succes))
    {
        <div class="alert alert-success border-0 bg-success bg-opacity-10 py-2 small mb-4 rounded-3" role="status">@_succes</div>
    }

    <div class="cit-card p-4 mb-4 border-0 shadow-sm">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="fs-4">➕</span>
            <h4 class="fw-bold text-dark mb-0 fs-5">@Loc["AdmPriorite.AddTitle"]</h4>
        </div>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6">
                <label class="form-label small fw-bold text-dark" for="libelle">@Loc["AdmPriorite.LblLibelle"]</label>
                <input id="libelle" class="form-control" @bind="_libelle" placeholder="@Loc["AdmPriorite.PhLibelle"]" maxlength="100" />
            </div>
            <div class="col-8 col-md-3">
                <label class="form-label small fw-bold text-dark" for="rang">@Loc["AdmPriorite.LblRang"]</label>
                <input id="rang" type="number" class="form-control" @bind="_rang" />
            </div>
            <div class="col-4 col-md-3 d-grid">
                <button class="btn btn-primary py-2 fw-semibold rounded-3 shadow-sm" @onclick="AjouterAsync"
                        disabled="@string.IsNullOrWhiteSpace(_libelle)">
                    @Loc["AdmPriorite.BtnAjouter"]
                </button>
            </div>
        </div>
        <div class="form-text small">@Loc["AdmPriorite.RangHint"]</div>
    </div>

    @if (_niveaux.Count == 0)
    {
        <EtatVide Titre="@Loc["AdmPriorite.EmptyTitle"]" Description="@Loc["AdmPriorite.EmptyDesc"]" Icone="🎚️" />
    }
    else
    {
        <div class="cit-card border-0 shadow-sm overflow-hidden">
            <div class="p-3 bg-light border-bottom">
                <span class="fw-bold text-dark small">@Loc["AdmPriorite.ListTitle", _niveaux.Count]</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@Loc["AdmPriorite.ColLibelle"]</th>
                            <th class="text-end pe-4">@Loc["AdmPriorite.ColRang"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var n in _niveaux)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@n.Libelle</td>
                                <td class="text-end pe-4 font-monospace">@n.Rang</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private IReadOnlyList<NiveauPrioriteVue> _niveaux = [];
    private Guid _appelantId;
    private bool _chargement = true;
    private bool _refuse;
    private string _messageRefus = string.Empty;
    private string? _erreur;
    private string? _succes;

    private string _libelle = string.Empty;
    private int _rang;

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _refuse = true;
                _messageRefus = Loc["AdmPriorite.LoginRequis"].Value;
                return;
            }

            _appelantId = contexte.UtilisateurId;

            using var scope = ScopeFactory.CreateScope();
            _niveaux = await scope.ServiceProvider
                .GetRequiredService<ListerNiveauxPrioriteQuery>()
                .ExecuterAsync(_appelantId);
            _refuse = false;
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task AjouterAsync()
    {
        _erreur = null;
        _succes = null;

        if (string.IsNullOrWhiteSpace(_libelle))
        {
            _erreur = Loc["AdmPriorite.ErrLibelle"].Value;
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider
                .GetRequiredService<GererNiveauxPrioriteCommand>()
                .DefinirAsync(_appelantId, _libelle, _rang);

            _succes = Loc["AdmPriorite.SuccessAjout"].Value;
            _libelle = string.Empty;
            _rang = 0;
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }
}
