@page "/administration/parametres-sla"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Administration
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.SuiviTemps
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>@Loc["AdmSla.PageTitle"]</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span aria-hidden="true">⏱️</span> @Loc["AdmSla.Pill"]
        </div>
        <h1 class="cit-page-title fw-bold text-dark mb-1">@Loc["AdmSla.Title"]</h1>
        <div class="cit-page-subtitle text-muted">
            @Loc["AdmSla.Subtitle"]
        </div>
    </div>
    <div>
        <button class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold shadow-sm d-flex align-items-center gap-2" @onclick="ChargerAsync" disabled="@_chargement">
            <span aria-hidden="true">🔄</span> @Loc["Common.Refresh"]
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["AdmSla.Loading"]" />
}
else if (_refuse)
{
    <PermissionDenied Message="@_messageRefus" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger border-0 text-danger bg-danger bg-opacity-10 mb-4 rounded-3 p-3 d-flex align-items-center shadow-sm" role="alert">
            <span class="me-2 fs-5" aria-hidden="true">⚠️</span> @_erreur
        </div>
    }

    <div class="cit-card p-4 mb-4 border-0 shadow-sm">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="fs-4" aria-hidden="true">➕</span>
            <h4 class="fw-bold text-dark mb-0 fs-5">@Loc["AdmSla.AddTitle"]</h4>
        </div>

        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-dark" for="module">@Loc["AdmSla.ModuleLabel"]</label>
                <input id="module" class="form-control" @bind="_module" placeholder="@Loc["AdmSla.ModulePlaceholder"]" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-dark" for="typeDemande">@Loc["AdmSla.TypeLabel"]</label>
                <input id="typeDemande" class="form-control" @bind="_typeDemande" placeholder="@Loc["AdmSla.TypePlaceholder"]" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-dark" for="file">@Loc["AdmSla.EtapeLabel"]</label>
                <select id="file" class="form-select" @bind="_fileId">
                    <option value="">@Loc["AdmSla.EtapeAll"]</option>
                    @foreach (var f in _axes?.Files ?? new List<(Guid, string)>())
                    {
                        <option value="@f.Item1">@f.Item2</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-dark" for="priorite">@Loc["AdmSla.PrioLabel"]</label>
                <select id="priorite" class="form-select" @bind="_prioriteId">
                    <option value="">@Loc["AdmSla.PrioAll"]</option>
                    @foreach (var p in _axes?.Priorites ?? new List<(Guid, string)>())
                    {
                        <option value="@p.Item1">@p.Item2</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-3">
                <label class="form-label small fw-bold text-dark" for="heures">@Loc["AdmSla.DureeLabel"]</label>
                <div class="input-group">
                    <input id="heures" type="number" step="0.25" min="0.25" class="form-control" @bind="_dureeCibleHeures" />
                    <span class="input-group-text">@Loc["AdmSla.HoursUnit"]</span>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-bold text-dark" for="sInfo">@Loc["AdmSla.SeuilInfoLabel"]</label>
                <input id="sInfo" type="number" step="0.05" min="0" max="1" class="form-control" @bind="_seuilInformation" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-bold text-dark" for="sAlerte">@Loc["AdmSla.SeuilAlerteLabel"]</label>
                <input id="sAlerte" type="number" step="0.05" min="0" max="1" class="form-control" @bind="_seuilAlerte" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small fw-bold text-dark" for="sEsc">@Loc["AdmSla.SeuilEscaladeLabel"]</label>
                <input id="sEsc" type="number" step="0.1" min="0" class="form-control"
                       aria-describedby="aide-escalade" @bind="_seuilEscalade" />
                <div id="aide-escalade" class="form-text small">@Loc["AdmSla.EscaladeHint"]</div>
            </div>
            <div class="col-12 col-md-2">
                <button class="btn btn-primary w-100 py-2 fw-semibold rounded-3 shadow-sm" @onclick="AjouterAsync">
                    @Loc["Common.Add"]
                </button>
            </div>
        </div>
    </div>

    @if (_parametres is null || _parametres.Count == 0)
    {
        <div class="cit-card p-5 text-center text-muted border-0 shadow-sm">
            <div class="fs-1 mb-2" aria-hidden="true">⏱️</div>
            <div class="fw-semibold">@Loc["AdmSla.EmptyTitle"]</div>
            <div class="small">@Loc["AdmSla.EmptyDesc"]</div>
        </div>
    }
    else
    {
        <div class="cit-card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <caption class="visually-hidden">@Loc["AdmSla.TableCaption"]</caption>
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="small fw-bold">@Loc["AdmSla.ColModule"]</th>
                            <th scope="col" class="small fw-bold">@Loc["AdmSla.ColType"]</th>
                            <th scope="col" class="small fw-bold">@Loc["AdmSla.ColEtape"]</th>
                            <th scope="col" class="small fw-bold">@Loc["AdmSla.ColPrio"]</th>
                            <th scope="col" class="small fw-bold text-end">@Loc["AdmSla.ColDuree"]</th>
                            <th scope="col" class="small fw-bold text-end">@Loc["AdmSla.ColInfo"]</th>
                            <th scope="col" class="small fw-bold text-end">@Loc["AdmSla.ColAlerte"]</th>
                            <th scope="col" class="small fw-bold text-end">@Loc["AdmSla.ColEscalade"]</th>
                            <th scope="col" class="small fw-bold text-end">@Loc["AdmSla.ColPrecision"]</th>
                            <th scope="col"><span class="visually-hidden">@Loc["AdmPieceC.ColActions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _parametres.OrderByDescending(x => x.Specificite).ThenBy(x => x.Module))
                        {
                            <tr>
                                <td class="fw-semibold">@p.Module</td>
                                <td>@p.TypeDemande</td>
                                <td>@NomFile(p.FileId)</td>
                                <td>@LibellePriorite(p.PrioriteId)</td>
                                <td class="text-end">@p.DureeCible.TotalHours.ToString("0.##") h</td>
                                <td class="text-end">@Pourcent(p.SeuilInformation)</td>
                                <td class="text-end">@Pourcent(p.SeuilAlerte)</td>
                                <td class="text-end">@(p.SeuilEscalade == 0 ? "—" : Pourcent(p.SeuilEscalade))</td>
                                <td class="text-end"><span class="badge bg-secondary bg-opacity-25 text-dark">@p.Specificite</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => DemanderConfirmationSuppression(p.Id)">@Loc["AdmSla.Remove"]</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<ModaleConfirmation EstOuvert="@(_confirmation is not null)"
                    Titre="@(_confirmation?.Titre ?? string.Empty)"
                    Message="@(_confirmation?.Message ?? string.Empty)"
                    BoutonConfirmerLibelle="@(_confirmation?.LibelleConfirmer ?? Loc["AdmSla.Remove"].Value)"
                    BoutonConfirmerClass="@(_confirmation?.ClasseConfirmer ?? "btn-danger")"
                    Desactive="@_confirmationEnCours"
                    OnConfirmer="@(async () => { if (_confirmation is not null) await _confirmation.Action(); })"
                    OnAnnuler="AnnulerConfirmation" />

@code {
    private IReadOnlyList<ParametreSlaAdministrable>? _parametres;
    private AxesSlaDisponibles? _axes;
    private Guid _appelantId;
    private bool _chargement = true;
    private bool _refuse;
    private string _messageRefus = string.Empty;
    private string? _erreur;

    // AM-03 — le retrait d'un paramètre SLA est une suppression de configuration : confirmation requise.
    private ConfirmationEnAttente? _confirmation;
    private bool _confirmationEnCours;

    private string _module = string.Empty;
    private string _typeDemande = string.Empty;
    private string _fileId = string.Empty;
    private string _prioriteId = string.Empty;
    private double _dureeCibleHeures = 1;
    private double _seuilInformation = 0.5;
    private double _seuilAlerte = 0.8;
    private double _seuilEscalade;

    protected override async Task OnInitializedAsync()
    {
        _messageRefus = Loc["AdmSla.Refuse"].Value;
        var contexte = await ContexteService.ObtenirContexteAsync();
        _appelantId = contexte.UtilisateurId;
        _refuse = !contexte.Permissions.Contains(CIT.Plateforme.Domain.Securite.Permission.AdministrationSla);

        if (!_refuse)
        {
            await ChargerAsync();
        }
        else
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var commande = scope.ServiceProvider.GetRequiredService<GererParametresSlaCommand>();
            _parametres = await commande.ListerAsync(_appelantId);
            _axes = await commande.ListerAxesAsync(_appelantId);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ExecuterAsync(Func<IServiceProvider, Task> action)
    {
        _erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await action(scope.ServiceProvider);
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private Task AjouterAsync() => ExecuterAsync(async sp =>
    {
        var commande = sp.GetRequiredService<GererParametresSlaCommand>();
        await commande.DefinirAsync(
            _appelantId, _module, _typeDemande,
            TimeSpan.FromHours(_dureeCibleHeures), _seuilInformation, _seuilAlerte,
            Analyser(_fileId), Analyser(_prioriteId), _seuilEscalade);

        _module = string.Empty;
        _typeDemande = string.Empty;
        _fileId = string.Empty;
        _prioriteId = string.Empty;
        _seuilEscalade = 0;
    });

    private void DemanderConfirmationSuppression(Guid parametreId)
    {
        _confirmation = new ConfirmationEnAttente(
            Loc["AdmSla.ConfirmTitle"].Value,
            Loc["AdmSla.ConfirmMsg"].Value,
            Loc["AdmSla.Remove"].Value,
            "btn-danger",
            () => ExecuterSuppressionAsync(parametreId));
    }

    private void AnnulerConfirmation() => _confirmation = null;

    private async Task ExecuterSuppressionAsync(Guid parametreId)
    {
        _confirmationEnCours = true;
        try
        {
            await SupprimerAsync(parametreId);
        }
        finally
        {
            _confirmationEnCours = false;
            _confirmation = null;
        }
    }

    private Task SupprimerAsync(Guid parametreId) => ExecuterAsync(sp =>
        sp.GetRequiredService<GererParametresSlaCommand>().SupprimerAsync(_appelantId, parametreId));

    private static Guid? Analyser(string valeur) => Guid.TryParse(valeur, out var id) ? id : null;

    private static string Pourcent(double part) => (part * 100).ToString("0.#") + " %";

    private string NomFile(Guid? fileId) =>
        fileId is null
            ? Loc["AdmSla.All"].Value
            : _axes?.Files.FirstOrDefault(f => f.Id == fileId.Value).Nom ?? fileId.Value.ToString();

    private string LibellePriorite(Guid? prioriteId) =>
        prioriteId is null
            ? Loc["AdmSla.All"].Value
            : _axes?.Priorites.FirstOrDefault(p => p.Id == prioriteId.Value).Libelle ?? prioriteId.Value.ToString();
}
