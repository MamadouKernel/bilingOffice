@page "/actualisation-badt/fiche/{TicketId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.ActualisationBadt
@using CIT.Plateforme.Domain.ActualisationBadt
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirFicheBadtQuery ObtenirFiche
@inject CIT.Plateforme.Application.Messagerie.PublierMessageCommand PublierMessage
@inject AjouterConteneursBadtCommand AjouterConteneurs
@inject QualifierLigneBadtCommand Qualifier
@inject DeciderLigneBadtCommand Decider
@inject GenererFichierNavisBadtCommand GenererNavis
@inject CloturerTicketBadtCommand CloturerTicket
@inject IJSRuntime Js
@inject NavigationManager Navigation

<PageTitle>@Loc["BadtFiche.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title"><span>🗓️</span> @Loc["BadtFiche.Title"] @(_fiche?.NumeroTicket)</h1>
        <div class="cit-page-subtitle">@_fiche?.ClientNom</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/actualisation-badt/file" class="btn btn-outline-secondary btn-sm shadow-sm">@Loc["BadtFiche.BackToFile"]</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["BadtFiche.Loading"]" />
}
else if (_fiche is null)
{
    <div class="alert alert-danger" role="alert">@(_erreur ?? Loc["BadtFiche.NotFound"].Value)</div>
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger" role="alert">@_erreur</div>
    }

    <div class="cit-card mb-4 p-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
            <div>
                <div class="small text-muted">@Loc["BadtFiche.File"] <span class="font-monospace">@_fiche.NumeroDossier</span></div>
                <StatutBadge Statut="@_fiche.Statut" />
            </div>
        </div>
        <h6 class="fw-semibold mt-2">@Loc["BadtFiche.ClientStory"]</h6>
        <p class="mb-0" style="white-space: pre-wrap;">@_fiche.Description</p>
    </div>

    <h5 class="fw-bold mb-3">@Loc["BadtFiche.LinesTitle"] (@_fiche.Lignes.Count)</h5>

    @foreach (var groupeBl in _fiche.Lignes.GroupBy(l => l.NumeroBl))
    {
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <div class="fw-semibold"><span class="text-muted small">@Loc["BadtFiche.Bl"]</span> <span class="font-monospace">@groupeBl.Key</span></div>
            </div>

            @if (_fiche.PeutQualifier && _fiche.Statut != StatutTicket.Cloture)
            {
                var saisie = SaisieConteneur(groupeBl.Key);
                <div class="input-group input-group-sm mb-2" style="max-width: 420px;">
                    <input class="form-control" placeholder="@Loc["BadtFiche.AddContainerPlaceholder"]" maxlength="32"
                           @bind="saisie.Valeur" @bind:event="oninput" />
                    <button type="button" class="btn btn-outline-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(saisie.Valeur))"
                            @onclick="() => AjouterConteneurAsync(groupeBl.Key)">➕ @Loc["BadtFiche.AddContainerBtn"]</button>
                </div>
            }

            @if (!groupeBl.Any(l => !string.IsNullOrEmpty(l.NumeroConteneur)))
            {
                <div class="text-muted small fst-italic mb-2">@Loc["BadtFiche.NoContainerYet"]</div>
            }

            @* écart 3 — QUALIFIER TOUT LE BL : même cause/motif sur tous ses conteneurs en attente. *@
            @if (_fiche.PeutQualifier && groupeBl.Any(l => !string.IsNullOrEmpty(l.NumeroConteneur) && l.Decision == DecisionLigneBadt.EnAttente && l.Cause is null))
            {
                var q = SaisieQualifBl(groupeBl.Key);
                <div class="row g-2 align-items-end mb-2">
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">@Loc["BadtFiche.QualifyBlTitle"]</label>
                        <select class="form-select form-select-sm" @bind="q.Cause">
                            <option value="Terminale">@Loc["BadtFiche.CauseTerminal"]</option>
                            <option value="NonTerminale">@Loc["BadtFiche.CauseNonTerminal"]</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-muted mb-1">@Loc["BadtFiche.MotifLabel"]</label>
                        <input class="form-control form-control-sm" @bind="q.Motif" @bind:event="oninput" maxlength="2000" />
                    </div>
                    <div class="col-md-2 text-end">
                        <button type="button" class="btn btn-sm btn-outline-primary w-100" disabled="@(_busy || string.IsNullOrWhiteSpace(q.Motif))"
                                @onclick="() => QualifierBlAsync(groupeBl.Key)">@Loc["BadtFiche.QualifyBlBtn"]</button>
                    </div>
                </div>
            }

    @foreach (var ligne in groupeBl.Where(l => !string.IsNullOrEmpty(l.NumeroConteneur)))
    {
        var e = Edition(ligne.Id);
        <div class="cit-card mb-3 p-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="font-monospace fw-bold">@ligne.NumeroConteneur</span>
                    <span class="text-muted small ms-2">@Loc["BadtFiche.Bl"] @ligne.NumeroBl</span>
                </div>
                <span class="badge @BadgeDecision(ligne.Decision)">@LibelleDecision(ligne.Decision)</span>
            </div>

            @if (ligne.Cause is not null)
            {
                <div class="small text-muted mt-2">
                    @Loc["BadtFiche.Cause"] <strong>@LibelleCause(ligne.Cause.Value)</strong> — @ligne.MotifCause
                </div>
            }

            @if (ligne.Decision == DecisionLigneBadt.Accordee)
            {
                <div class="small text-success mt-1">
                    @Loc["BadtFiche.Granted", ligne.NombreJoursAccordes ?? 0] — @Loc["BadtFiche.NewValidity"] <strong>@(ligne.NouvelleDateValidite?.ToString("yyyy-MM-dd"))</strong>
                </div>
            }
            else if (ligne.Decision == DecisionLigneBadt.Refusee)
            {
                <div class="small text-danger mt-1">@Loc["BadtFiche.Refused"] @ligne.MotifRefus</div>
            }

            @* QUALIFICATION — Support Client, tant que la ligne n'est ni qualifiée ni décidée. *@
            @if (_fiche.PeutQualifier && ligne.Decision == DecisionLigneBadt.EnAttente && ligne.Cause is null)
            {
                <div class="border-top mt-3 pt-3">
                    <div class="fw-semibold small mb-2">@Loc["BadtFiche.QualifyTitle"]</div>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label small text-muted mb-1">@Loc["BadtFiche.CauseLabel"]</label>
                            <select class="form-select form-select-sm" @bind="e.Cause">
                                <option value="Terminale">@Loc["BadtFiche.CauseTerminal"]</option>
                                <option value="NonTerminale">@Loc["BadtFiche.CauseNonTerminal"]</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">@Loc["BadtFiche.MotifLabel"]</label>
                            <input class="form-control form-control-sm" @bind="e.Motif" @bind:event="oninput" maxlength="2000" />
                        </div>
                        <div class="col-md-2 text-end">
                            <button type="button" class="btn btn-sm btn-primary w-100" disabled="@(_busy || string.IsNullOrWhiteSpace(e.Motif))"
                                    @onclick="() => QualifierAsync(ligne.Id, e)">@Loc["BadtFiche.QualifyBtn"]</button>
                        </div>
                    </div>
                </div>
            }

            @* DÉCISION — Décideur, une fois la ligne qualifiée et tant qu'elle n'est pas décidée. *@
            @if (_fiche.PeutDecider && ligne.Decision == DecisionLigneBadt.EnAttente && ligne.Cause is not null)
            {
                <div class="border-top mt-3 pt-3">
                    <div class="fw-semibold small mb-2">@Loc["BadtFiche.DecideTitle"]</div>
                    @if (ligne.Cause == CauseExpirationBadt.Terminale)
                    {
                        <div class="row g-2 align-items-end mb-2">
                            <div class="col-md-3">
                                <label class="form-label small text-muted mb-1">@Loc["BadtFiche.DaysLabel"]</label>
                                <input type="number" min="1" class="form-control form-control-sm" @bind="e.Jours" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small text-muted mb-1">@Loc["BadtFiche.OldDateLabel"]</label>
                                <input type="date" class="form-control form-control-sm" @bind="e.AncienneDate" />
                            </div>
                            <div class="col-md-6 text-end">
                                <button type="button" class="btn btn-sm btn-success" disabled="@(_busy || !(e.Jours > 0))"
                                        @onclick="() => AccorderAsync(ligne.Id, e)">@Loc["BadtFiche.GrantBtn"]</button>
                            </div>
                        </div>
                    }
                    <div class="row g-2 align-items-end">
                        <div class="col-md-9">
                            <label class="form-label small text-muted mb-1">@Loc["BadtFiche.RefuseMotifLabel"]</label>
                            <input class="form-control form-control-sm" @bind="e.MotifRefus" @bind:event="oninput" maxlength="2000" />
                        </div>
                        <div class="col-md-3 text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger w-100" disabled="@(_busy || string.IsNullOrWhiteSpace(e.MotifRefus))"
                                    @onclick="() => RefuserAsync(ligne.Id, e)">@Loc["BadtFiche.RefuseBtn"]</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
        </div>
    }

    @* GÉNÉRATION NAVIS — dès qu'au moins un conteneur est accordé : l'agent dépose l'extraction N4
       et la plateforme réinjecte automatiquement la colonne T des conteneurs accordés. *@
    @if (_fiche.PeutQualifier && _fiche.Lignes.Any(l => l.Decision == DecisionLigneBadt.Accordee))
    {
        <div class="cit-card mt-4 p-4 shadow-sm border-primary-subtle">
            <h5 class="fw-bold mb-1">@Loc["BadtNavis.Title"]</h5>
            <p class="text-muted small mb-3">@Loc["BadtNavis.Hint"]</p>
            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label small text-muted mb-1">@Loc["BadtNavis.UploadLabel"]</label>
                    <InputFile class="form-control form-control-sm" accept=".csv,.txt" OnChange="OnExtractionSelected" />
                    @if (_extraction is not null)
                    {
                        <div class="form-text small">📎 @_nomExtraction (@(_extraction.Length / 1024) @Loc["Common.KoUnit"])</div>
                    }
                </div>
                <div class="col-md-4 text-end">
                    <button type="button" class="btn btn-sm btn-primary" disabled="@(_busy || _extraction is null)"
                            @onclick="GenererAsync">@Loc["BadtNavis.GenerateBtn"]</button>
                </div>
            </div>
        </div>
    }

    @* CLÔTURE — une fois le fichier intégré dans Navis et tous les conteneurs statués. *@
    @if (_fiche.PeutQualifier && _fiche.Statut != StatutTicket.Cloture
         && _fiche.Lignes.Count > 0 && _fiche.Lignes.All(l => l.Decision != DecisionLigneBadt.EnAttente))
    {
        <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-success" disabled="@_busy" @onclick="CloturerAsync">
                @Loc["BadtFiche.CloseBtn"]
            </button>
        </div>
    }
    else if (_fiche.Statut == StatutTicket.Cloture)
    {
        <div class="alert alert-success mt-4 mb-0" role="alert">@Loc["BadtFiche.Closed"]</div>
    }

    @* CHAT AGENT ⇄ CLIENT — messagerie du ticket (compléments). Notes internes réservées aux agents. *@
    <div class="cit-card mt-4 p-0">
        <div class="px-3 pt-3 border-bottom fw-bold">@Loc["Ticket.TabMessages"] (@_fiche.Messages.Count)</div>
        <div class="p-3">
            <div class="messages-container mb-3" style="max-height: 400px; overflow-y: auto;">
                @if (_fiche.Messages.Count == 0)
                {
                    <div class="text-muted small py-4 text-center">@Loc["Ticket.NoMessages"]</div>
                }
                else
                {
                    @foreach (var msg in _fiche.Messages)
                    {
                        <div class="card mb-2 @(msg.EstInterne ? "border-warning bg-warning-subtle" : "bg-light border-0")">
                            <div class="card-body p-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold small text-dark">
                                        @msg.AuteurNom
                                        @if (msg.EstInterne)
                                        {
                                            <span class="badge bg-warning text-dark ms-2">@Loc["Ticket.InternalNoteBadge"]</span>
                                        }
                                    </span>
                                    <span class="text-muted u-fs-xs">@msg.DateEnvoiUtc.Horodate()</span>
                                </div>
                                <div class="small text-dark" style="white-space: pre-wrap;">@msg.Contenu</div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="border-top pt-3">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="@Loc["Ticket.MessagePlaceholder"]"
                           @bind="_nouveauMessage" @bind:event="oninput" />
                    <div class="input-group-text bg-light">
                        <input class="form-check-input mt-0 me-1" type="checkbox" @bind="_noteInterne" id="chkNoteInterneBadt" />
                        <label class="small mb-0" for="chkNoteInterneBadt">@Loc["Ticket.InternalNoteCheck"]</label>
                    </div>
                    <button type="button" class="btn btn-primary" @onclick="EnvoyerMessageAsync"
                            disabled="@(_busy || string.IsNullOrWhiteSpace(_nouveauMessage))">@Loc["Ticket.Send"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid TicketId { get; set; }

    private sealed class EditionLigne
    {
        public string Cause { get; set; } = "Terminale";
        public string Motif { get; set; } = string.Empty;
        public int? Jours { get; set; }
        public DateOnly? AncienneDate { get; set; }
        public string MotifRefus { get; set; } = string.Empty;
    }

    private bool _chargement = true;
    private bool _busy;
    private string? _erreur;
    private FicheBadtDto? _fiche;
    private readonly Dictionary<Guid, EditionLigne> _editions = new();
    private byte[]? _extraction;
    private string? _nomExtraction;
    private string _nouveauMessage = string.Empty;
    private bool _noteInterne;

    private EditionLigne Edition(Guid ligneId) =>
        _editions.TryGetValue(ligneId, out var e) ? e : _editions[ligneId] = new();

    private sealed class SaisieConteneurBl { public string Valeur { get; set; } = string.Empty; }
    private readonly Dictionary<string, SaisieConteneurBl> _ajoutConteneurs = new();
    private SaisieConteneurBl SaisieConteneur(string bl) =>
        _ajoutConteneurs.TryGetValue(bl, out var s) ? s : _ajoutConteneurs[bl] = new();

    private sealed class SaisieQualifBlModel { public string Cause { get; set; } = "Terminale"; public string Motif { get; set; } = string.Empty; }
    private readonly Dictionary<string, SaisieQualifBlModel> _qualifsBl = new();
    private SaisieQualifBlModel SaisieQualifBl(string bl) =>
        _qualifsBl.TryGetValue(bl, out var s) ? s : _qualifsBl[bl] = new();

    private async Task QualifierBlAsync(string bl)
    {
        var q = SaisieQualifBl(bl);
        if (string.IsNullOrWhiteSpace(q.Motif)) return;
        var cause = Enum.Parse<CauseExpirationBadt>(q.Cause);
        var motif = q.Motif.Trim();
        await ExecuterAsync(async contexte =>
        {
            await Qualifier.ExecuterParBlAsync(contexte.UtilisateurId, TicketId, bl, cause, motif);
            _qualifsBl.Clear();
        });
    }

    private async Task AjouterConteneurAsync(string bl)
    {
        var saisie = SaisieConteneur(bl);
        if (string.IsNullOrWhiteSpace(saisie.Valeur)) return;
        var conteneur = saisie.Valeur.Trim();
        await ExecuterAsync(async contexte =>
        {
            await AjouterConteneurs.ExecuterAsync(contexte.UtilisateurId, TicketId, bl, new[] { conteneur });
            _ajoutConteneurs.Clear();
        });
    }

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                Navigation.NavigateTo("/comptes/connexion", forceLoad: true);
                return;
            }

            _fiche = await ObtenirFiche.ExecuterAsync(contexte.UtilisateurId, TicketId);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task QualifierAsync(Guid ligneId, EditionLigne e)
    {
        await ExecuterAsync(async contexte =>
        {
            var cause = Enum.Parse<CauseExpirationBadt>(e.Cause);
            await Qualifier.ExecuterAsync(contexte.UtilisateurId, ligneId, cause, e.Motif.Trim());
        });
    }

    private async Task AccorderAsync(Guid ligneId, EditionLigne e)
    {
        await ExecuterAsync(async contexte =>
        {
            await Decider.ExecuterAsync(contexte.UtilisateurId,
                new DeciderLigneBadtRequete(ligneId, DecisionLigneBadt.Accordee, e.Jours, e.AncienneDate));
        });
    }

    private async Task RefuserAsync(Guid ligneId, EditionLigne e)
    {
        await ExecuterAsync(async contexte =>
        {
            await Decider.ExecuterAsync(contexte.UtilisateurId,
                new DeciderLigneBadtRequete(ligneId, DecisionLigneBadt.Refusee, MotifRefus: e.MotifRefus.Trim()));
        });
    }

    private async Task ExecuterAsync(Func<CIT.Plateforme.Application.Web.ContexteUtilisateurVue, Task> action)
    {
        if (_busy) return;
        _busy = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _erreur = Loc["Badt.SessionExpired"].Value;
                return;
            }

            await action(contexte);
            _editions.Clear();
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnExtractionSelected(InputFileChangeEventArgs e)
    {
        _erreur = null;
        try
        {
            var file = e.File;
            if (file.Size > 10 * 1024 * 1024)
            {
                _erreur = Loc["BadtNavis.FileTooBig"].Value;
                return;
            }

            using var ms = new MemoryStream();
            await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms);
            _extraction = ms.ToArray();
            _nomExtraction = file.Name;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private async Task GenererAsync()
    {
        if (_busy || _extraction is null) return;
        _busy = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _erreur = Loc["Badt.SessionExpired"].Value;
                return;
            }

            var resultat = await GenererNavis.ExecuterAsync(contexte.UtilisateurId, TicketId, _extraction);
            await Js.InvokeVoidAsync("telechargerFichier", resultat.NomFichier, "text/csv", Convert.ToBase64String(resultat.Contenu));
            _extraction = null;
            _nomExtraction = null;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CloturerAsync()
    {
        await ExecuterAsync(async contexte => await CloturerTicket.ExecuterAsync(contexte.UtilisateurId, TicketId));
    }

    private async Task EnvoyerMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_nouveauMessage)) return;
        var contenu = _nouveauMessage.Trim();
        var interne = _noteInterne;
        await ExecuterAsync(async contexte =>
        {
            if (interne)
            {
                await PublierMessage.PublierNoteInterneAsync(contexte.UtilisateurId, TicketId, contenu);
            }
            else
            {
                await PublierMessage.PublierMessageAgentAsync(contexte.UtilisateurId, TicketId, contenu);
            }
            _nouveauMessage = string.Empty;
            _noteInterne = false;
        });
    }

    private string BadgeDecision(DecisionLigneBadt d) => d switch
    {
        DecisionLigneBadt.Accordee => "bg-success",
        DecisionLigneBadt.Refusee => "bg-danger",
        _ => "bg-secondary",
    };

    private string LibelleDecision(DecisionLigneBadt d) => d switch
    {
        DecisionLigneBadt.Accordee => Loc["BadtFiche.DecAccordee"].Value,
        DecisionLigneBadt.Refusee => Loc["BadtFiche.DecRefusee"].Value,
        _ => Loc["BadtFiche.DecEnAttente"].Value,
    };

    private string LibelleCause(CauseExpirationBadt c) =>
        c == CauseExpirationBadt.Terminale ? Loc["BadtFiche.CauseTerminal"].Value : Loc["BadtFiche.CauseNonTerminal"].Value;
}
