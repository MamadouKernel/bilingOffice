@page "/billing-export/soumettre"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.BillingExport
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@inject IContexteUtilisateurWeb ContexteService
@inject SoumettreDemandeExportCommand Soumettre
@inject NavigationManager Navigation

<PageTitle>@Loc["BillingExport.Title"] — @Loc["Common.AppTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>📤</span> @Loc["BillingExport.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["BillingExport.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/client/dashboard" class="btn btn-outline-secondary btn-sm">← @Loc["Common.Back"]</a>
    </div>
</div>

<div class="cit-page-moyenne">
    @if (_chargement)
    {
        <IndicateurChargement Message="@Loc["BImp.CheckingPerms"]" />
    }
    else if (_nonAutorise)
    {
        <PermissionDenied Message="@_messageNonAutorise" />
    }
    else
    {
        <!-- Récapitulatif du compte émetteur -->
        <div class="cit-card mb-4 bg-light border">
            <h6 class="fw-bold text-dark mb-2">@Loc["BImp.IssuerAccount"]</h6>
            <div class="row g-2 small">
                <div class="col-12 col-md-6">
                    <span class="text-muted">@Loc["BImp.CompanyLabel"]</span>
                    <strong class="ms-1 text-dark">@_societeNom</strong>
                </div>
                <div class="col-12 col-md-6">
                    <span class="text-muted">@Loc["BImp.DepositorLabel"]</span>
                    <strong class="ms-1 text-dark">@_auteurNom</strong>
                </div>
            </div>
        </div>

        <EditForm Model="_modele" OnValidSubmit="SoumettreAsync">
            <div class="cit-card mb-4">
                <h6 class="fw-bold text-dark mb-3">@Loc["BExp.BookingSection"]</h6>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark" for="numeros-booking">@Loc["BillingExport.BookingNumber"]</label>
                    <InputTextArea id="numeros-booking" class="form-control font-monospace" rows="6"
                                   placeholder="@Loc["BExp.BookingPlaceholder"]"
                                   @bind-Value="_modele.NumerosBooking" />
                    <div class="form-text small text-muted">
                        @Loc["BExp.BookingHint"]
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold text-dark" for="marchandises">@Loc["BExp.GoodsLabel"]</label>
                        <InputText id="marchandises" class="form-control" placeholder="@Loc["BExp.GoodsPlaceholder"]" @bind-Value="_modele.Marchandises" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold text-dark" for="port-destination">@Loc["BExp.PortLabel"]</label>
                        <InputText id="port-destination" class="form-control" placeholder="@Loc["BExp.PortPlaceholder"]" @bind-Value="_modele.PortDestination" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark" for="ref-simulation-export">@Loc["BImp.SimRefLabel"]</label>
                    <InputText id="ref-simulation-export" class="form-control" placeholder="@Loc["BImp.SimRefPlaceholder"]" @bind-Value="_modele.ReferenceSimulationProforma" />
                    <div class="form-text small text-muted">
                        @((MarkupString)Loc["BImp.SimRefHint"].Value)
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2">
                    <a href="/client/dashboard" class="btn btn-outline-secondary">@Loc["Common.Cancel"]</a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold" disabled="@(string.IsNullOrWhiteSpace(_modele.NumerosBooking) || _soumissionEnCours)">
                        @if (_soumissionEnCours)
                        {
                            <span>@Loc["BImp.Submitting"]</span>
                        }
                        else
                        {
                            <span>@Loc["BExp.Submit"]</span>
                        }
                    </button>
                </div>
                @if (string.IsNullOrWhiteSpace(_modele.NumerosBooking) && !_soumissionEnCours)
                {
                    <p class="form-text small text-muted text-end mt-2 mb-0">
                        @Loc["BExp.NeedBooking"]
                    </p>
                }
            </div>
        </EditForm>

        @if (_erreur is not null)
        {
            <div class="alert alert-danger mt-3" role="alert">@_erreur</div>
        }

        @if (_resultat is not null)
        {
            <div class="cit-card border-success mt-4">
                <div class="d-flex align-items-center gap-2 text-success mb-3">
                    <span class="fs-4">✅</span>
                    <h5 class="fw-bold mb-0">@Loc["BExp.SuccessTitle"]</h5>
                </div>

                <p class="mb-2">
                    @Loc["BImp.FilePre"] <a href="/dossiers/@_resultat.Dossier.Id" class="fw-bold text-primary">@_resultat.Dossier.Numero</a> @Loc["BImp.FilePost"]
                </p>

                @if (_resultat.TicketsCrees.Count > 0)
                {
                    <h6 class="fw-bold text-dark mt-3 mb-2">@Loc["BImp.TicketsCreated"]</h6>
                    <div class="list-group mb-3">
                        @foreach (var t in _resultat.TicketsCrees)
                        {
                            <a href="/tickets/@t.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center rounded-2 mb-1 border">
                                <div>
                                    <strong class="text-primary">Booking @t.NumeroBooking</strong>
                                    <span class="text-muted small ms-2">(@Loc["BImp.RefWord"] @t.Numero)</span>
                                </div>
                                <span class="badge bg-primary-subtle text-primary">@Loc["BImp.AwaitingPickup"]</span>
                            </a>
                        }
                    </div>
                }

                @if (_resultat.BookingRefuses.Count > 0)
                {
                    <div class="alert alert-warning mt-3 mb-0">
                        <strong class="d-block mb-1">@Loc["BExp.DuplicatesIgnoredLabel"]</strong>
                        <ul class="mb-0 small ps-3">
                            @foreach (var refus in _resultat.BookingRefuses)
                            {
                                <li>
                                    <strong>@refus.NumeroBooking</strong> :
                                    @if (refus.TicketExistantId is Guid ticketId)
                                    {
                                        <span>@Loc["BImp.AlreadyExistsPre"]<a href="/tickets/@ticketId">@Loc["BImp.ViewTicketLink"]</a>@Loc["BImp.AlreadyExistsPost"]</span>
                                    }
                                    else
                                    {
                                        <span>@Loc["BExp.AlreadyProcessing"]</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private static readonly SharedResourcesLocalizer Loc = new();
    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;
    private bool _soumissionEnCours = false;

    private Guid _societeId;
    private string _societeNom = string.Empty;
    private Guid _auteurId;
    private string _auteurNom = string.Empty;

    private ModeleFormulaire _modele = new();
    private SoumettreDemandeExportResultat? _resultat;
    private string? _erreur;

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["BExp.LoginRequired"].Value;
                return;
            }

            if (contexte.DroitSoumission != true)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["BImp.NoSubmitRight"].Value;
                return;
            }

            _societeId = contexte.SocieteId.Value;
            _societeNom = contexte.SocieteNom ?? string.Empty;
            _auteurId = contexte.UtilisateurId;
            _auteurNom = contexte.NomAffiche ?? contexte.Email;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task SoumettreAsync()
    {
        _erreur = null;
        _resultat = null;
        _soumissionEnCours = true;

        try
        {
            var bookings = (_modele.NumerosBooking ?? string.Empty)
                .Split(new[] { '\r', '\n', ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(b => b.Trim())
                .Where(b => !string.IsNullOrWhiteSpace(b))
                .Distinct()
                .ToList();

            if (bookings.Count == 0)
            {
                _erreur = Loc["BExp.NeedBookingValid"].Value;
                return;
            }

            var requete = new SoumettreDemandeExportRequete(
                _societeId,
                _auteurId,
                bookings,
                _modele.Marchandises,
                _modele.PortDestination,
                ReferenceSimulationProforma: string.IsNullOrWhiteSpace(_modele.ReferenceSimulationProforma) ? null : _modele.ReferenceSimulationProforma.Trim());

            _resultat = await Soumettre.ExecuterAsync(requete);
            _modele = new ModeleFormulaire();
        }
        catch (AccesRefuseException ex)
        {
            _erreur = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = $"{Loc["BExp.SubmitErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
        finally
        {
            _soumissionEnCours = false;
        }
    }

    private sealed class ModeleFormulaire
    {
        public string? NumerosBooking { get; set; }
        public string? Marchandises { get; set; }
        public string? PortDestination { get; set; }
        public string? ReferenceSimulationProforma { get; set; }
    }
}
