@page "/billing-export/controle-documentaire"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.BillingExport
@using CIT.Plateforme.Application.Documents
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Documents
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IContexteUtilisateurWeb ContexteService
@inject FinaliserControleDocumentaireExportCommand FinaliserControle
@inject ConsulterFileBillingExportQuery ConsulterFile

<PageTitle>File Contrôle Documentaire EXPORT — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>📑</span> File Contrôle Documentaire EXPORT
        </h2>
        <div class="cit-page-subtitle">Délivrance du Bordereau d'Enlèvement Export (BEE) et clôture finale</div>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="ChargerAsync">🔄 Actualiser la file</button>
        <a href="/agent/dashboard" class="btn btn-outline-primary btn-sm shadow-sm">Mon tableau de bord</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement des dossiers en attente de validation documentaire Export..." />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_message is not null)
    {
        <div class="alert @(_erreur ? "alert-danger" : "alert-success") mb-3">@_message</div>
    }

    @if (_tickets.Count == 0)
    {
        <EtatVide Titre="Aucun dossier en attente documentaire"
                  Description="Tous les dossiers ont reçu leur BEE et ont été clôturés."
                  Icone="📑" />
    }
    else
    {
        <div class="cit-card mb-4 p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>N° Ticket</th>
                            <th>Numéro Booking</th>
                            <th>Statut</th>
                            <th>Arrivée en file</th>
                            <th>Joindre BEE et clôturer</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in _tickets)
                        {
                            var t = ticket;
                            <tr>
                                <td>
                                    <a href="/tickets/@t.Id" class="fw-bold text-decoration-none text-primary font-monospace">
                                        @t.Numero
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark font-monospace">@t.NumeroBooking</span>
                                </td>
                                <td>
                                    <StatutBadge Statut="@t.Statut" />
                                </td>
                                <td class="small text-muted font-monospace">
                                    @t.DateArriveeEnFileUtc.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <InputFile class="form-control form-control-sm" OnChange="e => DeposerBeeEtCloturerAsync(t.Id, e)" />
                                    </div>
                                </td>
                                <td class="text-end">
                                    <a href="/tickets/@t.Id" class="btn btn-outline-secondary btn-sm" title="Consulter la fiche">
                                        🔍 Fiche
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private static readonly ReglesDepotDocument Regles = new(["pdf", "jpg", "png"], TailleMaxOctets: 10 * 1024 * 1024);

    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;
    private Guid _agentId;

    private IReadOnlyList<Ticket> _tickets = [];
    private string? _message;
    private bool _erreur;

    protected override async Task OnInitializedAsync()
    {
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _message = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || contexte.Nature == NatureUtilisateur.Client)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Cet espace est strictement réservé aux agents de contrôle documentaire.";
                return;
            }

            _agentId = contexte.UtilisateurId;
            _tickets = await ConsulterFile.ExecuterAsync(
                _agentId,
                NomsFilesExport.ControleDocumentaire,
                [Permission.BillingExportControleDocumentaireTraiter]);
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task DeposerBeeEtCloturerAsync(Guid ticketId, InputFileChangeEventArgs e)
    {
        _message = null;
        _erreur = false;

        var fichier = e.File;
        if (fichier is null) return;

        try
        {
            using var stream = fichier.OpenReadStream(maxAllowedSize: Regles.TailleMaxOctets);
            await FinaliserControle.ExecuterAsync(
                _agentId,
                ticketId,
                fichier.Name,
                fichier.ContentType,
                stream,
                fichier.Size,
                Regles);

            _erreur = false;
            _message = $"Le BEE '{fichier.Name}' a été déposé et le ticket clôturé avec succès.";
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = $"Échec de la finalisation : {ex.Message}";
        }
    }
}
