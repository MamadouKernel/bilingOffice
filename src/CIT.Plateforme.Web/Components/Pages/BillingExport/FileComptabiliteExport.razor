@page "/billing-export/comptabilite"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.BillingExport
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ConfirmerLettrageExportCommand ConfirmerLettrage
@inject ConsulterFileBillingExportQuery ConsulterFile

<PageTitle>@Loc["FileComptaExp.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>💼</span> @Loc["FileComptaExp.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["FileComptaExp.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="ChargerAsync">@Loc["File.Refresh"]</button>
        <a href="/agent/dashboard" class="btn btn-outline-primary btn-sm shadow-sm">@Loc["File.MyDashboard"]</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["FileComptaExp.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_message is not null)
    {
        <div class="alert @(_erreur ? "alert-danger" : "alert-success") mb-3">@_message</div>
    }

    @if (_tickets.Count == 0)
    {
        <EtatVide Titre="@Loc["FileComptaExp.EmptyTitle"]"
                  Description="@Loc["FileComptaExp.EmptyDesc"]"
                  Icone="💰" />
    }
    else
    {
        <div class="cit-card mb-4 p-0 overflow-hidden">
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["AvoirExoList.ColTicket"]</th>
                            <th>@Loc["File.ColBooking"]</th>
                            <th>@Loc["Societe.ColStatus"]</th>
                            <th>@Loc["File.ColArrival"]</th>
                            <th class="text-end">@Loc["FileComptaExp.ColAction"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in _pagination1.Appliquer(_tickets))
                        {
                            var t = ticket;
                            <tr>
                                <td>
                                    <a href="/tickets/@t.Id" class="fw-bold text-decoration-none text-primary font-monospace">
                                        @t.Numero
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark font-monospace">@t.NumeroBooking</span>
                                    <ClientTicket DossierId="t.DossierId" /><PrisEnChargePar Ticket="t" AgentId="_agentId" />
                                </td>
                                <td>
                                    <StatutBadge Statut="@t.Statut" />
                                </td>
                                <td class="small text-muted font-monospace">
                                    @t.DateArriveeEnFileUtc.Horodate()
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/tickets/@t.Id" class="btn btn-outline-secondary" title="@Loc["File.SheetTitle"]">
                                            @Loc["File.Sheet"]
                                        </a>
                                        @if (t.Statut == StatutTicket.EnCours && t.OperateurAssigneId == _agentId)
                                        {
                                            <button type="button" class="btn btn-outline-success" @onclick="() => ConfirmerLettrageAsync(t.Id)" title="@Loc["FileComptaExp.ConfirmTitle"]">
                                                @Loc["FileComptaExp.Confirm"]
                                            </button>
                                        }
                                        <BoutonPriseEnChargeBilling Ticket="t" AgentId="_agentId" Permissions="@(new[] { Permission.BillingExportComptabiliteConfirmerLettrage })"
                                            OnPrise="ChargerAsync" OnErreur="(m) => { _message = m; _erreur = true; }" />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;
    private Guid _agentId;

    private IReadOnlyList<Ticket> _tickets = [];
    private string? _message;
    private bool _erreur;

    protected override async Task OnInitializedAsync()
    {
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _message = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || contexte.Nature == NatureUtilisateur.Client)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["FileComptaExp.NotAuthorized"].Value;
                return;
            }

            _agentId = contexte.UtilisateurId;
            _tickets = await ConsulterFile.ExecuterAsync(
                _agentId,
                NomsFilesExport.ComptabiliteClient,
                [Permission.BillingExportComptabiliteConfirmerLettrage]);
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = MessagesUtilisateur.Texte(ex);
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ConfirmerLettrageAsync(Guid ticketId)
    {
        _message = null;
        _erreur = false;
        try
        {
            await ConfirmerLettrage.ExecuterAsync(_agentId, ticketId);
            _message = Loc["FileComptaExp.Confirmed"].Value;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = MessagesUtilisateur.Pour(ex);
        }
    }
}
