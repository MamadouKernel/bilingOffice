@page "/billing-export/facturation"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.BillingExport
@using CIT.Plateforme.Application.Documents
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Documents
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject EmettreDraftInExportCommand EmettreDraftIn
@inject EditerFactureExportCommand EditerFacture
@inject ReglementDeclaratifExportCommand ReglementDeclaratifExport
@inject ConsulterFileBillingExportQuery ConsulterFile

<PageTitle>@Loc["FileFactExp.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>💳</span> @Loc["FileFactExp.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["FileFactExp.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="ChargerAsync">@Loc["File.Refresh"]</button>
        <a href="/agent/dashboard" class="btn btn-outline-primary btn-sm shadow-sm">@Loc["File.MyDashboard"]</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["FileFactExp.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_message is not null)
    {
        <div class="alert @(_erreur ? "alert-danger" : "alert-success") mb-3">@_message</div>
    }

    @if (_tickets.Count == 0)
    {
        <EtatVide Titre="@Loc["FileFactExp.EmptyTitle"]"
                  Description="@Loc["FileFactExp.EmptyDesc"]"
                  Icone="🧾" />
    }
    else
    {
        <div class="cit-card mb-4 p-0 overflow-hidden">
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["AvoirExoList.ColTicket"]</th>
                            <th>@Loc["File.ColBooking"]</th>
                            <th>@Loc["Societe.ColStatus"]</th>
                            <th>@Loc["File.ColArrival"]</th>
                            <th>@Loc["FileFactExp.ColDraftIn"]</th>
                            <th>@Loc["Proforma.ColProformaFacture"]</th>
                            <th class="text-end">@Loc["FileFactExp.ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in _pagination1.Appliquer(_tickets))
                        {
                            var t = ticket;
                            <tr>
                                <td>
                                    <a href="/tickets/@t.Id" class="fw-bold text-decoration-none text-primary font-monospace">
                                        @t.Numero
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark font-monospace">@t.NumeroBooking</span>
                                    <ClientTicket DossierId="t.DossierId" /><PrisEnChargePar Ticket="t" AgentId="_agentId" />
                                </td>
                                <td>
                                    <StatutBadge Statut="@t.Statut" />
                                </td>
                                <td class="small text-muted font-monospace">
                                    @t.DateArriveeEnFileUtc.Horodate()
                                </td>
                                <td>
                                    @* RG-EXP-03 : le Draft IN précède la facture. *@
                                    @if (t.DraftInExportEmis)
                                    {
                                        @* REMÉDIATION UI-20 : la date d'émission n'était portée que
                                           par un attribut title (invisible au tactile et aux lecteurs
                                           d'écran) — elle est désormais affichée. *@
                                        <span class="badge bg-success-subtle text-success">@Loc["FileFactExp.DraftEmitted"]</span>
                                        @if (t.DraftInExportEmisLeUtc is DateTime emisLe)
                                        {
                                            <div class="small text-muted mt-1">@Loc["FileFactExp.EmittedOnPrefix"] @emisLe.Horodate()</div>
                                        }
                                    }
                                    else
                                    {
                                        <InputFile class="form-control form-control-sm" OnChange="e => DemanderConfirmation(t, e, EmettreDraftInAsync)" />
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (t.DraftInExportEmis)
                                        {
                                            <div>
                                                @if (t.EtatProforma == EtatProforma.Validee)
                                                {
                                                    <span class="badge bg-success-subtle text-success mb-1">✅ @Loc["Proforma.Validee"]</span>
                                                }
                                                else
                                                {
                                                    <CelluleProforma Ticket="t" AgentId="_agentId" Termine="ProformaTermineeAsync" />
                                                }
                                                @if (CIT.Plateforme.Application.BillingImport.GestionProformaCommand.FacturePermise(t))
                                                {
                                                    @if (t.EtatProforma == EtatProforma.Aucune)
                                                    {
                                                        <div class="small text-muted mt-2">@Loc["Proforma.OuFactureDirecte"]</div>
                                                    }
                                                    <InputFile class="form-control form-control-sm" OnChange="e => DemanderConfirmation(t, e, EditerFactureAsync)" />
                                                }
                                                @if (t.ReglementDeclareUtc is not null)
                                                {
                                                    @* Écart 06/10 #2 (export), mode déclaratif : le client a déclaré le règlement, le facturier confirme. *@
                                                    <div class="small text-info mt-2">🕗 @Loc["Reglement.EnAttenteConfirmation"]</div>
                                                    <button type="button" class="btn btn-success btn-sm mt-1" @onclick="() => ConfirmerReglementAsync(t.Id)">✅ @Loc["Reglement.Confirmer"]</button>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="small text-muted">@Loc["FileFactExp.DraftInRequired"]</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end">
                                    <a href="/tickets/@t.Id" class="btn btn-outline-secondary btn-sm" title="@Loc["File.SheetTitle"]">
                                        @Loc["File.Sheet"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }
}

@* Le dépôt clôture ou facture le dossier — irréversible : on confirme le dossier et le fichier. *@
<ModaleConfirmation EstOuvert="@(_aConfirmer is not null)"
                    Titre="@Loc["FileAct.ConfirmTitle"]"
                    Message="@(_aConfirmer is { } c ? Loc["FileAct.ConfirmMessage", c.Ticket.Numero, c.Ticket.NumeroBl ?? c.Ticket.NumeroBooking ?? "—", c.Fichier.File.Name].Value : string.Empty)"
                    BoutonConfirmerLibelle="@Loc["FileAct.ConfirmButton"]"
                    BoutonConfirmerClass="btn-primary"
                    Desactive="@_confirmationEnCours"
                    OnConfirmer="ConfirmerDepotAsync"
                    OnAnnuler="() => _aConfirmer = null" />

@code {
    private sealed record DepotAConfirmer(Ticket Ticket, InputFileChangeEventArgs Fichier, Func<Guid, InputFileChangeEventArgs, Task> Action);
    private DepotAConfirmer? _aConfirmer;
    private bool _confirmationEnCours;

    private void DemanderConfirmation(Ticket ticket, InputFileChangeEventArgs e, Func<Guid, InputFileChangeEventArgs, Task> action) =>
        _aConfirmer = new DepotAConfirmer(ticket, e, action);

    private async Task ConfirmerDepotAsync()
    {
        if (_aConfirmer is not { } depot) return;
        _confirmationEnCours = true;
        try
        {
            await depot.Action(depot.Ticket.Id, depot.Fichier);
        }
        finally
        {
            _confirmationEnCours = false;
            _aConfirmer = null;
        }
    }

    private readonly EtatPagination _pagination1 = new();

    private static readonly ReglesDepotDocument Regles = new(["pdf", "jpg", "png"], TailleMaxOctets: 10 * 1024 * 1024);

    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;
    private Guid _agentId;

    private IReadOnlyList<Ticket> _tickets = [];
    private string? _message;
    private bool _erreur;

    protected override async Task OnInitializedAsync()
    {
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _message = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || contexte.Nature == NatureUtilisateur.Client)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["FileFactExp.NotAuthorized"].Value;
                return;
            }

            _agentId = contexte.UtilisateurId;
            _tickets = await ConsulterFile.ExecuterAsync(
                _agentId,
                NomsFilesExport.Facturation,
                [Permission.BillingExportFacturationEditer]);
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = MessagesUtilisateur.Texte(ex);
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    /// <summary>RG-EXP-03 — émission du Draft IN, préalable à l'édition de la facture.</summary>
    private async Task EmettreDraftInAsync(Guid ticketId, InputFileChangeEventArgs e)
    {
        _message = null;
        _erreur = false;

        var fichier = e.File;
        if (fichier is null) return;

        try
        {
            using var stream = fichier.OpenReadStream(maxAllowedSize: Regles.TailleMaxOctets);
            await EmettreDraftIn.ExecuterAsync(
                _agentId,
                ticketId,
                fichier.Name,
                fichier.ContentType,
                stream,
                fichier.Size,
                Regles);

            _erreur = false;
            _message = string.Format(Loc["FileFactExp.DraftIssued"].Value, fichier.Name);
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = string.Format(Loc["FileFactExp.DraftError"].Value, MessagesUtilisateur.Pour(ex));
        }
    }

    private async Task ProformaTermineeAsync((string Message, bool Erreur) resultat)
    {
        await ChargerAsync();
        _message = resultat.Message;
        _erreur = resultat.Erreur;
    }

    private async Task ConfirmerReglementAsync(Guid ticketId)
    {
        _message = null;
        try
        {
            await ReglementDeclaratifExport.ConfirmerAsync(_agentId, ticketId);
            _message = Loc["Reglement.MsgConfirmee"].Value;
            _erreur = false;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _message = MessagesUtilisateur.Pour(ex);
            _erreur = true;
        }
    }

    private async Task EditerFactureAsync(Guid ticketId, InputFileChangeEventArgs e)
    {
        _message = null;
        _erreur = false;

        var fichier = e.File;
        if (fichier is null) return;

        try
        {
            using var stream = fichier.OpenReadStream(maxAllowedSize: Regles.TailleMaxOctets);
            await EditerFacture.ExecuterAsync(
                _agentId,
                ticketId,
                fichier.Name,
                fichier.ContentType,
                stream,
                fichier.Size,
                Regles);

            _erreur = false;
            _message = string.Format(Loc["FileFactExp.InvoiceIssued"].Value, fichier.Name);
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = string.Format(Loc["FileFactExp.InvoiceError"].Value, MessagesUtilisateur.Pour(ex));
        }
    }
}
