@page "/billing-export/validation-paiement"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.BillingExport
@using CIT.Plateforme.Application.Documents
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Documents
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@inject IContexteUtilisateurWeb ContexteService
@inject ValiderPreuvePaiementExportCommand ValiderPreuve
@inject ConsulterFileBillingExportQuery ConsulterFile

<PageTitle>Validation Paiement EXPORT — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>💰</span> File Validation Paiement EXPORT
        </h2>
        <div class="cit-page-subtitle">Instruction des règlements et validation des encaissements Export</div>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="ChargerAsync">🔄 Actualiser la file</button>
        <a href="/agent/dashboard" class="btn btn-outline-primary btn-sm shadow-sm">Mon tableau de bord</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement des paiements Export en attente..." />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_message is not null)
    {
        <div class="alert @(_erreur ? "alert-danger" : "alert-success") mb-3">@_message</div>
    }

    @if (_tickets.Count == 0)
    {
        <EtatVide Titre="Aucun paiement en attente"
                  Description="Toutes les preuves de paiement Export ont été validées ou instruites."
                  Icone="💳" />
    }
    else
    {
        <div class="cit-card mb-4 p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>N° Ticket</th>
                            <th>Numéro Booking</th>
                            <th>Statut</th>
                            <th>Arrivée en file</th>
                            <th class="text-end">Décision</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in _tickets)
                        {
                            var t = ticket;
                            <tr>
                                <td>
                                    <a href="/tickets/@t.Id" class="fw-bold text-decoration-none text-primary font-monospace">
                                        @t.Numero
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark font-monospace">@t.NumeroBooking</span>
                                </td>
                                <td>
                                    <StatutBadge Statut="@t.Statut" />
                                </td>
                                <td class="small text-muted font-monospace">
                                    @t.DateArriveeEnFileUtc.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/tickets/@t.Id" class="btn btn-outline-secondary" title="Consulter la fiche">
                                            🔍 Fiche
                                        </a>
                                        <button class="btn btn-outline-success" @onclick="() => ValiderPaiementAsync(t.Id)" title="Valider le paiement">
                                            ✅ Valider paiement
                                        </button>
                                        <button class="btn btn-outline-danger" @onclick="() => OuvrirModalRefus(t.Id)" title="Refuser la preuve">
                                            ❌ Preuve non conforme
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@if (_ticketIdPourRefus.HasValue)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger">Refus de la preuve de paiement</h5>
                    <button type="button" class="btn-close" @onclick="FermerModal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Le ticket passera en attente client et le client sera notifié pour déposer une nouvelle preuve.</p>
                    <label for="motif-du-refus-obligatoire" class="form-label fw-semibold">Motif du refus (obligatoire)</label>
                    <textarea id="motif-du-refus-obligatoire" class="form-control" rows="3" @bind="_motifRefus" placeholder="Montant non concordant, virement non visible sur le compte..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="FermerModal">Annuler</button>
                    <button type="button" class="btn btn-danger fw-bold" disabled="@string.IsNullOrWhiteSpace(_motifRefus)" @onclick="ConfirmerRefusAsync">
                        Confirmer le refus
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;
    private Guid _agentId;

    private IReadOnlyList<Ticket> _tickets = [];
    private string? _message;
    private bool _erreur;

    private Guid? _ticketIdPourRefus;
    private string _motifRefus = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _message = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || contexte.Nature == NatureUtilisateur.Client)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Cet espace est strictement réservé aux agents habilités à valider les paiements.";
                return;
            }

            _agentId = contexte.UtilisateurId;
            _tickets = await ConsulterFile.ExecuterAsync(
                _agentId,
                NomsFilesExport.ValidationPaiement,
                [Permission.BillingExportPaiementValider]);
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ValiderPaiementAsync(Guid ticketId)
    {
        _message = null;
        _erreur = false;
        try
        {
            await ValiderPreuve.ValiderAsync(_agentId, ticketId);
            _message = "Paiement validé. Le ticket a été transmis au Contrôle Documentaire.";
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = ex.Message;
        }
    }

    private void OuvrirModalRefus(Guid ticketId)
    {
        _ticketIdPourRefus = ticketId;
        _motifRefus = string.Empty;
    }

    private void FermerModal()
    {
        _ticketIdPourRefus = null;
        _motifRefus = string.Empty;
    }

    private async Task ConfirmerRefusAsync()
    {
        if (!_ticketIdPourRefus.HasValue || string.IsNullOrWhiteSpace(_motifRefus)) return;
        _message = null;
        _erreur = false;
        try
        {
            await ValiderPreuve.RefuserAsync(_agentId, _ticketIdPourRefus.Value, _motifRefus);
            _message = "La preuve a été refusée et le client a été invité à déposer un nouveau document.";
            FermerModal();
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = ex.Message;
        }
    }
}
