@page "/billing-export/validation-paiement"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.BillingExport
@using CIT.Plateforme.Application.Documents
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Documents
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ValiderPreuvePaiementExportCommand ValiderPreuve
@inject ConsulterFileBillingExportQuery ConsulterFile

<PageTitle>@Loc["FilePayExp.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>💰</span> @Loc["FilePayExp.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["FilePayExp.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="ChargerAsync">@Loc["File.Refresh"]</button>
        <a href="/agent/dashboard" class="btn btn-outline-primary btn-sm shadow-sm">@Loc["File.MyDashboard"]</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["FilePayExp.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_message is not null)
    {
        <div class="alert @(_erreur ? "alert-danger" : "alert-success") mb-3">@_message</div>
    }

    @if (_tickets.Count == 0)
    {
        <EtatVide Titre="@Loc["FilePayExp.EmptyTitle"]"
                  Description="@Loc["FilePayExp.EmptyDesc"]"
                  Icone="💳" />
    }
    else
    {
        <div class="cit-card mb-4 p-0 overflow-hidden">
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["AvoirExoList.ColTicket"]</th>
                            <th>@Loc["File.ColBooking"]</th>
                            <th>@Loc["Societe.ColStatus"]</th>
                            <th>@Loc["File.ColArrival"]</th>
                            <th class="text-end">@Loc["FilePayExp.ColDecision"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in _pagination1.Appliquer(_tickets))
                        {
                            var t = ticket;
                            <tr>
                                <td>
                                    <a href="/tickets/@t.Id" class="fw-bold text-decoration-none text-primary font-monospace">
                                        @t.Numero
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark font-monospace">@t.NumeroBooking</span>
                                </td>
                                <td>
                                    <StatutBadge Statut="@t.Statut" />
                                </td>
                                <td class="small text-muted font-monospace">
                                    @t.DateArriveeEnFileUtc.Horodate()
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/tickets/@t.Id" class="btn btn-outline-secondary" title="@Loc["File.SheetTitle"]">
                                            @Loc["File.Sheet"]
                                        </a>
                                        <button type="button" class="btn btn-outline-success" @onclick="() => ValiderPaiementAsync(t.Id)" title="@Loc["FilePayExp.ValidateTitle"]">
                                            @Loc["FilePayExp.Validate"]
                                        </button>
                                        <button type="button" class="btn btn-outline-danger" @onclick="() => OuvrirModalRefus(t.Id)" title="@Loc["FilePayExp.RefuseTitle"]">
                                            @Loc["FilePayExp.Refuse"]
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }
}

@if (_ticketIdPourRefus.HasValue)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger">@Loc["FilePayExp.ModalTitle"]</h5>
                    <button type="button" class="btn-close" @onclick="FermerModal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">@Loc["FilePayExp.ModalHint"]</p>
                    <label for="motif-du-refus-obligatoire" class="form-label fw-semibold">@Loc["FilePayExp.MotifLabel"]</label>
                    <textarea id="motif-du-refus-obligatoire" class="form-control" rows="3" @bind="_motifRefus" placeholder="@Loc["FilePayExp.MotifPlaceholder"]"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="FermerModal">@Loc["Common.Cancel"]</button>
                    <button type="button" class="btn btn-danger fw-bold" disabled="@string.IsNullOrWhiteSpace(_motifRefus)" @onclick="ConfirmerRefusAsync">
                        @Loc["FilePayExp.ConfirmRefuse"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;
    private Guid _agentId;

    private IReadOnlyList<Ticket> _tickets = [];
    private string? _message;
    private bool _erreur;

    private Guid? _ticketIdPourRefus;
    private string _motifRefus = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _message = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || contexte.Nature == NatureUtilisateur.Client)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["FilePayExp.NotAuthorized"].Value;
                return;
            }

            _agentId = contexte.UtilisateurId;
            _tickets = await ConsulterFile.ExecuterAsync(
                _agentId,
                NomsFilesExport.ValidationPaiement,
                [Permission.BillingExportPaiementValider]);
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ValiderPaiementAsync(Guid ticketId)
    {
        _message = null;
        _erreur = false;
        try
        {
            await ValiderPreuve.ValiderAsync(_agentId, ticketId);
            _message = Loc["FilePayExp.Validated"].Value;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = MessagesUtilisateur.Pour(ex);
        }
    }

    private void OuvrirModalRefus(Guid ticketId)
    {
        _ticketIdPourRefus = ticketId;
        _motifRefus = string.Empty;
    }

    private void FermerModal()
    {
        _ticketIdPourRefus = null;
        _motifRefus = string.Empty;
    }

    private async Task ConfirmerRefusAsync()
    {
        if (!_ticketIdPourRefus.HasValue || string.IsNullOrWhiteSpace(_motifRefus)) return;
        _message = null;
        _erreur = false;
        try
        {
            await ValiderPreuve.RefuserAsync(_agentId, _ticketIdPourRefus.Value, _motifRefus);
            _message = Loc["FilePayExp.Refused"].Value;
            FermerModal();
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = MessagesUtilisateur.Pour(ex);
        }
    }
}
