@page "/billing-export/ies"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.BillingExport
@using CIT.Plateforme.Application.BillingImport
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject InstruireBrancheIesExportCommand Instruire
@inject ConstaterJointureIesExportEtFinaliserCommand ConstaterJointure
@inject ConsulterFileBillingExportQuery ConsulterFile
@inject ConsulterSuivisBranchesIesExportQuery ConsulterSuivis

<PageTitle>@Loc["FileIesExp.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>⚡</span> @Loc["FileIesExp.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["FileIesExp.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="ChargerAsync">@Loc["File.Refresh"]</button>
        <a href="/agent/dashboard" class="btn btn-outline-primary btn-sm shadow-sm">@Loc["File.MyDashboard"]</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["FileIesExp.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_message is not null)
    {
        <div class="alert @(_erreur ? "alert-danger" : "alert-success") mb-3">@_message</div>
    }

    @if (_tickets.Count == 0)
    {
        <EtatVide Titre="@Loc["FileIesExp.EmptyTitle"]"
                  Description="@Loc["FileIesExp.EmptyDesc"]"
                  Icone="🚢" />
    }
    else
    {
        <div class="cit-card mb-4 p-0 overflow-hidden">
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["AvoirExoList.ColTicket"]</th>
                            <th>@Loc["File.ColBooking"]</th>
                            <th>@Loc["FileIesExp.ColBackOffice"]</th>
                            <th>@Loc["FileIesExp.ColDocControl"]</th>
                            <th class="text-end">@Loc["FileBoExp.ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in _pagination1.Appliquer(_tickets))
                        {
                            var t = ticket;
                            var vue = _vueParTicket.TryGetValue(t.Id, out var v) ? v : null;
                            var suivis = vue?.Suivis ?? [];
                            // RG-SEC-01 : symétrique de l'import.
                            bool peutInstruireBackOffice = vue?.PeutInstruireManifeste == true;
                            bool peutInstruireControleDoc = vue?.PeutInstruireControleDocumentaire == true;
                            var backOffice = suivis.SingleOrDefault(x => x.Branche == BrancheIes.BackOffice);
                            var controleDoc = suivis.SingleOrDefault(x => x.Branche == BrancheIes.ControleDocumentaire);
                            bool boAchevee = backOffice?.EstTerminee == true;
                            bool docAchevee = controleDoc?.EstTerminee == true;

                            <tr>
                                <td>
                                    <a href="/tickets/@t.Id" class="fw-bold text-decoration-none text-primary font-monospace">
                                        @t.Numero
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark font-monospace">@t.NumeroBooking</span>
                                    <ClientTicket DossierId="t.DossierId" />
                                </td>
                                <td>
                                    @if (boAchevee)
                                    {
                                        <span class="badge bg-success-subtle text-success">@Loc["File.Done"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">@Loc["File.InProgress"]</span>
                                    }
                                </td>
                                <td>
                                    @if (docAchevee)
                                    {
                                        <span class="badge bg-success-subtle text-success">@Loc["File.Done"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">@Loc["File.InProgress"]</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/tickets/@t.Id" class="btn btn-outline-secondary" title="@Loc["File.SheetTitle"]">
                                            @Loc["File.Sheet"]
                                        </a>
                                        @if (!boAchevee && peutInstruireBackOffice)
                                        {
                                            <button type="button" class="btn btn-outline-primary" @onclick="() => AcheverAsync(t.Id, BrancheIes.BackOffice)">
                                                @Loc["FileIesExp.CompleteBackOffice"]
                                            </button>
                                        }
                                        @if (!docAchevee && peutInstruireControleDoc)
                                        {
                                            <button type="button" class="btn btn-outline-primary" @onclick="() => AcheverAsync(t.Id, BrancheIes.ControleDocumentaire)">
                                                @Loc["FileIesExp.CompleteDocControl"]
                                            </button>
                                        }
                                        @if (boAchevee && docAchevee)
                                        {
                                            <button type="button" class="btn btn-success" @onclick="() => FinaliserAsync(t.Id)">
                                                @Loc["FileIes.JoinAndClose"]
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;

    private Guid _agentId;
    private List<Ticket> _tickets = [];
    private Dictionary<Guid, VueBranchesIes> _vueParTicket = [];
    private string? _message;
    private bool _erreur;

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["File.LoginRequired"].Value;
                return;
            }

            _agentId = contexte.UtilisateurId;
            await ChargerAsync();
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ChargerAsync()
    {
        _message = null;
        try
        {
            var rawTickets = await ConsulterFile.ExecuterAsync(
                _agentId,
                NomsFilesExport.FileIes,
                [
                    Permission.BillingExportIesBackOfficeInstruire,
                    Permission.BillingExportIesControleDocumentaireInstruire
                ]);

            _tickets = rawTickets.ToList();
            _vueParTicket.Clear();

            foreach (var t in _tickets)
            {
                _vueParTicket[t.Id] = await ConsulterSuivis.ExecuterAsync(_agentId, t.Id);
            }
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = MessagesUtilisateur.Pour(ex);
        }
    }

    private async Task AcheverAsync(Guid ticketId, BrancheIes branche)
    {
        _message = null;
        _erreur = false;
        try
        {
            await Instruire.ExecuterAsync(_agentId, ticketId, branche);
            _message = string.Format(Loc["FileIesExp.BranchCompleted"].Value, branche);
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = MessagesUtilisateur.Pour(ex);
        }
    }

    private async Task FinaliserAsync(Guid ticketId)
    {
        _message = null;
        _erreur = false;
        try
        {
            await ConstaterJointure.ExecuterAsync(_agentId, ticketId);
            _message = Loc["FileIesExp.JoinDone"].Value;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = MessagesUtilisateur.Pour(ex);
        }
    }
}
