@page "/billing-export/back-office"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.BillingExport
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ValiderTicketExportCommand Valider
@inject RejeterTicketExportCommand Rejeter
@inject GestionComplementExportCommand Complement
@inject ConsulterFileBillingExportQuery ConsulterFile

<PageTitle>@Loc["FileBoExp.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>📦</span> @Loc["FileBoExp.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["FileBoExp.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm shadow-sm" @onclick="ChargerAsync">@Loc["File.Refresh"]</button>
        <a href="/agent/dashboard" class="btn btn-outline-primary btn-sm shadow-sm">@Loc["File.MyDashboard"]</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["FileBoExp.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-3" role="alert">@_erreur</div>
    }

    @if (!string.IsNullOrWhiteSpace(_actionSuccess))
    {
        <div class="alert alert-success py-2 small mb-3" role="status">@_actionSuccess</div>
    }

    @if (_tickets.Count == 0)
    {
        <EtatVide Titre="@Loc["FileBoExp.EmptyTitle"]"
                  Description="@Loc["FileBoExp.EmptyDesc"]"
                  Icone="📦" />
    }
    else
    {
        <div class="cit-card mb-4 p-0 overflow-hidden">
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["AvoirExoList.ColTicket"]</th>
                            <th>@Loc["File.ColBooking"]</th>
                            <th>@Loc["Societe.ColStatus"]</th>
                            <th>@Loc["File.ColArrival"]</th>
                            <th class="text-end">@Loc["FileBoExp.ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in _pagination1.Appliquer(_tickets))
                        {
                            var t = ticket;
                            <tr>
                                <td>
                                    <a href="/tickets/@t.Id" class="fw-bold text-decoration-none text-primary font-monospace">
                                        @t.Numero
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark font-monospace">@t.NumeroBooking</span>
                                    <ClientTicket DossierId="t.DossierId" />
                                </td>
                                <td>
                                    <StatutBadge Statut="@t.Statut" />
                                </td>
                                <td class="small text-muted font-monospace">
                                    @t.DateArriveeEnFileUtc.Horodate()
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/tickets/@t.Id" class="btn btn-outline-secondary" title="@Loc["File.SheetTitle"]">
                                            @Loc["File.Sheet"]
                                        </a>
                                        <button type="button" class="btn btn-outline-success" @onclick="() => ValiderAsync(t.Id)" title="@Loc["FileBoExp.ValidateTitle"]">
                                            @Loc["FileBoExp.Validate"]
                                        </button>
                                        <button type="button" class="btn btn-outline-warning" @onclick="() => OuvrirModalComplement(t.Id)" title="@Loc["FileBoExp.ComplementTitle"]">
                                            @Loc["FileBoExp.Complement"]
                                        </button>
                                        <button type="button" class="btn btn-outline-danger" @onclick="() => OuvrirModalRejet(t.Id)" title="@Loc["FileBoExp.RejectTitle"]">
                                            @Loc["FileBoExp.Reject"]
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }
}

@if (_ticketIdPourAction.HasValue && _modeModal == "rejet")
{
    <div class="modal show d-block u-voile" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger">@Loc["FileBoExp.RejectModalTitle"]</h5>
                    <button type="button" class="btn-close" @onclick="FermerModal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">@Loc["FileBoExp.RejectModalHint"]</p>
                    <label for="motif-du-rejet-obligatoire" class="form-label fw-semibold">@Loc["FileBoExp.RejectMotifLabel"]</label>
                    <textarea id="motif-du-rejet-obligatoire" class="form-control" rows="3" @bind="_texteAction" placeholder="@Loc["FileBoExp.RejectMotifPlaceholder"]"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="FermerModal">@Loc["Common.Cancel"]</button>
                    <button type="button" class="btn btn-danger fw-bold" disabled="@string.IsNullOrWhiteSpace(_texteAction)" @onclick="ConfirmerRejetAsync">
                        @Loc["FileBoExp.ConfirmReject"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_ticketIdPourAction.HasValue && _modeModal == "complement")
{
    <div class="modal show d-block u-voile" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-warning text-dark">@Loc["FileBoExp.ComplementModalTitle"]</h5>
                    <button type="button" class="btn-close" @onclick="FermerModal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">@Loc["FileBoExp.ComplementModalHint"]</p>
                    <label for="elements-attendus" class="form-label fw-semibold">@Loc["FileBoExp.ComplementLabel"]</label>
                    <textarea id="elements-attendus" class="form-control" rows="3" @bind="_texteAction" placeholder="@Loc["FileBoExp.ComplementPlaceholder"]"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="FermerModal">@Loc["Common.Cancel"]</button>
                    <button type="button" class="btn btn-warning fw-bold" disabled="@string.IsNullOrWhiteSpace(_texteAction)" @onclick="ConfirmerComplementAsync">
                        @Loc["FileBoExp.SendRequest"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;
    private Guid _agentId;

    private IReadOnlyList<Ticket> _tickets = [];
    private string? _erreur;
    private string? _actionSuccess;

    private Guid? _ticketIdPourAction;
    private string _modeModal = string.Empty;
    private string _texteAction = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || contexte.Nature == NatureUtilisateur.Client)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["FileBoExp.NotAuthorized"].Value;
                return;
            }

            _agentId = contexte.UtilisateurId;
            _tickets = await ConsulterFile.ExecuterAsync(
                _agentId,
                NomsFilesExport.BackOfficeExport,
                [Permission.BillingExportBackOfficeInstruire]);
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = MessagesUtilisateur.Texte(ex);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ValiderAsync(Guid ticketId)
    {
        _erreur = null;
        _actionSuccess = null;
        try
        {
            await Valider.ExecuterAsync(_agentId, ticketId);
            _actionSuccess = Loc["FileBoExp.Validated"].Value;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private void OuvrirModalRejet(Guid ticketId)
    {
        _ticketIdPourAction = ticketId;
        _modeModal = "rejet";
        _texteAction = string.Empty;
    }

    private void OuvrirModalComplement(Guid ticketId)
    {
        _ticketIdPourAction = ticketId;
        _modeModal = "complement";
        _texteAction = string.Empty;
    }

    private void FermerModal()
    {
        _ticketIdPourAction = null;
        _modeModal = string.Empty;
        _texteAction = string.Empty;
    }

    private async Task ConfirmerRejetAsync()
    {
        if (!_ticketIdPourAction.HasValue || string.IsNullOrWhiteSpace(_texteAction)) return;
        _erreur = null;
        try
        {
            await Rejeter.ExecuterAsync(_agentId, _ticketIdPourAction.Value, _texteAction);
            _actionSuccess = Loc["FileBoExp.Rejected"].Value;
            FermerModal();
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private async Task ConfirmerComplementAsync()
    {
        if (!_ticketIdPourAction.HasValue || string.IsNullOrWhiteSpace(_texteAction)) return;
        _erreur = null;
        try
        {
            await Complement.DemanderComplementAsync(_agentId, _ticketIdPourAction.Value, _texteAction);
            _actionSuccess = Loc["FileBoExp.ComplementSent"].Value;
            FermerModal();
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }
}
