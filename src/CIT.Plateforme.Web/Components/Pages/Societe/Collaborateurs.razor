@page "/societe/collaborateurs"
@page "/comptes/collaborateurs"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Abstractions
@using CIT.Plateforme.Application.Comptes
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Societe
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Comptes
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirDashboardSocieteQuery DashboardQuery
@inject RattacherUtilisateurCommand Rattacher
@inject ActiverDesactiverUtilisateurCommand ActiverDesactiver
@inject ModifierDroitsUtilisateurCommand ModifierDroits
@inject GererRoleAdministrateurCommand GererRole
@inject InviterCollaborateurCommand InviterCollaborateur
@inject ListerInvitationsQuery ListerInvitations
@inject RevoquerInvitationCommand RevoquerInvitation
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Gestion des Collaborateurs — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>👥</span> Gestion des Collaborateurs
        </h2>
        <div class="cit-page-subtitle">
            @if (_dashboard is not null)
            {
                <span>Société <strong class="text-dark">@_dashboard.SocieteNom</strong> · Administrateurs actifs : <span class="badge bg-primary-subtle text-primary">@_dashboard.NombreAdministrateursActifs</span></span>
            }
        </div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/societe/dashboard" class="btn btn-outline-secondary btn-sm">
            ← Retour Espace Entreprise
        </a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement des collaborateurs..." />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger">@_erreur</div>
}
else if (_dashboard is not null)
{
    <!-- Formulaire d'ajout / rattachement de collaborateur -->
    <div class="cit-card mb-4">
        <h6 class="fw-bold mb-2 text-dark">Rattacher un nouveau collaborateur</h6>
        <p class="small text-muted mb-3">Saisissez l'identifiant unique du compte utilisateur pour l'intégrer à votre espace entreprise.</p>
        
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-8">
                <input type="text" class="form-control font-monospace" placeholder="Identifiant UUID du collaborateur..." @bind="_nouveauCollaborateurId" />
            </div>
            <div class="col-12 col-md-4">
                <button type="button" class="btn btn-primary w-100" @onclick="RattacherAsync" disabled="@string.IsNullOrWhiteSpace(_nouveauCollaborateurId)">
                    <span>➕</span> Rattacher à l'entreprise
                </button>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_actionMessage))
        {
            <div class="alert alert-info mt-3 py-2 small mb-0">@_actionMessage</div>
        }
    </div>

    @* ENT-01 — INVITATION. Le rattachement ci-dessus suppose un compte deja existant ; or le
       seul parcours d'inscription ouvre aussi une demande de societe. Un collaborateur devait
       donc creer une societe parasite pour obtenir un compte. L'invitation ouvre la voie
       manquante : le collaborateur cree son compte et rejoint CETTE societe, sans qu'aucune
       demande supplementaire ne soit deposee.

       Aucun envoi automatique : la plateforme n'a pas de fournisseur d'e-mail. Le lien est
       affiche ici pour que vous le transmettiez par vos propres moyens. *@
    <div class="cit-card mb-4">
        <h6 class="fw-bold text-dark mb-1">Inviter un nouveau collaborateur</h6>
        <p class="small text-muted">
            Pour une personne qui n'a pas encore de compte sur la plateforme.
        </p>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-8">
                <label class="form-label small fw-bold" for="emailInvite">Adresse e-mail professionnelle</label>
                <input id="emailInvite" class="form-control form-control-sm" @bind="_emailInvite" />
            </div>
            <div class="col-12 col-md-4">
                <button type="button" class="btn btn-outline-primary w-100" @onclick="InviterAsync"
                        disabled="@string.IsNullOrWhiteSpace(_emailInvite)">
                    <span>✉️</span> Créer une invitation
                </button>
            </div>
        </div>

        @if (_invitations is not null && _invitations.Count > 0)
        {
            <div class="table-responsive mt-3">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Invité</th>
                            <th>État</th>
                            <th>Échéance</th>
                            <th>Lien à transmettre</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invitation in _invitations)
                        {
                            <tr>
                                <td class="fw-bold">@invitation.Email</td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@invitation.Etat</span></td>
                                <td class="small text-muted">@invitation.DateExpirationUtc.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (invitation.Etat == EtatInvitation.EnAttente)
                                    {
                                        <input class="form-control form-control-sm font-monospace"
                                               style="font-size: .7rem;" readonly
                                               value="@LienInvitation(invitation.Jeton)" />
                                    }
                                    else
                                    {
                                        <span class="small text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (invitation.Etat == EtatInvitation.EnAttente)
                                    {
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="() => RevoquerAsync(invitation.Id)">Révoquer</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Liste des collaborateurs avec actions -->
    <div class="cit-card mb-4 p-0 overflow-hidden">
        <div class="p-3 bg-light border-bottom">
            <h6 class="fw-bold m-0 text-dark">Collaborateurs actifs et historiques</h6>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nom & E-mail</th>
                        <th>Rôle</th>
                        <th>Droit Soumission</th>
                        <th>Périmètre Consultation</th>
                        <th>Statut</th>
                        <th class="text-end">Actions Administrateur</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _dashboard.Collaborateurs)
                    {
                        var col = c;
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@col.NomAffiche</div>
                                <div class="small text-muted">@col.Email</div>
                            </td>
                            <td>
                                @if (col.EstAdministrateur)
                                {
                                    <span class="badge bg-primary">Administrateur</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">Collaborateur</span>
                                }
                            </td>
                            <td>
                                @if (col.DroitSoumission)
                                {
                                    <span class="text-success fw-semibold">✅ Autorisé</span>
                                }
                                else
                                {
                                    <span class="text-muted">❌ Bloqué</span>
                                }
                            </td>
                            <td>
                                <span class="small">
                                    @(col.DroitConsultation == DroitConsultation.ToutesDemandesSociete ? "🌐 Toute la société" : "👤 Propres dossiers")
                                </span>
                            </td>
                            <td>
                                @if (col.EstActif)
                                {
                                    <span class="badge bg-success text-white">Actif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white">Désactivé</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <!-- Rôle Admin -->
                                    @if (col.EstAdministrateur)
                                    {
                                        <button type="button" class="btn btn-outline-secondary" title="Retirer droits admin" @onclick="() => RetirerRoleAdminAsync(col.Id)">
                                            Rétrograder
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-primary" title="Nommer administrateur" @onclick="() => NommerAdminAsync(col.Id)">
                                            Nommer admin
                                        </button>
                                    }

                                    <!-- Droit Soumission -->
                                    <button type="button" class="btn btn-outline-secondary" title="Basculer droit soumission" @onclick="() => BasculerSoumissionAsync(col)">
                                        @(col.DroitSoumission ? "Bloquer soumission" : "Autoriser soumission")
                                    </button>

                                    <!-- Droit Consultation -->
                                    <button type="button" class="btn btn-outline-secondary" title="Basculer consultation" @onclick="() => BasculerConsultationAsync(col)">
                                        @(col.DroitConsultation == DroitConsultation.ToutesDemandesSociete ? "Restreindre" : "Étendre")
                                    </button>

                                    <!-- Activation / Désactivation -->
                                    @if (col.EstActif)
                                    {
                                        <button type="button" class="btn btn-outline-danger" title="Désactiver collaborateur" @onclick="() => DesactiverAsync(col.Id)">
                                            Désactiver
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-success" title="Réactiver collaborateur" @onclick="() => ActiverAsync(col.Id)">
                                            Réactiver
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool _chargement = true;
    private string? _erreur;
    private string? _actionMessage;
    private DashboardSocieteVue? _dashboard;
    private string _nouveauCollaborateurId = string.Empty;
    private string _emailInvite = string.Empty;
    private IReadOnlyList<InvitationVue>? _invitations;

    /// <summary>
    /// Duree de validite d'une invitation, en jours.
    ///
    /// Le CDC n'en fixe aucune. Plutot que de la figer ici, elle est PARAMETRABLE : le metier
    /// l'ajuste sans developpement, comme pour l'expiration de session. La valeur de repli de
    /// 7 jours est un defaut technique, pas une regle metier — elle existe parce qu'un jeton
    /// porteur sans echeance serait un defaut de securite, et parce que 7 jours couvre une
    /// semaine ouvree tout en bornant la fenetre d'exposition.
    /// </summary>
    private TimeSpan ValiditeInvitation =>
        TimeSpan.FromDays(Configuration.GetValue("Comptes:ValiditeInvitationJours", 7));
    private Guid _appelantId;
    private Guid _societeId;

    protected override async Task OnInitializedAsync()
    {
        await RechargerAsync();
    }

    private async Task RechargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue || !contexte.EstAdministrateurSociete)
            {
                _erreur = "Accès réservé aux administrateurs de la société.";
                return;
            }

            _appelantId = contexte.UtilisateurId;
            _societeId = contexte.SocieteId.Value;
            _dashboard = await DashboardQuery.ExecuterAsync(_appelantId, _societeId);
            _invitations = await ListerInvitations.ExecuterAsync(_appelantId, _societeId);
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task RattacherAsync()
    {
        if (!Guid.TryParse(_nouveauCollaborateurId, out var nouvId))
        {
            _actionMessage = "Format d'identifiant UUID invalide.";
            return;
        }

        try
        {
            await Rattacher.ExecuterAsync(_appelantId, _societeId, nouvId);
            _nouveauCollaborateurId = string.Empty;
            _actionMessage = "Collaborateur rattaché avec succès.";
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"Erreur : {ex.Message}";
        }
    }

    private async Task NommerAdminAsync(Guid rattachementId)
    {
        try
        {
            await GererRole.AttribuerRoleAsync(_appelantId, rattachementId);
            _actionMessage = "Rôle administrateur attribué.";
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"Erreur : {ex.Message}";
        }
    }

    private async Task RetirerRoleAdminAsync(Guid rattachementId)
    {
        try
        {
            await GererRole.RetirerRoleAsync(_appelantId, rattachementId);
            _actionMessage = "Rôle administrateur retiré.";
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"Erreur : {ex.Message}";
        }
    }

    private async Task BasculerSoumissionAsync(CollaborateurVue col)
    {
        try
        {
            await ModifierDroits.ExecuterAsync(_appelantId, col.Id, col.DroitConsultation, !col.DroitSoumission);
            _actionMessage = "Droits de soumission mis à jour.";
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"Erreur : {ex.Message}";
        }
    }

    private async Task BasculerConsultationAsync(CollaborateurVue col)
    {
        try
        {
            var nouvConsultation = col.DroitConsultation == DroitConsultation.ToutesDemandesSociete
                ? DroitConsultation.PropresDemandesUniquement
                : DroitConsultation.ToutesDemandesSociete;
            await ModifierDroits.ExecuterAsync(_appelantId, col.Id, nouvConsultation, col.DroitSoumission);
            _actionMessage = "Périmètre de consultation mis à jour.";
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"Erreur : {ex.Message}";
        }
    }

    private async Task ActiverAsync(Guid rattachementId)
    {
        try
        {
            await ActiverDesactiver.ActiverAsync(_appelantId, rattachementId);
            _actionMessage = "Collaborateur réactivé.";
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"Erreur : {ex.Message}";
        }
    }

    private async Task DesactiverAsync(Guid rattachementId)
    {
        try
        {
            await ActiverDesactiver.DesactiverAsync(_appelantId, rattachementId);
            _actionMessage = "Collaborateur désactivé.";
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"Erreur : {ex.Message}";
        }
    }

    // ENT-01 — emission et revocation d'invitations.

    private async Task InviterAsync()
    {
        try
        {
            var invitation = await InviterCollaborateur.ExecuterAsync(_appelantId, _societeId, _emailInvite, ValiditeInvitation);
            _emailInvite = string.Empty;
            _actionMessage = $"Invitation créée pour {invitation.Email} — transmettez-lui le lien ci-dessous.";
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"Erreur : {ex.Message}";
        }
    }

    private async Task RevoquerAsync(Guid invitationId)
    {
        try
        {
            await RevoquerInvitation.ExecuterAsync(_appelantId, invitationId);
            _actionMessage = "Invitation révoquée.";
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"Erreur : {ex.Message}";
        }
    }

    /// <summary>Lien complet a transmettre : le jeton seul ne dit pas ou aller.</summary>
    private string LienInvitation(string jeton) =>
        Navigation.ToAbsoluteUri($"/comptes/invitation/{jeton}").ToString();
}
