@page "/societe/collaborateurs"
@page "/comptes/collaborateurs"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Abstractions
@using CIT.Plateforme.Application.Comptes
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Societe
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Comptes
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirDashboardSocieteQuery DashboardQuery
@inject RattacherUtilisateurCommand Rattacher
@inject ActiverDesactiverUtilisateurCommand ActiverDesactiver
@inject ModifierDroitsUtilisateurCommand ModifierDroits
@inject GererRoleAdministrateurCommand GererRole
@inject InviterCollaborateurCommand InviterCollaborateur
@inject ListerInvitationsQuery ListerInvitations
@inject RevoquerInvitationCommand RevoquerInvitation
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>@Loc["Collab.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>👥</span> @Loc["Collab.Title"]
        </h1>
        <div class="cit-page-subtitle">
            @if (_dashboard is not null)
            {
                <span>@Loc["Dash.Company"] <strong class="text-dark">@_dashboard.SocieteNom</strong> · @Loc["Societe.ActiveAdmins"] <span class="badge bg-primary-subtle text-primary">@_dashboard.NombreAdministrateursActifs</span></span>
            }
        </div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/societe/dashboard" class="btn btn-outline-secondary btn-sm">
            @Loc["Collab.BackToCompany"]
        </a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["Collab.Loading"]" />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger" role="alert">@_erreur</div>
}
else if (_dashboard is not null)
{
    <!-- Formulaire d'ajout / rattachement de collaborateur -->
    <div class="cit-card mb-4">
        <h6 class="fw-bold mb-2 text-dark">@Loc["Collab.AttachTitle"]</h6>
        <p class="small text-muted mb-3">@Loc["Collab.AttachHelp"]</p>

        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-8">
                <input type="text" class="form-control font-monospace" placeholder="@Loc["Collab.UuidPlaceholder"]" @bind="_nouveauCollaborateurId" />
            </div>
            <div class="col-12 col-md-4">
                <button type="button" class="btn btn-primary w-100" @onclick="RattacherAsync" disabled="@string.IsNullOrWhiteSpace(_nouveauCollaborateurId)">
                    <span>➕</span> @Loc["Collab.AttachButton"]
                </button>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_actionMessage))
        {
            <div class="alert alert-info mt-3 py-2 small mb-0">@_actionMessage</div>
        }
    </div>

    @* ENT-01 — INVITATION. Le rattachement ci-dessus suppose un compte deja existant ; or le
       seul parcours d'inscription ouvre aussi une demande de societe. Un collaborateur devait
       donc creer une societe parasite pour obtenir un compte. L'invitation ouvre la voie
       manquante : le collaborateur cree son compte et rejoint CETTE societe, sans qu'aucune
       demande supplementaire ne soit deposee.

       Aucun envoi automatique : la plateforme n'a pas de fournisseur d'e-mail. Le lien est
       affiche ici pour que vous le transmettiez par vos propres moyens. *@
    <div class="cit-card mb-4">
        <h6 class="fw-bold text-dark mb-1">@Loc["Collab.InviteTitle"]</h6>
        <p class="small text-muted">
            @Loc["Collab.InviteHelp"]
        </p>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-8">
                <label class="form-label small fw-bold" for="emailInvite">@Loc["Collab.InviteEmailLabel"]</label>
                <input id="emailInvite" class="form-control form-control-sm" @bind="_emailInvite" />
            </div>
            <div class="col-12 col-md-4">
                <button type="button" class="btn btn-outline-primary w-100" @onclick="InviterAsync"
                        disabled="@string.IsNullOrWhiteSpace(_emailInvite)">
                    <span>✉️</span> @Loc["Collab.InviteButton"]
                </button>
            </div>
        </div>

        @if (_invitations is not null && _invitations.Count > 0)
        {
            <div class="table-responsive mt-3">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["Collab.InviteColInvitee"]</th>
                            <th>@Loc["Collab.InviteColState"]</th>
                            <th>@Loc["Collab.InviteColDeadline"]</th>
                            <th>@Loc["Collab.InviteColLink"]</th>
                            <th class="text-end">@Loc["Collab.InviteColAction"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invitation in _invitations)
                        {
                            <tr>
                                <td class="fw-bold">@invitation.Email</td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@invitation.Etat</span></td>
                                <td class="small text-muted">@invitation.DateExpirationUtc.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (invitation.Etat == EtatInvitation.EnAttente)
                                    {
                                        <input class="form-control form-control-sm font-monospace"
                                               style="font-size: .7rem;" readonly
                                               value="@LienInvitation(invitation.Jeton)" />
                                    }
                                    else
                                    {
                                        <span class="small text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (invitation.Etat == EtatInvitation.EnAttente)
                                    {
                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="() => DemanderConfirmationRevocation(invitation.Id)">@Loc["Collab.Revoke"]</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Liste des collaborateurs avec actions -->
    <div class="cit-card mb-4 p-0 overflow-hidden">
        <div class="p-3 bg-light border-bottom">
            <h6 class="fw-bold m-0 text-dark">@Loc["Collab.ListTitle"]</h6>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Loc["Societe.ColNameEmail"]</th>
                        <th>@Loc["Societe.ColRole"]</th>
                        <th>@Loc["Societe.ColSubmitRight"]</th>
                        <th>@Loc["Societe.ColScope"]</th>
                        <th>@Loc["Societe.ColStatus"]</th>
                        <th class="text-end">@Loc["Collab.ColAdminActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _dashboard.Collaborateurs)
                    {
                        var col = c;
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@col.NomAffiche</div>
                                <div class="small text-muted">@col.Email</div>
                            </td>
                            <td>
                                @if (col.EstAdministrateur)
                                {
                                    <span class="badge bg-primary">@Loc["Societe.RoleAdmin"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">@Loc["Societe.RoleCollaborator"]</span>
                                }
                            </td>
                            <td>
                                @if (col.DroitSoumission)
                                {
                                    <span class="text-success fw-semibold">@Loc["Societe.SubmitAllowed"]</span>
                                }
                                else
                                {
                                    <span class="text-muted">@Loc["Collab.SubmitBlocked"]</span>
                                }
                            </td>
                            <td>
                                <span class="small">
                                    @(col.DroitConsultation == DroitConsultation.ToutesDemandesSociete ? Loc["Collab.ScopeAllCompany"].Value : Loc["Collab.ScopeOwnFiles"].Value)
                                </span>
                            </td>
                            <td>
                                @if (col.EstActif)
                                {
                                    <span class="badge bg-success text-white">@Loc["Societe.StatusActive"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white">@Loc["Societe.StatusDisabled"]</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <!-- Rôle Admin -->
                                    @if (col.EstAdministrateur)
                                    {
                                        <button type="button" class="btn btn-outline-secondary" title="@Loc["Collab.TitleRemoveAdmin"]" @onclick="() => RetirerRoleAdminAsync(col.Id)">
                                            @Loc["Collab.Demote"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-primary" title="@Loc["Collab.TitleNameAdmin"]" @onclick="() => NommerAdminAsync(col.Id)">
                                            @Loc["Collab.NameAdmin"]
                                        </button>
                                    }

                                    <!-- Droit Soumission -->
                                    <button type="button" class="btn btn-outline-secondary" title="@Loc["Collab.TitleToggleSubmission"]" @onclick="() => BasculerSoumissionAsync(col)">
                                        @(col.DroitSoumission ? Loc["Collab.BlockSubmission"].Value : Loc["Collab.AllowSubmission"].Value)
                                    </button>

                                    <!-- Droit Consultation -->
                                    <button type="button" class="btn btn-outline-secondary" title="@Loc["Collab.TitleToggleConsultation"]" @onclick="() => BasculerConsultationAsync(col)">
                                        @(col.DroitConsultation == DroitConsultation.ToutesDemandesSociete ? Loc["Collab.Restrict"].Value : Loc["Collab.Extend"].Value)
                                    </button>

                                    <!-- Activation / Désactivation -->
                                    @if (col.EstActif)
                                    {
                                        <button type="button" class="btn btn-outline-danger" title="@Loc["Collab.TitleDeactivate"]" @onclick="() => DemanderConfirmationDesactivation(col.Id)">
                                            @Loc["Collab.Deactivate"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-success" title="@Loc["Collab.TitleReactivate"]" @onclick="() => ActiverAsync(col.Id)">
                                            @Loc["Collab.Reactivate"]
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<ModaleConfirmation EstOuvert="@(_confirmation is not null)"
                    Titre="@(_confirmation?.Titre ?? string.Empty)"
                    Message="@(_confirmation?.Message ?? string.Empty)"
                    BoutonConfirmerLibelle="@(_confirmation?.LibelleConfirmer ?? "Confirmer")"
                    BoutonConfirmerClass="@(_confirmation?.ClasseConfirmer ?? "btn-danger")"
                    Desactive="@_confirmationEnCours"
                    OnConfirmer="@(async () => { if (_confirmation is not null) await _confirmation.Action(); })"
                    OnAnnuler="AnnulerConfirmation" />

@code {
    private bool _chargement = true;
    private string? _erreur;
    private string? _actionMessage;
    private DashboardSocieteVue? _dashboard;

    // AM-03 — révocation d'invitation (irréversible) et désactivation de collaborateur (impact
    // immédiat sur l'accès) passent par une confirmation explicite.
    private ConfirmationEnAttente? _confirmation;
    private bool _confirmationEnCours;
    private string _nouveauCollaborateurId = string.Empty;
    private string _emailInvite = string.Empty;
    private IReadOnlyList<InvitationVue>? _invitations;

    /// <summary>
    /// Duree de validite d'une invitation, en jours.
    ///
    /// Le CDC n'en fixe aucune. Plutot que de la figer ici, elle est PARAMETRABLE : le metier
    /// l'ajuste sans developpement, comme pour l'expiration de session. La valeur de repli de
    /// 7 jours est un defaut technique, pas une regle metier — elle existe parce qu'un jeton
    /// porteur sans echeance serait un defaut de securite, et parce que 7 jours couvre une
    /// semaine ouvree tout en bornant la fenetre d'exposition.
    /// </summary>
    private TimeSpan ValiditeInvitation =>
        TimeSpan.FromDays(Configuration.GetValue("Comptes:ValiditeInvitationJours", 7));
    private Guid _appelantId;
    private Guid _societeId;

    protected override async Task OnInitializedAsync()
    {
        await RechargerAsync();
    }

    private async Task RechargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue || !contexte.EstAdministrateurSociete)
            {
                _erreur = Loc["Societe.AccessAdminsOnly"].Value;
                return;
            }

            _appelantId = contexte.UtilisateurId;
            _societeId = contexte.SocieteId.Value;
            _dashboard = await DashboardQuery.ExecuterAsync(_appelantId, _societeId);
            _invitations = await ListerInvitations.ExecuterAsync(_appelantId, _societeId);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task RattacherAsync()
    {
        if (!Guid.TryParse(_nouveauCollaborateurId, out var nouvId))
        {
            _actionMessage = Loc["Collab.MsgInvalidUuid"].Value;
            return;
        }

        try
        {
            await Rattacher.ExecuterAsync(_appelantId, _societeId, nouvId);
            _nouveauCollaborateurId = string.Empty;
            _actionMessage = Loc["Collab.MsgAttached"].Value;
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"{Loc["Collab.ErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
    }

    private async Task NommerAdminAsync(Guid rattachementId)
    {
        try
        {
            await GererRole.AttribuerRoleAsync(_appelantId, rattachementId);
            _actionMessage = Loc["Collab.MsgAdminGranted"].Value;
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"{Loc["Collab.ErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
    }

    private async Task RetirerRoleAdminAsync(Guid rattachementId)
    {
        try
        {
            await GererRole.RetirerRoleAsync(_appelantId, rattachementId);
            _actionMessage = Loc["Collab.MsgAdminRemoved"].Value;
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"{Loc["Collab.ErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
    }

    private async Task BasculerSoumissionAsync(CollaborateurVue col)
    {
        try
        {
            await ModifierDroits.ExecuterAsync(_appelantId, col.Id, col.DroitConsultation, !col.DroitSoumission);
            _actionMessage = Loc["Collab.MsgSubmissionUpdated"].Value;
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"{Loc["Collab.ErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
    }

    private async Task BasculerConsultationAsync(CollaborateurVue col)
    {
        try
        {
            var nouvConsultation = col.DroitConsultation == DroitConsultation.ToutesDemandesSociete
                ? DroitConsultation.PropresDemandesUniquement
                : DroitConsultation.ToutesDemandesSociete;
            await ModifierDroits.ExecuterAsync(_appelantId, col.Id, nouvConsultation, col.DroitSoumission);
            _actionMessage = Loc["Collab.MsgConsultationUpdated"].Value;
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"{Loc["Collab.ErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
    }

    private async Task ActiverAsync(Guid rattachementId)
    {
        try
        {
            await ActiverDesactiver.ActiverAsync(_appelantId, rattachementId);
            _actionMessage = Loc["Collab.MsgReactivated"].Value;
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"{Loc["Collab.ErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
    }

    private void DemanderConfirmationDesactivation(Guid rattachementId)
    {
        _confirmation = new ConfirmationEnAttente(
            Loc["Collab.ConfirmDeactivateTitle"].Value,
            Loc["Collab.ConfirmDeactivateMsg"].Value,
            Loc["Collab.Deactivate"].Value,
            "btn-danger",
            () => ExecuterAvecConfirmation(() => DesactiverAsync(rattachementId)));
    }

    private void DemanderConfirmationRevocation(Guid invitationId)
    {
        _confirmation = new ConfirmationEnAttente(
            Loc["Collab.ConfirmRevokeTitle"].Value,
            Loc["Collab.ConfirmRevokeMsg"].Value,
            Loc["Collab.Revoke"].Value,
            "btn-danger",
            () => ExecuterAvecConfirmation(() => RevoquerAsync(invitationId)));
    }

    private void AnnulerConfirmation() => _confirmation = null;

    private async Task ExecuterAvecConfirmation(Func<Task> action)
    {
        _confirmationEnCours = true;
        try
        {
            await action();
        }
        finally
        {
            _confirmationEnCours = false;
            _confirmation = null;
        }
    }

    private async Task DesactiverAsync(Guid rattachementId)
    {
        try
        {
            await ActiverDesactiver.DesactiverAsync(_appelantId, rattachementId);
            _actionMessage = Loc["Collab.MsgDeactivated"].Value;
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"{Loc["Collab.ErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
    }

    // ENT-01 — emission et revocation d'invitations.

    private async Task InviterAsync()
    {
        try
        {
            var invitation = await InviterCollaborateur.ExecuterAsync(_appelantId, _societeId, _emailInvite, ValiditeInvitation);
            _emailInvite = string.Empty;
            _actionMessage = string.Format(Loc["Collab.MsgInviteCreated"].Value, invitation.Email);
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"{Loc["Collab.ErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
    }

    private async Task RevoquerAsync(Guid invitationId)
    {
        try
        {
            await RevoquerInvitation.ExecuterAsync(_appelantId, invitationId);
            _actionMessage = Loc["Collab.MsgInviteRevoked"].Value;
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = $"{Loc["Collab.ErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
    }

    /// <summary>Lien complet a transmettre : le jeton seul ne dit pas ou aller.</summary>
    private string LienInvitation(string jeton) =>
        Navigation.ToAbsoluteUri($"/comptes/invitation/{jeton}").ToString();
}
