@page "/societe/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Societe
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Comptes
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirDashboardSocieteQuery DashboardQuery
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["Societe.PageTitle"]</PageTitle>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["Societe.Loading"]" />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger" role="alert">@_erreur</div>
}
else if (_dashboard is not null)
{
    <div class="cit-page-header">
        <div>
            <h1 class="cit-page-title">
                <span>🏢</span> @Loc["Societe.Title"]
            </h1>
            <div class="cit-page-subtitle">
                @Loc["Dash.Company"] <strong class="text-dark">@_dashboard.SocieteNom</strong> · @Loc["Dash.Profile"] <span class="badge bg-secondary-subtle text-secondary">@_dashboard.SocieteProfil</span> · @Loc["Societe.ActiveAdmins"] <strong>@_dashboard.NombreAdministrateursActifs</strong>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            @if (_estTransporteur)
            {
                @* La tâche principale d'une entreprise de transport, accessible d'un clic. *@
                <a href="/enrolement/societe/soumettre" class="btn btn-primary btn-sm fw-semibold">
                    <span>🚚</span> @Loc["Enrôler ma flotte"]
                </a>
            }
            <a href="/societe/collaborateurs" class="btn btn-outline-primary btn-sm">
                <span>👥</span> @Loc["Societe.ManageTeam"]
            </a>
            <a href="/comptes/profil" class="btn btn-outline-secondary btn-sm">
                <span>⚙️</span> @Loc["Societe.CompanyProfile"]
            </a>
        </div>
    </div>

    <!-- 3 Cartes Métriques KPI -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-primary">
                <div class="cit-stat-icon bg-primary-subtle text-primary">
                    📦
                </div>
                <div>
                    <div class="cit-stat-label">@Loc["Societe.KpiFilesTitle"]</div>
                    <div class="cit-stat-value text-primary">@_dashboard.TotalDossiersSociete</div>
                    <div class="small text-muted">@Loc["Societe.KpiFilesHint"]</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-warning">
                <div class="cit-stat-icon bg-warning-subtle text-warning">
                    ⏳
                </div>
                <div>
                    <div class="cit-stat-label">@Loc["Societe.KpiTicketsTitle"]</div>
                    <div class="cit-stat-value text-warning">@_dashboard.TotalTicketsEnCours</div>
                    <div class="small text-muted">@Loc["Societe.KpiTicketsHint"]</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-success">
                <div class="cit-stat-icon bg-success-subtle text-success">
                    👥
                </div>
                <div>
                    <div class="cit-stat-label">@Loc["Societe.KpiTeamTitle"]</div>
                    <div class="cit-stat-value text-success">@_dashboard.Collaborateurs.Count</div>
                    <div class="small text-muted">@Loc["Societe.KpiTeamHint"]</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tableau des collaborateurs -->
    <div class="cit-card mb-4 p-0 overflow-hidden">
        <div class="d-flex justify-content-between align-items-center p-3 bg-light border-bottom">
            <h6 class="fw-bold m-0 text-dark">@Loc["Societe.CollaboratorsCardTitle"]</h6>
            <a href="/societe/collaborateurs" class="btn btn-primary btn-sm">
                <span>➕</span> @Loc["Societe.NewCollaborator"]
            </a>
        </div>

        <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Loc["Societe.ColNameEmail"]</th>
                        <th>@Loc["Societe.ColRole"]</th>
                        <th>@Loc["Societe.ColSubmitRight"]</th>
                        <th>@Loc["Societe.ColScope"]</th>
                        <th>@Loc["Societe.ColStatus"]</th>
                        <th class="text-end">@Loc["Societe.ColAttachedOn"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _pagination1.Appliquer(_dashboard.Collaborateurs))
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@c.NomAffiche</div>
                                <div class="small text-muted">@c.Email</div>
                            </td>
                            <td>
                                @if (c.EstAdministrateur)
                                {
                                    <span class="badge bg-primary">@Loc["Societe.RoleAdmin"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">@Loc["Societe.RoleCollaborator"]</span>
                                }
                            </td>
                            <td>
                                @if (c.DroitSoumission)
                                {
                                    <span class="text-success fw-semibold">@Loc["Societe.SubmitAllowed"]</span>
                                }
                                else
                                {
                                    <span class="text-muted">@Loc["Societe.SubmitNotAllowed"]</span>
                                }
                            </td>
                            <td>
                                <span class="small">
                                    @(c.DroitConsultation == DroitConsultation.ToutesDemandesSociete ? Loc["Societe.ScopeAll"].Value : Loc["Societe.ScopeOwn"].Value)
                                </span>
                            </td>
                            <td>
                                @if (c.EstActif)
                                {
                                    <span class="badge bg-success text-white">@Loc["Societe.StatusActive"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white">@Loc["Societe.StatusDisabled"]</span>
                                }
                            </td>
                            <td class="text-end text-muted small">
                                @c.DateRattachementUtc.Horodate()
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
        </div>
    </div>
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargement = true;
    private string? _erreur;
    private DashboardSocieteVue? _dashboard;

    private bool _estTransporteur;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue || !contexte.EstAdministrateurSociete)
            {
                _erreur = Loc["Societe.AccessAdminsOnly"].Value;
                return;
            }

            _estTransporteur = contexte.SocieteProfil == CIT.Plateforme.Domain.Comptes.TypeClient.Transporteur;
            _dashboard = await DashboardQuery.ExecuterAsync(contexte.UtilisateurId, contexte.SocieteId.Value);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }
}
