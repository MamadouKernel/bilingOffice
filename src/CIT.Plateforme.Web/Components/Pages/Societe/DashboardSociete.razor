@page "/societe/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Societe
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Comptes
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirDashboardSocieteQuery DashboardQuery

<PageTitle>Espace Entreprise — CIT</PageTitle>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement de l'espace entreprise..." />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger">@_erreur</div>
}
else if (_dashboard is not null)
{
    <div class="cit-page-header">
        <div>
            <h2 class="cit-page-title">
                <span>🏢</span> Espace Entreprise
            </h2>
            <div class="cit-page-subtitle">
                Société <strong class="text-dark">@_dashboard.SocieteNom</strong> · Profil <span class="badge bg-secondary-subtle text-secondary">@_dashboard.SocieteProfil</span> · Administrateurs actifs : <strong>@_dashboard.NombreAdministrateursActifs</strong>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a href="/societe/collaborateurs" class="btn btn-outline-primary btn-sm">
                <span>👥</span> Gérer l'équipe
            </a>
            <a href="/comptes/profil" class="btn btn-outline-secondary btn-sm">
                <span>⚙️</span> Profil société
            </a>
        </div>
    </div>

    <!-- 3 Cartes Métriques KPI -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-primary">
                <div class="cit-stat-icon bg-primary-subtle text-primary">
                    📦
                </div>
                <div>
                    <div class="cit-stat-label">Dossiers de la société</div>
                    <div class="cit-stat-value text-primary">@_dashboard.TotalDossiersSociete</div>
                    <div class="small text-muted">Total des importations de l'entreprise</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-warning">
                <div class="cit-stat-icon bg-warning-subtle text-warning">
                    ⏳
                </div>
                <div>
                    <div class="cit-stat-label">Tickets en cours</div>
                    <div class="cit-stat-value text-warning">@_dashboard.TotalTicketsEnCours</div>
                    <div class="small text-muted">Traitement portuaire en direct</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-success">
                <div class="cit-stat-icon bg-success-subtle text-success">
                    👥
                </div>
                <div>
                    <div class="cit-stat-label">Équipe rattachée</div>
                    <div class="cit-stat-value text-success">@_dashboard.Collaborateurs.Count</div>
                    <div class="small text-muted">Collaborateurs déclarés et habilités</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tableau des collaborateurs -->
    <div class="cit-card mb-4 p-0 overflow-hidden">
        <div class="d-flex justify-content-between align-items-center p-3 bg-light border-bottom">
            <h6 class="fw-bold m-0 text-dark">Collaborateurs de l'entreprise</h6>
            <a href="/societe/collaborateurs" class="btn btn-primary btn-sm">
                <span>➕</span> Nouveau collaborateur
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nom & E-mail</th>
                        <th>Rôle</th>
                        <th>Droit de soumission</th>
                        <th>Périmètre de consultation</th>
                        <th>Statut</th>
                        <th class="text-end">Rattaché le</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _dashboard.Collaborateurs)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@c.NomAffiche</div>
                                <div class="small text-muted">@c.Email</div>
                            </td>
                            <td>
                                @if (c.EstAdministrateur)
                                {
                                    <span class="badge bg-primary">Administrateur</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">Collaborateur</span>
                                }
                            </td>
                            <td>
                                @if (c.DroitSoumission)
                                {
                                    <span class="text-success fw-semibold">✅ Autorisé</span>
                                }
                                else
                                {
                                    <span class="text-muted">❌ Non autorisé</span>
                                }
                            </td>
                            <td>
                                <span class="small">
                                    @(c.DroitConsultation == DroitConsultation.ToutesDemandesSociete ? "🌐 Toutes les demandes" : "👤 Propres demandes")
                                </span>
                            </td>
                            <td>
                                @if (c.EstActif)
                                {
                                    <span class="badge bg-success text-white">Actif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white">Désactivé</span>
                                }
                            </td>
                            <td class="text-end text-muted small">
                                @c.DateRattachementUtc.ToString("dd/MM/yyyy")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool _chargement = true;
    private string? _erreur;
    private DashboardSocieteVue? _dashboard;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue || !contexte.EstAdministrateurSociete)
            {
                _erreur = "Accès réservé aux administrateurs de la société.";
                return;
            }

            _dashboard = await DashboardQuery.ExecuterAsync(contexte.UtilisateurId, contexte.SocieteId.Value);
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }
}
