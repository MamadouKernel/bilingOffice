@page "/supervision"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Supervision
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject VueFilesQuery VueFiles
@inject VueChargeQuery VueCharge
@inject IServiceScopeFactory ScopeFactory
@inject Microsoft.JSInterop.IJSRuntime Js
@inject ISignalSupervision Signal
@implements IAsyncDisposable

<PageTitle>@Loc["Sup.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>👁️</span> @Loc["Sup.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["Sup.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0">
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ChargerAsync" disabled="@_chargement">
            @Loc["Common.Refresh"]
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["Sup.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-3" role="alert">@_erreur</div>
    }

    @if (vuesFiles is not null && vuesFiles.Count == 0)
{
    @* Un tableau réduit à ses en-têtes se lit comme une panne, pas comme un vide voulu.
       Le message dit ce que l'absence signifie et ce qu'il faut faire pour la lever. *@
    <div class="cit-card mb-4 p-5 text-center text-muted">
        <div class="fs-1 mb-2" aria-hidden="true">🗂️</div>
        <div class="fw-semibold text-dark">@Loc["Sup.NoPerimTitle"]</div>
        <div class="small">
            @Loc["Sup.NoPerimDesc"]
        </div>
    </div>
}
else if (vuesFiles is not null)
{
    <div class="cit-card mb-4 p-0 overflow-hidden">
        <div class="p-3 bg-light border-bottom">
            <h6 class="fw-bold text-dark mb-0">@Loc["Sup.FilesTitle"]</h6>
        </div>
        <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Loc["Sup.ColFile"]</th>
                        <th class="text-end">@Loc["Sup.ColNonAffectes"]</th>
                        <th class="text-end">@Loc["Sup.ColEnCours"]</th>
                        <th class="text-end">@Loc["Sup.ColAttenteClient"]</th>
                        <th class="text-end fw-bold">@Loc["Sup.ColTotalActifs"]</th>
                        <th class="text-end">@Loc["Sup.ColProcheDepassement"]</th>
                        <th class="text-end">@Loc["Sup.ColEnDepassement"]</th>
                        <th class="text-end">@Loc["Sup.ColSansActivite"]</th>
                        <th class="text-end">@Loc["Sup.ColAnciennete"]</th>
                        <th class="text-end">@Loc["Sup.ColDelaiMoyen"]</th>
                        <th class="text-end"><span class="visually-hidden">@Loc["Sup.ExportSr"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vue in _pagination1.Appliquer(vuesFiles))
                    {
                        <tr>
                            <td class="text-dark fw-semibold">
                                @* Compter ne suffit pas à agir : le nom de la file ouvre la liste
                                   de ses tickets, seul endroit où le superviseur peut en désigner un. *@
                                <button type="button" class="btn btn-link p-0 text-decoration-none fw-semibold text-start"
                                        @onclick="() => OuvrirFileAsync(vue.FileId, vue.Nom)">
                                    @(string.IsNullOrWhiteSpace(vue.Nom) ? Loc["Sup.FileSansNom"].Value : vue.Nom)
                                </button>
                            </td>
                            <td class="text-end font-monospace @(vue.NonAffectes > 0 ? "text-warning fw-bold" : "text-muted")">@vue.NonAffectes</td>
                            <td class="text-end font-monospace text-primary fw-bold">@vue.EnCours</td>
                            <td class="text-end font-monospace text-muted">@vue.EnAttenteClient</td>
                            <td class="text-end font-monospace text-dark fw-bold">@vue.TotalActifs</td>
                            <td class="text-end font-monospace @(vue.ProcheDepassementSla > 0 ? "text-warning fw-bold" : "text-muted")">@vue.ProcheDepassementSla</td>
                            <td class="text-end font-monospace @(vue.EnDepassementSla > 0 ? "text-danger fw-bold" : "text-muted")">@vue.EnDepassementSla</td>
                            <td class="text-end font-monospace @(vue.SansActivite > 0 ? "text-warning fw-bold" : "text-muted")">@vue.SansActivite</td>
                            <td class="text-end small text-muted font-monospace">@FormaterDuree(vue.AncienneteTicketLePlusAncien)</td>
                            <td class="text-end small text-muted font-monospace">@FormaterDuree(vue.DelaiMoyenTraitement)</td>
                            <td class="text-end">
                                @* SOC-14 — export tabulaire de la file, sous le périmètre du superviseur. *@
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ExporterAsync(vue.FileId, vue.Nom)"
                                        disabled="@(_exportEnCours == vue.FileId)">
                                    @(_exportEnCours == vue.FileId ? Loc["Sup.Exporting"] : Loc["Sup.ExportCsv"])
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
        </div>
    </div>
}

@if (vuesCharge is not null)
{
    <div class="cit-card mb-4 p-0 overflow-hidden">
        <div class="p-3 bg-light border-bottom">
            <h6 class="fw-bold text-dark mb-0">@Loc["Sup.ChargeTitle"]</h6>
        </div>
        <FiltreTable Etat="_pagination2" AuChangement="StateHasChanged" />
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Loc["Sup.ColOperateur"]</th>
                        <th>@Loc["Sup.ColDispo"]</th>
                        <th class="text-end">@Loc["Sup.ColTicketsEnCours"]</th>
                        <th>@Loc["Sup.ColDerniereActivite"]</th>
                        <th class="text-end"><span class="visually-hidden">@Loc["Sup.ColActions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vue in _pagination2.Appliquer(vuesCharge))
                    {
                        <tr>
                            <td class="text-dark fw-semibold">@(string.IsNullOrWhiteSpace(vue.NomOperateur) ? Loc["Sup.OperateurNonId"].Value : vue.NomOperateur)</td>
                            <td>
                                <span class="badge @(vue.Disponibilite.ToString() == "Disponible" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                                    @vue.Disponibilite
                                </span>
                            </td>
                            <td class="text-end font-monospace fw-bold text-primary">@vue.TicketsEnCours</td>
                            <td class="small text-muted font-monospace">@vue.DerniereActiviteUtc.Horodate()</td>
                            <td class="text-end">
                                @* DIS-02 — réaffectation en masse des tickets d'un opérateur absent/indisponible. *@
                                @if (vue.Disponibilite != CIT.Plateforme.Domain.Affectation.StatutDisponibilite.Disponible && vue.TicketsEnCours > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-warning"
                                            @onclick="() => OuvrirReaffectationDeMasseAsync(vue.OperateurId, vue.NomOperateur)">
                                        @Loc["Sup.ReaffecterEnMasse"]
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <Pagination Etat="_pagination2" AuChangement="StateHasChanged" />
        </div>
    </div>
}

@if (_operateurAbsentCible is not null)
{
    <div class="cit-card mb-4 p-3">
        <h6 class="fw-bold text-dark mb-2">@Loc["Sup.ReaffecterEnMasseTitre", _nomOperateurAbsentCible]</h6>

        @if (_erreurReaffectationMasse is not null)
        {
            <div class="alert alert-danger border-0 mb-2 rounded-3" role="alert">@_erreurReaffectationMasse</div>
        }
        @if (_messageReaffectationMasse is not null)
        {
            <div class="alert alert-success border-0 mb-2 rounded-3" role="status">@_messageReaffectationMasse</div>
        }

        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label small fw-bold text-dark" for="sup-cible-masse">@Loc["Sup.OperateurDest"]</label>
                <select id="sup-cible-masse" class="form-select form-select-sm" @bind="_operateurCibleMasse">
                    <option value="">@Loc["Sup.ChoisirOption"]</option>
                    @foreach (var op in vuesCharge ?? [])
                    {
                        @if (op.OperateurId != _operateurAbsentCible)
                        {
                            <option value="@op.OperateurId">
                                @(string.IsNullOrWhiteSpace(op.NomOperateur) ? op.OperateurId.ToString() : op.NomOperateur)
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-3 d-grid">
                <button type="button" class="btn btn-sm btn-warning" @onclick="ReaffecterEnMasseAsync">
                    @Loc["Sup.ConfirmerReaffectationMasse"]
                </button>
            </div>
            <div class="col-12 col-md-2 d-grid">
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="FermerReaffectationDeMasse">
                    @Loc["Sup.Fermer"]
                </button>
            </div>
        </div>
    </div>
}

@if (_fileOuverte is not null)
{
    <div class="cit-card mb-4 p-0 overflow-hidden">
        <div class="p-3 bg-light border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h6 class="fw-bold text-dark mb-0">@Loc["Sup.TicketsFileTitle", _nomFileOuverte]</h6>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="FermerFile">@Loc["Sup.Fermer"]</button>
        </div>

        @if (_erreurAction is not null)
        {
            <div class="alert alert-danger border-0 m-3 rounded-3" role="alert">@_erreurAction</div>
        }
        @if (_messageAction is not null)
        {
            <div class="alert alert-success border-0 m-3 rounded-3" role="status">@_messageAction</div>
        }

        @if (_ticketsFile is null || _ticketsFile.Count == 0)
        {
            <div class="p-5 text-center text-muted">
                <div class="fw-semibold text-dark">@Loc["Sup.AucunTicketTitle"]</div>
                <div class="small">@Loc["Sup.AucunTicketDesc"]</div>
            </div>
        }
        else
        {
            <div class="p-3 border-bottom bg-body-tertiary">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold text-dark" for="sup-operateur">@Loc["Sup.OperateurDest"]</label>
                        <select id="sup-operateur" class="form-select form-select-sm" @bind="_operateurCible">
                            <option value="">@Loc["Sup.ChoisirOption"]</option>
                            @foreach (var op in vuesCharge ?? [])
                            {
                                <option value="@op.OperateurId">
                                    @(string.IsNullOrWhiteSpace(op.NomOperateur) ? op.OperateurId.ToString() : op.NomOperateur) — @Loc["Sup.EnCoursSuffix", op.TicketsEnCours]
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label small fw-bold text-dark" for="sup-priorite">@Loc["Sup.NouvellePriorite"]</label>
                        <select id="sup-priorite" class="form-select form-select-sm" @bind="_prioriteCible">
                            <option value="">@Loc["Sup.ChoisirOption"]</option>
                            @foreach (var niveau in _niveaux)
                            {
                                <option value="@niveau.Id">@niveau.Libelle</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label small fw-bold text-dark" for="sup-motif">@Loc["Sup.Motif"]</label>
                        <input id="sup-motif" class="form-control form-control-sm" @bind="_motif"
                               placeholder="@Loc["Sup.MotifPlaceholder"]" />
                    </div>
                    <div class="col-12 col-md-2 d-grid">
                        <button type="button" class="btn btn-sm btn-primary" @onclick="AppliquerEnMasseAsync"
                                disabled="@(_selection.Count == 0)">
                            @Loc["Sup.Appliquer", _selection.Count]
                        </button>
                    </div>
                </div>
                <div class="form-text small">
                    @((MarkupString)Loc["Sup.MasseHint"].Value)
                </div>
            </div>

            <FiltreTable Etat="_pagination3" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <caption class="visually-hidden">@Loc["Sup.TableCaption"]</caption>
                    <thead class="table-light">
                        <tr>
                            <th scope="col"><span class="visually-hidden">@Loc["Sup.ColSelection"]</span></th>
                            <th scope="col">@Loc["Sup.ColTicket"]</th>
                            <th scope="col">@Loc["Sup.ColStatut"]</th>
                            <th scope="col">@Loc["Sup.ColOperateur"]</th>
                            <th scope="col">@Loc["Sup.ColPriorite"]</th>
                            <th scope="col">@Loc["Sup.ColEnFileDepuis"]</th>
                            <th scope="col" class="text-end"><span class="visually-hidden">@Loc["Sup.ColActions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in _pagination3.Appliquer(_ticketsFile))
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" class="form-check-input"
                                           aria-label="@(Loc["Sup.SelectionnerTicket", ticket.Numero].Value)"
                                           checked="@_selection.Contains(ticket.TicketId)"
                                           @onchange="e => BasculerSelection(ticket.TicketId, (bool?)e.Value == true)" />
                                </td>
                                <td class="text-dark fw-semibold">
                                    @ticket.Numero <span class="text-muted small fw-normal">@Loc.Module(ticket.Module)</span>
                                </td>
                                <td class="small">@ticket.Statut</td>
                                <td class="small">@(string.IsNullOrWhiteSpace(ticket.OperateurAssigneNom) ? Loc["Sup.NonAffecte"].Value : ticket.OperateurAssigneNom)</td>
                                <td class="small">@ticket.PrioriteLibelle</td>
                                <td class="small text-muted font-monospace">@ticket.DateArriveeEnFileUtc.Horodate()</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm @(ticket.OperateurAssigneId is null ? "btn-outline-primary" : "btn-outline-secondary")"
                                            @onclick="() => AffecterAsync(ticket.TicketId, ticket.OperateurAssigneId is not null)">
                                        @(ticket.OperateurAssigneId is null ? Loc["Sup.Affecter"] : Loc["Sup.Reaffecter"])
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination3" AuChangement="StateHasChanged" />
            </div>
        }
    </div>
}
}

@code {
    private readonly EtatPagination _pagination1 = new();
    private readonly EtatPagination _pagination2 = new();
    private readonly EtatPagination _pagination3 = new();

    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private IReadOnlyList<VueFile>? vuesFiles;
    private IReadOnlyList<VueOperateur>? vuesCharge;

    // SUP-04 / PEC-05 / MAS-01 / MAS-02 / PRI-03 — le superviseur agit, il ne fait plus que lire.
    private Guid _superviseurId;
    private Guid? _fileOuverte;
    private string _nomFileOuverte = string.Empty;
    private IReadOnlyList<TicketSupervise>? _ticketsFile;
    private IReadOnlyList<(Guid Id, string Libelle)> _niveaux = [];
    private readonly HashSet<Guid> _selection = [];
    private string _operateurCible = string.Empty;
    private string _prioriteCible = string.Empty;
    private string _motif = string.Empty;
    private string? _messageAction;
    private string? _erreurAction;
    private Guid? _exportEnCours;

    // DIS-02 — réaffectation en masse des tickets d'un opérateur absent/indisponible.
    private Guid? _operateurAbsentCible;
    private string _nomOperateurAbsentCible = string.Empty;
    private string _operateurCibleMasse = string.Empty;
    private string? _messageReaffectationMasse;
    private string? _erreurReaffectationMasse;

    protected override async Task OnInitializedAsync()
    {
        await ChargerAsync();

        // SOC-08 / SUP-01 / SUP-02 : rafraîchissement temps réel — le signal ne porte que le
        // « quelque chose a changé », le tableau relit toujours ses vues via les cas d'usage.
        Signal.Change += RafraichirAsync;
    }

    private Task RafraichirAsync() => InvokeAsync(async () =>
    {
        await ChargerAsync();
        StateHasChanged();
    });

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["Sup.LoginRequis"].Value;
                return;
            }

            // Le périmètre de supervision découle de l'identité authentifiée : aucun identifiant
            // n'est saisi ni transmis par le navigateur (CLAR-05, anti-usurpation).
            vuesFiles = await VueFiles.ExecuterAsync(contexte.UtilisateurId);
            vuesCharge = await VueCharge.ExecuterAsync(contexte.UtilisateurId);
            _superviseurId = contexte.UtilisateurId;
            _nonAutorise = false;

            if (_fileOuverte is not null)
            {
                await ChargerTicketsFileAsync();
            }
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task OuvrirFileAsync(Guid fileId, string nom)
    {
        _fileOuverte = fileId;
        _nomFileOuverte = string.IsNullOrWhiteSpace(nom) ? Loc["Sup.FileSansNom"].Value : nom;
        _selection.Clear();
        _messageAction = null;
        _erreurAction = null;
        await ChargerTicketsFileAsync();
    }

    /// <summary>
    /// SOC-14 — export tabulaire d'une file. L'export passe par la requête de supervision, qui
    /// exige l'habilitation ET le périmètre : le bouton n'ouvre pas un accès que l'écran n'aurait pas.
    /// </summary>
    private async Task ExporterAsync(Guid fileId, string nom)
    {
        _erreur = null;
        _exportEnCours = fileId;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var csv = await scope.ServiceProvider
                .GetRequiredService<ExporterIndicateursQuery>()
                .ExecuterCsvAsync(_superviseurId, fileId);

            var horodatage = DateTime.UtcNow.ToString("yyyyMMdd-HHmm");
            var fichier = $"file-{(string.IsNullOrWhiteSpace(nom) ? fileId.ToString() : nom)}-{horodatage}.csv";

            await Js.InvokeVoidAsync("telechargerFichier", fichier, "text/csv", Convert.ToBase64String(csv));
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _exportEnCours = null;
        }
    }

    private void FermerFile()
    {
        _fileOuverte = null;
        _ticketsFile = null;
        _selection.Clear();
        _messageAction = null;
        _erreurAction = null;
    }

    private async Task ChargerTicketsFileAsync()
    {
        if (_fileOuverte is not Guid fileId)
        {
            return;
        }

        try
        {
            // Un scope par opération : le DbContext du circuit Blazor est partagé, deux requêtes
            // concurrentes s'y télescopent (« A second operation was started on this context »).
            using var scope = ScopeFactory.CreateScope();
            var vue = await scope.ServiceProvider
                .GetRequiredService<ListerTicketsDeLaFileQuery>()
                .ExecuterAsync(_superviseurId, fileId);

            _ticketsFile = vue.Tickets;
            _niveaux = vue.NiveauxPriorite;
            _selection.RemoveWhere(id => !vue.Tickets.Any(t => t.TicketId == id));
        }
        catch (Exception ex)
        {
            _erreurAction = MessagesUtilisateur.Pour(ex);
            _ticketsFile = null;
        }
    }

    private void BasculerSelection(Guid ticketId, bool selectionne)
    {
        if (selectionne)
        {
            _selection.Add(ticketId);
        }
        else
        {
            _selection.Remove(ticketId);
        }
    }

    /// <summary>
    /// SUP-04 / PEC-05 — affecter un ticket non pris en charge, ou le réaffecter. Les deux passent
    /// par des cas d'usage distincts : réaffecter un ticket déjà pris en charge n'est pas la même
    /// opération que désigner un premier opérateur, et l'historique doit les distinguer.
    /// </summary>
    private async Task AffecterAsync(Guid ticketId, bool dejaAffecte)
    {
        _messageAction = null;
        _erreurAction = null;

        if (!Guid.TryParse(_operateurCible, out var operateurId))
        {
            _erreurAction = Loc["Sup.ErrChoisirOperateur"].Value;
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var actions = scope.ServiceProvider.GetRequiredService<ActionsSuperviseurCommand>();

            if (dejaAffecte)
            {
                await actions.ReaffecterAsync(_superviseurId, ticketId, operateurId);
                _messageAction = Loc["Sup.TicketReaffecte"].Value;
            }
            else
            {
                await actions.AffecterTicketNonPrisEnChargeAsync(_superviseurId, ticketId, operateurId);
                _messageAction = Loc["Sup.TicketAffecte"].Value;
            }

            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreurAction = MessagesUtilisateur.Pour(ex);
        }
    }

    /// <summary>
    /// MAS-01 — affectation ou changement de priorité sur une sélection. MAS-02 exige que chaque
    /// ticket laisse sa propre trace : <see cref="ActionDeMasseCommand"/> applique l'action ticket
    /// par ticket et rend le détail des succès et des échecs, plutôt qu'un verdict global.
    /// </summary>
    private async Task AppliquerEnMasseAsync()
    {
        _messageAction = null;
        _erreurAction = null;

        var cibles = _selection.ToList();
        if (cibles.Count == 0)
        {
            return;
        }

        var versPriorite = Guid.TryParse(_prioriteCible, out var prioriteId);
        var versOperateur = Guid.TryParse(_operateurCible, out var operateurId);

        if (!versPriorite && !versOperateur)
        {
            _erreurAction = Loc["Sup.ErrChoisirCible"].Value;
            return;
        }

        if (versPriorite && string.IsNullOrWhiteSpace(_motif))
        {
            // PRI-03 : la modification de priorité enregistre l'ancienne valeur, la nouvelle,
            // l'auteur, la date ET le motif. Sans motif, le changement serait inexplicable après coup.
            _erreurAction = Loc["Sup.ErrMotifObligatoire"].Value;
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var actionDeMasse = scope.ServiceProvider.GetRequiredService<ActionDeMasseCommand>();

            IReadOnlyList<ResultatActionDeMasse> resultats;
            if (versPriorite)
            {
                var modifierPriorite = scope.ServiceProvider
                    .GetRequiredService<CIT.Plateforme.Application.Tickets.ModifierPrioriteCommand>();
                resultats = await actionDeMasse.ExecuterAsync(
                    _superviseurId, cibles, TypeActionDeMasse.ModifierPriorite,
                    (id, ct) => modifierPriorite.ExecuterAsync(_superviseurId, id, prioriteId, _motif, ct));
            }
            else
            {
                var actions = scope.ServiceProvider.GetRequiredService<ActionsSuperviseurCommand>();
                resultats = await actionDeMasse.ExecuterAsync(
                    _superviseurId, cibles, TypeActionDeMasse.Affecter,
                    (id, ct) => actions.AffecterTicketNonPrisEnChargeAsync(_superviseurId, id, operateurId, ct));
            }

            var succes = resultats.Count(r => r.Succes);
            var echecs = resultats.Where(r => !r.Succes).ToList();

            _messageAction = Loc["Sup.MasseResultat", succes, resultats.Count].Value;
            if (echecs.Count > 0)
            {
                // Un échec partiel doit se lire, pas se deviner : on nomme le premier motif rencontré.
                _erreurAction = Loc["Sup.MasseEchecs", echecs.Count, echecs[0].Erreur ?? string.Empty].Value;
            }

            _selection.Clear();
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreurAction = MessagesUtilisateur.Pour(ex);
        }
    }

    /// <summary>SUP-02 — affichage lisible d'une ancienneté ou d'un délai moyen ; « — » quand la
    /// file n'a aucun ticket actif plutôt qu'un zéro trompeur.</summary>
    private static string FormaterDuree(TimeSpan? duree)
    {
        if (duree is not TimeSpan valeur)
        {
            return "—";
        }

        return valeur.TotalDays >= 1
            ? $"{(int)valeur.TotalDays}j {valeur.Hours}h"
            : $"{(int)valeur.TotalHours}h {valeur.Minutes}min";
    }

    /// <summary>DIS-02 — ouvre le panneau de réaffectation en masse pour un opérateur donné.</summary>
    private Task OuvrirReaffectationDeMasseAsync(Guid operateurId, string nom)
    {
        _operateurAbsentCible = operateurId;
        _nomOperateurAbsentCible = string.IsNullOrWhiteSpace(nom) ? operateurId.ToString() : nom;
        _operateurCibleMasse = string.Empty;
        _messageReaffectationMasse = null;
        _erreurReaffectationMasse = null;
        return Task.CompletedTask;
    }

    private void FermerReaffectationDeMasse()
    {
        _operateurAbsentCible = null;
        _nomOperateurAbsentCible = string.Empty;
        _operateurCibleMasse = string.Empty;
        _messageReaffectationMasse = null;
        _erreurReaffectationMasse = null;
    }

    /// <summary>
    /// DIS-02 — « réaffecter ces tickets en masse ». Passe par
    /// <see cref="ReaffecterTousLesTicketsDUnOperateurCommand"/>, qui applique le même contrôle
    /// TRF-04 que la réaffectation individuelle, ticket par ticket : un échec partiel se lit
    /// (compte de succès/échecs), il ne bloque pas les réaffectations valides.
    /// </summary>
    private async Task ReaffecterEnMasseAsync()
    {
        _messageReaffectationMasse = null;
        _erreurReaffectationMasse = null;

        if (_operateurAbsentCible is not Guid operateurAbsentId || !Guid.TryParse(_operateurCibleMasse, out var operateurCibleId))
        {
            _erreurReaffectationMasse = Loc["Sup.ErrChoisirOperateur"].Value;
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var commande = scope.ServiceProvider
                .GetRequiredService<CIT.Plateforme.Application.Affectation.ReaffecterTousLesTicketsDUnOperateurCommand>();

            var resultats = await commande.ExecuterAsync(_superviseurId, operateurAbsentId, operateurCibleId);
            var succes = resultats.Count(r => r.Succes);
            var echecs = resultats.Where(r => !r.Succes).ToList();

            _messageReaffectationMasse = Loc["Sup.MasseResultat", succes, resultats.Count].Value;
            if (echecs.Count > 0)
            {
                _erreurReaffectationMasse = Loc["Sup.MasseEchecs", echecs.Count, echecs[0].Erreur ?? string.Empty].Value;
            }

            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreurReaffectationMasse = MessagesUtilisateur.Pour(ex);
        }
    }

    public ValueTask DisposeAsync()
    {
        Signal.Change -= RafraichirAsync;
        return ValueTask.CompletedTask;
    }
}
