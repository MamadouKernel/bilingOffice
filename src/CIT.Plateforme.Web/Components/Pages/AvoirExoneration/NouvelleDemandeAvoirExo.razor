@page "/avoir-exoneration/soumettre"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.AvoirExoneration
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject SoumettreDemandeAvoirExonerationCommand SoumettreDemande
@inject CIT.Plateforme.Application.Client.ObtenirDashboardClientQuery DashboardClient
@inject NavigationManager Navigation

<PageTitle>@Loc["AvoirExo.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>🏷️</span> @Loc["AvoirExo.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["AvoirExo.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/avoir-exoneration/mes-demandes" class="btn btn-outline-secondary btn-sm shadow-sm">@Loc["AvoirExo.MyRequests"]</a>
    </div>
</div>

<div class="cit-page-etroite">
    @if (_chargement)
    {
        <IndicateurChargement Message="@Loc["AvoirExo.InitForm"]" />
    }
    else if (_ticketCreeNumero is not null)
    {
        <div class="cit-card border-success p-4 mb-4">
            <div class="d-flex align-items-center gap-3 text-success mb-3">
                <span class="fs-2">✅</span>
                <div>
                    <h5 class="fw-bold mb-0">@Loc["AvoirExo.SuccessTitle"]</h5>
                    <div class="text-muted small">@Loc["AvoirExo.TicketGenerated"] <strong class="font-monospace text-primary">@_ticketCreeNumero</strong></div>
                    @if (!string.IsNullOrEmpty(_dossierCreeNumero))
                    {
                        <div class="text-muted small">@Loc["AvoirExo.AssociatedFile"] <strong class="font-monospace text-secondary">@_dossierCreeNumero</strong></div>
                    }
                </div>
            </div>
            <a href="/avoir-exoneration/mes-demandes" class="btn btn-primary fw-bold px-4">@Loc["AvoirExo.ViewMyRequests"]</a>
        </div>
    }
    else
    {
        @if (_erreur is not null)
        {
            <div class="alert alert-danger mb-4" role="alert">@_erreur</div>
        }

        <div class="cit-card mb-4 p-4 shadow-sm">
            <div class="mb-3">
                <label class="form-label fw-semibold text-dark" for="typeDemande">@Loc["AvoirExo.TypeLabel"]</label>
                <select id="typeDemande" class="form-select" @bind="_typeDemande">
                    <option value="Avoir">@Loc["AvoirExo.TypeAvoir"]</option>
                    <option value="Exoneration">@Loc["AvoirExo.TypeExoneration"]</option>
                </select>
            </div>

            <div class="row">
                <div class="col-md-8 mb-3">
                    <label class="form-label fw-semibold text-dark" for="objet">@Loc["AvoirExo.ObjectLabel"]</label>
                    <input id="objet" class="form-control" placeholder="@Loc["AvoirExo.ObjectPlaceholder"]" @bind="_objet" @bind:event="oninput" maxlength="200" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold text-dark" for="montant">@Loc["AvoirExo.AmountLabel"]</label>
                    <input id="montant" type="number" step="1000" min="0" class="form-control" placeholder="@Loc["AvoirExo.AmountPlaceholder"]" @bind="_montantConteste" />
                </div>
            </div>

            <div class="mb-3">
                @* REMÉDIATION D-18 : le client choisit son ticket parent dans la liste de SES
                   propres demandes — il ne saisit plus un UUID à la main. *@
                <label class="form-label fw-semibold text-dark" for="ticketParent">@Loc["AvoirExo.LinkLabel"]</label>
                <select id="ticketParent" class="form-select" @bind="_ticketParentIdString">
                    <option value="">@Loc["AvoirExo.NoLink"]</option>
                    @foreach (var t in _ticketsLiables)
                    {
                        <option value="@t.Id">@t.Libelle</option>
                    }
                </select>
                <div class="form-text small">
                    @if (_ticketsLiables.Count == 0)
                    {
                        <span>@Loc["AvoirExo.NoLinkableHint"]</span>
                    }
                    else
                    {
                        <span>@Loc["AvoirExo.LinkableHint"]</span>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold text-dark" for="description">@Loc["AvoirExo.MotivesLabel"]</label>
                <textarea id="description" class="form-control" rows="5" placeholder="@Loc["AvoirExo.MotivesPlaceholder"]" @bind="_description" @bind:event="oninput"></textarea>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold text-dark" for="fichiers">@Loc["AvoirExo.FilesLabel"]</label>
                <InputFile id="fichiers" class="form-control" OnChange="OnFilesSelected" multiple />
                <div class="form-text small">@Loc["AvoirExo.FilesHint"]</div>

                @if (_fichiersSelectionnes.Count > 0)
                {
                    <ul class="list-group list-group-flush mt-2">
                        @foreach (var file in _fichiersSelectionnes)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-1 px-2 small bg-light">
                                <span>📎 @file.NomFichier (@(file.Contenu.Length / 1024) @Loc["Common.KoUnit"])</span>
                                <BoutonSupprimer Discret="true" OnSupprimer="() => SupprimerFichier(file)" />
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                <a href="/avoir-exoneration/mes-demandes" class="btn btn-outline-secondary">@Loc["Common.Cancel"]</a>
                <button type="button" id="btnSoumettre" class="btn btn-primary px-4 fw-bold shadow-sm" @onclick="SoumettreAsync" disabled="@(!PeutSoumettre || _envoiEnCours)">
                    @if (_envoiEnCours)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>@Loc["AvoirExo.Submitting"]</span>
                    }
                    else
                    {
                        <span>@Loc["AvoirExo.Submit"]</span>
                    }
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool _chargement = true;
    private bool _envoiEnCours;
    private string? _erreur;
    private string? _ticketCreeNumero;
    private string? _dossierCreeNumero;

    private string _typeDemande = "Avoir";
    private string _objet = string.Empty;
    private string _description = string.Empty;
    private decimal? _montantConteste;
    private string? _ticketParentIdString;

    // REMÉDIATION D-18 : tickets du client proposés à la liaison (identifiant + libellé lisible).
    private sealed record TicketLiable(Guid Id, string Libelle);
    private IReadOnlyList<TicketLiable> _ticketsLiables = [];
    private readonly List<PieceJointeSoumission> _fichiersSelectionnes = new();

    private bool PeutSoumettre =>
        !string.IsNullOrWhiteSpace(_objet) &&
        !string.IsNullOrWhiteSpace(_description) &&
        _fichiersSelectionnes.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        var contexte = await ContexteService.ObtenirContexteAsync();
        if (contexte is null || !contexte.EstAuthentifie)
        {
            Navigation.NavigateTo("/comptes/connexion", forceLoad: true);
            return;
        }

        // Charge les demandes du client pour alimenter le sélecteur de liaison (D-18).
        if (contexte.SocieteId is Guid societeId)
        {
            try
            {
                var dashboard = await DashboardClient.ExecuterAsync(contexte.UtilisateurId, societeId);
                _ticketsLiables = [.. dashboard.DemandesRecentes
                    .SelectMany(d => d.Tickets.Select(t => new TicketLiable(
                        t.TicketId,
                        $"{t.NumeroTicket}{(string.IsNullOrWhiteSpace(t.NumeroBl) ? (string.IsNullOrWhiteSpace(t.NumeroBooking) ? "" : $" — Booking {t.NumeroBooking}") : $" — BL {t.NumeroBl}")} ({d.NumeroDossier})")))];
            }
            catch
            {
                // La liaison est optionnelle : un échec de chargement ne bloque pas la demande.
                _ticketsLiables = [];
            }
        }

        _chargement = false;
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        _erreur = null;
        try
        {
            foreach (var file in e.GetMultipleFiles(5))
            {
                if (file.Size > 10 * 1024 * 1024)
                {
                    _erreur = string.Format(Loc["AvoirExo.FileTooBig"].Value, file.Name);
                    continue;
                }

                using var ms = new MemoryStream();
                await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms);
                _fichiersSelectionnes.Add(new PieceJointeSoumission(file.Name, file.ContentType, ms.ToArray()));
            }
        }
        catch (Exception ex)
        {
            _erreur = $"{Loc["AvoirExo.FileReadError"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
    }

    private void SupprimerFichier(PieceJointeSoumission piece)
    {
        _fichiersSelectionnes.Remove(piece);
    }

    private async Task SoumettreAsync()
    {
        if (!PeutSoumettre || _envoiEnCours) return;

        _erreur = null;
        _envoiEnCours = true;

        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _erreur = Loc["AvoirExo.SessionExpired"].Value;
                return;
            }

            Guid? ticketParentId = null;
            if (!string.IsNullOrWhiteSpace(_ticketParentIdString) && Guid.TryParse(_ticketParentIdString.Trim(), out var parsedId))
            {
                ticketParentId = parsedId;
            }

            var requete = new SoumettreDemandeAvoirExoRequete(
                TypeDemande: _typeDemande,
                Objet: _objet.Trim(),
                Description: _description.Trim(),
                MontantConteste: _montantConteste,
                ReferenceMetier: null,
                TicketParentId: ticketParentId,
                PiecesJointes: _fichiersSelectionnes);

            var reponse = await SoumettreDemande.ExecuterAsync(contexte.UtilisateurId, requete);
            _ticketCreeNumero = reponse.NumeroTicket;
            _dossierCreeNumero = reponse.NumeroDossier;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _envoiEnCours = false;
        }
    }
}
