@page "/avoir-exoneration/soumettre"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.AvoirExoneration
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IContexteUtilisateurWeb ContexteService
@inject SoumettreDemandeAvoirExonerationCommand SoumettreDemande
@inject NavigationManager Navigation

<PageTitle>Demande d'Avoir ou d'Exonération — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>🏷️</span> Demande d'Avoir ou d'Exonération
        </h2>
        <div class="cit-page-subtitle">Soumettez votre demande avec les justificatifs obligatoires</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/avoir-exoneration/mes-demandes" class="btn btn-outline-secondary btn-sm shadow-sm">← Mes demandes</a>
    </div>
</div>

<div style="max-width: 800px;">
    @if (_chargement)
    {
        <IndicateurChargement Message="Initialisation du formulaire..." />
    }
    else if (_ticketCreeNumero is not null)
    {
        <div class="cit-card border-success p-4 mb-4">
            <div class="d-flex align-items-center gap-3 text-success mb-3">
                <span class="fs-2">✅</span>
                <div>
                    <h5 class="fw-bold mb-0">Demande enregistrée avec succès !</h5>
                    <div class="text-muted small">Numéro de ticket généré : <strong class="font-monospace text-primary">@_ticketCreeNumero</strong></div>
                    @if (!string.IsNullOrEmpty(_dossierCreeNumero))
                    {
                        <div class="text-muted small">Dossier associé : <strong class="font-monospace text-secondary">@_dossierCreeNumero</strong></div>
                    }
                </div>
            </div>
            <a href="/avoir-exoneration/mes-demandes" class="btn btn-primary fw-bold px-4">Consulter mes demandes ➔</a>
        </div>
    }
    else
    {
        @if (_erreur is not null)
        {
            <div class="alert alert-danger mb-4">@_erreur</div>
        }

        <div class="cit-card mb-4 p-4 shadow-sm">
            <div class="mb-3">
                <label class="form-label fw-semibold text-dark" for="typeDemande">Type de demande *</label>
                <select id="typeDemande" class="form-select" @bind="_typeDemande">
                    <option value="Avoir">Demande d'Avoir (contestation de facture / trop-perçu)</option>
                    <option value="Exoneration">Demande d'Exonération (frais de stationnement / magasinage)</option>
                </select>
            </div>

            <div class="row">
                <div class="col-md-8 mb-3">
                    <label class="form-label fw-semibold text-dark" for="objet">Objet de la demande *</label>
                    <input id="objet" class="form-control" placeholder="Ex: Contestation facture magasinage BL 12345" @bind="_objet" @bind:event="oninput" maxlength="200" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold text-dark" for="montant">Montant contesté (XOF)</label>
                    <input id="montant" type="number" step="1000" min="0" class="form-control" placeholder="Montant chiffré" @bind="_montantConteste" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold text-dark" for="ticketParent">Liaison ticket / dossier existant (optionnel)</label>
                <input id="ticketParent" class="form-control" placeholder="Identifiant UUID du ticket parent (ex: dossier Billing / Facture)" @bind="_ticketParentIdString" />
                <div class="form-text small">Permet de rattacher cette contestation à une opération Billing existante.</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold text-dark" for="description">Exposé des motifs & justification détaillée *</label>
                <textarea id="description" class="form-control" rows="5" placeholder="Expliquez précisément les raisons de la demande d'avoir ou d'exonération..." @bind="_description" @bind:event="oninput"></textarea>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold text-dark" for="fichiers">Pièces justificatives * (Obligatoire)</label>
                <InputFile id="fichiers" class="form-control" OnChange="OnFilesSelected" multiple />
                <div class="form-text small">Factures initiales, bordereaux de livraison, attestations douanières, etc. Au moins 1 document requis.</div>

                @if (_fichiersSelectionnes.Count > 0)
                {
                    <ul class="list-group list-group-flush mt-2">
                        @foreach (var file in _fichiersSelectionnes)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-1 px-2 small bg-light">
                                <span>📎 @file.NomFichier (@(file.Contenu.Length / 1024) Ko)</span>
                                <button type="button" class="btn btn-sm text-danger p-0" @onclick="() => SupprimerFichier(file)">✕</button>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                <a href="/avoir-exoneration/mes-demandes" class="btn btn-outline-secondary">Annuler</a>
                <button id="btnSoumettre" class="btn btn-primary px-4 fw-bold shadow-sm" @onclick="SoumettreAsync" disabled="@(!PeutSoumettre || _envoiEnCours)">
                    @if (_envoiEnCours)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Soumission en cours...</span>
                    }
                    else
                    {
                        <span>Soumettre la demande</span>
                    }
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool _chargement = true;
    private bool _envoiEnCours;
    private string? _erreur;
    private string? _ticketCreeNumero;
    private string? _dossierCreeNumero;

    private string _typeDemande = "Avoir";
    private string _objet = string.Empty;
    private string _description = string.Empty;
    private decimal? _montantConteste;
    private string? _ticketParentIdString;
    private readonly List<PieceJointeSoumission> _fichiersSelectionnes = new();

    private bool PeutSoumettre =>
        !string.IsNullOrWhiteSpace(_objet) &&
        !string.IsNullOrWhiteSpace(_description) &&
        _fichiersSelectionnes.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        var contexte = await ContexteService.ObtenirContexteAsync();
        if (contexte is null || !contexte.EstAuthentifie)
        {
            Navigation.NavigateTo("/comptes/connexion", forceLoad: true);
            return;
        }

        _chargement = false;
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        _erreur = null;
        try
        {
            foreach (var file in e.GetMultipleFiles(5))
            {
                if (file.Size > 10 * 1024 * 1024)
                {
                    _erreur = $"Le fichier {file.Name} dépasse la limite de 10 Mo.";
                    continue;
                }

                using var ms = new MemoryStream();
                await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms);
                _fichiersSelectionnes.Add(new PieceJointeSoumission(file.Name, file.ContentType, ms.ToArray()));
            }
        }
        catch (Exception ex)
        {
            _erreur = $"Erreur lors de la lecture des fichiers : {ex.Message}";
        }
    }

    private void SupprimerFichier(PieceJointeSoumission piece)
    {
        _fichiersSelectionnes.Remove(piece);
    }

    private async Task SoumettreAsync()
    {
        if (!PeutSoumettre || _envoiEnCours) return;

        _erreur = null;
        _envoiEnCours = true;

        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _erreur = "Session expirée. Veuillez vous reconnecter.";
                return;
            }

            Guid? ticketParentId = null;
            if (!string.IsNullOrWhiteSpace(_ticketParentIdString) && Guid.TryParse(_ticketParentIdString.Trim(), out var parsedId))
            {
                ticketParentId = parsedId;
            }

            var requete = new SoumettreDemandeAvoirExoRequete(
                TypeDemande: _typeDemande,
                Objet: _objet.Trim(),
                Description: _description.Trim(),
                MontantConteste: _montantConteste,
                ReferenceMetier: null,
                TicketParentId: ticketParentId,
                PiecesJointes: _fichiersSelectionnes);

            var reponse = await SoumettreDemande.ExecuterAsync(contexte.UtilisateurId, requete);
            _ticketCreeNumero = reponse.NumeroTicket;
            _dossierCreeNumero = reponse.NumeroDossier;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _envoiEnCours = false;
        }
    }
}
