@page "/avoir-exoneration/mes-demandes"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.AvoirExoneration
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IContexteUtilisateurWeb ContexteService
@inject ListerMesDemandesAvoirExonerationQuery ListerMesDemandes
@inject NavigationManager Navigation

<PageTitle>Mes demandes d'Avoir & Exonération — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>📑</span> Mes demandes d'Avoir & Exonération
        </h2>
        <div class="cit-page-subtitle">Suivi en direct de l'état de traitement de vos demandes de régularisation financière</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/avoir-exoneration/soumettre" class="btn btn-primary btn-sm fw-bold shadow-sm">+ Nouvelle demande</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement de vos demandes..." />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger">@_erreur</div>
}
else if (_demandes.Count == 0)
{
    <div class="cit-card p-5 text-center">
        <div class="display-4 text-muted mb-3">📭</div>
        <h5 class="fw-bold text-dark mb-2">Aucune demande enregistrée</h5>
        <p class="text-muted small mb-4">Vous n'avez pas encore soumis de demande d'avoir ou d'exonération.</p>
        <div>
            <a href="/avoir-exoneration/soumettre" class="btn btn-primary px-4 fw-semibold">+ Créer une demande</a>
        </div>
    </div>
}
else
{
    <div class="cit-card p-0 overflow-hidden shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">N° Ticket</th>
                        <th>Type</th>
                        <th>Objet</th>
                        <th>Montant contesté</th>
                        <th>Décision / Statut</th>
                        <th>Date de création</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _demandes)
                    {
                        <tr>
                            <td class="ps-3 font-monospace fw-bold text-primary">@d.NumeroTicket</td>
                            <td>
                                <span class="badge @(d.TypeDemande == "Avoir" ? "bg-info text-dark" : "bg-warning text-dark")">
                                    @d.TypeDemande
                                </span>
                            </td>
                            <td class="fw-semibold text-truncate" style="max-width: 250px;" title="@d.Objet">@d.Objet</td>
                            <td>
                                @if (d.MontantConteste.HasValue)
                                {
                                    <span>@d.MontantConteste.Value.ToString("N0") XOF</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                @if (d.Decision == "Accorde")
                                {
                                    <span class="badge bg-success">Accordé (@(d.MontantAccorde?.ToString("N0") ?? "0") XOF)</span>
                                }
                                else if (d.Decision == "Rejete")
                                {
                                    <span class="badge bg-danger">Rejeté</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@d.Statut</span>
                                }
                            </td>
                            <td class="small text-muted">@d.DateCreationUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end pe-3">
                                <a href="/avoir-exoneration/fiche/@d.TicketId" class="btn btn-outline-primary btn-sm">Consulter ➔</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool _chargement = true;
    private string? _erreur;
    private IReadOnlyList<DemandeAvoirExoResumeDto> _demandes = Array.Empty<DemandeAvoirExoResumeDto>();

    protected override async Task OnInitializedAsync()
    {
        await ChargerDemandesAsync();
    }

    private async Task ChargerDemandesAsync()
    {
        _chargement = true;
        _erreur = null;

        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                Navigation.NavigateTo("/comptes/connexion", forceLoad: true);
                return;
            }

            _demandes = await ListerMesDemandes.ExecuterAsync(contexte.UtilisateurId);
        }
        catch (Exception ex)
        {
            _erreur = $"Erreur lors du chargement des demandes : {ex.Message}";
        }
        finally
        {
            _chargement = false;
        }
    }
}
