@page "/avoir-exoneration/mes-demandes"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.AvoirExoneration
@using CIT.Plateforme.Domain.AvoirExoneration
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ListerMesDemandesAvoirExonerationQuery ListerMesDemandes
@inject NavigationManager Navigation

<PageTitle>@Loc["AvoirExoList.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>📑</span> @Loc["AvoirExoList.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["AvoirExoList.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/avoir-exoneration/soumettre" class="btn btn-primary btn-sm fw-bold shadow-sm">@Loc["AvoirExoList.NewRequest"]</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["AvoirExoList.Loading"]" />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger" role="alert">@_erreur</div>
}
else if (_demandes.Count == 0)
{
    <div class="cit-card p-5 text-center">
        <div class="display-4 text-muted mb-3">📭</div>
        <h5 class="fw-bold text-dark mb-2">@Loc["AvoirExoList.EmptyTitle"]</h5>
        <p class="text-muted small mb-4">@Loc["AvoirExoList.EmptyMsg"]</p>
        <div>
            <a href="/avoir-exoneration/soumettre" class="btn btn-primary px-4 fw-semibold">@Loc["AvoirExoList.CreateRequest"]</a>
        </div>
    </div>
}
else
{
    <div class="cit-card p-0 overflow-hidden shadow-sm">
        <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">@Loc["AvoirExoList.ColTicket"]</th>
                        <th>@Loc["AvoirExoList.ColType"]</th>
                        <th>@Loc["AvoirExoList.ColObject"]</th>
                        <th>@Loc["AvoirExoList.ColAmount"]</th>
                        <th>@Loc["AvoirExoList.ColDecision"]</th>
                        <th>@Loc["AvoirExoList.ColDate"]</th>
                        <th class="text-end pe-3">@Loc["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _pagination1.Appliquer(_demandes))
                    {
                        <tr>
                            <td class="ps-3 font-monospace fw-bold text-primary">@d.NumeroTicket</td>
                            <td>
                                <span class="badge @(d.TypeDemande == "Avoir" ? "bg-info text-dark" : "bg-warning text-dark")">
                                    @d.TypeDemande
                                </span>
                            </td>
                            <td class="fw-semibold text-truncate" style="max-width: 250px;" title="@d.Objet">@d.Objet</td>
                            <td>
                                @if (d.MontantConteste.HasValue)
                                {
                                    <span>@d.MontantConteste.Value.ToString("N0") XOF</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                @if (d.Decision == DecisionAvoirExo.Accorde)
                                {
                                    <span class="badge bg-success">@string.Format(Loc["AvoirExoList.Granted"].Value, d.MontantAccorde?.ToString("N0") ?? "0")</span>
                                }
                                else if (d.Decision == DecisionAvoirExo.Rejete)
                                {
                                    <span class="badge bg-danger">@Loc["AvoirExoList.Rejected"]</span>
                                }
                                else
                                {
                                    <StatutBadge Statut="@d.Statut" />
                                }
                            </td>
                            <td class="small text-muted">@d.DateCreationUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end pe-3">
                                <a href="/avoir-exoneration/fiche/@d.TicketId" class="btn btn-outline-primary btn-sm">@Loc["AvoirExoList.Consult"]</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
        </div>
    </div>
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargement = true;
    private string? _erreur;
    private IReadOnlyList<DemandeAvoirExoResumeDto> _demandes = Array.Empty<DemandeAvoirExoResumeDto>();

    protected override async Task OnInitializedAsync()
    {
        await ChargerDemandesAsync();
    }

    private async Task ChargerDemandesAsync()
    {
        _chargement = true;
        _erreur = null;

        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                Navigation.NavigateTo("/comptes/connexion", forceLoad: true);
                return;
            }

            _demandes = await ListerMesDemandes.ExecuterAsync(contexte.UtilisateurId);
        }
        catch (Exception ex)
        {
            _erreur = $"{Loc["AvoirExoList.LoadError"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
        finally
        {
            _chargement = false;
        }
    }
}
