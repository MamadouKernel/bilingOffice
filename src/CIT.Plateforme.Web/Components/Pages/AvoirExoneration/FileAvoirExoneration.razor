@page "/avoir-exoneration/file"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.AvoirExoneration
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IContexteUtilisateurWeb ContexteService
@inject ConsulterFileAvoirExonerationQuery ConsulterFile
@inject PrendreEnChargeAvoirExoCommand PrendreEnCharge
@inject NavigationManager Navigation

<PageTitle>File Avoirs & Exonérations — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>⚖️</span> File Avoirs & Exonérations
        </h1>
        <div class="cit-page-subtitle">Instruction et décision formelle des contestations financières et demandes de dispense</div>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement de la file de traitement..." />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger" role="alert">@_erreur</div>
}
else
{
    <!-- Filtres -->
    <div class="cit-card mb-4 p-3 shadow-sm">
        <div class="row g-3 align-items-center">
            <div class="col-md-4">
                <label for="type-de-demande" class="form-label small fw-semibold text-muted mb-1">Type de demande</label>
                <select id="type-de-demande" class="form-select form-select-sm" @bind="_typeFiltre" @bind:after="ChargerFileAsync">
                    <option value="">Tous les types</option>
                    <option value="Avoir">Avoir (Trop-perçu / Litige)</option>
                    <option value="Exoneration">Exonération (Magasinage / Stationnement)</option>
                </select>
            </div>
            <div class="col-md-4">
                <label for="statut" class="form-label small fw-semibold text-muted mb-1">Statut</label>
                <select id="statut" class="form-select form-select-sm" @bind="_statutFiltre" @bind:after="ChargerFileAsync">
                    <option value="">Tous les statuts</option>
                    <option value="EnAttenteDePriseEnCharge">En attente de prise en charge</option>
                    <option value="EnCours">En cours d'instruction</option>
                    <option value="EnAttenteClient">En attente client</option>
                    <option value="Cloture">Clôturé</option>
                </select>
            </div>
            <div class="col-md-4 text-md-end pt-md-4">
                <button class="btn btn-outline-secondary btn-sm" @onclick="ChargerFileAsync">🔄 Actualiser</button>
            </div>
        </div>
    </div>

    @if (_tickets.Count == 0)
    {
        <div class="cit-card p-5 text-center">
            <div class="display-4 text-muted mb-3">✅</div>
            <h5 class="fw-bold text-dark mb-1">File vide</h5>
            <p class="text-muted small mb-0">Aucun dossier ne correspond aux critères sélectionnés.</p>
        </div>
    }
    else
    {
        <div class="cit-card p-0 overflow-hidden shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">N° Ticket</th>
                            <th>Type</th>
                            <th>Client</th>
                            <th>Objet</th>
                            <th>Montant contesté</th>
                            <th>Statut</th>
                            <th>Date d'arrivée</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _tickets)
                        {
                            <tr>
                                <td class="ps-3 font-monospace fw-bold text-primary">@t.NumeroTicket</td>
                                <td>
                                    <span class="badge @(t.TypeDemande == "Avoir" ? "bg-info text-dark" : "bg-warning text-dark")">
                                        @t.TypeDemande
                                    </span>
                                </td>
                                <td class="fw-semibold">@t.ClientNom</td>
                                <td class="text-truncate" style="max-width: 220px;" title="@t.Objet">@t.Objet</td>
                                <td>
                                    @(t.MontantConteste.HasValue ? $"{t.MontantConteste.Value:N0} XOF" : "-")
                                </td>
                                <td>
                                    <span class="badge @ObtenirBadgeStatut(t.Statut)">@t.Statut</span>
                                </td>
                                <td class="small text-muted">@t.DateCreationUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-1">
                                        @if (t.Statut == "EnAttenteDePriseEnCharge")
                                        {
                                            <button class="btn btn-sm btn-outline-success" @onclick="() => PrendreEnChargeAsync(t.TicketId)">
                                                Prendre en charge
                                            </button>
                                        }
                                        <a href="/avoir-exoneration/fiche/@t.TicketId" class="btn btn-sm btn-outline-primary">
                                            Ouvrir ➔
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private bool _chargement = true;
    private string? _erreur;
    private string? _typeFiltre;
    private string? _statutFiltre;
    private IReadOnlyList<TicketFileAvoirExoDto> _tickets = Array.Empty<TicketFileAvoirExoDto>();

    protected override async Task OnInitializedAsync()
    {
        await ChargerFileAsync();
    }

    private async Task ChargerFileAsync()
    {
        _chargement = true;
        _erreur = null;

        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                Navigation.NavigateTo("/comptes/connexion", forceLoad: true);
                return;
            }

            StatutTicket? statut = null;
            if (!string.IsNullOrEmpty(_statutFiltre) && Enum.TryParse<StatutTicket>(_statutFiltre, out var s))
            {
                statut = s;
            }

            var criteres = new CriteresFiltreFileAvoirExo(_typeFiltre, statut, null);
            _tickets = await ConsulterFile.ExecuterAsync(contexte.UtilisateurId, criteres);
        }
        catch (Exception ex)
        {
            _erreur = $"Erreur lors du chargement de la file : {MessagesUtilisateur.Pour(ex)}";
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task PrendreEnChargeAsync(Guid ticketId)
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie) return;

            await PrendreEnCharge.ExecuterAsync(contexte.UtilisateurId, ticketId);
            await ChargerFileAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private static string ObtenirBadgeStatut(string statut) => statut switch
    {
        "EnAttenteDePriseEnCharge" => "bg-secondary",
        "EnCours" => "bg-primary",
        "EnAttenteClient" => "bg-warning text-dark",
        "Cloture" => "bg-success",
        _ => "bg-dark"
    };
}
