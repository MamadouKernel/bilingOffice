@page "/simulation/proforma"
@rendermode InteractiveServer
@using CIT.Plateforme.Application.Tarification
@using CIT.Plateforme.Domain.Tarification
@using CIT.Plateforme.Domain.Tarification.Exceptions
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@inject IContexteUtilisateurWeb ContexteService
@inject CalculerSimulationProformaQueryHandler Calculer
@inject ValiderCoherenceSimulationQuery ValiderCoherence
@inject SauvegarderSimulationProformaCommandHandler Sauvegarder
@inject ConsulterReferentielsTarifairesQueryHandler Referentiels
@inject NavigationManager Navigation

<PageTitle>@Loc["Simulation.Title"] — @Loc["Common.AppTitle"]</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span>🧮</span> Facturation & Proforma • TAR-01..05
        </div>
        <h2 class="cit-page-title fw-bold text-dark mb-1">
            @Loc["Simulation.Title"]
        </h2>
        <div class="cit-page-subtitle text-muted">@Loc["Simulation.Subtitle"]</div>
    </div>
    @if (!_nonAutorise)
    {
        <div>
            <a href="/simulation/historique" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold rounded-pill shadow-sm">
                🕒 Mes simulations
            </a>
        </div>
    }
</div>

<div style="max-width: 1100px;">
    @if (_chargement)
    {
        <IndicateurChargement Message="Vérification de vos habilitations..." />
    }
    else if (_nonAutorise)
    {
        <PermissionDenied Message="@_messageNonAutorise" />
    }
    else
    {
        <div class="cit-card mb-4">
            <h6 class="fw-bold text-dark mb-3">Paramètres du Dossier</h6>
            <div class="row g-3">
                <div class="col-md-3">
                    <label for="sens-du-trafic" class="form-label small fw-semibold text-dark">Sens du trafic</label>
                    <select id="sens-du-trafic" class="form-select form-select-sm"
                            @bind="_sensOperationId" @bind:after="RafraichirCategories">
                        @foreach (var s in _referentiels.Sens)
                        {
                            <option value="@s.Id">@s.Libelle</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="date-d-arrivee" class="form-label small fw-semibold text-dark">Date d'arrivée</label>
                    <input id="date-d-arrivee" type="date" class="form-control form-control-sm" @bind="_dateArrivee" />
                </div>
                <div class="col-md-3">
                    <label for="date-d-enlevement-previsionnel" class="form-label small fw-semibold text-dark">Date d'enlèvement prévisionnel</label>
                    <input id="date-d-enlevement-previsionnel" type="date" class="form-control form-control-sm" @bind="_dateEnlevement" />
                </div>
                <div class="col-md-3">
                    <label for="n-navire-optionnel" class="form-label small fw-semibold text-dark">N° navire (optionnel)</label>
                    <input id="n-navire-optionnel" class="form-control form-control-sm" placeholder="Ex. CMA CGM BIANCA" @bind="_nomNavire" />
                </div>
            </div>
        </div>

        <div class="cit-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0">Conteneurs (@_conteneurs.Count)</h6>
                <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" @onclick="AjouterConteneur">➕ Ajouter un conteneur</button>
            </div>

            @for (var i = 0; i < _conteneurs.Count; i++)
            {
                var index = i;
                var c = _conteneurs[index];
                <div class="border rounded-3 p-3 mb-2 bg-light">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-2">
                            <label for="n-conteneur" class="form-label small fw-semibold text-dark">N° conteneur</label>
                            <input id="n-conteneur" class="form-control form-control-sm font-monospace" @bind="c.NumeroConteneur" />
                        </div>
                        <div class="col-md-2">
                            <label for="taille" class="form-label small fw-semibold text-dark">Taille</label>
                            <select id="taille" class="form-select form-select-sm" @bind="c.TailleConteneurId">
                                @foreach (var t in _referentiels.Tailles)
                                {
                                    <option value="@t.Id">@t.Libelle</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="type" class="form-label small fw-semibold text-dark">Type</label>
                            <select id="type" class="form-select form-select-sm" @bind="c.TypeConteneurId">
                                @foreach (var t in _referentiels.Types)
                                {
                                    <option value="@t.Id">@t.Libelle</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="poids-t" class="form-label small fw-semibold text-dark">Poids (t)</label>
                            <input id="poids-t" type="number" step="0.01" class="form-control form-control-sm" @bind="c.PoidsTonnes" />
                        </div>
                        <div class="col-md-2">
                            @* La catégorie était un champ texte libre : une faute de frappe donnait
                               « tarif non trouvé » au lieu d'un tarif. Elle se choisit désormais
                               dans le référentiel, restreint au sens du dossier (Annexe A.6). *@
                            <label for="categorie" class="form-label small fw-semibold text-dark">Catégorie</label>
                            <select id="categorie" class="form-select form-select-sm" @bind="c.CategorieMarchandiseId">
                                @foreach (var cat in _categoriesDuSens)
                                {
                                    <option value="@cat.Id">@cat.Code — @cat.Libelle</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-1 form-check mb-2 ps-4">
                            <input type="checkbox" class="form-check-input" id="dang-@index" @bind="c.EstDangereux" />
                            <label class="form-check-label small" for="dang-@index">Danger</label>
                        </div>
                        <div class="col-md-1 form-check mb-2 ps-4">
                            <input type="checkbox" class="form-check-input" id="oog-@index" @bind="c.EstHorsGabarit" />
                            <label class="form-check-label small" for="oog-@index">OOG</label>
                        </div>
                    </div>
                    <div class="text-end mt-2">
                        <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0" @onclick="() => SupprimerConteneur(index)">🗑️ Retirer ce conteneur</button>
                    </div>
                </div>
            }

            @if (_conteneurs.Count == 0)
            {
                <EtatVide Titre="Aucun conteneur" Message="Ajoutez au moins un conteneur pour lancer le calcul." Icone="📦" />
            }
        </div>

        <div class="d-flex justify-content-end gap-2 mb-4">
            <button type="button" class="btn btn-primary px-4 fw-bold shadow-sm" disabled="@(_conteneurs.Count == 0 || _calculEnCours)" @onclick="CalculerAsync">
                @(_calculEnCours ? "Calcul en cours..." : "🧮 Calculer la proforma")
            </button>
        </div>

        @* SIM-11 — « contrôles de cohérence à la saisie, avec messages d'aide contextuels ».
           Les contrôles existaient et aucun écran ne les appelait : on calculait un proforma sur
           des dates inversées sans rien dire. Les incohérences BLOQUENT ; les messages d'aide
           informent sans jamais empêcher. *@
        @if (_alertesCoherence.Count > 0)
        {
            <div class="alert alert-warning mb-4" role="alert">
                <div class="fw-semibold mb-1">Incohérences à corriger avant le calcul</div>
                <ul class="mb-0 small">
                    @foreach (var alerte in _alertesCoherence)
                    {
                        <li>@alerte</li>
                    }
                </ul>
            </div>
        }

        @if (_aidesCoherence.Count > 0)
        {
            <div class="alert alert-info mb-4" role="status">
                <ul class="mb-0 small">
                    @foreach (var aide in _aidesCoherence)
                    {
                        <li>@aide</li>
                    }
                </ul>
            </div>
        }

        @if (_erreur is not null)
        {
            <div class="alert alert-danger mb-4">@_erreur</div>
        }

        @if (_resultat is not null)
        {
            <div class="cit-card mb-4 border-primary">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark mb-0">Décomposition du calcul</h6>
                    <span class="badge bg-primary-subtle text-primary">Simulation calculée</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Conteneur</th>
                                <th class="text-end">Acconage</th>
                                <th class="text-end">Relevage</th>
                                <th class="text-end">Branch. Frigo</th>
                                <th class="text-end">Maj. Lourd</th>
                                <th class="text-end">Maj. Dangereux</th>
                                <th class="text-end">Maj. OOG</th>
                                <th class="text-end">Stationnement</th>
                                <th class="text-end fw-bold">Total ligne</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in _resultat.Lignes)
                            {
                                <tr>
                                    <td class="fw-bold font-monospace text-dark">@l.NumeroConteneur</td>
                                    <td class="text-end font-monospace">@l.Acconage.ToString("N0") XOF</td>
                                    <td class="text-end font-monospace">@l.Relevage.ToString("N0") XOF</td>
                                    <td class="text-end font-monospace">@l.BranchementFrigorifique.ToString("N0") XOF</td>
                                    <td class="text-end font-monospace">@l.MajorationLourd.ToString("N0") XOF</td>
                                    <td class="text-end font-monospace">@l.MajorationDangereux.ToString("N0") XOF</td>
                                    <td class="text-end font-monospace">@l.MajorationHorsGabarit.ToString("N0") XOF</td>
                                    <td class="text-end font-monospace">@l.Stationnement.ToString("N0") XOF</td>
                                    <td class="text-end fw-bold font-monospace text-dark">@l.TotalLigne.ToString("N0") XOF</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-light border-top">
                                <td colspan="8" class="text-end fw-bold">Total général estimé</td>
                                <td class="text-end fw-bold fs-5 text-primary font-monospace">@_resultat.TotalGeneralXof.ToString("N0") XOF</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="alert alert-secondary small mt-3 mb-0">@_resultat.MentionLegale</div>

                <div class="d-flex justify-content-end mt-3">
                    <button type="button" class="btn btn-success px-4 fw-bold shadow-sm" disabled="@_sauvegardeEnCours" @onclick="SauvegarderAsync">
                        @(_sauvegardeEnCours ? "Enregistrement..." : "💾 Enregistrer cette simulation")
                    </button>
                </div>
            </div>
        }
    }
</div>

@code {
    private static readonly SharedResourcesLocalizer Loc = new();
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private Guid _societeId;
    private Guid _auteurId;

    // Les référentiels sont chargés une fois et servent à la fois les listes de saisie et les
    // contrôles de cohérence (analyse Merise § 3.3 — ils étaient auparavant des énumérations C#).
    private ReferentielsSimulationVue _referentiels = new([], [], [], []);
    private IReadOnlyList<ReferenceTarifaireVue> _categoriesDuSens = [];

    private Guid _sensOperationId;
    private DateTime _dateArrivee = DateTime.Today;
    private DateTime _dateEnlevement = DateTime.Today;
    private string? _nomNavire;
    private readonly List<ConteneurSaisie> _conteneurs = [];

    private bool _calculEnCours;
    private bool _sauvegardeEnCours;
    private string? _erreur;
    private ResultatSimulationProformaVue? _resultat;
    private IReadOnlyList<string> _alertesCoherence = [];
    private IReadOnlyList<string> _aidesCoherence = [];

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Vous devez être connecté et rattaché à une entreprise pour simuler une proforma.";
                return;
            }

            _societeId = contexte.SocieteId.Value;
            _auteurId = contexte.UtilisateurId;

            _referentiels = await Referentiels.HandleAsync();

            if (_referentiels.Sens.Count == 0)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Les référentiels tarifaires ne sont pas encore approvisionnés. "
                    + "Contactez l'administrateur fonctionnel avant de simuler une proforma.";
                return;
            }

            _sensOperationId = _referentiels.Sens[0].Id;
            RafraichirCategories();
            AjouterConteneur();
        }
        finally
        {
            _chargement = false;
        }
    }

    /// <summary>
    /// Annexe A.6 — une catégorie n'existe que pour un sens. Changer de sens invalide donc les
    /// catégories déjà choisies : elles sont réalignées plutôt que laissées à une valeur qui ne
    /// s'applique plus, ce que le contrôle de cohérence signalerait ensuite comme une erreur.
    /// </summary>
    private void RafraichirCategories()
    {
        _categoriesDuSens = _referentiels.CategoriesDuSens(_sensOperationId);
        var defaut = _categoriesDuSens.Count > 0 ? _categoriesDuSens[0].Id : Guid.Empty;

        foreach (var c in _conteneurs.Where(c => _categoriesDuSens.All(cat => cat.Id != c.CategorieMarchandiseId)))
        {
            c.CategorieMarchandiseId = defaut;
        }
    }

    private void AjouterConteneur() => _conteneurs.Add(new ConteneurSaisie
    {
        NumeroConteneur = $"CONT{_conteneurs.Count + 1:00}",
        TailleConteneurId = _referentiels.Tailles.Count > 0 ? _referentiels.Tailles[0].Id : Guid.Empty,
        TypeConteneurId = _referentiels.Types.Count > 0 ? _referentiels.Types[0].Id : Guid.Empty,
        CategorieMarchandiseId = _categoriesDuSens.Count > 0 ? _categoriesDuSens[0].Id : Guid.Empty,
    });

    private void SupprimerConteneur(int index) => _conteneurs.RemoveAt(index);

    private CalculerSimulationProformaRequete ConstruireRequete() => new(
        _sensOperationId,
        DateOnly.FromDateTime(_dateArrivee),
        DateOnly.FromDateTime(_dateEnlevement),
        _conteneurs.Select(c => new ConteneurSimulationRequete(
            c.NumeroConteneur, c.TailleConteneurId, c.TypeConteneurId, c.PoidsTonnes,
            c.EstDangereux, c.EstHorsGabarit, c.CategorieMarchandiseId)).ToList(),
        _nomNavire);

    /// <summary>
    /// SIM-11 — les contrôles de cohérence passent AVANT le calcul. Le branchement frigorifique
    /// n'est pas saisi sur cet écran : le contrôle correspondant ne peut donc pas se déclencher
    /// ici, et c'est la saisie qu'il faudrait compléter, pas le contrôle qu'il faut retirer.
    /// </summary>
    private async Task<bool> VerifierCoherenceAsync()
    {
        var validation = await ValiderCoherence.ExecuterAsync(
            _sensOperationId,
            DateOnly.FromDateTime(_dateArrivee),
            DateOnly.FromDateTime(_dateEnlevement),
            _conteneurs.Select(c => new ConteneurValidationRequete(
                c.TailleConteneurId, c.TypeConteneurId, c.CategorieMarchandiseId,
                AvecBranchementFrigorifique: false, c.PoidsTonnes)).ToList());

        _alertesCoherence = validation.Alertes;
        _aidesCoherence = validation.MessagesAide;
        return validation.EstValide;
    }

    private async Task CalculerAsync()
    {
        _erreur = null;
        _resultat = null;

        if (!await VerifierCoherenceAsync())
        {
            return;
        }

        _calculEnCours = true;
        try
        {
            _resultat = await Calculer.HandleAsync(ConstruireRequete());
        }
        catch (TarifNonTrouveException ex)
        {
            _erreur = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = $"Erreur lors du calcul : {ex.Message}";
        }
        finally
        {
            _calculEnCours = false;
        }
    }

    private async Task SauvegarderAsync()
    {
        _erreur = null;

        // Enregistrer une simulation incohérente reviendrait à archiver un devis faux.
        if (!await VerifierCoherenceAsync())
        {
            return;
        }

        _sauvegardeEnCours = true;
        try
        {
            // P2-02 : la société n'est plus transmise — elle est résolue côté serveur.
            var enregistree = await Sauvegarder.HandleAsync(new SauvegarderSimulationProformaCommande(_auteurId, ConstruireRequete()));
            Navigation.NavigateTo($"/simulation/{enregistree.Id}");
        }
        catch (Exception ex)
        {
            _erreur = $"Erreur lors de l'enregistrement : {ex.Message}";
        }
        finally
        {
            _sauvegardeEnCours = false;
        }
    }

    private sealed class ConteneurSaisie
    {
        public string NumeroConteneur { get; set; } = string.Empty;
        public Guid TailleConteneurId { get; set; }
        public Guid TypeConteneurId { get; set; }
        public decimal PoidsTonnes { get; set; }
        public bool EstDangereux { get; set; }
        public bool EstHorsGabarit { get; set; }
        public Guid CategorieMarchandiseId { get; set; }
    }
}
