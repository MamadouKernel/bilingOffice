@page "/simulation/proforma"
@rendermode InteractiveServer
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Tarification
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tarification
@using CIT.Plateforme.Domain.Tarification.Exceptions
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@inject IContexteUtilisateurWeb ContexteService
@inject CalculerSimulationProformaQueryHandler Calculer
@inject ValiderCoherenceSimulationQuery ValiderCoherence
@inject SauvegarderSimulationProformaCommandHandler Sauvegarder
@inject ConsulterReferentielsTarifairesQueryHandler Referentiels
@inject IAutorisationService Autorisation
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>@Loc["Simulation.Title"] — @Loc["Common.AppTitle"]</PageTitle>

@* Page accessible sans authentification (TAR-01..05, simulateur public depuis l'accueil) :
   MainLayout n'affiche l'en-tête et le menu que pour un utilisateur connecté, donc un
   visiteur anonyme qui arrive ici n'a autrement aucun moyen de revenir à l'accueil. Même
   convention que Connexion.razor. *@
<div class="mb-3 px-2">
    <a href="/" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold rounded-pill bg-white shadow-xs d-inline-flex align-items-center gap-2">
        <span>🏠</span> @Loc["Common.BackHome"]
    </a>
</div>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span>🧮</span> @Loc["Sim.Badge"]
        </div>
        <h1 class="cit-page-title fw-bold text-dark mb-1">
            @Loc["Simulation.Title"]
        </h1>
        <div class="cit-page-subtitle text-muted">@Loc["Simulation.Subtitle"]</div>
    </div>
    @if (!_nonAutorise)
    {
        <div>
            <a href="/simulation/historique" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold rounded-pill shadow-sm">
                🕒 @Loc["Sim.MySimulations"]
            </a>
        </div>
    }
</div>

<div class="cit-page-large">
    @if (_chargement)
    {
        <IndicateurChargement Message="@Loc["Sim.LoadingPermissions"]" />
    }
    else if (_nonAutorise)
    {
        <PermissionDenied Message="@_messageNonAutorise" />
    }
    else
    {
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        @if (_estAdminTarif)
        {
            <a href="/admin/tarification" class="btn btn-outline-secondary btn-sm fw-semibold">⚙️ @Loc["Sim.ConfigureTariffs"]</a>
        }
        <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold" @onclick="ChargerExempleAsync">📄 @Loc["Sim.LoadExample"]</button>
        <button type="button" class="btn btn-warning btn-sm fw-semibold text-dark ms-auto" disabled="@(_resultat is null)" @onclick="ImprimerAsync">🖨️ @Loc["Sim.ExportPdf"]</button>
    </div>

    <div class="row g-4">
      <div class="col-12 col-xl-5">
        <section class="cit-card cit-sim-panel mb-4">
            <div class="cit-sim-section-head">
                <span class="cit-sim-section-icon" aria-hidden="true">📋</span>
                <div>
                    <h2 class="cit-sim-section-title">@Loc["Sim.ParamsTitle"]</h2>
                    <div class="cit-sim-section-hint">@Loc["Sim.ParamsHint"]</div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label for="date-d-arrivee" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.ArrivalDate"]</label>
                    <input id="date-d-arrivee" type="date" class="form-control" @bind="_dateArrivee" @bind:after="RecalculerAsync" />
                </div>
                <div class="col-12 col-md-6">
                    <label for="date-d-enlevement-previsionnel" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.PickupDate"]</label>
                    <input id="date-d-enlevement-previsionnel" type="date" class="form-control" @bind="_dateEnlevement" @bind:after="RecalculerAsync" />
                </div>
                <div class="col-12 col-md-6">
                    <label for="n-navire-optionnel" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.VesselOptional"]</label>
                    <input id="n-navire-optionnel" class="form-control" placeholder="@Loc["Sim.VesselPlaceholder"]" @bind="_nomNavire" />
                </div>
                <div class="col-12 col-md-6">
                    <label for="n-voyage" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.Voyage"]</label>
                    <input id="n-voyage" class="form-control" @bind="_numeroVoyage" />
                </div>
                <div class="col-12 col-md-6">
                    <label for="n-bl" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.BlBooking"]</label>
                    <input id="n-bl" class="form-control" @bind="_numeroBl" />
                </div>
                <div class="col-12 col-md-6">
                    <label for="n-escale" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.Escale"]</label>
                    <input id="n-escale" class="form-control" @bind="_escale" />
                </div>
                <div class="col-12 col-md-6">
                    <label for="n-client" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.Client"]</label>
                    <input id="n-client" class="form-control" @bind="_client" />
                </div>
                <div class="col-12 col-md-6">
                    <label for="n-typeclient" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.ClientType"]</label>
                    <select id="n-typeclient" class="form-select" @bind="_typeClient">
                        <option value="Client Comptant">@Loc["Simu.TypeClientComptant"]</option>
                        <option value="Client en compte">@Loc["Simu.TypeClientEnCompte"]</option>
                        <option value="Client deposit">@Loc["Simu.TypeClientDeposit"]</option>
                        <option value="Client IES">@Loc["Simu.TypeClientIes"]</option>
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label for="n-pchg" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.PortChargement"]</label>
                    <input id="n-pchg" class="form-control" @bind="_portChargement" />
                </div>
                <div class="col-12 col-md-6">
                    <label for="n-pdch" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.PortDechargement"]</label>
                    <input id="n-pdch" class="form-control" @bind="_portDechargement" />
                </div>
            </div>
        </section>

        @* AJOUTER UN CONTENEUR — on configure le conteneur puis on l'ajoute au dossier (maquette). *@
        <section class="cit-card cit-sim-panel mb-4">
            <div class="cit-sim-section-head">
                <span class="cit-sim-section-icon" aria-hidden="true">📦</span>
                <div><h2 class="cit-sim-section-title">@Loc["Sim.AddContainerPanel"]</h2></div>
            </div>
            <div class="row g-3">
                <div class="col-12">
                    <label for="sens-du-trafic" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.TrafficDirection"]</label>
                    <select id="sens-du-trafic" class="form-select" @bind="_sensOperationId" @bind:after="SensChangeAsync">
                        @foreach (var s in _referentiels.Sens)
                        {
                            <option value="@s.Id">@s.Libelle</option>
                        }
                    </select>
                    <div class="form-text small">@Loc["Sim.SensDossierHint"]</div>
                </div>
                <div class="col-6 col-md-4">
                    <label for="b-taille" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.Size"]</label>
                    <select id="b-taille" class="form-select" @bind="_brouillon.TailleConteneurId">
                        @foreach (var t in _referentiels.Tailles)
                        {
                            <option value="@t.Id">@t.Libelle</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-4">
                    <label for="b-type" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.Type"]</label>
                    <select id="b-type" class="form-select" @bind="_brouillon.TypeConteneurId">
                        @foreach (var t in _referentiels.Types)
                        {
                            <option value="@t.Id">@t.Libelle</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label for="b-cat" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.Category"]</label>
                    <select id="b-cat" class="form-select" @bind="_brouillon.CategorieMarchandiseId">
                        @foreach (var cat in _categoriesDuSens)
                        {
                            <option value="@cat.Id">@cat.Code — @cat.Libelle</option>
                        }
                    </select>
                </div>
                <div class="col-4">
                    <label for="b-poids" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.Weight"]</label>
                    <input id="b-poids" type="number" step="0.01" min="0" class="form-control" @bind="_brouillon.PoidsTonnes" />
                </div>
                <div class="col-4">
                    <label for="b-nb" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.Quantity"]</label>
                    <input id="b-nb" type="number" min="1" step="1" class="form-control" @bind="_brouillon.Nombre" />
                </div>
                <div class="col-4">
                    <label for="b-num" class="form-label small fw-semibold text-muted text-uppercase">@Loc["Sim.ContainerNumber"]</label>
                    <input id="b-num" class="form-control font-monospace" placeholder="ABCD1234567" @bind="_brouillon.NumeroConteneur" />
                </div>
            </div>
            <div class="cit-sim-toggles">
                <label class="cit-sim-toggle" for="b-oog">
                    <input type="checkbox" id="b-oog" @bind="_brouillon.EstHorsGabarit" /> 📐 OOG
                </label>
                <label class="cit-sim-toggle" for="b-dang">
                    <input type="checkbox" id="b-dang" @bind="_brouillon.EstDangereux" /> ⚠️ @Loc["Sim.Danger"]
                </label>
            </div>
            <div class="mt-3">
                <button type="button" class="btn btn-primary fw-semibold" @onclick="AjouterConteneur">➕ @Loc["Sim.AddToDossier"]</button>
            </div>
        </section>

        @* CONTENEURS DU DOSSIER — liste des conteneurs ajoutés (lecture seule + retrait). *@
        <section class="cit-card cit-sim-panel mb-4">
            <div class="cit-sim-section-head">
                <span class="cit-sim-section-icon" aria-hidden="true">🗂️</span>
                <div><h2 class="cit-sim-section-title">@Loc["Sim.DossierContainers"] (@_conteneurs.Count)</h2></div>
            </div>

            @if (_conteneurs.Count == 0)
            {
                <EtatVide Titre="@Loc["Sim.EmptyTitle"]" Message="@Loc["Sim.EmptyMsg"]" Icone="📦" />
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @for (var i = 0; i < _conteneurs.Count; i++)
                    {
                        var index = i;
                        var c = _conteneurs[index];
                        <div class="cit-sim-ctn d-flex justify-content-between align-items-start gap-2">
                            <div class="small">
                                <div class="fw-bold text-dark">@c.Nombre × @LibelleTaille(c.TailleConteneurId) @LibelleType(c.TypeConteneurId)</div>
                                <div class="text-muted">@LibelleCategorie(c.CategorieMarchandiseId)</div>
                                <div class="text-muted">
                                    @c.PoidsTonnes t@(string.IsNullOrWhiteSpace(c.NumeroConteneur) ? "" : " · " + c.NumeroConteneur)
                                    @if (c.EstHorsGabarit)
                                    {
                                        <span class="badge bg-warning-subtle text-warning ms-1">OOG</span>
                                    }
                                    @if (c.EstDangereux)
                                    {
                                        <span class="badge bg-danger-subtle text-danger ms-1">@Loc["Sim.Danger"]</span>
                                    }
                                </div>
                            </div>
                            <BoutonSupprimer Discret="true" Libelle="@Loc["Sim.Remove"]" OnSupprimer="() => SupprimerConteneur(index)" />
                        </div>
                    }
                </div>
            }
        </section>

        <div class="small text-muted mb-3">
            @(_calculEnCours ? Loc["Sim.Calculating"].Value : Loc["Sim.AutoCalc"].Value)
        </div>

        @* SIM-11 — « contrôles de cohérence à la saisie, avec messages d'aide contextuels ».
           Les contrôles existaient et aucun écran ne les appelait : on calculait un proforma sur
           des dates inversées sans rien dire. Les incohérences BLOQUENT ; les messages d'aide
           informent sans jamais empêcher. *@
        @if (_alertesCoherence.Count > 0)
        {
            <div class="alert alert-warning mb-4" role="alert">
                <div class="fw-semibold mb-1">@Loc["Sim.IncoherenceTitle"]</div>
                <ul class="mb-0 small">
                    @foreach (var alerte in _alertesCoherence)
                    {
                        <li>@alerte</li>
                    }
                </ul>
            </div>
        }

        @if (_aidesCoherence.Count > 0)
        {
            <div class="alert alert-info mb-4" role="status">
                <ul class="mb-0 small">
                    @foreach (var aide in _aidesCoherence)
                    {
                        <li>@aide</li>
                    }
                </ul>
            </div>
        }

      </div>

      <div class="col-12 col-xl-7">
        <div style="position:sticky;top:1rem;">
            <div class="d-flex justify-content-between align-items-center mb-2 no-print gap-2 flex-wrap">
                <span class="small text-muted">
                    @(_calculEnCours ? Loc["Sim.Calculating"].Value : (_resultat is not null ? "✓ " + Loc["Sim.Calculated"].Value : ""))
                </span>
                @if (_resultat is not null)
                {
                    <div class="d-flex gap-2">
                        @if (_peutEnregistrer)
                        {
                            <button type="button" class="btn btn-success btn-sm fw-bold shadow-sm" disabled="@_sauvegardeEnCours" @onclick="SauvegarderAsync">
                                @(_sauvegardeEnCours ? Loc["Sim.Saving"].Value : "💾 " + Loc["Sim.Save"].Value)
                            </button>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary btn-sm fw-bold" href="/comptes/connexion?returnUrl=/simulation/proforma">
                                🔒 @Loc["Sim.LoginToSave"]
                            </a>
                        }
                    </div>
                }
            </div>

            @if (_erreur is not null)
            {
                <div class="alert alert-danger mb-3" role="alert">@_erreur</div>
            }

            @if (_resultat is not null)
            {
                <div id="facture-proforma">
                    <ApercuProformaFacture Sens="@_resultat.Sens"
                                           DateArrivee="@_resultat.DateArrivee"
                                           DateEnlevement="@_resultat.DateEnlevementPrevisionnel"
                                           Duree="@_resultat.DureeSejourJours"
                                           Lignes="@_resultat.Lignes"
                                           Total="@_resultat.TotalGeneralXof"
                                           MentionLegale="@_resultat.MentionLegale"
                                           GrilleLibelle="@_resultat.VersionGrilleLibelle"
                                           Navire="@_nomNavire"
                                           Voyage="@_numeroVoyage"
                                           Bl="@_numeroBl"
                                           ClientNom="@_client"
                                           TypeClient="@_typeClient"
                                           Escale="@_escale"
                                           PortChargement="@_portChargement"
                                           PortDechargement="@_portDechargement" />
                </div>
            }
            else if (_erreur is null)
            {
                <div class="cit-card p-5 text-center text-muted">
                    <div class="fs-1 mb-2" aria-hidden="true">🧾</div>
                    <div>@Loc["Sim.PreviewEmpty"]</div>
                </div>
            }
        </div>
      </div>
    </div>
    }
</div>

@code {
    private readonly EtatPagination _pagination1 = new();

    private static readonly SharedResourcesLocalizer Loc = new();
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;

    // REMÉDIATION UI-R01 — LA SIMULATION EST PUBLIQUE (décision métier : SIM-01 « le client PEUT
    // lancer une simulation »). Un visiteur anonyme charge la page, saisit et calcule. Seul
    // l'ENREGISTREMENT — donc l'historique personnel — reste réservé à un compte rattaché à une
    // société : c'est lui, et lui seul, qui a besoin d'une identité et d'une portée.
    private bool _peutEnregistrer;
    private bool _estAdminTarif;
    private Guid _auteurId;

    // Les référentiels sont chargés une fois et servent à la fois les listes de saisie et les
    // contrôles de cohérence (analyse Merise § 3.3 — ils étaient auparavant des énumérations C#).
    private ReferentielsSimulationVue _referentiels = new([], [], [], []);
    private IReadOnlyList<ReferenceTarifaireVue> _categoriesDuSens = [];

    private Guid _sensOperationId;
    private DateTime _dateArrivee = DateTime.Today;
    private DateTime _dateEnlevement = DateTime.Today;
    private string? _nomNavire;
    private string? _numeroVoyage;
    private string? _numeroBl;
    private string? _escale;
    private string? _client;
    private string _typeClient = "Client Comptant";
    private string? _portChargement;
    private string? _portDechargement;
    private readonly List<ConteneurSaisie> _conteneurs = [];
    // Conteneur en cours de saisie dans le panneau « Ajouter un conteneur » (maquette).
    private ConteneurSaisie _brouillon = new();

    private bool _calculEnCours;
    private bool _sauvegardeEnCours;
    private string? _erreur;
    private ResultatSimulationProformaVue? _resultat;
    private IReadOnlyList<string> _alertesCoherence = [];
    private IReadOnlyList<string> _aidesCoherence = [];

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();

            // La simulation reste ouverte à tous. On note seulement si l'appelant pourra
            // l'enregistrer : un compte authentifié ET rattaché à une société active.
            _peutEnregistrer = contexte.EstAuthentifie && contexte.SocieteId.HasValue;
            _auteurId = contexte.UtilisateurId;
            _estAdminTarif = contexte.EstAuthentifie
                && await Autorisation.EstAutoriseAsync(_auteurId, Permission.TarificationAdministrer);

            _referentiels = await Referentiels.HandleAsync();

            if (_referentiels.Sens.Count == 0)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["Sim.NotProvisioned"].Value;
                return;
            }

            _sensOperationId = _referentiels.Sens[0].Id;
            RafraichirCategories();
            InitialiserBrouillon();
        }
        finally
        {
            _chargement = false;
        }
    }

    /// <summary>
    /// Annexe A.6 — une catégorie n'existe que pour un sens. Changer de sens invalide donc les
    /// catégories déjà choisies : elles sont réalignées plutôt que laissées à une valeur qui ne
    /// s'applique plus, ce que le contrôle de cohérence signalerait ensuite comme une erreur.
    /// </summary>
    private void RafraichirCategories()
    {
        _categoriesDuSens = _referentiels.CategoriesDuSens(_sensOperationId);
        var defaut = _categoriesDuSens.Count > 0 ? _categoriesDuSens[0].Id : Guid.Empty;

        foreach (var c in _conteneurs.Where(c => _categoriesDuSens.All(cat => cat.Id != c.CategorieMarchandiseId)))
        {
            c.CategorieMarchandiseId = defaut;
        }

        // Le brouillon suit le sens courant : sa catégorie est réalignée si elle n'existe plus.
        if (_brouillon is not null && _categoriesDuSens.All(cat => cat.Id != _brouillon.CategorieMarchandiseId))
        {
            _brouillon.CategorieMarchandiseId = defaut;
        }
    }

    private void InitialiserBrouillon() => _brouillon = new ConteneurSaisie
    {
        NumeroConteneur = string.Empty,
        Nombre = 1,
        PoidsTonnes = 10m,
        TailleConteneurId = _referentiels.Tailles.Count > 0 ? _referentiels.Tailles[0].Id : Guid.Empty,
        TypeConteneurId = _referentiels.Types.Count > 0 ? _referentiels.Types[0].Id : Guid.Empty,
        CategorieMarchandiseId = _categoriesDuSens.Count > 0 ? _categoriesDuSens[0].Id : Guid.Empty,
    };

    /// <summary>Ajoute le brouillon courant au dossier (maquette : « + Ajouter au dossier »), puis
    /// recalcule en direct. Les sélections (taille/type/catégorie) restent prêtes pour un ajout
    /// suivant ; seuls le numéro et la quantité sont réinitialisés.</summary>
    private async Task AjouterConteneur()
    {
        if (_brouillon.TailleConteneurId == Guid.Empty
            || _brouillon.TypeConteneurId == Guid.Empty
            || _brouillon.CategorieMarchandiseId == Guid.Empty)
        {
            return;
        }

        _conteneurs.Add(new ConteneurSaisie
        {
            NumeroConteneur = _brouillon.NumeroConteneur,
            Nombre = Math.Max(1, _brouillon.Nombre),
            TailleConteneurId = _brouillon.TailleConteneurId,
            TypeConteneurId = _brouillon.TypeConteneurId,
            CategorieMarchandiseId = _brouillon.CategorieMarchandiseId,
            PoidsTonnes = _brouillon.PoidsTonnes,
            EstDangereux = _brouillon.EstDangereux,
            EstHorsGabarit = _brouillon.EstHorsGabarit,
        });

        _brouillon.NumeroConteneur = string.Empty;
        _brouillon.Nombre = 1;
        _brouillon.EstDangereux = false;
        _brouillon.EstHorsGabarit = false;

        await RecalculerAsync();
    }

    private string LibelleTaille(Guid id) =>
        _referentiels.Tailles.FirstOrDefault(t => t.Id == id)?.Libelle ?? "?";

    private string LibelleType(Guid id) =>
        _referentiels.Types.FirstOrDefault(t => t.Id == id)?.Libelle ?? "?";

    private string LibelleCategorie(Guid id) =>
        _categoriesDuSens.FirstOrDefault(c => c.Id == id)?.Libelle
        ?? _referentiels.Categories.FirstOrDefault(c => c.Id == id)?.Libelle ?? "?";

    private async Task SupprimerConteneur(int index)
    {
        _conteneurs.RemoveAt(index);
        await RecalculerAsync();
    }

    /// <summary>Changement de sens : réaligne les catégories (Annexe A.6) puis recalcule en direct.</summary>
    private async Task SensChangeAsync()
    {
        RafraichirCategories();
        await RecalculerAsync();
    }

    /// <summary>Calcul en direct, comme la maquette : relancé à chaque modification. Sans conteneur,
    /// la facture est vidée plutôt que de laisser un résultat périmé.</summary>
    private async Task RecalculerAsync()
    {
        if (_conteneurs.Count == 0)
        {
            _resultat = null;
            _erreur = null;
            _alertesCoherence = [];
            _aidesCoherence = [];
            return;
        }
        await CalculerAsync();
    }

    /// <summary>Pré-remplit un exemple (cas de recette Annexe A test06) — comme « Charger un exemple »
    /// de la maquette — puis recalcule en direct.</summary>
    private async Task ChargerExempleAsync()
    {
        Guid IdParCode(IReadOnlyList<ReferenceTarifaireVue> liste, string code) =>
            liste.FirstOrDefault(x => string.Equals(x.Code, code, StringComparison.OrdinalIgnoreCase))?.Id ?? Guid.Empty;

        var sensImportLocal = IdParCode(_referentiels.Sens, "IMPORT_LOCAL");
        if (sensImportLocal != Guid.Empty)
        {
            _sensOperationId = sensImportLocal;
            RafraichirCategories();
        }

        _nomNavire = "CMA CGM CORTE REAL";
