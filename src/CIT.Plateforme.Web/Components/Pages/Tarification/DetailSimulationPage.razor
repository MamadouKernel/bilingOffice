@page "/simulation/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.Tarification
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ConsulterSimulationProformaQueryHandler Consulter
@inject GenererDocumentProformaPdfQueryHandler GenererPdf
@inject IJSRuntime Js

<PageTitle>@Loc["SimDet.PageTitle"]</PageTitle>

<FilAriane Elements="@(new List<FilAriane.ElementAriane> { new(Loc["FicheAvoirExo.BcHome"].Value, "/"), new(Loc["SimHist.Title"].Value, "/simulation/historique"), new(Loc["SimDet.BcDetail"].Value) })" />

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>📄</span> @Loc["SimDet.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["SimDet.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/simulation/historique" class="btn btn-outline-secondary btn-sm shadow-sm">@Loc["SimDet.BackToHistory"]</a>
    </div>
</div>

<div class="cit-page-large">
    @if (_chargement)
    {
        <IndicateurChargement Message="@Loc["SimDet.Loading"]" />
    }
    else if (_nonAutorise)
    {
        <PermissionDenied Message="@_messageNonAutorise" />
    }
    else if (_detail is null)
    {
        <EtatVide Titre="@Loc["SimDet.NotFoundTitle"]" Message="@Loc["SimDet.NotFoundMsg"]" Icone="❓" />
    }
    else
    {
        @if (_detail.EstGrilleObsolete)
        {
            <div class="alert alert-warning border-warning">
                @Loc["SimDet.ObsoletePre"]
                <strong>@_detail.VersionActiveActuelleLibelle</strong>@Loc["SimDet.ObsoleteMid"]
                <strong>@_detail.VersionGrilleLibelle</strong> @Loc["SimDet.ObsoletePost"]
            </div>
        }

        <div class="d-flex justify-content-end mb-2 no-print">
            <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold" @onclick="ImprimerAsync">
                🖨️ @Loc["Sim.PrintPdf"]
            </button>
        </div>
        <div id="facture-proforma" class="mb-4">
            <ApercuProformaFacture Sens="_detail.Sens"
                                   DateArrivee="_detail.DateArrivee"
                                   DateEnlevement="_detail.DateEnlevementPrevisionnel"
                                   Duree="_detail.DureeSejourJours"
                                   Lignes="_detail.Lignes"
                                   Total="_detail.MontantTotalXof"
                                   MentionLegale="_detail.MentionLegale"
                                   Reference="_detail.Reference"
                                   GrilleLibelle="_detail.VersionGrilleLibelle"
                                   Navire="_detail.NomNavire"
                                   Voyage="_detail.NumeroVoyage"
                                   Bl="_detail.NumeroBlOuBooking"
                                   ClientNom="_detail.ClientAFacturer"
                                   TypeClient="_detail.TypeClientLibelle"
                                   Escale="_detail.Escale"
                                   PortChargement="_detail.PortChargement"
                                   PortDechargement="_detail.PortDechargement" />
        </div>

        <div class="cit-card mb-4">
            <div class="text-muted small text-uppercase fw-bold mb-2">@Loc["SimDet.TechBreakdown"]</div>
            <div class="row g-3 small mb-3 p-3 bg-light rounded-3 border">
                <div class="col-md-3"><span class="text-muted">@Loc["SimDet.RefLabel"]</span> <strong class="font-monospace text-primary">@_detail.Reference</strong></div>
                <div class="col-md-3"><span class="text-muted">@Loc["SimDet.DateLabel"]</span> <strong class="font-monospace">@_detail.DateCreationUtc.Horodate()</strong></div>
                <div class="col-md-3"><span class="text-muted">@Loc["SimDet.SensLabel"]</span> <strong>@_detail.Sens</strong></div>
                <div class="col-md-3"><span class="text-muted">@Loc["SimDet.StayLabel"]</span> <strong>@_detail.DureeSejourJours @Loc["SimHist.DaySuffix"]</strong></div>
                @if (!string.IsNullOrWhiteSpace(_detail.NomNavire))
                {
                    <div class="col-md-3"><span class="text-muted">@Loc["SimDet.ShipLabel"]</span> <strong>@_detail.NomNavire</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(_detail.NumeroBlOuBooking))
                {
                    <div class="col-md-3"><span class="text-muted">@Loc["SimDet.BlBookingLabel"]</span> <strong class="font-monospace text-dark">@_detail.NumeroBlOuBooking</strong></div>
                }
                <div class="col-md-3"><span class="text-muted">@Loc["SimDet.GridApplied"]</span> <span class="badge bg-secondary-subtle text-secondary">@_detail.VersionGrilleLibelle</span></div>
            </div>

            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["Sim.ColContainer"]</th>
                            <th class="text-end">@Loc["Sim.ColAcconage"]</th>
                            <th class="text-end">@Loc["Sim.ColRelevage"]</th>
                            <th class="text-end">@Loc["Sim.ColBranchement"]</th>
                            <th class="text-end">@Loc["Sim.ColMajLourd"]</th>
                            <th class="text-end">@Loc["Sim.ColMajDanger"]</th>
                            <th class="text-end">@Loc["Sim.ColMajOog"]</th>
                            <th class="text-end">@Loc["Sim.ColStationnement"]</th>
                            <th class="text-end fw-bold">@Loc["Sim.ColTotalLine"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in _pagination1.Appliquer(_detail.Lignes))
                        {
                            <tr>
                                <td class="fw-bold font-monospace text-dark">@l.NumeroConteneur</td>
                                <td class="text-end font-monospace">@l.Acconage.ToString("N0") XOF</td>
                                <td class="text-end font-monospace">@l.Relevage.ToString("N0") XOF</td>
                                <td class="text-end font-monospace">@l.BranchementFrigorifique.ToString("N0") XOF</td>
                                <td class="text-end font-monospace">@l.MajorationLourd.ToString("N0") XOF</td>
                                <td class="text-end font-monospace">@l.MajorationDangereux.ToString("N0") XOF</td>
                                <td class="text-end font-monospace">@l.MajorationHorsGabarit.ToString("N0") XOF</td>
                                <td class="text-end font-monospace">@l.Stationnement.ToString("N0") XOF</td>
                                <td class="text-end fw-bold font-monospace text-dark">@l.TotalLigne.ToString("N0") XOF</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light border-top">
                            <td colspan="8" class="text-end fw-bold">@Loc["SimDet.GrandTotal"]</td>
                            <td class="text-end fw-bold fs-5 text-primary font-monospace">@_detail.MontantTotalXof.ToString("N0") XOF</td>
                        </tr>
                    </tfoot>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>

            <div class="alert alert-secondary small mt-3 mb-0">@_detail.MentionLegale</div>

            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="button" class="btn btn-primary px-4 fw-bold shadow-sm" disabled="@_telechargementEnCours" @onclick="OuvrirApercuAsync">
                    👁 @Loc["Preview.Open"]
                </button>
                <button type="button" class="btn btn-outline-primary px-4 fw-bold shadow-sm" disabled="@_telechargementEnCours" @onclick="TelechargerPdfAsync">
                    @(_telechargementEnCours ? Loc["SimDet.Generating"].Value : Loc["SimDet.DownloadPdf"].Value)
                </button>
            </div>

            @if (_erreur is not null)
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert">@_erreur</div>
            }
        </div>

        <ApercuDocument EstOuvert="_apercu is not null"
                        NomFichier="@(_apercu?.NomFichier ?? string.Empty)"
                        TypeContenu="@(_apercu?.TypeContenu ?? string.Empty)"
                        Base64="@_apercu?.Base64"
                        OnFermer="FermerApercu"
                        OnTelecharger="TelechargerDepuisApercuAsync" />
    }
</div>

@code {
    private readonly EtatPagination _pagination1 = new();

    [Parameter]
    public Guid Id { get; set; }

    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private Guid _societeId;
    private Guid _appelantId;
    private SimulationProformaDetailVue? _detail;
    private bool _telechargementEnCours;
    private string? _erreur;
    private PdfGenere? _apercu;

    // Impression navigateur de la facture proforma = export PDF au design officiel.
    private async Task ImprimerAsync() => await Js.InvokeVoidAsync("window.print");

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["SimDet.LoginRequired"].Value;
                return;
            }

            _societeId = contexte.SocieteId.Value;
            _appelantId = contexte.UtilisateurId;

            try
            {
                // P2-02 : la société n'est plus transmise — elle est résolue côté serveur.
                _detail = await Consulter.HandleAsync(new ConsulterSimulationProformaRequete(_appelantId, Id));
            }
            catch (UnauthorizedAccessException)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["SimDet.OtherCompany"].Value;
            }
        }
        finally
        {
            _chargement = false;
        }
    }

    private Task TelechargerPdfAsync() => GenererPuisAsync(async pdf =>
        await Js.InvokeVoidAsync("telechargerFichier", pdf.NomFichier, pdf.TypeContenu, pdf.Base64));

    /// <summary>Aperçu du proforma dans l'application, sans téléchargement.</summary>
    private Task OuvrirApercuAsync() => GenererPuisAsync(pdf =>
    {
        _apercu = pdf;
        return Task.CompletedTask;
    });

    private void FermerApercu() => _apercu = null;

    private async Task TelechargerDepuisApercuAsync()
    {
        if (_apercu is { } pdf)
        {
            await Js.InvokeVoidAsync("telechargerFichier", pdf.NomFichier, pdf.TypeContenu, pdf.Base64);
        }
    }

    private async Task GenererPuisAsync(Func<PdfGenere, Task> action)
    {
        _erreur = null;
        _telechargementEnCours = true;
        try
        {
            // P2-02 : la société n'est plus transmise — elle est résolue côté serveur.
            var pdf = await GenererPdf.HandleAsync(new GenererDocumentProformaPdfRequete(_appelantId, Id));
            await action(new PdfGenere(pdf.NomFichier, pdf.TypeContenu, Convert.ToBase64String(pdf.Contenu)));
        }
        catch (Exception ex)
        {
            _erreur = $"{Loc["SimDet.PdfErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
        finally
        {
            _telechargementEnCours = false;
        }
    }

    private sealed record PdfGenere(string NomFichier, string TypeContenu, string Base64);
}
