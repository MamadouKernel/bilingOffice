@page "/admin/tarification"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Tarification
@using CIT.Plateforme.Domain.Tarification
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@inject IContexteUtilisateurWeb ContexteService
@inject ConsulterVersionsGrillesTarifairesQueryHandler ConsulterVersions
@inject ImporterGrilleTarifaireCsvCommandHandler ImporterCsv

<PageTitle>Administration tarifaire — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>⚙️</span> Administration des grilles tarifaires
        </h1>
        <div class="cit-page-subtitle">Versionnement et import CSV atomique — aucune valeur tarifaire codée en dur</div>
    </div>
</div>

<div style="max-width: 1100px;">
    @if (_chargement)
    {
        <IndicateurChargement Message="Vérification de vos habilitations..." />
    }
    else if (_nonAutorise)
    {
        <PermissionDenied Message="@_messageNonAutorise" />
    }
    else
    {
        <div class="cit-card mb-4">
            <h6 class="fw-bold text-dark mb-2">Importer une nouvelle version (CSV)</h6>
            <p class="text-muted small mb-3">
                Format attendu : UTF-8, séparateur point-virgule, en-tête
                <code>Sens;Taille;Categorie;Acconage;Relevage;BranchementJour</code>.
                L'import est atomique : la moindre erreur bloque la totalité du fichier.
            </p>
            <div class="row g-2 align-items-end mb-2">
                <div class="col-md-3">
                    <label for="n-de-version" class="form-label small fw-semibold text-dark">N° de version</label>
                    <input id="n-de-version" class="form-control form-control-sm font-monospace" @bind="_numeroVersion" placeholder="v2.0" />
                </div>
                <div class="col-md-3">
                    <label for="date-d-effet" class="form-label small fw-semibold text-dark">Date d'effet</label>
                    <input id="date-d-effet" type="date" class="form-control form-control-sm font-monospace" @bind="_dateEffet" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-dark">Fichier CSV</label>
                    <InputFile class="form-control form-control-sm" OnChange="ImporterAsync" />
                </div>
            </div>

            @if (_resultatImport is not null)
            {
                @if (_resultatImport.Succes)
                {
                    <div class="alert alert-success mt-2 mb-0" role="status">
                        ✅ Version <strong>@_numeroVersion</strong> créée avec @_resultatImport.NombreLignesImportees ligne(s) tarifaire(s).
                    </div>
                }
                else
                {
                    <div class="alert alert-danger mt-2 mb-0" role="alert">
                        <strong class="d-block mb-1">Import refusé — aucune donnée persistée :</strong>
                        <ul class="mb-0 small ps-3">
                            @foreach (var erreur in _resultatImport.Erreurs)
                            {
                                <li>@erreur</li>
                            }
                        </ul>
                    </div>
                }
            }

            @if (_erreur is not null)
            {
                <div class="alert alert-danger mt-2 mb-0" role="alert">@_erreur</div>
            }
        </div>

        <div class="cit-card p-0 overflow-hidden mb-4">
            <div class="p-3 bg-light border-bottom">
                <h6 class="fw-bold text-dark mb-0">Versions des grilles existantes</h6>
            </div>
            @if (_versions.Count == 0)
            {
                <div class="p-4">
                    <EtatVide Titre="Aucune grille tarifaire" Message="Importez un fichier CSV pour créer la première version." Icone="📊" />
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Version</th>
                                <th>Date d'effet</th>
                                <th>Créée le</th>
                                <th class="text-end">Lignes</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in _versions)
                            {
                                <tr>
                                    <td class="fw-bold text-primary font-monospace">@v.NumeroVersion</td>
                                    <td class="small text-muted font-monospace">@v.DateEffetUtc.ToString("dd/MM/yyyy")</td>
                                    <td class="small text-muted font-monospace">@v.DateCreationUtc.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end font-monospace">@v.NombreLignes</td>
                                    <td>
                                        @if (v.EstActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private Guid _agentId;

    private string _numeroVersion = string.Empty;
    private DateTime _dateEffet = DateTime.Today;
    private ResultatImportCsvVue? _resultatImport;
    private string? _erreur;
    private IReadOnlyList<VersionGrilleTarifaireSommaireVue> _versions = [];

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Vous devez être connecté pour accéder à l'administration tarifaire.";
                return;
            }

            _agentId = contexte.UtilisateurId;
            await ChargerVersionsAsync();
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ChargerVersionsAsync()
    {
        try
        {
            _versions = await ConsulterVersions.HandleAsync(new ConsulterVersionsGrillesTarifairesRequete(_agentId));
        }
        catch (AccesRefuseException)
        {
            _nonAutorise = true;
            _messageNonAutorise = "Vous ne disposez pas de l'habilitation d'administration tarifaire.";
        }
    }

    private async Task ImporterAsync(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        _erreur = null;
        _resultatImport = null;

        if (string.IsNullOrWhiteSpace(_numeroVersion))
        {
            _erreur = "Veuillez renseigner le numéro de la nouvelle version avant d'importer le fichier.";
            return;
        }

        try
        {
            await using var flux = e.File.OpenReadStream(5 * 1024 * 1024);
            await using var memoire = new MemoryStream();
            await flux.CopyToAsync(memoire);
            memoire.Position = 0;

            // Paramètres non renseignés : la commande applique le paramétrage initial de
            // l'Annexe A. Le fichier CSV porte les tarifs, jamais les taux ni les tranches.
            _resultatImport = await ImporterCsv.HandleAsync(new ImporterGrilleTarifaireCsvCommande(
                _agentId,
                _numeroVersion,
                DateTime.SpecifyKind(_dateEffet, DateTimeKind.Utc),
                memoire));

            if (_resultatImport.Succes)
            {
                await ChargerVersionsAsync();
            }
        }
        catch (AccesRefuseException)
        {
            _nonAutorise = true;
            _messageNonAutorise = "Vous ne disposez pas de l'habilitation d'administration tarifaire.";
        }
        catch (Exception ex)
        {
            _erreur = $"Erreur lors de l'import : {MessagesUtilisateur.Pour(ex)}";
        }
    }
}
