@page "/simulation/historique"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.Tarification
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@inject IContexteUtilisateurWeb ContexteService
@inject ListerSimulationsProformaQueryHandler Lister

<PageTitle>Historique des simulations — CIT</PageTitle>

<PageTitle>Historique des simulations — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>🕒</span> Historique des simulations
        </h2>
        <div class="cit-page-subtitle">Chaque simulation enregistrée conserve le détail figé de son calcul d'origine</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/simulation/proforma" class="btn btn-primary btn-sm shadow-sm fw-bold">➕ Nouvelle simulation</a>
    </div>
</div>

<div style="max-width: 1100px;">
    @if (_chargement)
    {
        <IndicateurChargement Message="Chargement de vos simulations..." />
    }
    else if (_nonAutorise)
    {
        <PermissionDenied Message="@_messageNonAutorise" />
    }
    else if (_simulations.Count == 0)
    {
        <EtatVide Titre="Aucune simulation enregistrée" Message="Vos simulations sauvegardées apparaîtront ici." Icone="🧮"
                  ActionLibelle="Créer une simulation" ActionUrl="/simulation/proforma" />
    }
    else
    {
        <div class="cit-card p-0 overflow-hidden mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Référence</th>
                            <th>Date</th>
                            <th>Sens</th>
                            <th class="text-end">Conteneurs</th>
                            <th class="text-end">Séjour</th>
                            <th>Grille</th>
                            <th class="text-end">Montant</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _simulations)
                        {
                            <tr>
                                <td class="fw-bold text-primary font-monospace">@s.Reference</td>
                                <td class="small text-muted font-monospace">@s.DateCreationUtc.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge bg-light text-dark border">@s.Sens</span></td>
                                <td class="text-end font-monospace">@s.NombreConteneurs</td>
                                <td class="text-end font-monospace">@s.DureeSejourJours j</td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@s.VersionGrilleLibelle</span></td>
                                <td class="text-end fw-bold font-monospace text-dark">@s.MontantTotalXof.ToString("N0") XOF</td>
                                <td class="text-end">
                                    <a class="btn btn-outline-primary btn-sm" href="/simulation/@s.Id">Voir le détail ➔</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private IReadOnlyList<SimulationProformaSommaireVue> _simulations = [];

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Vous devez être connecté et rattaché à une entreprise pour consulter cet historique.";
                return;
            }

            // P2-02 : la société n'est plus transmise — elle est résolue côté serveur.
            _simulations = await Lister.HandleAsync(new ListerSimulationsProformaRequete(contexte.UtilisateurId));
        }
        finally
        {
            _chargement = false;
        }
    }
}
