@page "/simulation/historique"
@rendermode InteractiveServer
@using CIT.Plateforme.Application.Tarification
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@inject IContexteUtilisateurWeb ContexteService
@inject ListerSimulationsProformaQueryHandler Lister

<PageTitle>Historique des simulations — CIT</PageTitle>

<div class="container-fluid py-3" style="max-width: 1100px;">
    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-0 text-dark">Historique des simulations</h2>
            <div class="text-muted small">Chaque simulation enregistrée conserve le détail figé de son calcul d'origine</div>
        </div>
        <a href="/simulation/proforma" class="btn btn-primary btn-sm">➕ Nouvelle simulation</a>
    </div>

    @if (_chargement)
    {
        <IndicateurChargement Message="Chargement de vos simulations..." />
    }
    else if (_nonAutorise)
    {
        <PermissionDenied Message="@_messageNonAutorise" />
    }
    else if (_simulations.Count == 0)
    {
        <EtatVide Titre="Aucune simulation enregistrée" Message="Vos simulations sauvegardées apparaîtront ici." Icone="🧮"
                  ActionLibelle="Créer une simulation" ActionUrl="/simulation/proforma" />
    }
    else
    {
        <div class="cit-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Référence</th>
                            <th>Date</th>
                            <th>Sens</th>
                            <th class="text-end">Conteneurs</th>
                            <th class="text-end">Séjour</th>
                            <th>Grille</th>
                            <th class="text-end">Montant</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _simulations)
                        {
                            <tr>
                                <td class="fw-semibold">@s.Reference</td>
                                <td>@s.DateCreationUtc.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@s.Sens</td>
                                <td class="text-end">@s.NombreConteneurs</td>
                                <td class="text-end">@s.DureeSejourJours j</td>
                                <td>@s.VersionGrilleLibelle</td>
                                <td class="text-end fw-bold">@s.MontantTotalXof.ToString("N0") XOF</td>
                                <td class="text-end">
                                    <a class="btn btn-outline-primary btn-sm" href="/simulation/@s.Id">Voir le détail</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private IReadOnlyList<SimulationProformaSommaireVue> _simulations = [];

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Vous devez être connecté et rattaché à une entreprise pour consulter cet historique.";
                return;
            }

            _simulations = await Lister.HandleAsync(new ListerSimulationsProformaRequete(contexte.UtilisateurId, contexte.SocieteId.Value));
        }
        finally
        {
            _chargement = false;
        }
    }
}
