@page "/simulation/historique"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.Tarification
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ListerSimulationsProformaQueryHandler Lister

<PageTitle>@Loc["SimHist.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>🕒</span> @Loc["SimHist.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["SimHist.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/simulation/proforma" class="btn btn-primary btn-sm shadow-sm fw-bold">@Loc["SimHist.New"]</a>
    </div>
</div>

<div style="max-width: 1100px;">
    @if (_chargement)
    {
        <IndicateurChargement Message="@Loc["SimHist.Loading"]" />
    }
    else if (_nonAutorise)
    {
        <PermissionDenied Message="@_messageNonAutorise" />
    }
    else if (_simulations.Count == 0)
    {
        <EtatVide Titre="@Loc["SimHist.EmptyTitle"]" Message="@Loc["SimHist.EmptyMsg"]" Icone="🧮"
                  ActionLibelle="@Loc["SimHist.EmptyCta"]" ActionUrl="/simulation/proforma" />
    }
    else
    {
        <div class="cit-card p-0 overflow-hidden mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["SimHist.ColRef"]</th>
                            <th>@Loc["SimHist.ColDate"]</th>
                            <th>@Loc["SimHist.ColSens"]</th>
                            <th class="text-end">@Loc["SimHist.ColContainers"]</th>
                            <th class="text-end">@Loc["SimHist.ColStay"]</th>
                            <th>@Loc["SimHist.ColGrid"]</th>
                            <th class="text-end">@Loc["SimHist.ColAmount"]</th>
                            <th class="text-end">@Loc["SimHist.ColAction"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _simulations)
                        {
                            <tr>
                                <td class="fw-bold text-primary font-monospace">@s.Reference</td>
                                <td class="small text-muted font-monospace">@s.DateCreationUtc.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge bg-light text-dark border">@s.Sens.Libelle</span></td>
                                <td class="text-end font-monospace">@s.NombreConteneurs</td>
                                <td class="text-end font-monospace">@s.DureeSejourJours @Loc["SimHist.DaySuffix"]</td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@s.VersionGrilleLibelle</span></td>
                                <td class="text-end fw-bold font-monospace text-dark">@s.MontantTotalXof.ToString("N0") XOF</td>
                                <td class="text-end">
                                    <a class="btn btn-outline-primary btn-sm" href="/simulation/@s.Id">@Loc["SimHist.ViewDetail"]</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private IReadOnlyList<SimulationProformaSommaireVue> _simulations = [];

    protected override async Task OnInitializedAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["SimHist.LoginRequired"].Value;
                return;
            }

            // P2-02 : la société n'est plus transmise — elle est résolue côté serveur.
            _simulations = await Lister.HandleAsync(new ListerSimulationsProformaRequete(contexte.UtilisateurId));
        }
        finally
        {
            _chargement = false;
        }
    }
}
