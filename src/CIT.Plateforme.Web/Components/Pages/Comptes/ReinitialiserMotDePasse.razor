@page "/comptes/reinitialiser-mot-de-passe"
@using CIT.Plateforme.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using System.Text
@using CIT.Plateforme.Web.Resources
@using Microsoft.Extensions.Localization
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["Account.ResetPageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>🔑</span> @Loc["Account.ResetTitle"]
        </h1>
        <div class="cit-page-subtitle">@Loc["Account.ResetSubtitle"]</div>
    </div>
</div>

<div style="max-width: 600px;">
    <div class="cit-card mb-4">
        <EditForm Model="Modele" OnValidSubmit="ReinitialiserAsync" FormName="reinitialiser-mot-de-passe">
            <input type="hidden" @bind-value="Modele.UtilisateurId" />
            <input type="hidden" @bind-value="Modele.Jeton" />
            <div class="mb-4">
                <label class="form-label small fw-semibold text-dark" for="nouveau-mot-de-passe">@Loc["Account.NewPassword"]</label>
                <ChampMotDePasse>
                    <InputText id="nouveau-mot-de-passe" type="password" class="form-control" @bind-Value="Modele.NouveauMotDePasse" placeholder="@Loc["Account.NewPasswordPlaceholder"]" />
                </ChampMotDePasse>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <a href="/comptes/connexion" class="text-decoration-none small text-muted">@Loc["Account.ResetCancel"]</a>
                <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">@Loc["Account.ResetSubmit"]</button>
            </div>
        </EditForm>
    </div>

    @if (erreur is not null)
    {
        <div class="alert alert-danger mb-4" role="alert">@erreur</div>
    }

    @if (succes)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="status">
            <span class="fs-4">✅</span>
            <div>
                <strong>@Loc["Account.ResetSuccess"]</strong>
                <div class="mt-1"><a href="/comptes/connexion" class="fw-bold text-success text-decoration-underline">@Loc["Account.GoToLogin"] ➔</a></div>
            </div>
        </div>
    }
</div>

@code {
    // REMÉDIATION POST-AUDIT (2026-08-29) : voir Connexion.razor pour la justification — le
    // paramètre [SupplyParameterFromForm] doit être le même identifiant que le Model de l'EditForm.
    [SupplyParameterFromForm]
    private ModeleReinitialisation Modele { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "utilisateurId")]
    private string? UtilisateurIdParametre { get; set; }

    [SupplyParameterFromQuery(Name = "jeton")]
    private string? JetonParametre { get; set; }

    private string? erreur;
    private bool succes;

    protected override void OnInitialized()
    {
        Modele ??= new();
        Modele.UtilisateurId ??= UtilisateurIdParametre ?? string.Empty;
        Modele.Jeton ??= JetonParametre ?? string.Empty;
    }

    private async Task ReinitialiserAsync()
    {
        erreur = null;
        var utilisateur = await UserManager.FindByIdAsync(Modele.UtilisateurId);
        if (utilisateur is null)
        {
            erreur = Loc["Account.ResetLinkInvalid"].Value;
            return;
        }

        var jeton = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Modele.Jeton));
        var resultat = await UserManager.ResetPasswordAsync(utilisateur, jeton, Modele.NouveauMotDePasse);
        if (!resultat.Succeeded)
        {
            erreur = string.Join(" ", resultat.Errors.Select(e => e.Description));
            return;
        }

        succes = true;
    }

    private sealed class ModeleReinitialisation
    {
        public string UtilisateurId { get; set; } = string.Empty;
        public string Jeton { get; set; } = string.Empty;
        public string NouveauMotDePasse { get; set; } = string.Empty;
    }
}
