@page "/comptes/reinitialiser-mot-de-passe"
@using CIT.Plateforme.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using System.Text
@using CIT.Plateforme.Web.Resources
@using Microsoft.Extensions.Localization
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc[activation ? "Account.ActivatePageTitle" : "Account.ResetPageTitle"]</PageTitle>

@* Écran d'authentification : même langage visuel que Connexion (carte centrée, champ large,
   bouton pleine largeur). Le titre reçoit le focus à la navigation (FocusOnNavigate) : il n'affiche
   pas de contour — ce n'est pas un élément interactif — les champs et boutons gardent le leur. *@
<div class="d-flex justify-content-center py-4 py-md-5">
    <div class="w-100" style="max-width: 460px;">
        <div class="cit-card border-0 shadow-lg p-4 p-md-5" style="border-radius: 1.5rem;">

            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center mb-3"
                     style="width: 3.5rem; height: 3.5rem; border-radius: 1rem; background: var(--azure-50); border: 1px solid var(--azure-100); font-size: 1.6rem;"
                     aria-hidden="true">
                    @(succes ? "✅" : activation ? "👋" : "🔑")
                </div>
                <h1 class="fw-bold h3 mb-2" style="color: var(--ink); outline: none; box-shadow: none;" tabindex="-1">
                    @Loc[activation ? "Account.ActivateTitle" : "Account.ResetTitle"]
                </h1>
                <p class="text-muted mb-0 small">@Loc[activation ? "Account.ActivateSubtitle" : "Account.ResetSubtitle"]</p>
            </div>

            @if (succes)
            {
                <div class="alert alert-success text-center mb-4" role="status">
                    <strong>@Loc[activation ? "Account.ActivateSuccess" : "Account.ResetSuccess"]</strong>
                </div>
                <a href="/comptes/connexion" class="btn btn-primary btn-lg w-100 py-3 shadow-sm" style="border-radius: .75rem;">
                    @Loc["Account.GoToLogin"] <span class="ms-2" aria-hidden="true">→</span>
                </a>
            }
            else
            {
                @if (erreur is not null)
                {
                    <div class="alert alert-danger mb-4" role="alert">@erreur</div>
                }

                <EditForm Model="Modele" OnValidSubmit="ReinitialiserAsync" FormName="reinitialiser-mot-de-passe">
                    <input type="hidden" @bind-value="Modele.UtilisateurId" />
                    <input type="hidden" @bind-value="Modele.Jeton" />

                    <div class="mb-4">
                        <label class="form-label text-uppercase fw-bold text-muted" style="font-size: .75rem; letter-spacing: .06em;" for="nouveau-mot-de-passe">
                            @Loc["Account.NewPassword"]
                        </label>
                        <ChampMotDePasse>
                            <InputText id="nouveau-mot-de-passe" type="password" autocomplete="new-password"
                                       class="form-control form-control-lg px-3 py-3"
                                       @bind-Value="Modele.NouveauMotDePasse"
                                       placeholder="@Loc["Account.NewPasswordPlaceholder"]" />
                        </ChampMotDePasse>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 py-3 shadow-sm" style="border-radius: .75rem;">
                        @if (activation)
                        {
                            @Loc["Account.ActivateSubmit"]
                        }
                        else
                        {
                            @Loc["Account.ResetSubmit"]
                        }
                        <span class="ms-2" aria-hidden="true">→</span>
                    </button>

                    <div class="text-center mt-4">
                        <a href="/comptes/connexion" class="small text-muted text-decoration-none">@Loc["Account.ResetCancel"]</a>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    // REMÉDIATION POST-AUDIT (2026-08-29) : voir Connexion.razor pour la justification — le
    // paramètre [SupplyParameterFromForm] doit être le même identifiant que le Model de l'EditForm.
    [SupplyParameterFromForm]
    private ModeleReinitialisation Modele { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "utilisateurId")]
    private string? UtilisateurIdParametre { get; set; }

    [SupplyParameterFromQuery(Name = "jeton")]
    private string? JetonParametre { get; set; }

    private string? erreur;
    private bool succes;

    /// <summary>
    /// Vrai pour une INVITATION : le compte n'a encore aucun mot de passe (agent créé par un
    /// administrateur). La page parle alors d'activation plutôt que de réinitialisation. Évalué
    /// avant le traitement du formulaire, ce mode reste stable sur l'écran de succès.
    /// </summary>
    private bool activation;

    protected override async Task OnInitializedAsync()
    {
        Modele ??= new();
        Modele.UtilisateurId ??= UtilisateurIdParametre ?? string.Empty;
        Modele.Jeton ??= JetonParametre ?? string.Empty;

        if (Guid.TryParse(Modele.UtilisateurId, out _)
            && await UserManager.FindByIdAsync(Modele.UtilisateurId) is { } compte)
        {
            activation = !await UserManager.HasPasswordAsync(compte);
        }
    }

    private async Task ReinitialiserAsync()
    {
        erreur = null;
        var utilisateur = await UserManager.FindByIdAsync(Modele.UtilisateurId);
        if (utilisateur is null)
        {
            erreur = Loc["Account.ResetLinkInvalid"].Value;
            return;
        }

        var jeton = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Modele.Jeton));
        var resultat = await UserManager.ResetPasswordAsync(utilisateur, jeton, Modele.NouveauMotDePasse);
        if (!resultat.Succeeded)
        {
            // Jeton expiré (> 2 h) ou déjà utilisé : un message clair plutôt que « Invalid token ».
            var jetonInvalide = resultat.Errors.Any(e => e.Code == nameof(IdentityErrorDescriber.InvalidToken));
            erreur = jetonInvalide
                ? Loc["Account.LinkExpired"].Value
                : string.Join(" ", resultat.Errors.Select(e => e.Description));
            return;
        }

        succes = true;
    }

    private sealed class ModeleReinitialisation
    {
        public string UtilisateurId { get; set; } = string.Empty;
        public string Jeton { get; set; } = string.Empty;
        public string NouveauMotDePasse { get; set; } = string.Empty;
    }
}
