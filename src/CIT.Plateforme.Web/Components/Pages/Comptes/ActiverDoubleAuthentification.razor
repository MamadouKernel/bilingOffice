@page "/comptes/double-authentification"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Text
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Infrastructure.Identity
@using CIT.Plateforme.Web.Resources
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IGenerateurQrCode GenerateurQrCode
@inject NavigationManager Navigation

<PageTitle>@Loc["TwoFa.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>🛡️</span> @Loc["TwoFa.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["TwoFa.Subtitle"]</div>
    </div>
</div>

<div style="max-width: 760px;">
    <div class="cit-card mb-4 shadow-sm">
        <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
            <div>
                <h6 class="fw-bold text-dark mb-1">@Loc["TwoFa.StatusTitle"]</h6>
                <div class="small text-muted">@Loc["TwoFa.StatusHelp"]</div>
            </div>
            @if (deuxFacteursActifs)
            {
                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-bold">@Loc["TwoFa.Active"]</span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill">@Loc["TwoFa.Inactive"]</span>
            }
        </div>

        @if (!deuxFacteursActifs)
        {
            <div class="alert alert-warning d-flex align-items-start gap-2 mb-4" role="alert">
                <span aria-hidden="true">🔒</span>
                <div>
                    <strong class="d-block">@Loc["TwoFa.MandatoryTitle"]</strong>
                    <span class="small">@Loc["TwoFa.MandatoryDesc"]</span>
                </div>
            </div>
        }

        @if (messageSucces is not null)
        {
            <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="status">
                <span>✅</span> <div>@messageSucces</div>
            </div>
        }

        @if (erreur is not null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                <span>⚠️</span> <div>@erreur</div>
            </div>
        }

        @if (deuxFacteursActifs)
        {
            <div class="alert alert-success bg-opacity-10 border-success d-flex align-items-start gap-3 mb-4 p-3 rounded-3" role="status">
                <span class="fs-4">🛡️</span>
                <div>
                    <strong class="d-block text-success mb-1">@Loc["TwoFa.SecuredTitle"]</strong>
                    <div class="small text-muted">
                        @Loc["TwoFa.SecuredDesc"]
                    </div>
                </div>
            </div>

            @* 2FA OBLIGATOIRE : plus de bouton « Désactiver ». On peut seulement reconfigurer
               l'application (changement de téléphone), ce qui la laisse active. *@
            <div class="d-flex justify-content-between align-items-center pt-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="AfficherReconfigurationAsync">
                    @Loc["TwoFa.ResetApp"]
                </button>
                <button class="btn btn-primary btn-sm fw-bold px-3" @onclick="ContinuerVersMonEspace">
                    @Loc["TwoFa.Continue"] <span aria-hidden="true">→</span>
                </button>
            </div>
        }
        else if (enConfiguration)
        {
            <div class="p-3 bg-light rounded-3 mb-4">
                <h6 class="fw-bold text-dark mb-3">@Loc["TwoFa.ConfigTitle"]</h6>

                <ol class="small text-muted ps-3 mb-4 d-flex flex-column gap-2">
                    <li>@((MarkupString)Loc["TwoFa.Step1"].Value)</li>
                    <li>@Loc["TwoFa.Step2"]</li>
                    <li>@Loc["TwoFa.Step3"]</li>
                </ol>

                <div class="row g-4 align-items-center mb-4">
                    <!-- QR Code -->
                    <div class="col-12 col-sm-auto text-center">
                        <div class="p-2 bg-white border rounded-3 d-inline-block shadow-xs">
                            <img src="@qrCodeDataUri" alt="@Loc["TwoFa.QrAlt"]" style="width: 160px; height: 160px;" class="img-fluid" />
                        </div>
                        <div class="small text-muted mt-1" style="font-size: 0.75rem;">@Loc["TwoFa.ScanQr"]</div>
                    </div>

                    <!-- Clé Manuelle -->
                    <div class="col-12 col-sm">
                        <label class="form-label small fw-bold text-dark mb-1">@Loc["TwoFa.ManualKeyLabel"]</label>
                        <div class="p-3 bg-white border rounded-3 font-monospace fw-bold text-primary tracking-wider mb-2 select-all" style="font-size: 1rem; word-break: break-all;">
                            @cleFormatee
                        </div>
                        <div class="small text-muted" style="font-size: 0.8rem;">
                            @((MarkupString)Loc["TwoFa.KeyMeta"].Value)
                        </div>
                    </div>
                </div>

                <!-- Validation du Code -->
                <div class="border-top pt-3">
                    <label class="form-label small fw-bold text-dark" for="codeConfirmation">@Loc["TwoFa.EnterCodeLabel"]</label>
                    <div class="d-flex gap-2">
                        <input id="codeConfirmation" type="text" maxlength="6" class="form-control font-monospace text-center fs-5 fw-bold" style="max-width: 180px; letter-spacing: 0.2em;" placeholder="123456" @bind="codeConfirmation" @bind:event="oninput" />
                        <button class="btn btn-primary fw-bold px-4" @onclick="ConfirmerActivationAsync" disabled="@(codeConfirmation?.Length != 6)">
                            @Loc["TwoFa.ConfirmActivate"]
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="AnnulerConfiguration">
                            @Loc["Common.Cancel"]
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4 align-items-center py-2">
                <div class="col-12 col-md-8">
                    <p class="text-muted small mb-2">
                        @Loc["TwoFa.IntroDesc"]
                    </p>
                    <div class="d-flex align-items-center gap-3 text-muted small mt-3">
                        <span class="d-flex align-items-center gap-1">@Loc["TwoFa.AppGoogle"]</span>
                        <span>•</span>
                        <span class="d-flex align-items-center gap-1">@Loc["TwoFa.AppMicrosoft"]</span>
                        <span>•</span>
                        <span class="d-flex align-items-center gap-1">@Loc["TwoFa.KeyTotpStd"]</span>
                    </div>
                </div>
                <div class="col-12 col-md-4 text-md-end">
                    <button class="btn btn-primary fw-bold px-4 py-2 shadow-sm rounded-pill w-100 w-md-auto" @onclick="DemarrerConfigurationAsync">
                        @Loc["TwoFa.ConfigureBtn"]
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private bool deuxFacteursActifs;
    private bool enConfiguration;
    private ApplicationUser? utilisateurCourant;
    private string? cleBrute;
    private string? cleFormatee;
    private string? qrCodeDataUri;
    private string? codeConfirmation;
    private string? messageSucces;
    private string? erreur;

    protected override async Task OnInitializedAsync()
    {
        var etatAuthentification = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        utilisateurCourant = await UserManager.GetUserAsync(etatAuthentification.User);
        if (utilisateurCourant is not null)
        {
            deuxFacteursActifs = await UserManager.GetTwoFactorEnabledAsync(utilisateurCourant);
        }
    }

    private async Task DemarrerConfigurationAsync()
    {
        if (utilisateurCourant is null) return;
        erreur = null;
        messageSucces = null;
        codeConfirmation = string.Empty;

        cleBrute = await UserManager.GetAuthenticatorKeyAsync(utilisateurCourant);
        if (string.IsNullOrEmpty(cleBrute))
        {
            await UserManager.ResetAuthenticatorKeyAsync(utilisateurCourant);
            cleBrute = await UserManager.GetAuthenticatorKeyAsync(utilisateurCourant);
        }

        cleFormatee = FormaterCle(cleBrute!);
        var email = utilisateurCourant.Email ?? "utilisateur";
        var issuer = "YABA";
        var otpauthUri = $"otpauth://totp/{Uri.EscapeDataString(issuer)}:{Uri.EscapeDataString(email)}?secret={cleBrute}&issuer={Uri.EscapeDataString(issuer)}&digits=6";
        
        // Rendu LOCAL du QR code. L'URI otpauth:// porte le secret TOTP partagé, qui EST le
        // second facteur : il ne doit jamais transiter par un service de rendu tiers ni
        // apparaître dans une query string. Voir IGenerateurQrCode.
        qrCodeDataUri = GenerateurQrCode.GenererDataUri(otpauthUri);
        enConfiguration = true;
    }

    private async Task AfficherReconfigurationAsync()
    {
        await DemarrerConfigurationAsync();
    }

    private void AnnulerConfiguration()
    {
        enConfiguration = false;
        erreur = null;
        codeConfirmation = string.Empty;
    }

    private async Task ConfirmerActivationAsync()
    {
        if (utilisateurCourant is null || string.IsNullOrWhiteSpace(codeConfirmation)) return;
        erreur = null;

        var estValide = await UserManager.VerifyTwoFactorTokenAsync(
            utilisateurCourant,
            UserManager.Options.Tokens.AuthenticatorTokenProvider,
            codeConfirmation.Trim());

        if (!estValide)
        {
            erreur = Loc["TwoFa.MsgInvalidCode"].Value;
            return;
        }

        await UserManager.SetTwoFactorEnabledAsync(utilisateurCourant, true);
        deuxFacteursActifs = true;
        enConfiguration = false;
        messageSucces = Loc["TwoFa.MsgEnabled"].Value;
    }

    // 2FA OBLIGATOIRE : la désactivation n'est plus proposée. Une fois activée, l'utilisateur
    // rejoint son espace ; le rechargement complet repasse par le contrôle d'accès du serveur.
    private void ContinuerVersMonEspace() => Navigation.NavigateTo("/", forceLoad: true);

    private static string FormaterCle(string cle)
    {
        var sb = new StringBuilder();
        for (int i = 0; i < cle.Length; i++)
        {
            if (i > 0 && i % 4 == 0)
            {
                sb.Append(' ');
            }
            sb.Append(cle[i]);
        }
        return sb.ToString();
    }
}
