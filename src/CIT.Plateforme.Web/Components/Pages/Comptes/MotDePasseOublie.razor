@page "/comptes/mot-de-passe-oublie"
@using CIT.Plateforme.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.Localization
@inject UserManager<ApplicationUser> UserManager
@inject EnvoiLienMotDePasse EnvoiLien
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["Account.ForgotPageTitle"]</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <div class="cit-card p-0 overflow-hidden border-0 shadow-lg u-r-2xl">
            <div class="row g-0">
                
                <!-- Left Side: 3D Illustration -->
                <div class="col-md-6 d-none d-md-block u-bg-azure">
                    <div class="h-100 d-flex flex-column justify-content-center align-items-center p-5 text-center">
                        <img src="images/login-illustration.jpg" alt="@Loc["Auth.MaritimeIllustrationAlt"]" class="img-fluid" style="max-height: 500px; border-radius: 1rem; mix-blend-mode: multiply;" />
                        <div class="mt-4">
                            <h3 class="fw-bold text-uppercase u-c-action">@Loc["Auth.WelcomeDigital"]</h3>
                            <p class="text-muted mb-0">@Loc["Auth.WelcomeTagline"]</p>
                        </div>
                    </div>
                </div>

                <!-- Right Side: Form -->
                <div class="col-md-6 d-flex align-items-center">
                    <div class="p-5 p-lg-5 w-100">
                        <div class="mb-5 text-center text-md-start">
                            <img src="images/logo_cit.jpeg" alt="Côte d'Ivoire Terminal" style="height: 54px; border-radius: 8px; margin-bottom: 1.5rem;" />
                            <h1 class="fw-bold h2 mb-0 u-c-ink">@Loc["Account.ForgotTitle"]</h1>
                            <p class="text-muted">@Loc["Account.ForgotSubtitle"]</p>
                        </div>

                        <EditForm Model="Modele" OnValidSubmit="DemanderAsync" FormName="mot-de-passe-oublie">
                            <div class="mb-4">
                                <label class="form-label text-uppercase fw-bold text-muted u-fs-xs" for="email">@Loc["Account.EmailProfessional"]</label>
                                <InputText id="email" class="form-control form-control-lg border-0 px-3 py-3 u-bg-surface" placeholder="@Loc["Common.EmailPlaceholder"]" @bind-Value="Modele.Email" />
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm mt-3 py-3 u-r-md">
                                @Loc["Account.ForgotSubmit"] <span class="ms-2">✉</span>
                            </button>
                        </EditForm>
                        
                        <div class="mt-4 text-center text-md-start">
                            <a href="/comptes/connexion" class="text-decoration-none fw-bold u-c-marine">@Loc["Common.BackToLogin"]</a>
                        </div>

                        @if (demandeEnregistree)
                        {
                            @* Message volontairement identique que le compte existe ou non :
                               toute différence observable renseignerait un anonyme sur les
                               adresses réellement enregistrées. *@
                            <div class="alert alert-info border-0 bg-info bg-opacity-10 mt-4 rounded-3 p-3">
                                @Loc["Account.ForgotConfirmation"]
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    // REMÉDIATION POST-AUDIT (2026-08-29) : voir Connexion.razor pour la justification — le
    // paramètre [SupplyParameterFromForm] doit être le même identifiant que le Model de l'EditForm.
    [SupplyParameterFromForm]
    private ModeleDemande Modele { get; set; } = default!;

    private bool demandeEnregistree;

    protected override void OnInitialized() => Modele ??= new();

    /// <summary>
    /// G-04 — CORRECTION DE SÉCURITÉ.
    ///
    /// Cette page est publique : elle ne porte aucun <c>[Authorize]</c>, et <c>Program.cs</c>
    /// appelle <c>AddAuthorization()</c> sans politique de repli. Elle rendait auparavant le lien
    /// de réinitialisation — jeton compris — dans la réponse HTTP, sans aucune garde
    /// d'environnement : le libellé annonçait un « mode démo » que le code ne vérifiait nulle
    /// part. N'importe qui pouvait saisir une adresse, lire le lien à l'écran, le suivre et
    /// prendre le compte.
    ///
    /// DISTRIBUTION : le lien est envoyé UNIQUEMENT par e-mail, à l'adresse du compte, par le canal
    /// e-mail existant (<see cref="ICanalNotification"/>, SMTP Office 365). Il n'est JAMAIS affiché
    /// à l'écran — dans aucun environnement — ni journalisé : seul le titulaire de la boîte peut le
    /// recevoir. Si le SMTP n'est pas configuré, l'envoi échoue proprement et seul ce fait est
    /// journalisé (sans jeton, sans adresse).
    /// </summary>
    private async Task DemanderAsync()
    {
        // Posé AVANT toute recherche : la réponse est ainsi rigoureusement la même que le compte
        // existe ou non, ce qui prive un anonyme de tout oracle d'énumération.
        demandeEnregistree = true;

        var utilisateur = await UserManager.FindByEmailAsync(Modele.Email);
        if (utilisateur is null || string.IsNullOrWhiteSpace(utilisateur.Email))
        {
            return;
        }

        await EnvoiLien.EnvoyerAsync(
            utilisateur,
            new Uri(Navigation.BaseUri),
            Loc["Account.ResetMailSubject"].Value,
            lien => Loc["Account.ResetMailBody", lien].Value);
    }

    private sealed class ModeleDemande
    {
        public string Email { get; set; } = string.Empty;
    }
}
