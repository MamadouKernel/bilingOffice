@page "/comptes/mot-de-passe-oublie"
@using CIT.Plateforme.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using System.Text
@inject UserManager<ApplicationUser> UserManager
@inject IWebHostEnvironment Environnement
@inject ILogger<MotDePasseOublie> Journal

<PageTitle>Mot de passe oublié</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <div class="cit-card p-0 overflow-hidden border-0 shadow-lg" style="border-radius: 1.5rem;">
            <div class="row g-0">
                
                <!-- Left Side: 3D Illustration -->
                <div class="col-md-6 d-none d-md-block" style="background-color: #eaf4fc;">
                    <div class="h-100 d-flex flex-column justify-content-center align-items-center p-5 text-center">
                        <img src="images/login-illustration.jpg" alt="Terminal Maritime 3D" class="img-fluid" style="max-height: 500px; border-radius: 1rem; mix-blend-mode: multiply;" />
                        <div class="mt-4">
                            <h3 class="fw-bold text-uppercase" style="color: #1e3a8a;">Bienvenue sur l'Espace Digital</h3>
                            <p class="text-muted mb-0">Gérez vos expéditions, conteneurs et facturations maritimes en toute simplicité grâce à la plateforme.</p>
                        </div>
                    </div>
                </div>

                <!-- Right Side: Form -->
                <div class="col-md-6 d-flex align-items-center">
                    <div class="p-5 p-lg-5 w-100">
                        <div class="mb-5 text-center text-md-start">
                            <img src="images/logo_cit.jpeg" alt="Côte d'Ivoire Terminal" style="height: 54px; border-radius: 8px; margin-bottom: 1.5rem;" />
                            <h2 class="fw-bold" style="color: var(--ink);">Mot de passe oublié</h2>
                            <p class="text-muted">Renseignez votre e-mail pour recevoir un lien de réinitialisation.</p>
                        </div>

                        <EditForm Model="Modele" OnValidSubmit="DemanderAsync" FormName="mot-de-passe-oublie">
                            <div class="mb-4">
                                <label class="form-label text-uppercase fw-bold text-muted" style="font-size: 0.75rem;" for="email">E-mail Professionnel</label>
                                <InputText id="email" class="form-control form-control-lg border-0 px-3 py-3" placeholder="jean.dupont@entreprise.com" @bind-Value="Modele.Email" style="background-color: var(--surface);" />
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm mt-3 py-3" style="border-radius: 0.75rem;">
                                Recevoir le lien <span class="ms-2">✉</span>
                            </button>
                        </EditForm>
                        
                        <div class="mt-4 text-center text-md-start">
                            <a href="/comptes/connexion" class="text-decoration-none fw-bold" style="color: var(--marine-600);">← Retour à la connexion</a>
                        </div>

                        @if (demandeEnregistree)
                        {
                            @* Message volontairement identique que le compte existe ou non :
                               toute différence observable renseignerait un anonyme sur les
                               adresses réellement enregistrées. *@
                            <div class="alert alert-info border-0 bg-info bg-opacity-10 mt-4 rounded-3 p-3">
                                Si un compte correspond à cette adresse, la marche à suivre pour
                                réinitialiser le mot de passe lui sera communiquée.
                            </div>
                        }

                        @if (lienDeveloppement is not null)
                        {
                            @* Affiché UNIQUEMENT en environnement de développement (voir @code).
                               Ce bloc n'est jamais rendu en Staging ni en Production. *@
                            <div class="alert alert-warning border-0 mt-4 rounded-3 p-3 text-break">
                                <strong class="d-block mb-1">Environnement de développement uniquement</strong>
                                <code>@lienDeveloppement</code>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    // REMÉDIATION POST-AUDIT (2026-08-29) : voir Connexion.razor pour la justification — le
    // paramètre [SupplyParameterFromForm] doit être le même identifiant que le Model de l'EditForm.
    [SupplyParameterFromForm]
    private ModeleDemande Modele { get; set; } = default!;

    private bool demandeEnregistree;
    private string? lienDeveloppement;

    protected override void OnInitialized() => Modele ??= new();

    /// <summary>
    /// G-04 — CORRECTION DE SÉCURITÉ.
    ///
    /// Cette page est publique : elle ne porte aucun <c>[Authorize]</c>, et <c>Program.cs</c>
    /// appelle <c>AddAuthorization()</c> sans politique de repli. Elle rendait auparavant le lien
    /// de réinitialisation — jeton compris — dans la réponse HTTP, sans aucune garde
    /// d'environnement : le libellé annonçait un « mode démo » que le code ne vérifiait nulle
    /// part. N'importe qui pouvait saisir une adresse, lire le lien à l'écran, le suivre et
    /// prendre le compte.
    ///
    /// PRINCIPE RETENU : tant qu'aucun canal de distribution approuvé n'est configuré (PC-16 non
    /// résolu), la plateforme préfère une réinitialisation NON DISTRIBUABLE à une
    /// réinitialisation PUBLIQUE. Le jeton est produit puis abandonné ; il n'est ni affiché, ni
    /// journalisé, ni transmis.
    ///
    /// Le jour où un canal est retenu, il se substitue ici derrière l'abstraction existante
    /// <c>ICanalNotification</c>, sans rien changer au reste du parcours.
    /// </summary>
    private async Task DemanderAsync()
    {
        // Posé AVANT toute recherche : la réponse est ainsi rigoureusement la même que le compte
        // existe ou non, ce qui prive un anonyme de tout oracle d'énumération.
        demandeEnregistree = true;
        lienDeveloppement = null;

        var utilisateur = await UserManager.FindByEmailAsync(Modele.Email);
        if (utilisateur is null)
        {
            return;
        }

        var jeton = await UserManager.GeneratePasswordResetTokenAsync(utilisateur);
        var jetonEncode = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(jeton));
        var lien = $"/comptes/reinitialiser-mot-de-passe?utilisateurId={utilisateur.Id}&jeton={jetonEncode}";

        if (Environnement.IsDevelopment())
        {
            // Sans canal de distribution, c'est le seul moyen d'exercer le parcours en local.
            // La garde est explicite, et c'est précisément ce qui manquait.
            lienDeveloppement = lien;
            return;
        }

        // Hors développement : aucune trace du lien nulle part. Le message ci-dessous ne contient
        // ni jeton, ni adresse, ni identifiant — seulement le fait qu'aucun canal n'est configuré.
        Journal.LogWarning(
            "Demande de réinitialisation de mot de passe reçue, mais aucun canal de distribution "
            + "approuvé n'est configuré (PC-16) : le lien n'a pas été transmis.");
    }

    private sealed class ModeleDemande
    {
        public string Email { get; set; } = string.Empty;
    }
}
