@page "/comptes/collaborateurs"
@rendermode InteractiveServer
@using CIT.Plateforme.Application.Abstractions
@using CIT.Plateforme.Application.Comptes
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Comptes
@inject ConsulterProfilSocieteQuery ConsulterProfil
@inject RattacherUtilisateurCommand Rattacher
@inject ActiverDesactiverUtilisateurCommand ActiverDesactiver
@inject ModifierDroitsUtilisateurCommand ModifierDroits
@inject GererRoleAdministrateurCommand GererRole

<PageTitle>Gestion des collaborateurs</PageTitle>

<h1>Gestion des collaborateurs</h1>

<p class="text-muted">
    Contrats C2-06→09 (ENT-01, ENT-02). Réservé à un administrateur actif de la société concernée
    (vérifié côté serveur, cloisonné à cette société — CPT-04). REMÉDIATION POST-AUDIT (§19, IDOR) :
    la liste des collaborateurs n'est plus jamais chargée en accédant au dépôt directement — elle
    passe systématiquement par <code>ConsulterProfilSocieteQuery</code>, qui vérifie que l'appelant
    est membre de la société consultée (ou administrateur fonctionnel CIT habilité).
</p>

<div class="row mb-3">
    <div class="col">
        <label class="form-label" for="appelant">Identifiant de l'administrateur (démonstration)</label>
        <InputText id="appelant" class="form-control" @bind-Value="appelantId" />
    </div>
    <div class="col">
        <label class="form-label" for="societe">Identifiant de la société</label>
        <InputText id="societe" class="form-control" @bind-Value="societeId" />
    </div>
    <div class="col align-self-end">
        <button class="btn btn-primary" @onclick="ChargerAsync">Charger</button>
    </div>
</div>

@if (erreur is not null)
{
    <div class="alert alert-danger">@erreur</div>
}

<div class="mb-3">
    <label class="form-label" for="nouvel-utilisateur">Rattacher un nouvel utilisateur (identifiant)</label>
    <div class="input-group">
        <InputText id="nouvel-utilisateur" class="form-control" @bind-Value="nouvelUtilisateurId" />
        <button class="btn btn-primary" @onclick="RattacherAsync">Rattacher</button>
    </div>
</div>

@if (collaborateurs.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>Utilisateur</th>
                <th>Administrateur</th>
                <th>Consultation</th>
                <th>Soumission</th>
                <th>Actif</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var collaborateur in collaborateurs)
            {
                <tr>
                    <td>@collaborateur.UtilisateurId</td>
                    <td>@collaborateur.EstAdministrateur</td>
                    <td>@collaborateur.DroitConsultation</td>
                    <td>@collaborateur.DroitSoumission</td>
                    <td>@collaborateur.EstActif</td>
                    <td>
                        @if (collaborateur.EstActif)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DesactiverAsync(collaborateur.Id)">Désactiver</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-success" @onclick="() => ActiverAsync(collaborateur.Id)">Activer</button>
                        }
                        @if (collaborateur.EstAdministrateur)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => RetirerRoleAsync(collaborateur.Id)">Retirer admin</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => AttribuerRoleAsync(collaborateur.Id)">Nommer admin</button>
                        }
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => BasculerConsultationAsync(collaborateur)">Basculer visibilité</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string appelantId = string.Empty;
    private string societeId = string.Empty;
    private string nouvelUtilisateurId = string.Empty;
    private List<UtilisateurSociete> collaborateurs = [];
    private string? erreur;

    // REMÉDIATION POST-AUDIT (§19, IDOR) : plus aucun accès direct au dépôt depuis l'UI — la
    // lecture passe par ConsulterProfilSocieteQuery, qui vérifie le périmètre société côté serveur
    // avant de retourner quoi que ce soit (appelant membre de la société, ou CIT habilité).
    private async Task ChargerAsync()
    {
        erreur = null;
        if (!Guid.TryParse(societeId, out var id) || !Guid.TryParse(appelantId, out var appelant))
        {
            erreur = "Identifiants invalides.";
            collaborateurs = [];
            return;
        }

        try
        {
            var profil = await ConsulterProfil.ExecuterAsync(appelant, id);
            collaborateurs = profil.UtilisateursRattaches.ToList();
        }
        catch (AccesRefuseException ex)
        {
            collaborateurs = [];
            erreur = ex.Message;
        }
    }

    private async Task ExecuterAsync(Func<Task> action)
    {
        erreur = null;
        try
        {
            await action();
            await ChargerAsync();
        }
        catch (Exception ex) when (ex is AccesRefuseException or DernierAdministrateurActifException)
        {
            erreur = ex.Message;
        }
    }

    private Task RattacherAsync() => ExecuterAsync(async () =>
        await Rattacher.ExecuterAsync(Guid.Parse(appelantId), Guid.Parse(societeId), Guid.Parse(nouvelUtilisateurId)));

    private Task ActiverAsync(Guid cibleId) => ExecuterAsync(() => ActiverDesactiver.ActiverAsync(Guid.Parse(appelantId), cibleId));

    private Task DesactiverAsync(Guid cibleId) => ExecuterAsync(() => ActiverDesactiver.DesactiverAsync(Guid.Parse(appelantId), cibleId));

    private Task AttribuerRoleAsync(Guid cibleId) => ExecuterAsync(() => GererRole.AttribuerRoleAsync(Guid.Parse(appelantId), cibleId));

    private Task RetirerRoleAsync(Guid cibleId) => ExecuterAsync(() => GererRole.RetirerRoleAsync(Guid.Parse(appelantId), cibleId));

    private Task BasculerConsultationAsync(UtilisateurSociete collaborateur)
    {
        var nouveauDroit = collaborateur.DroitConsultation == DroitConsultation.PropresDemandesUniquement
            ? DroitConsultation.ToutesDemandesSociete
            : DroitConsultation.PropresDemandesUniquement;
        return ExecuterAsync(() => ModifierDroits.ExecuterAsync(Guid.Parse(appelantId), collaborateur.Id, nouveauDroit, collaborateur.DroitSoumission));
    }
}
