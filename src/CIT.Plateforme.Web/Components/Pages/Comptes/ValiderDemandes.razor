@page "/comptes/valider"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Abstractions
@using CIT.Plateforme.Application.Comptes
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Comptes
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory
@inject Microsoft.JSInterop.IJSRuntime Js

<PageTitle>@Loc["ValidDem.PageTitle"]</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span>🛡️</span> @Loc["ValidDem.Pill"]
        </div>
        <h1 class="cit-page-title fw-bold text-dark mb-1">@Loc["ValidDem.Title"]</h1>
        <div class="cit-page-subtitle text-muted">@Loc["ValidDem.Subtitle"]</div>
    </div>
    <div>
        <button type="button" class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold shadow-sm d-flex align-items-center gap-2" @onclick="ChargerAsync" disabled="@_chargement">
            <span>🔄</span> @Loc["ValidDem.BtnRefresh"]
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["ValidDem.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (erreur is not null)
    {
        <div class="alert alert-danger border-0 text-danger bg-danger bg-opacity-10 mb-4 rounded-3 p-3 d-flex align-items-center shadow-sm" role="alert">
            <span class="me-2 fs-5">⚠️</span> @erreur
        </div>
    }

    @if (demandes.Count == 0)
    {
        <div class="cit-card p-5 text-center my-4 border-0 shadow-sm u-r-lg u-bg-surface">
            <div class="fs-1 mb-3">✅</div>
            <h4 class="fw-bold text-dark mb-2">@Loc["ValidDem.EmptyTitle"]</h4>
            <p class="text-muted mb-0">@Loc["ValidDem.EmptyDesc"]</p>
        </div>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="fw-bold text-dark small text-uppercase tracking-wider">@Loc["ValidDem.ListTitle", demandes.Count]</div>
            <span class="badge bg-warning text-dark fw-bold px-2 py-1">@Loc["ValidDem.BadgeEnAttente"]</span>
        </div>

        <div class="d-flex flex-column gap-3">
            @foreach (var demande in demandes)
            {
                <div class="cit-card border-0 shadow-sm u-r-lg overflow-hidden">
                    @* En-tête : identité de l'entreprise + date *@
                    <div class="p-3 p-md-4 d-flex flex-wrap align-items-start justify-content-between gap-3 border-bottom">
                        <div class="min-w-0">
                            <div class="fw-bold text-dark fs-6">
                                @(string.IsNullOrWhiteSpace(demande.NomAffichable) ? Loc["ValidDem.InfoNonRenseignees"].Value : demande.NomAffichable)
                            </div>
                            @if (demande.RccmAffichable is { } rccm)
                            {
                                <div class="small"><span class="text-muted">RCCM</span> <span class="font-monospace fw-semibold">@rccm</span></div>
                            }
                            @if (demande.RaisonSociale is not null && !string.IsNullOrWhiteSpace(demande.InformationsDeclarees))
                            {
                                <div class="small text-muted" title="@demande.InformationsDeclarees">@demande.InformationsDeclarees</div>
                            }
                            <div class="small text-muted font-monospace mt-1">@Loc["ValidDem.IdLabel"] @demande.Id.ToString()[..8]...</div>
                        </div>
                        <div class="text-md-end small text-muted">
                            <div>📅 @demande.DateCreationUtc.Horodate()</div>
                        </div>
                    </div>

                    @* Pièces justificatives : cliquables (aperçu dans l'app) + téléchargement *@
                    <div class="p-3 p-md-4 border-bottom">
                        <div class="small text-uppercase text-muted fw-bold mb-2 u-fs-xs">@Loc["ValidDem.ColJustif"]</div>
                        @if (justificatifs.TryGetValue(demande.Id, out var pieces) && pieces.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var piece in pieces)
                                {
                                    <div class="btn-group btn-group-sm shadow-sm" role="group">
                                        <button type="button"
                                                class="btn @(EstApercuActif(demande.Id, piece.Id) ? "btn-primary" : "btn-outline-primary") fw-semibold d-flex align-items-center gap-1"
                                                @onclick="() => ApercuAsync(demande.Id, piece.Id)">
                                            <span>📎</span> <span class="text-truncate" style="max-width: 15rem;">@piece.PieceCode : @piece.NomFichier</span>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" title="@Loc["ValidDem.Telecharger"]"
                                                @onclick="() => TelechargerAsync(piece.Id)">⬇</button>
                                    </div>
                                }
                            </div>

                            @* Panneau d'aperçu : présent dans le DOM, masqué tant qu'aucune pièce n'est ouverte. *@
                            <div class="mt-3 @(_apercu.ContainsKey(demande.Id) ? "" : "d-none")">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="small text-muted font-monospace">@(_apercuNom.GetValueOrDefault(demande.Id) ?? "")</div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => FermerApercu(demande.Id)">✕ @Loc["ValidDem.FermerApercu"]</button>
                                </div>
                                <iframe id="apercu-@demande.Id" title="@Loc["ValidDem.Apercu"]" class="w-100 border rounded-3"
                                        style="height: 70vh; background: var(--surface);"></iframe>
                            </div>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1">@Loc["ValidDem.AucunePiece"]</span>
                        }
                    </div>

                    @* Décision : profil + valider + motif + rejeter, empilés et jamais tronqués *@
                    <div class="p-3 p-md-4">
                        <div class="row g-2 align-items-end">
                            <div class="col-12 col-md-3">
                                <label class="form-label small fw-bold text-dark">@Loc["ValidDem.ColProfil"]</label>
                                <select class="form-select form-select-sm fw-semibold"
                                        @onchange="e => CorrigerProfilAsync(demande.Id, e.Value?.ToString())">
                                    @foreach (var valeur in Enum.GetValues<TypeClient>())
                                    {
                                        <option value="@valeur" selected="@(valeur == demande.Profil)">@valeur</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-5">
                                <label class="form-label small fw-bold text-dark">@Loc["ValidDem.PlaceholderRejet"]</label>
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="@Loc["ValidDem.PlaceholderRejet"]"
                                       @bind="motifsRejet[demande.Id]" />
                            </div>
                            <div class="col-12 col-md-4 d-flex gap-2">
                                <button type="button" class="btn btn-success btn-sm fw-bold shadow-sm flex-fill d-flex align-items-center justify-content-center gap-1"
                                        @onclick="() => ValiderAsync(demande.Id)">
                                    <span>✓</span> @Loc["ValidDem.BtnValider"]
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm fw-semibold flex-fill d-flex align-items-center justify-content-center gap-1"
                                        @onclick="() => RejeterAsync(demande.Id)">
                                    <span>✕</span> @Loc["ValidDem.BtnRejeter"]
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private List<SocieteCliente> demandes = [];
    private readonly Dictionary<Guid, string> motifsRejet = [];
    private Guid _appelantId;
    private readonly Dictionary<Guid, IReadOnlyList<JustificatifVue>> justificatifs = new();
    // Pièce actuellement prévisualisée par demande (clé = demande, valeur = justificatif).
    private readonly Dictionary<Guid, Guid> _apercu = new();
    private readonly Dictionary<Guid, string> _apercuNom = new();
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? erreur;

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private bool EstApercuActif(Guid demandeId, Guid justificatifId) =>
        _apercu.TryGetValue(demandeId, out var id) && id == justificatifId;

    private async Task ChargerAsync()
    {
        _chargement = true;
        erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["ValidDem.LoginRequis"].Value;
                return;
            }

            _appelantId = contexte.UtilisateurId;

            using var scope = ScopeFactory.CreateScope();
            var listerDemandesQuery = scope.ServiceProvider.GetRequiredService<ListerDemandesEnAttenteQuery>();
            var listerJustificatifsQuery = scope.ServiceProvider.GetRequiredService<ListerJustificatifsDemandeQuery>();

            demandes = (await listerDemandesQuery.ExecuterAsync(_appelantId)).ToList();
            justificatifs.Clear();
            _apercu.Clear();
            _apercuNom.Clear();
            foreach (var demande in demandes)
            {
                motifsRejet.TryAdd(demande.Id, string.Empty);
                justificatifs[demande.Id] = await listerJustificatifsQuery.ExecuterAsync(_appelantId, demande.Id);
            }
            _nonAutorise = false;
        }
        catch (AccesRefuseException ex)
        {
            demandes = [];
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task<ContenuJustificatif?> LireAsync(Guid justificatifId)
    {
        using var scope = ScopeFactory.CreateScope();
        var query = scope.ServiceProvider.GetRequiredService<TelechargerJustificatifQuery>();
        return await query.ExecuterAsync(_appelantId, justificatifId);
    }

    /// <summary>Aperçu de la pièce DANS l'application (iframe), sans quitter l'écran de validation.</summary>
    private async Task ApercuAsync(Guid demandeId, Guid justificatifId)
    {
        erreur = null;
        try
        {
            if (EstApercuActif(demandeId, justificatifId))
            {
                FermerApercu(demandeId);
                return;
            }

            var contenu = await LireAsync(justificatifId);
            if (contenu is null) return;

            _apercu[demandeId] = justificatifId;
            _apercuNom[demandeId] = contenu.NomFichier;
            StateHasChanged(); // l'iframe doit exister avant l'appel JS

            var base64 = Convert.ToBase64String(contenu.Contenu);
            await Js.InvokeVoidAsync("apercuDocument.ouvrir", $"apercu-{demandeId}", contenu.TypeContenu, base64);
        }
        catch (Exception ex)
        {
            erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private void FermerApercu(Guid demandeId)
    {
        _apercu.Remove(demandeId);
        _apercuNom.Remove(demandeId);
        _ = Js.InvokeVoidAsync("apercuDocument.fermer", $"apercu-{demandeId}");
    }

    private async Task TelechargerAsync(Guid justificatifId)
    {
        erreur = null;
        try
        {
            var contenu = await LireAsync(justificatifId);
            if (contenu is null) return;
            var base64 = Convert.ToBase64String(contenu.Contenu);
            await Js.InvokeVoidAsync("telechargerFichier", contenu.NomFichier, contenu.TypeContenu, base64);
        }
        catch (Exception ex)
        {
            erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private async Task CorrigerProfilAsync(Guid societeId, string? profil)
    {
        if (!Enum.TryParse<TypeClient>(profil, out var nouveauProfil))
        {
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var modifierTypeClientCmd = scope.ServiceProvider.GetRequiredService<ModifierTypeClientCommand>();
            await modifierTypeClientCmd.ExecuterAsync(_appelantId, societeId, nouveauProfil);
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _messageNonAutorise = MessagesUtilisateur.Pour(ex);
        }
    }

    private async Task ValiderAsync(Guid societeId)
    {
        erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var validerOuRejeterCmd = scope.ServiceProvider.GetRequiredService<ValiderOuRejeterDemandeCompteCommand>();
            await validerOuRejeterCmd.ValiderAsync(societeId, _appelantId);
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            erreur = ex.Message;
        }
    }

    private async Task RejeterAsync(Guid societeId)
    {
        erreur = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var validerOuRejeterCmd = scope.ServiceProvider.GetRequiredService<ValiderOuRejeterDemandeCompteCommand>();
            await validerOuRejeterCmd.RejeterAsync(societeId, _appelantId, motifsRejet.GetValueOrDefault(societeId, string.Empty));
            await ChargerAsync();
        }
        catch (Exception ex) when (ex is AccesRefuseException or ArgumentException)
        {
            erreur = MessagesUtilisateur.Pour(ex);
        }
    }
}
