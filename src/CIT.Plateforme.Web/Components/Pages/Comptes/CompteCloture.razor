@page "/comptes/compte-cloture"
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Web.Resources
@using Microsoft.Extensions.Localization
@attribute [AllowAnonymous]
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["Account.ClosedPageTitle"]</PageTitle>

<div class="container py-5" style="max-width: 600px;">
    <div class="cit-card text-center p-5 shadow-sm">
        <div class="display-4 mb-3">🔒</div>
        <h1 class="fw-bold text-dark mb-3 h3">@Loc["Account.ClosedTitle"]</h1>
        <p class="text-muted mb-4">
            @Loc["Account.ClosedText"]
        </p>
        <div class="alert alert-light border small text-start text-muted mb-4">
            @Loc["Account.ClosedArchiveNote"]
        </div>
        <a href="/comptes/connexion" class="btn btn-primary fw-semibold px-4">
            @Loc["Account.ClosedBackToLogin"]
        </a>
    </div>
</div>
