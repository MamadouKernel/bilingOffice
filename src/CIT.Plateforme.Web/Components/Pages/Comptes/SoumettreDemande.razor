@page "/comptes/soumettre"
@rendermode InteractiveServer
@using CIT.Plateforme.Application.Comptes
@using CIT.Plateforme.Domain.Comptes
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@inject SoumettreDemandeCompteCommand SoumettreDemandeCommande
@inject UserManager<ApplicationUser> UserManager
@inject ListerPiecesExigeesQuery ListerPiecesExigees
@inject CIT.Plateforme.Domain.Documents.IStockageDocuments StockageDocuments

<PageTitle>Créer un compte entreprise — Côte d'Ivoire Terminal</PageTitle>

<div class="row justify-content-center py-2">
    <div class="col-12 col-xl-11">
        
        <!-- Navigation Top Bar : Accueil & Aide -->
        <div class="d-flex align-items-center justify-content-between mb-3 px-2">
            <a href="/" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold rounded-pill bg-white shadow-xs d-inline-flex align-items-center gap-2">
                <span>🏠</span> Retour à l'accueil
            </a>
            
            <a href="/comptes/connexion" class="btn btn-light btn-sm px-3 py-2 fw-semibold rounded-pill text-primary border shadow-xs d-inline-flex align-items-center gap-2">
                <span>🔑</span> Déjà un compte ? Se connecter
            </a>
        </div>

        <div class="cit-card p-0 overflow-hidden border-0 shadow-lg" style="border-radius: 1.5rem; background-color: var(--surface);">
            <div class="row g-0">
                
                <!-- Left Side: Terminal 3D Illustration & Presentation -->
                <div class="col-lg-5 d-none d-lg-block" style="background-color: var(--azure-50);">
                    <div class="h-100 d-flex flex-column justify-content-between p-5">
                        <div>
                            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-white rounded-pill shadow-xs mb-4">
                                <img src="images/logo_cit.jpeg" alt="Logo CIT" style="height: 32px; object-fit: contain; border-radius: 4px;" />
                                <span class="small fw-bold text-dark">Côte d'Ivoire Terminal</span>
                            </div>

                            <h3 class="fw-bold text-dark mb-3 lh-sm" style="color: var(--action);">
                                Rejoignez l'Espace Digital Billing Office
                            </h3>
                            <p class="text-muted small mb-4" style="line-height: 1.6;">
                                Simplifiez vos formalités portuaires au Port Autonome d'Abidjan : traitez vos connaissements, suivez vos conteneurs et simulez vos proformas en temps réel.
                            </p>

                            <!-- Key benefits list -->
                            <div class="d-flex flex-column gap-3 mb-4">
                                <div class="d-flex align-items-start gap-2">
                                    <span class="badge bg-primary bg-opacity-10 text-primary p-2 rounded-circle">⚡</span>
                                    <div class="small">
                                        <strong class="text-dark d-block">Validation sous 24h ouvrées</strong>
                                        <span class="text-muted">Instruction administrative rapide de vos pièces justificatives.</span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-start gap-2">
                                    <span class="badge bg-success bg-opacity-10 text-success p-2 rounded-circle">📦</span>
                                    <div class="small">
                                        <strong class="text-dark d-block">Gestion Intégrée Import / Export</strong>
                                        <span class="text-muted">Contrôle documentaire dématérialisé et traçabilité complète.</span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-start gap-2">
                                    <span class="badge bg-warning bg-opacity-10 text-dark p-2 rounded-circle">💳</span>
                                    <div class="small">
                                        <strong class="text-dark d-block">Facturation & Comptes Dédiés</strong>
                                        <span class="text-muted">Profils adaptés (Normal, En Compte, Deposit, IES).</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Image illustration -->
                        <div class="text-center pt-2">
                            <img src="images/onboarding-illustration.jpg" 
                                 alt="Terminal Portuaire CIT" 
                                 class="img-fluid rounded-4 shadow-sm border border-white border-2" 
                                 style="max-height: 300px; object-fit: cover;" />
                            <div class="text-muted small mt-2" style="font-size: 0.75rem;">
                                Infrastructure moderne du 2ème terminal à conteneurs d'Abidjan
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Side: Registration Form -->
                <div class="col-12 col-lg-7 d-flex align-items-center">
                    <div class="p-4 p-md-5 w-100">
                        
                        <!-- Header with Logo -->
                        <div class="mb-4">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                                <img src="images/logo_cit.jpeg" alt="Côte d'Ivoire Terminal" style="height: 48px; object-fit: contain; border-radius: 6px;" />
                                <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-3 py-2 rounded-pill small">
                                    🛡️ Onboarding Entreprise
                                </span>
                            </div>
                            <h2 class="fw-bold text-dark mb-1">Ouverture de Compte Société</h2>
                            <p class="text-muted small mb-0">Renseignez les données légales de votre structure pour créer votre espace entreprise.</p>
                        </div>

                        @if (societeCreee is not null)
                        {
                            <div class="p-4 p-md-5 border-0 shadow-sm mb-4 text-center rounded-4" 
                                 style="background-color: var(--ok-100); border: 1px solid var(--ok-border);">
                                <div class="fs-1 mb-2">🎉</div>
                                <h4 class="fw-bold mb-2" style="color: var(--ok-600);">Demande enregistrée avec succès !</h4>
                                <p class="text-muted small mb-3">
                                    Votre dossier est en cours d'instruction par les équipes Billing Office de CIT.
                                </p>
                                <div class="d-inline-block p-3 bg-white rounded-3 border mb-4">
                                    <span class="small text-muted d-block mb-1">Numéro de suivi dossier :</span>
                                    <code class="fs-6 fw-bold text-primary font-monospace">@societeCreee</code>
                                </div>
                                <div>
                                    <a href="/comptes/connexion" class="btn btn-success px-4 py-2 fw-bold shadow-sm rounded-pill">
                                        Accéder à la connexion ➔
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <EditForm Model="modele" OnValidSubmit="SoumettreAsync" FormName="soumettre-demande-compte">
                                
                                <!-- BLOC 1 : IDENTIFIANTS ADMINISTRATEUR -->
                                <div class="mb-4 pb-3 border-bottom">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="badge bg-primary text-white rounded-circle px-2 py-1 small fw-bold">1</span>
                                        <h6 class="fw-bold text-dark mb-0">Compte Administrateur Principal</h6>
                                    </div>
                                    
                                    <div class="row g-3">
                                        <div class="col-12 col-md-6">
                                            <label class="form-label text-uppercase fw-bold text-muted small" style="font-size: 0.7rem;" for="email">E-mail Professionnel <span class="text-danger">*</span></label>
                                            <InputText id="email" class="form-control border-0 px-3 py-2 shadow-xs" 
                                                       placeholder="responsable@entreprise.ci" 
                                                       @bind-Value="modele.Email" 
                                                       style="background-color: var(--surface); border-radius: 0.65rem;" />
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <label class="form-label text-uppercase fw-bold text-muted small" style="font-size: 0.7rem;" for="mot-de-passe">Mot de Passe <span class="text-danger">*</span></label>
                                            <ChampMotDePasse>
                                                <InputText id="mot-de-passe" type="password"
                                                           class="form-control border-0 px-3 py-2 shadow-xs"
                                                           placeholder="••••••••••••"
                                                           @bind-Value="modele.MotDePasse"
                                                           style="background-color: var(--surface); border-radius: 0.65rem;" />
                                            </ChampMotDePasse>
                                        </div>
                                    </div>
                                </div>

                                <!-- BLOC 2 : INFORMATIONS ENTREPRISE -->
                                <div class="mb-4 pb-3 border-bottom">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="badge bg-primary text-white rounded-circle px-2 py-1 small fw-bold">2</span>
                                        <h6 class="fw-bold text-dark mb-0">Données de l'Entreprise & Profil</h6>
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-12 col-md-6">
                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                <label class="form-label text-uppercase fw-bold text-muted small mb-0" style="font-size: 0.7rem;" for="profil">Profil d'Activité Sollicité</label>
                                                <button type="button" class="btn btn-link p-0 text-decoration-none small text-primary fw-semibold" style="font-size: 0.75rem;" @onclick="() => _afficherGuideProfils = !_afficherGuideProfils">
                                                    💡 Comprendre les 4 profils
                                                </button>
                                            </div>
                                            <InputSelect id="profil" class="form-select border-0 shadow-xs" 
                                                         @bind-Value="modele.Profil"
                                                         style="background-color: var(--surface); border-radius: 0.65rem;">
                                                @foreach (var valeur in Enum.GetValues<TypeClient>())
                                                {
                                                    <option value="@valeur">@valeur</option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <!-- Encadré explicatif dynamique selon le profil sélectionné -->
                                        <div class="col-12 col-md-6 d-flex align-items-center">
                                            <div class="p-2 px-3 rounded-3 border bg-light w-100 small" style="font-size: 0.8rem; line-height: 1.4;">
                                                @switch (modele.Profil)
                                                {
                                                    case TypeClient.Normal:
                                                        <div><strong class="text-dark">💳 Normal (Comptant) :</strong> Paiement exigé à chaque dossier. Bon d'enlèvement (BAE) délivré dès confirmation du règlement bancaire.</div>
                                                        break;
                                                    case TypeClient.EnCompte:
                                                        <div><strong class="text-primary">📑 En Compte (Différé) :</strong> Convention grand compte (30j). Enlèvement immédiat et facturation périodique groupée.</div>
                                                        break;
                                                    case TypeClient.Deposit:
                                                        <div><strong class="text-success">💰 Deposit (Provisionné) :</strong> Compte prépayé. Débit automatique sur votre solde pour chaque conteneur sans attente bancaire.</div>
                                                        break;
                                                    case TypeClient.IES:
                                                        <div><strong class="text-warning text-dark">⚡ IES (Stratégique) :</strong> Circuit prioritaire d'urgence pour importateurs/exportateurs conventionnés d'État.</div>
                                                        break;
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Guide complet déroulant des 4 profils -->
                                    @if (_afficherGuideProfils)
                                    {
                                        <div class="p-3 mb-3 rounded-3 border-0 shadow-xs" style="background-color: var(--surface-2); border: 1px solid var(--steel-200);">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <span class="small fw-bold text-dark">📋 Guide comparatif des profils d'activité CIT</span>
                                                <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => _afficherGuideProfils = false"></button>
                                            </div>
                                            <div class="row g-2 small text-muted" style="font-size: 0.75rem;">
                                                <div class="col-12 col-sm-6">
                                                    <div class="p-2 bg-white rounded border h-100">
                                                        <strong class="text-dark d-block mb-1">🏢 1. Normal (Standard)</strong>
                                                        Règlement au comptant dossier par dossier avant délivrance du Bon à Enlever. Idéal pour les transitaires et déclarants occasionnels ou réguliers.
                                                    </div>
                                                </div>
                                                <div class="col-12 col-sm-6">
                                                    <div class="p-2 bg-white rounded border h-100">
                                                        <strong class="text-primary d-block mb-1">📑 2. En Compte (Facilité de Crédit)</strong>
                                                        Paiement différé (30 jours fin de mois). Enlèvement immédiat et lettrage comptable groupé. Réservé aux entreprises conventionnées.
                                                    </div>
                                                </div>
                                                <div class="col-12 col-sm-6">
                                                    <div class="p-2 bg-white rounded border h-100">
                                                        <strong class="text-success d-block mb-1">💰 3. Deposit (Solde Prépayé)</strong>
                                                        Dépôt de provision préalable. Déduction automatique du montant de chaque conteneur sans démarche de virement individuel.
                                                    </div>
                                                </div>
                                                <div class="col-12 col-sm-6">
                                                    <div class="p-2 bg-white rounded border h-100">
                                                        <strong class="text-warning text-dark d-block mb-1">⚡ 4. IES (Flux Stratégiques)</strong>
                                                        Circuit prioritaire d'urgence pour denrées sensibles, matières stratégiques ou flux sous convention spéciale d'État.
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <div>
                                        <label class="form-label text-uppercase fw-bold text-muted small" style="font-size: 0.7rem;" for="informations">Raison Sociale & RCCM / DFE <span class="text-danger">*</span></label>
                                        <InputTextArea id="informations" rows="2" class="form-control border-0 shadow-xs p-2" 
                                                       placeholder="Ex : TRANSIT IVOIRE LOGISTICS - RCCM : CI-ABJ-2023-B-12345 - Compte Contribuable : 2049583A..." 
                                                       @bind-Value="modele.InformationsDeclarees" 
                                                       style="background-color: var(--surface); border-radius: 0.65rem;" />
                                    </div>
                                </div>

                                <!-- BLOC 3 : PIÈCES JUSTIFICATIVES -->
                                @if (piecesExigees is not null && piecesExigees.Count > 0)
                                {
                                    <div class="mb-4 pb-2">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <span class="badge bg-primary text-white rounded-circle px-2 py-1 small fw-bold">3</span>
                                            <h6 class="fw-bold text-dark mb-0">Pièces Justificatives Officielles</h6>
                                        </div>

                                        <div class="row g-2">
                                            @foreach (var piece in piecesExigees)
                                            {
                                                <div class="col-12 col-md-6">
                                                    <div class="p-2 border rounded-3 bg-light d-flex flex-column justify-content-between h-100">
                                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                                            <span class="small fw-bold text-dark" style="font-size: 0.8rem;">📄 @piece.Libelle</span>
                                                            @if (piece.Obligatoire)
                                                            {
                                                                <span class="badge bg-danger-subtle text-danger" style="font-size: 0.65rem;">Obligatoire</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.65rem;">Facultatif</span>
                                                            }
                                                        </div>

                                                        <div class="mt-1">
                                                            <InputFile class="form-control form-control-sm" 
                                                                       OnChange="e => SelectionnerFichier(piece.Code, e)" />
                                                        </div>

                                                        @if (fichiers.ContainsKey(piece.Code))
                                                        {
                                                            <div class="mt-1 small text-success fw-semibold" style="font-size: 0.75rem;">
                                                                ✅ @fichiers[piece.Code].Name
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                <!-- MESSAGE D'ERREUR HAUTE VISIBILITÉ -->
                                @if (erreur is not null)
                                {
                                    <div class="alert mt-3 mb-3 rounded-3 p-3 d-flex align-items-center shadow-sm" 
                                         style="background-color: var(--stop-100); color: var(--stop-600); border: 1px solid var(--stop-border);">
                                        <span class="me-2 fs-5">⚠️</span>
                                        <span class="fw-semibold small">@erreur</span>
                                    </div>
                                }

                                <!-- BOUTONS D'ACTION -->
                                <div class="pt-3 border-top d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <a href="/comptes/connexion" class="small text-decoration-none fw-bold" style="color: var(--marine-600);">
                                        ← Déjà un compte ? Se connecter
                                    </a>
                                    <button type="submit" class="btn btn-primary btn-lg px-4 py-2 fw-bold shadow-sm rounded-pill" style="border-radius: 0.75rem;">
                                        Soumettre le dossier <span class="ms-1">🚀</span>
                                    </button>
                                </div>

                                <div class="mt-3 text-center">
                                    <a href="/comptes/inscription-transporteur" class="text-decoration-none small text-muted">
                                        🚚 Vous êtes un transporteur ou chauffeur routier ? <span class="text-primary fw-semibold">Pré-enrôlez-vous ici</span>
                                    </a>
                                </div>

                            </EditForm>
                        }

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private ModeleSoumission? modeleFormulaire { get; set; }

    private ModeleSoumission modele = new();
    private Guid? societeCreee;
    private string? erreur;
    private bool _afficherGuideProfils;

    private IReadOnlyList<PieceExigeeVue>? piecesExigees;
    private readonly Dictionary<string, IBrowserFile> fichiers = new(StringComparer.Ordinal);

    private const long TailleMaxOctets = 10L * 1024 * 1024;

    protected override async Task OnInitializedAsync()
    {
        modele = modeleFormulaire ?? modele;
        piecesExigees = await ListerPiecesExigees.ExecuterAsync();
    }

    private void SelectionnerFichier(string pieceCode, InputFileChangeEventArgs e)
    {
        if (e.File is null)
        {
            fichiers.Remove(pieceCode);
            return;
        }

        fichiers[pieceCode] = e.File;
    }

    private async Task SoumettreAsync()
    {
        erreur = null;

        var demandeur = new ApplicationUser
        {
            UserName = modele.Email,
            Email = modele.Email,
            NomAffiche = modele.Email,
            Nature = NatureUtilisateur.Client,
        };
        var resultat = await UserManager.CreateAsync(demandeur, modele.MotDePasse);
        if (!resultat.Succeeded)
        {
            erreur = string.Join(" ", resultat.Errors.Select(e => e.Description));
            return;
        }

        var justificatifs = new List<JustificatifDepose>();
        foreach (var (pieceCode, fichier) in fichiers)
        {
            await using var flux = fichier.OpenReadStream(TailleMaxOctets);
            var cle = await StockageDocuments.EnregistrerAsync(flux, fichier.Name);
            justificatifs.Add(new JustificatifDepose(
                pieceCode, fichier.Name, fichier.ContentType, fichier.Size, cle));
        }

        SocieteCliente societe;
        try
        {
            societe = await SoumettreDemandeCommande.ExecuterAsync(new SoumettreDemandeCompteRequete(
                demandeur.Id, modele.InformationsDeclarees, modele.Profil, justificatifs));
        }
        catch (DossierIncompletException ex)
        {
            erreur = ex.Message;
            return;
        }

        societeCreee = societe.Id;
        modele = new ModeleSoumission();
        fichiers.Clear();
    }

    private sealed class ModeleSoumission
    {
        public string Email { get; set; } = string.Empty;
        public string MotDePasse { get; set; } = string.Empty;
        public TypeClient Profil { get; set; } = TypeClient.Normal;
        public string InformationsDeclarees { get; set; } = string.Empty;
    }
}
