@page "/comptes/verifier-code"
@using CIT.Plateforme.Infrastructure.Identity
@using CIT.Plateforme.Web.Resources
@using Microsoft.AspNetCore.Identity
@using CIT.Plateforme.Application.Comptes
@using CIT.Plateforme.Domain.Securite
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject RegleAccesConnexion RegleAcces
@inject CIT.Plateforme.Application.Securite.JournalConnexionService JournalConnexion
@inject IHttpContextAccessor AccesContexteHttp

<PageTitle>@Loc["Auth.TwoFactorTitle"] — @Loc["Common.AppTitle"]</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <div class="cit-card p-0 overflow-hidden border-0 shadow-lg" style="border-radius: 1.5rem;">
            <div class="row g-0">
                
                <!-- Left Side: 3D Illustration -->
                <div class="col-md-6 d-none d-md-block" style="background-color: var(--azure-50);">
                    <div class="h-100 d-flex flex-column justify-content-center align-items-center p-5 text-center">
                        <img src="images/login-illustration.jpg" alt="Sécurité CIT" class="img-fluid" style="max-height: 480px; border-radius: 1rem; mix-blend-mode: multiply;" />
                        <div class="mt-4">
                            <h3 class="fw-bold text-uppercase" style="color: var(--action);">Double Authentification (2FA)</h3>
                            <p class="text-muted mb-0">Protégez l'accès à vos dossiers et opérations maritimes avec la validation par code temporaire à usage unique.</p>
                        </div>
                    </div>
                </div>

                <!-- Right Side: Verification Form -->
                <div class="col-md-6 d-flex align-items-center">
                    <div class="p-4 p-lg-5 w-100">
                        <div class="mb-4 text-center text-md-start">
                            <img src="images/logo_cit.jpeg" alt="Côte d'Ivoire Terminal" style="height: 54px; border-radius: 8px; margin-bottom: 1.5rem;" />
                            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-3">
                                <span>🛡️</span> Sécurité Renforcée
                            </div>
                            <h2 class="fw-bold" style="color: var(--ink);">@Loc["Auth.TwoFactorTitle"]</h2>
                            <p class="text-muted mb-0">Saisissez le code à 6 chiffres généré par votre application d'authentification (Google Authenticator, Microsoft Authenticator, etc.).</p>
                        </div>

                        <EditForm Model="Modele" OnValidSubmit="ValiderAsync" FormName="verifier-code">
                            <div class="mb-4">
                                <label class="form-label text-uppercase fw-bold text-muted" style="font-size: 0.75rem;" for="code">@Loc["Auth.TwoFactorCode"]</label>
                                <div class="position-relative">
                                    <InputText id="code" 
                                               class="form-control form-control-lg border-0 px-3 py-3 text-center font-monospace fw-bold" 
                                               placeholder="0 0 0 0 0 0" 
                                               maxlength="6" 
                                               @bind-Value="Modele.Code" 
                                               style="background-color: var(--surface); letter-spacing: 0.5rem; font-size: 1.6rem; border-radius: 0.75rem;" />
                                </div>
                                <div class="form-text small text-muted mt-2 text-center text-md-start">
                                    ⏱️ Le code se renouvelle toutes les 30 secondes sur votre téléphone.
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm mt-2 py-3 fw-bold" style="border-radius: 0.75rem;">
                                @Loc["Auth.VerifyButton"] <span class="ms-2">→</span>
                            </button>

                            <div class="mt-4 text-center">
                                <a href="/comptes/connexion" class="small text-decoration-none fw-semibold text-muted">
                                    ← Annuler et revenir à la connexion
                                </a>
                            </div>
                        </EditForm>

                        @if (erreur is not null)
                        {
                            <div class="alert alert-danger border-0 text-danger bg-danger bg-opacity-10 mt-4 rounded-3 p-3 d-flex align-items-center">
                                <span class="me-2 fs-5">⚠️</span> @erreur
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    private static readonly SharedResourcesLocalizer Loc = new();

    // REMÉDIATION POST-AUDIT (2026-08-29) : voir Connexion.razor — le paramètre
    // [SupplyParameterFromForm] doit être le même identifiant que le Model de l'EditForm.
    [SupplyParameterFromForm]
    private ModeleCode Modele { get; set; } = default!;

    private string? erreur;

    protected override void OnInitialized() => Modele ??= new();

    private async Task ValiderAsync()
    {
        erreur = null;
        // Message générique : ne révèle jamais si le code était incorrect vs. l'absence de défi en
        // attente (mêmes principes que Connexion.razor).
        const string messageRefusGenerique = "Code invalide ou expiré.";

        var utilisateurEnAttente = await SignInManager.GetTwoFactorAuthenticationUserAsync();
        if (utilisateurEnAttente is null)
        {
            erreur = messageRefusGenerique;
            return;
        }

        // CONSOLIDATION SÉCURITÉ — LA VOIE 2FA EST UNE VRAIE VOIE D'OUVERTURE DE SESSION.
        //
        // Elle n'appliquait aucun contrôle d'activité : Connexion.razor vérifiait le compte avant
        // de rediriger ici, mais rien ne le revérifiait au moment de finaliser. Une désactivation
        // survenant ENTRE la saisie du mot de passe et celle du code laissait donc une session
        // s'ouvrir. Le contrôle est refait ici, immédiatement avant la finalisation, et non
        // hérité de l'étape précédente.
        if (!utilisateurEnAttente.EstActif)
        {
            await JournalConnexion.SecondFacteurRefuseAsync(
                utilisateurEnAttente.Id, CIT.Plateforme.Application.Securite.MotifRefusConnexion.CompteDesactive, Origine());
            await SignInManager.SignOutAsync();
            erreur = messageRefusGenerique;
            return;
        }

        var resultat = await SignInManager.TwoFactorAuthenticatorSignInAsync(
            Modele.Code, isPersistent: false, rememberClient: false);

        if (!resultat.Succeeded)
        {
            await JournalConnexion.SecondFacteurRefuseAsync(
                utilisateurEnAttente.Id, CIT.Plateforme.Application.Securite.MotifRefusConnexion.SecondFacteurInvalide, Origine());
            erreur = messageRefusGenerique;
            return;
        }

        // Second contrôle APRÈS la finalisation : la désactivation peut survenir pendant la
        // validation elle-même. Sans lui, la fenêtre serait seulement déplacée, non fermée.
        if (!await EstAccesAutoriseAsync(utilisateurEnAttente))
        {
            await JournalConnexion.SecondFacteurRefuseAsync(
                utilisateurEnAttente.Id,
                utilisateurEnAttente.EstActif
                    ? CIT.Plateforme.Application.Securite.MotifRefusConnexion.AccesSocieteRefuse
                    : CIT.Plateforme.Application.Securite.MotifRefusConnexion.CompteDesactive,
                Origine());
            await SignInManager.SignOutAsync();
            erreur = messageRefusGenerique;
            return;
        }

        await JournalConnexion.SecondFacteurReussiAsync(utilisateurEnAttente.Id, Origine());
        await JournalConnexion.ConnexionReussieAsync(utilisateurEnAttente.Id, Origine());

        Navigation.NavigateTo("/", forceLoad: true);
    }

    // Mêmes deux règles que Connexion.razor, dans le même ordre — l'activation d'abord, pour tous
    // les comptes ; le rattachement société ensuite, pour les seuls comptes Client (CPT-03).
    // Elles sont énoncées ici aussi : une voie d'ouverture de session qui hériterait du contrôle
    // d'une autre page n'en porterait aucun.
    // P3 — LA RÈGLE VIT DÉSORMAIS DANS `RegleAccesConnexion`, ET NON PLUS ICI.
    // Elle était recopiée à l'identique dans les deux voies d'ouverture de session. Deux copies
    // d'une règle de sécurité finissent par diverger — c'est ce qui a produit le P0-ter, où cette
    // page portait un contrôle d'activité que l'autre n'avait jamais eu.
    private Task<bool> EstAccesAutoriseAsync(ApplicationUser utilisateur) =>
        RegleAcces.AccesAutoriseAsync(utilisateur.Id, utilisateur.Nature, utilisateur.EstActif);

    // Origine réseau, quand le contexte HTTP est disponible. Le code saisi n'est JAMAIS consigné.
    private string? Origine() => AccesContexteHttp.HttpContext?.Connection.RemoteIpAddress?.ToString();

    private sealed class ModeleCode
    {
        public string Code { get; set; } = string.Empty;
    }
}
