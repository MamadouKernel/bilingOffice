@page "/comptes/modifier-type"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Comptes
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Comptes
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Modifier le type de client — CIT</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span>🏷️</span> Administration CIT • CPT-06
        </div>
        <h2 class="cit-page-title fw-bold text-dark mb-1">
            Modifier le Type de Client
        </h2>
        <div class="cit-page-subtitle text-muted">
            Modification administrative tracée du profil de facturation (Normal, En Compte, Deposit, IES).
        </div>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement des sociétés clientes..." />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    <div style="max-width: 720px;">
        @if (_societes is null || _societes.Count == 0)
        {
            <EtatVide Titre="Aucune société active"
                      Description="Aucune société cliente validée n'est disponible : il n'y a pas de type de client à modifier."
                      Icone="🏷️" />
        }
        else
        {
            <div class="cit-card p-4 border-0 shadow-sm mb-4" style="border-radius: 1rem;">
                <div class="alert alert-info bg-info bg-opacity-10 border-0 text-info mb-4 d-flex align-items-center gap-2 p-3 rounded-3">
                    <span class="fs-5">ℹ️</span>
                    <span class="small">Le changement est consigné dans le journal d'audit et s'applique aux nouveaux dossiers sans rétroactivité.</span>
                </div>

                <div class="mb-4">
                    <label class="form-label text-uppercase fw-bold text-muted small" for="societe">Société cliente concernée</label>
                    <select id="societe" class="form-select form-select-lg border-0 shadow-sm" 
                            style="background-color: var(--surface); border-radius: 0.75rem;" 
                            @bind="_societeSelectionnee">
                        @foreach (var societe in _societes)
                        {
                            <option value="@societe.Id">@NomLisible(societe)</option>
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label text-uppercase fw-bold text-muted small">Type de client actuel</label>
                    <div>
                        <span class="badge bg-secondary-subtle text-dark border px-3 py-2 fs-6">@LibelleType(TypeActuel)</span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-uppercase fw-bold text-muted small" for="nouveau-type">Nouveau type de client cible</label>
                    <select id="nouveau-type" class="form-select form-select-lg border-0 shadow-sm" 
                            style="background-color: var(--surface); border-radius: 0.75rem;" 
                            @bind="_nouveauType">
                        @foreach (var valeur in Enum.GetValues<TypeClient>())
                        {
                            <option value="@valeur">@LibelleType(valeur)</option>
                        }
                    </select>
                </div>

                <div class="pt-2 border-top text-end">
                    <button type="button" class="btn btn-primary btn-lg px-4 py-2 fw-bold shadow-sm" 
                            style="border-radius: 0.75rem;" 
                            @onclick="ModifierAsync">
                        💾 Enregistrer la modification
                    </button>
                </div>
            </div>
        }

        @if (_erreur is not null)
        {
            <div class="alert alert-danger border-0 text-danger bg-danger bg-opacity-10 mb-4 rounded-3 p-3 d-flex align-items-center">
                <span class="me-2 fs-5">⚠️</span> @_erreur
            </div>
        }

        @if (_succes)
        {
            <div class="alert alert-success border-0 text-success bg-success bg-opacity-10 d-flex align-items-center gap-2 mb-4 rounded-3 p-3">
                <span class="fs-4">✅</span>
                <div class="fw-semibold">Type de client modifié avec succès et tracé dans le journal d'audit.</div>
            </div>
        }
    </div>
}

@code {
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private bool _succes;

    private Guid _appelantId;
    private IReadOnlyList<SocieteSelectionnable>? _societes;
    private Guid _societeSelectionnee;
    private TypeClient _nouveauType = TypeClient.Normal;

    private TypeClient TypeActuel =>
        _societes?.FirstOrDefault(s => s.Id == _societeSelectionnee)?.Profil ?? TypeClient.Normal;

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private static string NomLisible(SocieteSelectionnable societe) =>
        string.IsNullOrWhiteSpace(societe.InformationsDeclarees)
            ? "Société sans informations déclarées"
            : societe.InformationsDeclarees;

    private static string LibelleType(TypeClient type) => type switch
    {
        TypeClient.Normal => "Normal (paiement à l'acte)",
        TypeClient.EnCompte => "En compte (facturation différée)",
        TypeClient.Deposit => "Deposit (provision préalable)",
        TypeClient.IES => "IES (Import Export Service)",
        _ => type.ToString()
    };

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Veuillez vous connecter pour modifier un type de client.";
                return;
            }

            _appelantId = contexte.UtilisateurId;

            using var scope = ScopeFactory.CreateScope();
            var listerSocietesQuery = scope.ServiceProvider.GetRequiredService<ListerSocietesActivesQuery>();
            _societes = await listerSocietesQuery.ExecuterAsync(_appelantId);

            var courante = _societes.FirstOrDefault(s => s.Id == _societeSelectionnee) ?? _societes.FirstOrDefault();
            if (courante is not null)
            {
                _societeSelectionnee = courante.Id;
                _nouveauType = courante.Profil;
            }
            _nonAutorise = false;
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ModifierAsync()
    {
        _erreur = null;
        _succes = false;

        if (_societeSelectionnee == Guid.Empty)
        {
            _erreur = "Veuillez sélectionner une société cliente.";
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var modifierTypeCmd = scope.ServiceProvider.GetRequiredService<ModifierTypeClientCommand>();
            await modifierTypeCmd.ExecuterAsync(_appelantId, _societeSelectionnee, _nouveauType);
            _succes = true;
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _erreur = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
    }
}
