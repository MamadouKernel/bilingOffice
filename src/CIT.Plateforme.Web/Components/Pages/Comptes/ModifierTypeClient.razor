@page "/comptes/modifier-type"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Comptes
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Comptes
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory

<PageTitle>@Loc["ModifType.PageTitle"]</PageTitle>

<div class="cit-page-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-2">
            <span>🏷️</span> @Loc["ModifType.Pill"]
        </div>
        <h1 class="cit-page-title fw-bold text-dark mb-1">
            @Loc["ModifType.Title"]
        </h1>
        <div class="cit-page-subtitle text-muted">
            @Loc["ModifType.Subtitle"]
        </div>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["ModifType.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    <div class="cit-page-etroite">
        @if (_societes is null || _societes.Count == 0)
        {
            <EtatVide Titre="@Loc["ModifType.EmptyTitle"]"
                      Description="@Loc["ModifType.EmptyDesc"]"
                      Icone="🏷️" />
        }
        else
        {
            <div class="cit-card p-4 border-0 shadow-sm mb-4 u-r-lg">
                <div class="alert alert-info bg-info bg-opacity-10 border-0 text-info mb-4 d-flex align-items-center gap-2 p-3 rounded-3">
                    <span class="fs-5">ℹ️</span>
                    <span class="small">@Loc["ModifType.InfoTrace"]</span>
                </div>

                <div class="mb-4">
                    <label class="form-label text-uppercase fw-bold text-muted small" for="societe">@Loc["ModifType.LblSociete"]</label>
                    <select id="societe" class="form-select form-select-lg border-0 shadow-sm u-r-md u-bg-surface" 
                            @bind="_societeSelectionnee" @bind:after="SurChangementSociete">
                        @foreach (var societe in _societes)
                        {
                            <option value="@societe.Id">@NomLisible(societe)</option>
                        }
                    </select>
                    @* Le RCCM confirme la société choisie (deux noms peuvent se ressembler) sans
                       alourdir la liste : action tracée à l'audit, l'erreur de cible doit être évitée. *@
                    @if (SocieteCourante?.Rccm is { } rccm)
                    {
                        <div class="form-text mt-2"><span class="fw-semibold">RCCM</span> · <span class="font-monospace">@rccm</span></div>
                    }
                </div>

                <div class="mb-4">
                    <label class="form-label text-uppercase fw-bold text-muted small">@Loc["ModifType.LblTypeActuel"]</label>
                    <div>
                        <span class="badge bg-secondary-subtle text-dark border px-3 py-2 fs-6">@LibelleType(TypeActuel)</span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-uppercase fw-bold text-muted small" for="nouveau-type">@Loc["ModifType.LblNouveauType"]</label>
                    <select id="nouveau-type" class="form-select form-select-lg border-0 shadow-sm u-r-md u-bg-surface" 
                            @bind="_nouveauType">
                        @* Types proposables : les ACTIFS du référentiel, plus le type actuel de la société. *@
                        @foreach (var valeur in TypesProposes)
                        {
                            <option value="@valeur">@LibelleType(valeur)</option>
                        }
                    </select>
                </div>

                <div class="pt-2 border-top text-end">
                    <button type="button" class="btn btn-primary btn-lg px-4 py-2 fw-bold shadow-sm u-r-md" 
                            @onclick="ModifierAsync">
                        @Loc["ModifType.BtnEnregistrer"]
                    </button>
                </div>
            </div>

            @* IDENTITÉ STRUCTURÉE — correction de la raison sociale et du RCCM (sociétés reprises
               sans RCCM valide, erreur de saisie). Action distincte, tracée à l'audit. *@
            <div class="cit-card p-4 mb-4">
                <h2 class="h6 fw-bold mb-1">🪪 @Loc["ModifType.IdentityTitle"]</h2>
                <p class="small text-muted mb-3">@Loc["ModifType.IdentityHint"]</p>
                @if (SocieteCourante is { Rccm: null })
                {
                    <div class="alert alert-warning small py-2 mb-3">@Loc["ModifType.RccmMissing"]</div>
                }
                <div class="row g-3">
                    <div class="col-12 col-md-7">
                        <label class="form-label small" for="raison-sociale">@Loc["Account.CompanyNameLabel"]</label>
                        <input id="raison-sociale" class="form-control" maxlength="200" @bind="_raisonSociale" />
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label small" for="rccm">@Loc["Account.RccmLabel"]</label>
                        <input id="rccm" class="form-control font-monospace text-uppercase" maxlength="40"
                               placeholder="CI-ABJ-2024-B-12345" spellcheck="false" @bind="_rccm" />
                    </div>
                </div>
                <div class="pt-3 text-end">
                    <button type="button" class="btn btn-outline-primary px-4" @onclick="CorrigerIdentiteAsync">
                        @Loc["ModifType.BtnIdentity"]
                    </button>
                </div>
            </div>
        }

        @if (_erreur is not null)
        {
            <div class="alert alert-danger border-0 text-danger bg-danger bg-opacity-10 mb-4 rounded-3 p-3 d-flex align-items-center" role="alert">
                <span class="me-2 fs-5">⚠️</span> @_erreur
            </div>
        }

        @if (_succes)
        {
            <div class="alert alert-success border-0 text-success bg-success bg-opacity-10 d-flex align-items-center gap-2 mb-4 rounded-3 p-3" role="status">
                <span class="fs-4">✅</span>
                <div class="fw-semibold">@(_messageSucces ?? Loc["ModifType.Success"].Value)</div>
            </div>
        }
    </div>
}

@code {
    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private bool _succes;

    private Guid _appelantId;
    private IReadOnlyList<SocieteSelectionnable>? _societes;
    private Guid _societeSelectionnee;
    private TypeClient _nouveauType = TypeClient.Normal;

    private string? _messageSucces;
    private string _raisonSociale = string.Empty;
    private string _rccm = string.Empty;

    /// <summary>Pré-remplit les champs (type, identité) avec la société choisie.</summary>
    private void SurChangementSociete()
    {
        _succes = false;
        _erreur = null;
        if (SocieteCourante is { } societe)
        {
            _nouveauType = societe.Profil;
            _raisonSociale = societe.Nom;
            _rccm = societe.Rccm ?? string.Empty;
        }
    }

    private async Task CorrigerIdentiteAsync()
    {
        _erreur = null;
        _succes = false;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider.GetRequiredService<CorrigerIdentiteSocieteCommand>()
                .ExecuterAsync(_appelantId, _societeSelectionnee, _raisonSociale, _rccm);
            _messageSucces = Loc["ModifType.IdentitySuccess"].Value;
            _succes = true;
            await ChargerAsync();
        }
        catch (RccmDejaUtiliseException)
        {
            _erreur = Loc["ModifType.RccmTaken"].Value;
        }
        catch (ArgumentException)
        {
            _erreur = Loc["Account.RccmInvalid"].Value;
        }
        catch (AccesRefuseException ex)
        {
            _erreur = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private TypeClient TypeActuel =>
        _societes?.FirstOrDefault(s => s.Id == _societeSelectionnee)?.Profil ?? TypeClient.Normal;

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private string NomLisible(SocieteSelectionnable societe) =>
        string.IsNullOrWhiteSpace(societe.Nom)
            ? Loc["ModifType.SocieteSansInfo"].Value
            : societe.Nom;

    private SocieteSelectionnable? SocieteCourante =>
        _societes?.FirstOrDefault(s => s.Id == _societeSelectionnee);

    private IReadOnlyList<TypeClientVue> _typesClient = [];

    private IEnumerable<TypeClient> TypesProposes =>
        _typesClient.Count == 0
            ? Enum.GetValues<TypeClient>()
            : _typesClient.Where(t => t.Actif || t.Type == TypeActuel).Select(t => t.Type);

    /// <summary>Libellé paramétré (référentiel), sinon libellé par défaut.</summary>
    private string LibelleType(TypeClient type) =>
        _typesClient.FirstOrDefault(t => t.Type == type)?.Libelle(System.Globalization.CultureInfo.CurrentUICulture.Name)
        ?? LibelleParDefaut(type);

    private string LibelleParDefaut(TypeClient type) => type switch
    {
        TypeClient.Normal => Loc["ModifType.TypeNormal"].Value,
        TypeClient.EnCompte => Loc["ModifType.TypeEnCompte"].Value,
        TypeClient.Deposit => Loc["ModifType.TypeDeposit"].Value,
        TypeClient.IES => Loc["ModifType.TypeIES"].Value,
        _ => type.ToString()
    };

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["ModifType.LoginRequis"].Value;
                return;
            }

            _appelantId = contexte.UtilisateurId;

            using var scope = ScopeFactory.CreateScope();
            var listerSocietesQuery = scope.ServiceProvider.GetRequiredService<ListerSocietesActivesQuery>();
            _societes = await listerSocietesQuery.ExecuterAsync(_appelantId);
            _typesClient = await scope.ServiceProvider.GetRequiredService<ListerTypesClientQuery>().ExecuterAsync(activesUniquement: false);

            var courante = _societes.FirstOrDefault(s => s.Id == _societeSelectionnee) ?? _societes.FirstOrDefault();
            if (courante is not null)
            {
                _societeSelectionnee = courante.Id;
                _nouveauType = courante.Profil;
                _raisonSociale = courante.Nom;
                _rccm = courante.Rccm ?? string.Empty;
            }
            _nonAutorise = false;
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task ModifierAsync()
    {
        _erreur = null;
        _succes = false;

        if (_societeSelectionnee == Guid.Empty)
        {
            _erreur = Loc["ModifType.ErrSelectSociete"].Value;
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var modifierTypeCmd = scope.ServiceProvider.GetRequiredService<ModifierTypeClientCommand>();
            await modifierTypeCmd.ExecuterAsync(_appelantId, _societeSelectionnee, _nouveauType);
            _messageSucces = null;
            _succes = true;
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _erreur = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }
}
