@page "/comptes/profil"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Comptes
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IContexteUtilisateurWeb ContexteService
@inject ConsulterProfilSocieteQuery ConsulterProfil

<PageTitle>Profil de la société — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>🏢</span> Profil de la société (CPT-04, ENT-01)
        </h2>
        <div class="cit-page-subtitle">Informations de votre entreprise et statut de rattachement cloisonné</div>
    </div>
    <div class="mt-3 mt-md-0">
        <button class="btn btn-outline-secondary btn-sm" @onclick="ChargerAsync" disabled="@_chargement">
            🔄 Actualiser
        </button>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement du profil de votre société..." />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else if (_sansSociete)
{
    <EtatVide Titre="Aucune société rattachée"
              Description="Votre compte n'est rattaché à aucune société cliente. Cette page concerne les comptes entreprise."
              Icone="🏢" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger mb-4">@_erreur</div>
    }

    @if (_resultat is not null)
    {
        <div class="cit-card mb-4">
            <div class="d-flex justify-content-between align-items-start mb-3 gap-3 flex-wrap">
                <div>
                    <h5 class="fw-bold text-dark mb-1">
                        @(string.IsNullOrWhiteSpace(_resultat.Societe.InformationsDeclarees)
                            ? "Société sans informations déclarées"
                            : _resultat.Societe.InformationsDeclarees)
                    </h5>
                    <div class="text-muted small">
                        Type de client : <span class="fw-semibold">@_resultat.Societe.Profil</span>
                        · Créée le @_resultat.Societe.DateCreationUtc.ToString("dd/MM/yyyy")
                    </div>
                </div>
                <span class="badge bg-primary-subtle text-primary fs-6">@_resultat.Societe.Etat</span>
            </div>

            <h6 class="fw-bold text-dark mt-4 mb-2">Utilisateurs et collaborateurs rattachés</h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Collaborateur</th>
                            <th>Rôle</th>
                            <th>Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var utilisateur in _resultat.UtilisateursRattaches)
                        {
                            <tr>
                                <td class="text-dark fw-semibold">@NomLisible(utilisateur.UtilisateurId)</td>
                                <td>
                                    @if (utilisateur.EstAdministrateur)
                                    {
                                        <span class="badge bg-primary">Administrateur</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">Collaborateur</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(utilisateur.EstActif ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                        @(utilisateur.EstActif ? "Actif" : "Inactif")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private bool _chargement = true;
    private bool _nonAutorise;
    private bool _sansSociete;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private ProfilSocieteResultat? _resultat;

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    /// <summary>Repli explicite : si le nom n'a pas pu être résolu, on l'annonce en clair plutôt
    /// que d'exposer un identifiant technique incompréhensible.</summary>
    private string NomLisible(Guid utilisateurId) =>
        _resultat?.NomsUtilisateurs?.GetValueOrDefault(utilisateurId) is { Length: > 0 } nom
            ? nom
            : "Collaborateur non identifié";

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = "Veuillez vous connecter pour consulter le profil de votre société.";
                return;
            }

            if (!contexte.SocieteId.HasValue)
            {
                _sansSociete = true;
                return;
            }

            // Appelant ET société proviennent du contexte authentifié : un utilisateur ne peut pas
            // désigner la société d'un tiers (cloisonnement CPT-04 / ENT-01, anti-IDOR).
            _sansSociete = false;
            _resultat = await ConsulterProfil.ExecuterAsync(contexte.UtilisateurId, contexte.SocieteId.Value);
            _nonAutorise = false;
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }
}
