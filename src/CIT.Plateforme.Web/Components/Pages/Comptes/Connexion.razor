@page "/comptes/connexion"
@using CIT.Plateforme.Application.Comptes
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Infrastructure.Identity
@using CIT.Plateforme.Web.Resources
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject VerifierAccesCompteQuery VerifierAcces
@inject NavigationManager Navigation

<PageTitle>@Loc["Auth.LoginTitle"]</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        
        <!-- Navigation Top Bar : Accueil & Inscription -->
        <div class="d-flex align-items-center justify-content-between mb-3 px-2">
            <a href="/" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold rounded-pill bg-white shadow-xs d-inline-flex align-items-center gap-2">
                <span>🏠</span> Retour à l'accueil
            </a>
            
            <a href="/comptes/soumettre" class="btn btn-light btn-sm px-3 py-2 fw-semibold rounded-pill text-primary border shadow-xs d-inline-flex align-items-center gap-2">
                <span>🏢</span> Créer un compte société
            </a>
        </div>

        <div class="cit-card p-0 overflow-hidden border-0 shadow-lg" style="border-radius: 1.5rem;">
            <div class="row g-0">
                
                <!-- Left Side: 3D Illustration -->
                <div class="col-md-6 d-none d-md-block" style="background-color: #eaf4fc;">
                    <div class="h-100 d-flex flex-column justify-content-center align-items-center p-5 text-center">
                        <img src="images/login-illustration.jpg" alt="Terminal Maritime 3D" class="img-fluid" style="max-height: 500px; border-radius: 1rem; mix-blend-mode: multiply;" />
                        <div class="mt-4">
                            <h3 class="fw-bold text-uppercase" style="color: #1e3a8a;">Bienvenue sur l'Espace Digital</h3>
                            <p class="text-muted mb-0">Gérez vos expéditions, conteneurs et facturations maritimes en toute simplicité grâce à la plateforme.</p>
                        </div>
                    </div>
                </div>

                <!-- Right Side: Login Form -->
                <div class="col-md-6 d-flex align-items-center">
                    <div class="p-5 p-lg-5 w-100">
                        <div class="mb-5 text-center text-md-start">
                            <img src="images/logo_cit.jpeg" alt="Côte d'Ivoire Terminal" style="height: 54px; border-radius: 8px; margin-bottom: 1.5rem;" />
                            <h2 class="fw-bold" style="color: var(--ink);">@Loc["Auth.LoginTitle"]</h2>
                            <p class="text-muted">Renseignez vos identifiants pour accéder à votre espace de travail.</p>
                        </div>

                        <EditForm Model="Modele" OnValidSubmit="ConnecterAsync" FormName="connexion">
                            <div class="mb-4">
                                <label class="form-label text-uppercase fw-bold text-muted" style="font-size: 0.75rem;" for="email">@Loc["Auth.Email"]</label>
                                <InputText id="email" class="form-control form-control-lg border-0 px-3 py-3" placeholder="jean.dupont@entreprise.com" @bind-Value="Modele.Email" style="background-color: var(--surface);" />
                            </div>
                            
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="form-label text-uppercase fw-bold text-muted mb-0" style="font-size: 0.75rem;" for="mot-de-passe">@Loc["Auth.Password"]</label>
                                    <a href="/comptes/mot-de-passe-oublie" class="small text-decoration-none fw-bold" style="color: var(--marine-600);">@Loc["Auth.ForgotPassword"]</a>
                                </div>
                                <InputText id="mot-de-passe" type="password" class="form-control form-control-lg border-0 px-3 py-3 mt-2" placeholder="••••••••" @bind-Value="Modele.MotDePasse" style="background-color: var(--surface);" />
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm mt-3 py-3" style="border-radius: 0.75rem;">
                                @Loc["Auth.SignInButton"] <span class="ms-2">→</span>
                            </button>
                        </EditForm>

                        @if (erreur is not null)
                        {
                            <div class="alert mt-4 rounded-3 p-3 d-flex align-items-center shadow-sm" 
                                 style="background-color: #fef2f2 !important; color: #991b1b !important; border: 1px solid #fecaca !important;">
                                <span class="me-2 fs-5">⚠️</span>
                                <span class="fw-semibold small">@erreur</span>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    private static readonly SharedResourcesLocalizer Loc = new();

    // REMÉDIATION POST-AUDIT (2026-08-29) : le champ [SupplyParameterFromForm] doit être LE MÊME
    // identifiant que celui utilisé comme Model de l'EditForm et dans les expressions @bind-Value —
    // sinon les noms de champs rendus (dérivés de l'expression @bind-Value, ex. "modele.Email") ne
    // correspondent jamais aux noms que le mappage de formulaire recherche pour ce paramètre (ex.
    // "modeleFormulaire.Email"), et les valeurs postées reviennent silencieusement vides. Bug
    // découvert par le test HTTP réel `ParcoursConnexion2FaTests` (browser + WebApplicationFactory),
    // jamais visible dans les tests précédents qui appelaient UserManager/SignInManager directement.
    [SupplyParameterFromForm]
    private ModeleConnexion Modele { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? erreur;

    protected override void OnInitialized() => Modele ??= new();

    private async Task ConnecterAsync()
    {
        erreur = null;
        // Message volontairement générique quel que soit le cas de refus (identifiants invalides,
        // société non validée/désactivée, rattachement désactivé) — ne révèle aucune information
        // sensible sur l'état exact du compte (US2 scénario 2).
        const string messageRefusGenerique = "Identifiants incorrects ou compte non accessible.";

        var utilisateur = await UserManager.FindByEmailAsync(Modele.Email);
        if (utilisateur is null)
        {
            erreur = messageRefusGenerique;
            return;
        }

        // REMÉDIATION POST-AUDIT (post-implementation-audit.md §11, CPT-07) : PasswordSignInAsync
        // (Identity natif) est la seule primitive qui déclenche réellement RequiresTwoFactor quand
        // un second facteur est activé — CheckPasswordSignInAsync (ancien code) ne le fait jamais,
        // ce qui rendait la 2FA inerte en production.
        var resultat = await SignInManager.PasswordSignInAsync(utilisateur, Modele.MotDePasse, isPersistent: false, lockoutOnFailure: true);

        if (resultat.RequiresTwoFactor)
        {
            // Refus avant le défi 2FA si le compte est désactivé (E : refus dès que possible dans
            // le parcours, sans exposer l'existence d'un second facteur à un compte non autorisé).
            if (!await EstAccesAutoriseAsync(utilisateur))
            {
                await SignInManager.SignOutAsync();
                erreur = messageRefusGenerique;
                return;
            }

            Navigation.NavigateTo("/comptes/verifier-code");
            return;
        }

        if (!resultat.Succeeded)
        {
            erreur = messageRefusGenerique;
            return;
        }

        // Connexion directe réussie (aucun second facteur activé) : PasswordSignInAsync a déjà
        // écrit le cookie d'authentification — vérifier l'accès société après coup et annuler la
        // connexion si le compte n'est pas autorisé (US2 scénario 2).
        if (!await EstAccesAutoriseAsync(utilisateur))
        {
            await SignInManager.SignOutAsync();
            erreur = messageRefusGenerique;
            return;
        }

        // Redirection immédiate post-connexion : évite que la page reste statique et empêche
        // les soumissions multiples (double-clic) qui invalidaient le jeton Antiforgery anonyme
        // une fois le cookie d'authentification posé.
        var destination = !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith("/") && !ReturnUrl.StartsWith("//")
            ? ReturnUrl
            : "/";
        Navigation.NavigateTo(destination, forceLoad: true);
    }

    // CORRECTIF (2026-08-30) : VerifierAccesCompteQuery vérifie une règle propre aux comptes
    // société (CPT-03 — société active + rattachement actif) ; elle ne s'applique qu'aux comptes
    // Client. L'appliquer sans distinction bloquait la connexion de TOUT compte Agent/Admin CIT
    // interne (jamais rattaché à une société par conception, CLAR-01) — découvert en pratique via
    // un compte agent créé pour les tests, refusé malgré des identifiants valides.
    private async Task<bool> EstAccesAutoriseAsync(ApplicationUser utilisateur) =>
        utilisateur.Nature != NatureUtilisateur.Client || await VerifierAcces.AccesAutoriseAsync(utilisateur.Id);

    private sealed class ModeleConnexion
    {
        public string Email { get; set; } = string.Empty;
        public string MotDePasse { get; set; } = string.Empty;
    }
}
