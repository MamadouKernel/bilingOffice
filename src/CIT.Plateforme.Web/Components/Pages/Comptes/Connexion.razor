@page "/comptes/connexion"
@using CIT.Plateforme.Application.Comptes
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Infrastructure.Identity
@using CIT.Plateforme.Web.Resources
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject RegleAccesConnexion RegleAcces
@inject CIT.Plateforme.Application.Securite.JournalConnexionService JournalConnexion
@inject IHttpContextAccessor AccesContexteHttp
@inject NavigationManager Navigation

<PageTitle>@Loc["Auth.LoginTitle"]</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        
        <!-- Navigation Top Bar : Accueil & Inscription -->
        <div class="d-flex align-items-center justify-content-between mb-3 px-2">
            <a href="/" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold rounded-pill bg-white shadow-xs d-inline-flex align-items-center gap-2">
                <span>🏠</span> @Loc["Common.BackHome"]
            </a>

            <a href="/comptes/soumettre" class="btn btn-light btn-sm px-3 py-2 fw-semibold rounded-pill text-primary border shadow-xs d-inline-flex align-items-center gap-2">
                <span>🏢</span> @Loc["Nav.CreateCompanyAccount"]
            </a>
        </div>

        <div class="cit-card p-0 overflow-hidden border-0 shadow-lg" style="border-radius: 1.5rem;">
            <div class="row g-0">
                
                <!-- Left Side: 3D Illustration -->
                <div class="col-md-6 d-none d-md-block" style="background-color: var(--azure-50);">
                    <div class="h-100 d-flex flex-column justify-content-center align-items-center p-5 text-center">
                        <img src="images/login-illustration.jpg" alt="@Loc["Auth.MaritimeIllustrationAlt"]" class="img-fluid" style="max-height: 500px; border-radius: 1rem; mix-blend-mode: multiply;" />
                        <div class="mt-4">
                            <h3 class="fw-bold text-uppercase" style="color: var(--action);">@Loc["Auth.WelcomeDigital"]</h3>
                            <p class="text-muted mb-0">@Loc["Auth.WelcomeTagline"]</p>
                        </div>
                    </div>
                </div>

                <!-- Right Side: Login Form -->
                <div class="col-md-6 d-flex align-items-center">
                    <div class="p-5 p-lg-5 w-100">
                        <div class="mb-5 text-center text-md-start">
                            <img src="images/logo_cit.jpeg" alt="Côte d'Ivoire Terminal" style="height: 54px; border-radius: 8px; margin-bottom: 1.5rem;" />
                            <h1 class="fw-bold h2 mb-0" style="color: var(--ink);">@Loc["Auth.LoginTitle"]</h1>
                            <p class="text-muted">@Loc["Auth.LoginSubtitle"]</p>
                        </div>

                        <EditForm Model="Modele" OnValidSubmit="ConnecterAsync" FormName="connexion">
                            <div class="mb-4">
                                <label class="form-label text-uppercase fw-bold text-muted" style="font-size: 0.75rem;" for="email">@Loc["Auth.Email"]</label>
                                <InputText id="email" class="form-control form-control-lg border-0 px-3 py-3" placeholder="@Loc["Common.EmailPlaceholder"]" @bind-Value="Modele.Email" style="background-color: var(--surface);" />
                            </div>
                            
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="form-label text-uppercase fw-bold text-muted mb-0" style="font-size: 0.75rem;" for="mot-de-passe">@Loc["Auth.Password"]</label>
                                    <a href="/comptes/mot-de-passe-oublie" class="small text-decoration-none fw-bold" style="color: var(--marine-600);">@Loc["Auth.ForgotPassword"]</a>
                                </div>
                                <ChampMotDePasse>
                                    <InputText id="mot-de-passe" type="password" class="form-control form-control-lg border-0 px-3 py-3 mt-2" placeholder="••••••••" @bind-Value="Modele.MotDePasse" style="background-color: var(--surface);" />
                                </ChampMotDePasse>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm mt-3 py-3" style="border-radius: 0.75rem;">
                                @Loc["Auth.SignInButton"] <span class="ms-2">→</span>
                            </button>
                        </EditForm>

                        @if (erreur is not null)
                        {
                            <div class="alert mt-4 rounded-3 p-3 d-flex align-items-center shadow-sm" 
                                 style="background-color: var(--stop-100); color: var(--stop-600); border: 1px solid var(--stop-border);">
                                <span class="me-2 fs-5">⚠️</span>
                                <span class="fw-semibold small">@erreur</span>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    private static readonly SharedResourcesLocalizer Loc = new();

    // REMÉDIATION POST-AUDIT (2026-08-29) : le champ [SupplyParameterFromForm] doit être LE MÊME
    // identifiant que celui utilisé comme Model de l'EditForm et dans les expressions @bind-Value —
    // sinon les noms de champs rendus (dérivés de l'expression @bind-Value, ex. "modele.Email") ne
    // correspondent jamais aux noms que le mappage de formulaire recherche pour ce paramètre (ex.
    // "modeleFormulaire.Email"), et les valeurs postées reviennent silencieusement vides. Bug
    // découvert par le test HTTP réel `ParcoursConnexion2FaTests` (browser + WebApplicationFactory),
    // jamais visible dans les tests précédents qui appelaient UserManager/SignInManager directement.
    [SupplyParameterFromForm]
    private ModeleConnexion Modele { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? erreur;

    protected override void OnInitialized()
    {
        // Le modèle est initialisé EN PREMIER : l'EditForm l'exige dès le rendu, y compris pendant
        // la redirection ci-dessous (le rendu SSR peut se poursuivre après l'appel à NavigateTo).
        Modele ??= new();

        // REMÉDIATION D-07 : un utilisateur déjà authentifié était rendu SUR l'écran de connexion,
        // DANS la coquille authentifiée — son identité en en-tête au-dessus d'un formulaire de
        // connexion. La page est en SSR : NavigateTo émet ici une redirection HTTP vers l'accueil.
        if (AccesContexteHttp.HttpContext?.User?.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task ConnecterAsync()
    {
        erreur = null;
        // Message volontairement générique quel que soit le cas de refus (identifiants invalides,
        // société non validée/désactivée, rattachement désactivé) — ne révèle aucune information
        // sensible sur l'état exact du compte (US2 scénario 2). Localisé, mais TOUJOURS unique :
        // la culture ne change que la langue, jamais la décision ni le degré d'information.
        var messageRefusGenerique = Loc["Auth.LoginFailed"].Value;

        var utilisateur = await UserManager.FindByEmailAsync(Modele.Email);
        if (utilisateur is null)
        {
            // P2-03 (RG-SEC-03) : identifiant inconnu. Le journal ne porte AUCUNE identité — en
            // inventer une attribuerait la tentative à un tiers.
            await JournalConnexion.ConnexionRefuseeAsync(null, MotifRefusConnexion.IdentifiantsInvalides, Origine());
            erreur = messageRefusGenerique;
            return;
        }

        // REMÉDIATION POST-AUDIT (post-implementation-audit.md §11, CPT-07) : PasswordSignInAsync
        // (Identity natif) est la seule primitive qui déclenche réellement RequiresTwoFactor quand
        // un second facteur est activé — CheckPasswordSignInAsync (ancien code) ne le fait jamais,
        // ce qui rendait la 2FA inerte en production.
        var resultat = await SignInManager.PasswordSignInAsync(utilisateur, Modele.MotDePasse, isPersistent: false, lockoutOnFailure: true);

        if (resultat.RequiresTwoFactor)
        {
            // Refus avant le défi 2FA si le compte est désactivé (E : refus dès que possible dans
            // le parcours, sans exposer l'existence d'un second facteur à un compte non autorisé).
            if (!await EstAccesAutoriseAsync(utilisateur))
            {
                await JournalConnexion.ConnexionRefuseeAsync(utilisateur.Id, MotifRefus(utilisateur), Origine());
                await SignInManager.SignOutAsync();
                erreur = messageRefusGenerique;
                return;
            }

            await JournalConnexion.SecondFacteurDemandeAsync(utilisateur.Id, Origine());
            Navigation.NavigateTo("/comptes/verifier-code");
            return;
        }

        if (!resultat.Succeeded)
        {
            await JournalConnexion.ConnexionRefuseeAsync(
                utilisateur.Id,
                resultat.IsLockedOut ? MotifRefusConnexion.CompteVerrouille : MotifRefusConnexion.IdentifiantsInvalides,
                Origine());
            erreur = messageRefusGenerique;
            return;
        }

        // Connexion directe réussie (aucun second facteur activé) : PasswordSignInAsync a déjà
        // écrit le cookie d'authentification — vérifier l'accès société après coup et annuler la
        // connexion si le compte n'est pas autorisé (US2 scénario 2).
        if (!await EstAccesAutoriseAsync(utilisateur))
        {
            await JournalConnexion.ConnexionRefuseeAsync(utilisateur.Id, MotifRefus(utilisateur), Origine());
            await SignInManager.SignOutAsync();
            erreur = messageRefusGenerique;
            return;
        }

        await JournalConnexion.ConnexionReussieAsync(utilisateur.Id, Origine());

        // Redirection immédiate post-connexion : évite que la page reste statique et empêche
        // les soumissions multiples (double-clic) qui invalidaient le jeton Antiforgery anonyme
        // une fois le cookie d'authentification posé.
        var destination = !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith("/") && !ReturnUrl.StartsWith("//")
            ? ReturnUrl
            : "/";
        Navigation.NavigateTo(destination, forceLoad: true);
    }

    // DEUX RÈGLES DISTINCTES, ET C'EST TOUT L'ENJEU (remédiation P0-ter).
    //
    // 1. ACTIVATION — applicable à TOUS les comptes, sans exception de nature. Un compte désactivé
    //    n'ouvre aucune session, qu'il soit client, agent ou administrateur.
    //
    // 2. RATTACHEMENT SOCIÉTÉ (CPT-03 — société active + rattachement actif) — propre aux comptes
    //    Client. Un compte interne n'est jamais rattaché à une société, par conception (CLAR-01).
    //
    // Le correctif du 2026-08-30 avait raison de soustraire les comptes internes à la règle 2, qui
    // les bloquait tous. Mais il les a soustraits à la règle 1 par la même occasion, car les deux
    // étaient portées par une seule expression : `Nature != Client || AccesAutoriseAsync(...)`
    // rendait vraie la condition entière dès que l'appelant n'était pas un client, sans jamais
    // regarder son état. C'est ainsi qu'un agent désactivé pouvait ouvrir une session neuve.
    // Les deux règles sont désormais énoncées séparément, dans cet ordre.
    // P3 — LA RÈGLE VIT DÉSORMAIS DANS `RegleAccesConnexion`, ET NON PLUS ICI.
    // Elle était recopiée à l'identique dans les deux voies d'ouverture de session. Deux copies
    // d'une règle de sécurité finissent par diverger — c'est ce qui a produit le P0-ter, où cette
    // page portait un contrôle d'activité que l'autre n'avait jamais eu.
    private Task<bool> EstAccesAutoriseAsync(ApplicationUser utilisateur) =>
        RegleAcces.AccesAutoriseAsync(utilisateur.Id, utilisateur.Nature, utilisateur.EstActif);

    // Le journal distingue les motifs que l'utilisateur, lui, ne doit pas distinguer : le message
    // affiché reste générique, la trace est précise. C'est la différence entre ne pas renseigner un
    // attaquant et ne pas renseigner l'exploitation.
    private static MotifRefusConnexion MotifRefus(ApplicationUser utilisateur) =>
        utilisateur.EstActif ? MotifRefusConnexion.AccesSocieteRefuse : MotifRefusConnexion.CompteDesactive;

    // Origine réseau, quand le contexte HTTP est disponible. Aucune autre donnée de requête n'est
    // consignée — ni en-tête, ni empreinte, ni identifiant de session.
    private string? Origine() => AccesContexteHttp.HttpContext?.Connection.RemoteIpAddress?.ToString();

    private sealed class ModeleConnexion
    {
        public string Email { get; set; } = string.Empty;
        public string MotDePasse { get; set; } = string.Empty;
    }
}
