@page "/comptes/inscription-transporteur"
@rendermode InteractiveServer
@using CIT.Plateforme.Application.Comptes
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@using CIT.Plateforme.Web.Resources
@using Microsoft.Extensions.Localization
@inject UserManager<ApplicationUser> UserManager
@inject InscrireTransporteurCommand InscrireTransporteur
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["Account.CarrierPageTitle"]</PageTitle>

<div class="row justify-content-center py-2">
    <div class="col-12 col-xl-11">
        
        <!-- Navigation Top Bar : Accueil & Aide -->
        <div class="d-flex align-items-center justify-content-between mb-3 px-2">
            <a href="/" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold rounded-pill bg-white shadow-xs d-inline-flex align-items-center gap-2">
                <span>🏠</span> @Loc["Common.BackHome"]
            </a>

            <button class="btn btn-light btn-sm px-3 py-2 fw-semibold rounded-pill text-primary border shadow-xs d-inline-flex align-items-center gap-2"
                    type="button"
                    @onclick="() => _afficherAide = !_afficherAide">
                <span>💡</span> @Loc["Account.GuideHelp"]
            </button>
        </div>

        <!-- Panneau d'Aide Dépliable -->
        @if (_afficherAide)
        {
            <div class="cit-card p-4 mb-4 border-0 shadow-sm rounded-4" style="background-color: var(--info-100); border: 1px solid var(--info-border);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <span>💡</span> @Loc["Account.CarrierGuideTitle"]
                    </h5>
                    <button type="button" class="btn-close" aria-label="@Loc["Common.Close"]" @onclick="() => _afficherAide = false"></button>
                </div>
                <div class="row g-3 small text-muted mt-1">
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-white rounded-3 border h-100">
                            <strong class="text-dark d-block mb-1">@Loc["Account.CarrierStep1Title"]</strong>
                            @Loc["Account.CarrierStep1Text"]
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-white rounded-3 border h-100">
                            <strong class="text-dark d-block mb-1">@Loc["Account.CarrierStep2Title"]</strong>
                            @Loc["Account.CarrierStep2Text"]
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-white rounded-3 border h-100">
                            <strong class="text-dark d-block mb-1">@Loc["Account.CarrierStep3Title"]</strong>
                            @Loc["Account.CarrierStep3Text"]
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Carte Principale 2 Colonnes -->
        <div class="cit-card p-0 overflow-hidden border-0 shadow-lg" style="border-radius: 1.5rem; background-color: var(--surface);">
            <div class="row g-0">
                
                <!-- Left Column: Transport 3D Illustration & Presentation -->
                <div class="col-lg-5 d-none d-lg-block" style="background-color: var(--warn-100);">
                    <div class="h-100 d-flex flex-column justify-content-between p-5">
                        <div>
                            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-white rounded-pill shadow-xs mb-4">
                                <img src="images/logo_cit.jpeg" alt="Logo CIT" style="height: 32px; object-fit: contain; border-radius: 4px;" />
                                <span class="small fw-bold text-dark">Côte d'Ivoire Terminal</span>
                            </div>

                            <h3 class="fw-bold text-dark mb-3 lh-sm" style="color: var(--warn-600);">
                                @Loc["Account.CarrierPanelHeading"]
                            </h3>
                            <p class="text-muted small mb-4" style="line-height: 1.6;">
                                @Loc["Account.CarrierPanelTagline"]
                            </p>

                            <div class="d-flex flex-column gap-3 mb-4">
                                <div class="d-flex align-items-start gap-2">
                                    <span class="badge bg-warning bg-opacity-25 text-dark p-2 rounded-circle">🚚</span>
                                    <div class="small">
                                        <strong class="text-dark d-block">@Loc["Account.CarrierBenefit1Title"]</strong>
                                        <span class="text-muted">@Loc["Account.CarrierBenefit1Text"]</span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-start gap-2">
                                    <span class="badge bg-success bg-opacity-10 text-success p-2 rounded-circle">⏱️</span>
                                    <div class="small">
                                        <strong class="text-dark d-block">@Loc["Account.CarrierBenefit2Title"]</strong>
                                        <span class="text-muted">@Loc["Account.CarrierBenefit2Text"]</span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-start gap-2">
                                    <span class="badge bg-primary bg-opacity-10 text-primary p-2 rounded-circle">📱</span>
                                    <div class="small">
                                        <strong class="text-dark d-block">@Loc["Account.CarrierBenefit3Title"]</strong>
                                        <span class="text-muted">@Loc["Account.CarrierBenefit3Text"]</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Image illustration -->
                        <div class="text-center pt-2">
                            <img src="images/transport-illustration.jpg"
                                 alt="@Loc["Account.CarrierImageAlt"]"
                                 class="img-fluid rounded-4 shadow-sm border border-white border-2"
                                 style="max-height: 280px; object-fit: cover;" />
                            <div class="text-muted small mt-2" style="font-size: 0.75rem;">
                                @Loc["Account.CarrierImageCaption"]
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Registration Form -->
                <div class="col-12 col-lg-7 d-flex align-items-center">
                    <div class="p-4 p-md-5 w-100">
                        
                        <!-- Header with Logo -->
                        <div class="mb-4">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                                <img src="images/logo_cit.jpeg" alt="Côte d'Ivoire Terminal" style="height: 48px; object-fit: contain; border-radius: 6px;" />
                                <span class="badge bg-warning bg-opacity-20 text-dark fw-bold px-3 py-2 rounded-pill small">
                                    🚚 @Loc["Account.CarrierBadge"]
                                </span>
                            </div>
                            <h1 class="fw-bold text-dark mb-1 h2">@Loc["Account.CarrierTitle"]</h1>
                            <p class="text-muted small mb-0">@Loc["Account.CarrierSubtitle"]</p>
                        </div>

                        @if (_termine)
                        {
                            <div class="p-4 p-md-5 border-0 shadow-sm mb-4 text-center rounded-4" 
                                 style="background-color: var(--ok-100); border: 1px solid var(--ok-border);">
                                <div class="fs-1 mb-2">🎉</div>
                                <h4 class="fw-bold mb-2" style="color: var(--ok-600);">@Loc["Account.CarrierSuccessTitle"]</h4>
                                <p class="text-muted small mb-4">
                                    @Loc["Account.CarrierSuccessText"]
                                </p>
                                <a class="btn btn-success px-4 py-2 fw-bold shadow-sm rounded-pill" href="/comptes/connexion">
                                    @Loc["Account.CarrierSuccessCta"] ➔
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label text-uppercase fw-bold text-muted small" style="font-size: 0.75rem;" for="email">@Loc["Account.CarrierEmailLabel"] <span class="text-danger">*</span></label>
                                <input id="email" class="form-control form-control-lg border-0 shadow-xs px-3 py-3"
                                       placeholder="@Loc["Account.CarrierEmailPlaceholder"]"
                                       style="background-color: var(--surface); border-radius: 0.75rem;"
                                       @bind="_email" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-uppercase fw-bold text-muted small" style="font-size: 0.75rem;" for="nom">@Loc["Account.FullNameLabel"] <span class="text-danger">*</span></label>
                                <input id="nom" class="form-control form-control-lg border-0 shadow-xs px-3 py-3"
                                       placeholder="@Loc["Account.FullNamePlaceholder"]"
                                       style="background-color: var(--surface); border-radius: 0.75rem;"
                                       @bind="_nomAffiche" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label text-uppercase fw-bold text-muted small" style="font-size: 0.75rem;" for="mdp">@Loc["Account.Password"] <span class="text-danger">*</span></label>
                                <ChampMotDePasse>
                                    <input id="mdp" type="password" class="form-control form-control-lg border-0 shadow-xs px-3 py-3"
                                           placeholder="••••••••••••"
                                           style="background-color: var(--surface); border-radius: 0.75rem;"
                                           @bind="_motDePasse" />
                                </ChampMotDePasse>
                                <div class="form-text small text-muted">@Loc["Account.PasswordHint"]</div>
                            </div>

                            @if (_erreur is not null)
                            {
                                <div class="alert mt-3 mb-3 rounded-3 p-3 d-flex align-items-center shadow-sm" 
                                     style="background-color: var(--stop-100); color: var(--stop-600); border: 1px solid var(--stop-border);">
                                    <span class="me-2 fs-5">⚠️</span>
                                    <span class="fw-semibold small">@_erreur</span>
                                </div>
                            }

                            <div class="pt-3 border-top d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <a href="/comptes/connexion" class="small text-decoration-none fw-bold" style="color: var(--marine-600);">
                                    @Loc["Account.CarrierAlreadySignIn"]
                                </a>
                                <button type="button" class="btn btn-warning btn-lg px-4 py-2 fw-bold text-dark shadow-sm rounded-pill" @onclick="CreerAsync">
                                    @Loc["Account.CarrierSubmit"] ➔
                                </button>
                            </div>

                            <div class="mt-4 pt-3 border-top text-center">
                                <span class="text-muted small">@Loc["Account.CarrierToCompanyQuestion"]</span><br />
                                <a href="/comptes/soumettre" class="fw-bold text-primary text-decoration-none small">
                                    @Loc["Account.CarrierToCompanyLink"]
                                </a>
                            </div>
                        }

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    private string _email = string.Empty;
    private string _nomAffiche = string.Empty;
    private string _motDePasse = string.Empty;
    private string? _erreur;
    private bool _termine;
    private bool _afficherAide;

    private async Task CreerAsync()
    {
        _erreur = null;

        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_nomAffiche))
        {
            _erreur = Loc["Account.CarrierNameRequired"].Value;
            return;
        }

        var transporteur = new ApplicationUser
        {
            UserName = _email.Trim(),
            Email = _email.Trim(),
            NomAffiche = _nomAffiche.Trim(),
            Nature = NatureUtilisateur.Client,
        };

        var resultat = await UserManager.CreateAsync(transporteur, _motDePasse);
        if (!resultat.Succeeded)
        {
            _erreur = string.Join(" ", resultat.Errors.Select(e => e.Description));
            return;
        }

        try
        {
            await InscrireTransporteur.ExecuterAsync(transporteur.Id);
            _termine = true;
        }
        catch (Exception ex)
        {
            await UserManager.DeleteAsync(transporteur);
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }
}
