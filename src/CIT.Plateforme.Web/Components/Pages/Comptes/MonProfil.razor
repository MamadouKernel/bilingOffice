@page "/comptes/mon-profil"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Comptes
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirMonProfilQuery ObtenirMonProfil
@inject ModifierMonProfilCommand ModifierMonProfil
@inject CloturerMonCompteCommand CloturerMonCompte
@inject NavigationManager Navigation

<PageTitle>@Loc["Profil.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>👤</span> @Loc["Profil.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["Profil.Subtitle"]</div>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["Profil.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else if (_profil is not null)
{
    <div class="cit-page-etroite">
        @if (_erreur is not null)
        {
            <div class="alert alert-danger mb-4" role="alert">@_erreur</div>
        }
        @if (_succes is not null)
        {
            <div class="alert alert-success mb-4" role="status">@_succes</div>
        }

        <!-- Identité -->
        <div class="cit-card mb-4">
            <h6 class="fw-bold text-dark mb-1">@Loc["Profil.IdentitySection"]</h6>
            <div class="small text-muted mb-4">@Loc["Profil.IdentityHelp"]</div>

            <div class="mb-3">
                <label class="form-label" for="nomAffiche">@Loc["Profil.DisplayNameLabel"]</label>
                <input id="nomAffiche" class="form-control" maxlength="128"
                       @bind="_nomAffiche" @bind:event="oninput"
                       placeholder="@Loc["Profil.DisplayNamePlaceholder"]" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="email">@Loc["Profil.EmailLabel"]</label>
                <input id="email" class="form-control" value="@_profil.Email" disabled readonly />
                <div class="form-text">
                    @Loc["Profil.EmailHelp"]
                </div>
            </div>

            <div class="mb-0">
                <label class="form-label" for="telephone">@Loc["Profil.PhoneLabel"]</label>
                <input id="telephone" class="form-control" maxlength="32"
                       @bind="_telephone" @bind:event="oninput"
                       placeholder="@Loc["Profil.PhonePlaceholder"]" />
                <div class="form-text">@Loc["Profil.PhoneHelp"]</div>
            </div>
        </div>

        <!-- Rattachement -->
        <div class="cit-card mb-4">
            <h6 class="fw-bold text-dark mb-1">@Loc["Profil.AttachmentSection"]</h6>
            <div class="small text-muted mb-4">@Loc["Profil.AttachmentHelp"]</div>

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <tbody>
                        <tr>
                            <td class="text-muted" style="width: 40%;">@Loc["Profil.ActiveSpace"]</td>
                            <td class="fw-semibold text-dark">@LibelleEspace(_contexte!.EspaceActif)</td>
                        </tr>
                        <tr>
                            <td class="text-muted">@Loc["Profil.AccountType"]</td>
                            <td class="fw-semibold text-dark">@_profil.Nature</td>
                        </tr>
                        <tr>
                            <td class="text-muted">@Loc["Dash.Company"]</td>
                            <td class="fw-semibold text-dark">@(_contexte.SocieteNom ?? "—")</td>
                        </tr>
                        @if (_contexte.SocieteProfil.HasValue)
                        {
                            <tr>
                                <td class="text-muted">@Loc["Profil.ClientProfile"]</td>
                                <td class="fw-semibold text-dark">@_contexte.SocieteProfil</td>
                            </tr>
                        }
                        <tr>
                            <td class="text-muted">@Loc["Profil.Permissions"]</td>
                            <td class="fw-semibold text-dark">@_contexte.Permissions.Count</td>
                        </tr>
                        <tr>
                            <td class="text-muted">@Loc["Profil.AccountState"]</td>
                            <td>
                                @if (_profil.EstActif)
                                {
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">@Loc["Societe.StatusActive"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1">@Loc["Profil.StateInactive"]</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Sécurité -->
        <div class="cit-card mb-4">
            <h6 class="fw-bold text-dark mb-1">@Loc["Profil.SecuritySection"]</h6>
            <div class="small text-muted mb-3">@Loc["Profil.SecurityHelp"]</div>
            <div class="d-flex flex-wrap gap-2">
                <a href="/comptes/double-authentification" class="btn btn-outline-secondary btn-sm">
                    @Loc["Profil.Btn2fa"]
                </a>
                <a href="/comptes/mot-de-passe-oublie" class="btn btn-outline-secondary btn-sm">
                    @Loc["Profil.BtnChangePassword"]
                </a>
            </div>
        </div>

        @if (_contexte?.Nature == NatureUtilisateur.Client)
        {
            <!-- Zone de danger : Clôture du compte -->
            <div class="cit-card border-danger-subtle mb-4">
                <h6 class="fw-bold text-danger mb-1">@Loc["Profil.ClosureSection"]</h6>
                <div class="small text-muted mb-3">
                    @Loc["Profil.ClosureHelp"]
                </div>
                <div>
                    <button type="button" class="btn btn-outline-danger btn-sm fw-semibold" @onclick="AfficherModaleCloture">
                        @Loc["Profil.CloseAccountBtn"]
                    </button>
                </div>
            </div>
        }

        <div class="d-flex justify-content-end gap-2 mb-5">
            <button type="button" class="btn btn-outline-secondary" @onclick="AnnulerAsync" disabled="@_enregistrement">@Loc["Common.Cancel"]</button>
            <button type="button" class="btn btn-primary px-4 fw-bold" @onclick="EnregistrerAsync" disabled="@(!PeutEnregistrer || _enregistrement)">
                @(_enregistrement ? Loc["Profil.Saving"].Value : Loc["Profil.SaveChanges"].Value)
            </button>
        </div>
    </div>

    @if (_afficherModaleCloture)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header border-bottom-0 pb-0">
                        <h5 class="modal-title fw-bold text-danger">@Loc["Profil.ClosureModalTitle"]</h5>
                        <button type="button" class="btn-close" @onclick="FermerModaleCloture" disabled="@_clotureEnCours"></button>
                    </div>
                    <div class="modal-body py-3">
                        <p class="small text-muted mb-3">
                            @Loc["Profil.ClosureModalWarning"]
                        </p>

                        @if (_erreurCloture is not null)
                        {
                            <div class="alert alert-danger py-2 small mb-3" role="alert">@_erreurCloture</div>
                        }

                        <div class="mb-3">
                            <label class="form-label small fw-semibold" for="motDePasseCloture">@Loc["Profil.ClosurePwdLabel"] <span class="text-danger">*</span></label>
                            <input id="motDePasseCloture" type="password" class="form-control"
                                   @bind="_motDePasseCloture" placeholder="@Loc["Profil.ClosurePwdPlaceholder"]" />
                        </div>

                        <div class="mb-0">
                            <label class="form-label small fw-semibold" for="motifCloture">@Loc["Profil.ClosureReasonLabel"]</label>
                            <input id="motifCloture" type="text" class="form-control" maxlength="256"
                                   @bind="_motifCloture" placeholder="@Loc["Profil.ClosureReasonPlaceholder"]" />
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary" @onclick="FermerModaleCloture" disabled="@_clotureEnCours">
                            @Loc["Common.Cancel"]
                        </button>
                        <button type="button" class="btn btn-danger fw-bold" @onclick="ConfirmerClotureAsync" disabled="@(string.IsNullOrWhiteSpace(_motDePasseCloture) || _clotureEnCours)">
                            @(_clotureEnCours ? Loc["Profil.ClosureConfirmInProgress"].Value : Loc["Profil.ClosureConfirmBtn"].Value)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool _chargement = true;
    private bool _enregistrement;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private string? _succes;

    private bool _afficherModaleCloture;
    private bool _clotureEnCours;
    private string _motDePasseCloture = string.Empty;
    private string _motifCloture = string.Empty;
    private string? _erreurCloture;

    private ContexteUtilisateurVue? _contexte;
    private MonProfilVue? _profil;

    private string _nomAffiche = string.Empty;
    private string _telephone = string.Empty;

    private bool PeutEnregistrer => !string.IsNullOrWhiteSpace(_nomAffiche);

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private async Task ChargerAsync()
    {
        _chargement = true;
        _erreur = null;
        try
        {
            _contexte = await ContexteService.ObtenirContexteAsync();
            if (_contexte is null || !_contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["Profil.MsgLoginRequired"].Value;
                return;
            }

            // L'identité provient exclusivement du contexte authentifié (anti-IDOR).
            _profil = await ObtenirMonProfil.ExecuterAsync(_contexte.UtilisateurId);
            _nomAffiche = _profil.NomAffiche;
            _telephone = _profil.Telephone ?? string.Empty;
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task EnregistrerAsync()
    {
        if (!PeutEnregistrer || _contexte is null) return;

        _enregistrement = true;
        _erreur = null;
        _succes = null;
        try
        {
            await ModifierMonProfil.ExecuterAsync(
                _contexte.UtilisateurId,
                new ModifierMonProfilRequete(_nomAffiche, _telephone));

            _succes = Loc["Profil.MsgSaved"].Value;
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _enregistrement = false;
        }
    }

    private async Task AnnulerAsync()
    {
        _succes = null;
        _erreur = null;
        await ChargerAsync();
    }

    private void AfficherModaleCloture()
    {
        _motDePasseCloture = string.Empty;
        _motifCloture = string.Empty;
        _erreurCloture = null;
        _afficherModaleCloture = true;
    }

    private void FermerModaleCloture()
    {
        if (_clotureEnCours) return;
        _afficherModaleCloture = false;
        _erreurCloture = null;
    }

    private async Task ConfirmerClotureAsync()
    {
        if (_contexte is null || string.IsNullOrWhiteSpace(_motDePasseCloture)) return;

        _clotureEnCours = true;
        _erreurCloture = null;
        try
        {
            await CloturerMonCompte.ExecuterAsync(
                _contexte.UtilisateurId,
                new CloturerMonCompteRequete(_motDePasseCloture, _motifCloture));

            _afficherModaleCloture = false;
            Navigation.NavigateTo("/comptes/compte-cloture", forceLoad: true);
        }
        catch (Exception ex)
        {
            _erreurCloture = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _clotureEnCours = false;
        }
    }

    private static string LibelleEspace(EspaceFonctionnel espace) => espace switch
    {
        EspaceFonctionnel.Client => SharedResourcesLocalizer.Get("Profil.SpaceClient"),
        EspaceFonctionnel.AdministrateurSociete => SharedResourcesLocalizer.Get("Societe.Title"),
        EspaceFonctionnel.Agent => SharedResourcesLocalizer.Get("Profil.SpaceAgent"),
        EspaceFonctionnel.Supervision => SharedResourcesLocalizer.Get("Profil.SpaceSupervision"),
        EspaceFonctionnel.AdministrationCit => SharedResourcesLocalizer.Get("Profil.SpaceAdmin"),
        _ => espace.ToString()
    };
}
