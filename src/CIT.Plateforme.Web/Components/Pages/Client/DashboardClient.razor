@page "/client/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Client
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Comptes
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirDashboardClientQuery DashboardQuery
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["Dash.PageTitle"]</PageTitle>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["Dash.Loading"]" />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger" role="alert">@_erreur</div>
}
else if (_dashboard is not null)
{
    <div class="cit-page-header">
        <div>
            <h1 class="cit-page-title">
                <span>📊</span> @Loc["Dash.Title"]
            </h1>
            <div class="cit-page-subtitle">
                @Loc["Dash.Company"] <strong class="text-dark">@_dashboard.SocieteNom</strong> · @Loc["Dash.Profile"] <span class="badge bg-secondary-subtle text-secondary">@_dashboard.SocieteProfil</span> · @Loc["Dash.Status"] <span class="badge bg-success-subtle text-success">@_dashboard.SocieteStatut</span>
            </div>
        </div>
        @* AM-02 — le raccourci de soumission ne s'affiche que si le collaborateur détient
           réellement le droit (résolu serveur). Un collaborateur limité ne voit pas un CTA qui
           mènerait à un 403 ; la commande serveur reste seule juge s'il force l'URL. *@
        @if (_dashboard.PeutSoumettre)
        {
            <div class="mt-3 mt-md-0">
                <a href="/billing-import/soumettre" class="btn btn-primary shadow-sm">
                    <span>➕</span> @Loc["Dash.NewImport"]
                </a>
            </div>
        }
    </div>

    <!-- 3 Cartes Métriques KPI -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-primary">
                <div class="cit-stat-icon bg-primary-subtle text-primary">
                    📁
                </div>
                <div>
                    <div class="cit-stat-label">@Loc["Dash.KpiActiveTitle"]</div>
                    <div class="cit-stat-value text-primary">@_dashboard.TotalDemandesActives</div>
                    <div class="small text-muted">@Loc["Dash.KpiActiveHint"]</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-info">
                <div class="cit-stat-icon bg-info-subtle text-info">
                    ⚙️
                </div>
                <div>
                    <div class="cit-stat-label">@Loc["Dash.KpiCitTitle"]</div>
                    <div class="cit-stat-value text-info">@_dashboard.TotalEnAttenteCit</div>
                    <div class="small text-muted">@Loc["Dash.KpiCitHint"]</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-warning">
                <div class="cit-stat-icon bg-warning-subtle text-warning">
                    ⚠️
                </div>
                <div>
                    <div class="cit-stat-label">@Loc["Dash.KpiActionsTitle"]</div>
                    <div class="cit-stat-value text-warning">@_dashboard.TotalActionsRequises</div>
                    <div class="small text-muted">@Loc["Dash.KpiActionsHint"]</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Zone ACR-01 : Mes actions requises -->
    <ZoneActionsRequises Actions="@_dashboard.ActionsRequises" />

    <!-- Demandes récentes -->
    <div class="cit-card mb-4 p-0 overflow-hidden">
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom bg-light">
            <h6 class="fw-bold m-0 text-dark">@Loc["Dash.RecentTitle"]</h6>
            <a href="/client/demandes" class="btn btn-outline-secondary btn-sm">
                @Loc["Dash.SeeAll"]
            </a>
        </div>

        @if (_dashboard.DemandesRecentes.Count == 0)
        {
            <div class="p-4">
                @* AM-02 — même règle : le CTA de création n'apparaît que si le droit de soumission
                   est accordé. Sans droit, l'état vide reste informatif mais n'offre aucune action
                   qui échouerait côté serveur. *@
                <EtatVide Titre="@Loc["Dash.EmptyTitle"]"
                          Message="@Loc["Dash.EmptyMsg"]"
                          Icone="🚢"
                          ActionLibelle="@(_dashboard.PeutSoumettre ? Loc["Dash.EmptyCta"].Value : null)"
                          ActionUrl="@(_dashboard.PeutSoumettre ? "/billing-import/soumettre" : null)" />
            </div>
        }
        else
        {
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["Dash.ColFile"]</th>
                            <th>@Loc["Dash.ColDate"]</th>
                            <th>@Loc["Dash.ColModule"]</th>
                            <th>@Loc["Dash.ColBl"]</th>
                            <th>@Loc["Dash.ColStatus"]</th>
                            <th class="text-end">@Loc["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _pagination1.Appliquer(_dashboard.DemandesRecentes))
                        {
                            <tr>
                                <td class="fw-bold">
                                    <a href="/dossiers/@d.DossierId" class="text-decoration-none text-primary">
                                        @d.NumeroDossier
                                    </a>
                                </td>
                                <td class="text-muted small">@d.DateCreationUtc.Horodate()</td>
                                <td><span class="badge bg-light text-dark border">@d.Module</span></td>
                                <td>
                                    @if (d.Tickets.Count == 0)
                                    {
                                        <span class="text-muted small">@Loc["Dash.NoBl"]</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var t in d.Tickets)
                                            {
                                                <a href="/tickets/@t.TicketId" class="badge bg-light text-dark border text-decoration-none">
                                                    @(t.NumeroBl ?? t.NumeroTicket)
                                                </a>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge @BadgeClassDossier(d.EtatGlobal)">
                                        @LibelleEtatDossier(d.EtatGlobal)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a href="/dossiers/@d.DossierId" class="btn btn-outline-primary btn-sm">
                                        @Loc["Dash.Consult"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        }
    </div>
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargement = true;
    private string? _erreur;
    private DashboardClientVue? _dashboard;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            // Compte transporteur (sans société, droit d'enrôlement) : ce tableau de bord ne le
            // concerne pas — son espace est celui de ses enrôlements, comme depuis l'accueil.
            if (contexte.EstTransporteur)
            {
                Navigation.NavigateTo("/enrolement/mes-enrolements", replace: true);
                return;
            }

            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue)
            {
                _erreur = Loc["Dash.LoadError"].Value;
                return;
            }

            _dashboard = await DashboardQuery.ExecuterAsync(contexte.UtilisateurId, contexte.SocieteId.Value);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private static string BadgeClassDossier(StatutVisuelDossier etat) => etat switch
    {
        StatutVisuelDossier.ClotureTermine => "bg-success text-white",
        StatutVisuelDossier.EnAttenteClient => "bg-warning text-dark",
        StatutVisuelDossier.EnCoursTraitement => "bg-primary text-white",
        StatutVisuelDossier.Annule => "bg-secondary text-white",
        StatutVisuelDossier.Rejete => "bg-danger text-white",
        _ => "bg-info text-dark"
    };

    private static string LibelleEtatDossier(StatutVisuelDossier etat) => etat switch
    {
        StatutVisuelDossier.ClotureTermine => SharedResourcesLocalizer.Get("Dash.EtatCloture"),
        StatutVisuelDossier.EnAttenteClient => SharedResourcesLocalizer.Get("Dash.EtatActionRequise"),
        StatutVisuelDossier.EnCoursTraitement => SharedResourcesLocalizer.Get("Dash.EtatEnCoursCit"),
        StatutVisuelDossier.Annule => SharedResourcesLocalizer.Get("Dash.EtatAnnule"),
        StatutVisuelDossier.Rejete => SharedResourcesLocalizer.Get("Dash.EtatRejete"),
        _ => SharedResourcesLocalizer.Get("Dash.EtatEnAttenteCit")
    };
}
