@page "/client/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Client
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Comptes
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirDashboardClientQuery DashboardQuery

<PageTitle>Tableau de bord Client — CIT</PageTitle>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement de votre tableau de bord..." />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger">@_erreur</div>
}
else if (_dashboard is not null)
{
    <div class="cit-page-header">
        <div>
            <h2 class="cit-page-title">
                <span>📊</span> Tableau de bord Client
            </h2>
            <div class="cit-page-subtitle">
                Société <strong class="text-dark">@_dashboard.SocieteNom</strong> · Profil <span class="badge bg-secondary-subtle text-secondary">@_dashboard.SocieteProfil</span> · Statut <span class="badge bg-success-subtle text-success">@_dashboard.SocieteStatut</span>
            </div>
        </div>
        <div class="mt-3 mt-md-0">
            <a href="/billing-import/soumettre" class="btn btn-primary shadow-sm">
                <span>➕</span> Nouvelle demande IMPORT
            </a>
        </div>
    </div>

    <!-- 3 Cartes Métriques KPI -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-primary">
                <div class="cit-stat-icon bg-primary-subtle text-primary">
                    📁
                </div>
                <div>
                    <div class="cit-stat-label">Demandes en cours</div>
                    <div class="cit-stat-value text-primary">@_dashboard.TotalDemandesActives</div>
                    <div class="small text-muted">Dossiers actifs sur la plateforme</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-info">
                <div class="cit-stat-icon bg-info-subtle text-info">
                    ⚙️
                </div>
                <div>
                    <div class="cit-stat-label">En cours de traitement CIT</div>
                    <div class="cit-stat-value text-info">@_dashboard.TotalEnAttenteCit</div>
                    <div class="small text-muted">Pris en charge par les équipes portuaires</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="cit-stat-card border-start border-4 border-warning">
                <div class="cit-stat-icon bg-warning-subtle text-warning">
                    ⚠️
                </div>
                <div>
                    <div class="cit-stat-label">Actions requises</div>
                    <div class="cit-stat-value text-warning">@_dashboard.TotalActionsRequises</div>
                    <div class="small text-muted">Compléments ou paiements attendus</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Zone ACR-01 : Mes actions requises -->
    <ZoneActionsRequises Actions="@_dashboard.ActionsRequises" />

    <!-- Demandes récentes -->
    <div class="cit-card mb-4 p-0 overflow-hidden">
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom bg-light">
            <h6 class="fw-bold m-0 text-dark">Dernières demandes soumises</h6>
            <a href="/client/demandes" class="btn btn-outline-secondary btn-sm">
                Voir toutes mes demandes →
            </a>
        </div>

        @if (_dashboard.DemandesRecentes.Count == 0)
        {
            <div class="p-4">
                <EtatVide Titre="Aucune demande enregistrée"
                          Message="Vous n'avez pas encore soumis de demande d'importation maritime."
                          Icone="🚢"
                          ActionLibelle="Créer une première demande"
                          ActionUrl="/billing-import/soumettre" />
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>N° Dossier</th>
                            <th>Date</th>
                            <th>Module</th>
                            <th>BL associés</th>
                            <th>Statut global</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _dashboard.DemandesRecentes)
                        {
                            <tr>
                                <td class="fw-bold">
                                    <a href="/dossiers/@d.DossierId" class="text-decoration-none text-primary">
                                        @d.NumeroDossier
                                    </a>
                                </td>
                                <td class="text-muted small">@d.DateCreationUtc.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge bg-light text-dark border">@d.Module</span></td>
                                <td>
                                    @if (d.Tickets.Count == 0)
                                    {
                                        <span class="text-muted small">Aucun BL</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var t in d.Tickets)
                                            {
                                                <a href="/tickets/@t.TicketId" class="badge bg-light text-dark border text-decoration-none">
                                                    @(t.NumeroBl ?? t.NumeroTicket)
                                                </a>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge @BadgeClassDossier(d.EtatGlobal)">
                                        @LibelleEtatDossier(d.EtatGlobal)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a href="/dossiers/@d.DossierId" class="btn btn-outline-primary btn-sm">
                                        Consulter ➔
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private bool _chargement = true;
    private string? _erreur;
    private DashboardClientVue? _dashboard;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue)
            {
                _erreur = "Impossible de charger le tableau de bord : aucun compte société associé.";
                return;
            }

            _dashboard = await DashboardQuery.ExecuterAsync(contexte.UtilisateurId, contexte.SocieteId.Value);
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private static string BadgeClassDossier(StatutVisuelDossier etat) => etat switch
    {
        StatutVisuelDossier.ClotureTermine => "bg-success text-white",
        StatutVisuelDossier.EnAttenteClient => "bg-warning text-dark",
        StatutVisuelDossier.EnCoursTraitement => "bg-primary text-white",
        StatutVisuelDossier.Annule => "bg-secondary text-white",
        StatutVisuelDossier.Rejete => "bg-danger text-white",
        _ => "bg-info text-dark"
    };

    private static string LibelleEtatDossier(StatutVisuelDossier etat) => etat switch
    {
        StatutVisuelDossier.ClotureTermine => "Clôturé / Traité",
        StatutVisuelDossier.EnAttenteClient => "Action requise",
        StatutVisuelDossier.EnCoursTraitement => "En cours CIT",
        StatutVisuelDossier.Annule => "Annulé",
        StatutVisuelDossier.Rejete => "Rejeté",
        _ => "En attente CIT"
    };
}
