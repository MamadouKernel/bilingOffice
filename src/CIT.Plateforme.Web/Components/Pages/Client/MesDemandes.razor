@page "/client/demandes"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Client
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirDashboardClientQuery DashboardQuery

<PageTitle>Mes Demandes — CIT</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0 text-primary">Mes Demandes & Dossiers</h2>
        <div class="text-secondary small">Consultez l'historique complet de vos opérations d'importation</div>
    </div>
    <a href="/billing-import/soumettre" class="btn btn-primary px-3 py-2 shadow-sm">
        ➕ Nouvelle demande
    </a>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="Chargement de vos dossiers..." />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger">@_erreur</div>
}
else if (_dashboard is not null)
{
    <div class="cit-card mb-4">
        <div class="row g-2 mb-3">
            <div class="col-12 col-md-6">
                <input type="text" class="form-control" placeholder="Rechercher par n° de dossier ou BL..." @bind="_recherche" @bind:event="oninput" />
            </div>
        </div>

        @{
            var dossiersFiltres = _dashboard.DemandesRecentes
                .Where(d => string.IsNullOrWhiteSpace(_recherche) ||
                            d.NumeroDossier.Contains(_recherche, StringComparison.OrdinalIgnoreCase) ||
                            d.Tickets.Any(t => t.NumeroBl?.Contains(_recherche, StringComparison.OrdinalIgnoreCase) == true))
                .ToList();
        }

        @if (dossiersFiltres.Count == 0)
        {
            <EtatVide Titre="Aucun dossier trouvé"
                      Message="Aucune demande ne correspond à vos critères de recherche."
                      Icone="🔍" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>N° Dossier</th>
                            <th>Date de soumission</th>
                            <th>Module</th>
                            <th>Connaissements (BL)</th>
                            <th>Statut global</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in dossiersFiltres)
                        {
                            <tr>
                                <td class="fw-bold">
                                    <a href="/dossiers/@d.DossierId" class="text-decoration-none">
                                        @d.NumeroDossier
                                    </a>
                                </td>
                                <td class="text-muted small">@d.DateCreationUtc.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge bg-secondary">@d.Module</span></td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var t in d.Tickets)
                                        {
                                            <a href="/tickets/@t.TicketId" class="badge bg-light text-dark border text-decoration-none">
                                                @(t.NumeroBl ?? t.NumeroTicket)
                                            </a>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @BadgeClassDossier(d.EtatGlobal)">
                                        @LibelleEtatDossier(d.EtatGlobal)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a href="/dossiers/@d.DossierId" class="btn btn-outline-primary btn-sm">
                                        Détails
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private bool _chargement = true;
    private string? _erreur;
    private DashboardClientVue? _dashboard;
    private string _recherche = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue)
            {
                _erreur = "Session invalide ou compte non rattaché.";
                return;
            }

            _dashboard = await DashboardQuery.ExecuterAsync(contexte.UtilisateurId, contexte.SocieteId.Value);
        }
        catch (Exception ex)
        {
            _erreur = ex.Message;
        }
        finally
        {
            _chargement = false;
        }
    }

    private static string BadgeClassDossier(StatutVisuelDossier etat) => etat switch
    {
        StatutVisuelDossier.ClotureTermine => "bg-success text-white",
        StatutVisuelDossier.EnAttenteClient => "bg-warning text-dark",
        StatutVisuelDossier.EnCoursTraitement => "bg-primary text-white",
        StatutVisuelDossier.Annule => "bg-secondary text-white",
        StatutVisuelDossier.Rejete => "bg-danger text-white",
        _ => "bg-info text-dark"
    };

    private static string LibelleEtatDossier(StatutVisuelDossier etat) => etat switch
    {
        StatutVisuelDossier.ClotureTermine => "Clôturé / Traité",
        StatutVisuelDossier.EnAttenteClient => "Action requise",
        StatutVisuelDossier.EnCoursTraitement => "En cours CIT",
        StatutVisuelDossier.Annule => "Annulé",
        StatutVisuelDossier.Rejete => "Rejeté",
        _ => "En attente CIT"
    };
}
