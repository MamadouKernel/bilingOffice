@page "/client/demandes"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Client
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirDashboardClientQuery DashboardQuery
@inject IServiceScopeFactory ScopeFactory
@inject Microsoft.JSInterop.IJSRuntime Js
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["Demandes.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>📁</span> @Loc["Demandes.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc[_estTransporteur ? "Demandes.SubtitleTransporteur" : "Demandes.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        @* SOC-14 — export tabulaire de la liste. La requête applique le cloisonnement CPT-04 :
           elle n'exporte que les tickets de la société à laquelle le compte est rattaché. *@
        <button type="button" class="btn btn-outline-secondary shadow-sm"
                @onclick="ExporterAsync" disabled="@_exportEnCours">
            @(_exportEnCours ? Loc["Demandes.Exporting"].Value : Loc["Demandes.Export"].Value)
        </button>
        <button type="button" class="btn btn-outline-secondary shadow-sm"
                @onclick="ExporterExcelAsync" disabled="@_exportExcelEnCours">
            @(_exportExcelEnCours ? Loc["Demandes.Exporting"].Value : Loc["Demandes.ExportExcel"].Value)
        </button>
        @* Une entreprise de transport n'a pas de parcours Billing Office : son « nouveau » est l'enrôlement de flotte. *@
        <a href="@(_estTransporteur ? "/enrolement/societe/soumettre" : "/billing-import/soumettre")" class="btn btn-primary shadow-sm">
            <span>➕</span> @Loc[_estTransporteur ? "Enrôler ma flotte" : "Demandes.NewRequest"]
        </a>
    </div>
</div>

@if (_erreurExport is not null)
{
    <div class="alert alert-warning border-0 mb-3 rounded-3" role="alert">
        @Loc["Demandes.ExportFailed"] @_erreurExport
    </div>
}

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["Demandes.Loading"]" />
}
else if (_erreur is not null)
{
    <div class="alert alert-danger" role="alert">@_erreur</div>
}
else if (_dashboard is not null)
{
    <div class="cit-card mb-4 p-0 overflow-hidden">
        <div class="p-3 bg-light border-bottom">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-6 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted" aria-hidden="true">🔍</span>
                        <input type="text" class="form-control border-start-0 ps-0" aria-label="@Loc["Demandes.SearchAria"]" placeholder="@Loc["Demandes.SearchPlaceholder"]" @bind="_recherche" @bind:event="oninput" />
                    </div>
                </div>
            </div>
        </div>

        @{
            var dossiersFiltres = _dashboard.DemandesRecentes
                .Where(d => string.IsNullOrWhiteSpace(_recherche) ||
                            d.NumeroDossier.Contains(_recherche, StringComparison.OrdinalIgnoreCase) ||
                            d.Tickets.Any(t => t.NumeroBl?.Contains(_recherche, StringComparison.OrdinalIgnoreCase) == true))
                .ToList();
        }

        @if (dossiersFiltres.Count == 0)
        {
            <div class="p-4">
                <EtatVide Titre="@Loc["Demandes.EmptyTitle"]"
                          Message="@Loc["Demandes.EmptyMsg"]"
                          Icone="🔍" />
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["Dash.ColFile"]</th>
                            <th>@Loc["Demandes.ColSubmitDate"]</th>
                            <th>@Loc["Dash.ColModule"]</th>
                            <th>@Loc[_estTransporteur ? "Demandes.ColReferences" : "Demandes.ColBl"]</th>
                            <th>@Loc["Dash.ColStatus"]</th>
                            <th class="text-end">@Loc["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _pagination1.Appliquer(dossiersFiltres))
                        {
                            <tr>
                                <td class="fw-bold">
                                    <a href="/dossiers/@d.DossierId" class="text-decoration-none text-primary">
                                        @d.NumeroDossier
                                    </a>
                                </td>
                                <td class="text-muted small">@d.DateCreationUtc.Horodate()</td>
                                <td><span class="badge bg-light text-dark border">@Loc.Module(d.Module)</span></td>
                                <td>
                                    @if (d.Tickets.Count == 0)
                                    {
                                        <span class="text-muted small">@Loc["Dash.NoBl"]</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var t in d.Tickets)
                                            {
                                                <a href="/tickets/@t.TicketId" class="badge bg-light text-dark border text-decoration-none">
                                                    @(t.NumeroBl ?? t.NumeroTicket)
                                                </a>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge @BadgeClassDossier(d.EtatGlobal)">
                                        @LibelleEtatDossier(d.EtatGlobal)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a href="/dossiers/@d.DossierId" class="btn btn-outline-primary btn-sm">
                                        @Loc["Demandes.Details"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        }
    </div>
}

@code {
    private bool _estTransporteur;
    private readonly EtatPagination _pagination1 = new();

    private bool _chargement = true;
    private string? _erreur;
    private DashboardClientVue? _dashboard;
    private string _recherche = string.Empty;
    private Guid _utilisateurId;
    private Guid? _societeId;
    private bool _exportEnCours;
    private bool _exportExcelEnCours;
    private string? _erreurExport;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie || !contexte.SocieteId.HasValue)
            {
                _erreur = Loc["Demandes.SessionInvalid"].Value;
                return;
            }

            _utilisateurId = contexte.UtilisateurId;
            _societeId = contexte.SocieteId;
            _estTransporteur = contexte.SocieteProfil == CIT.Plateforme.Domain.Comptes.TypeClient.Transporteur;
            _dashboard = await DashboardQuery.ExecuterAsync(contexte.UtilisateurId, contexte.SocieteId.Value);
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    /// <summary>
    /// SOC-14 — « export des indicateurs et listes de tickets aux formats usuels ». La commande
    /// existait, testée, et aucun écran ne l'appelait : le client voyait ses demandes sans jamais
    /// pouvoir en sortir la liste.
    /// </summary>
    private async Task ExporterAsync()
    {
        if (_societeId is not Guid societeId)
        {
            return;
        }

        _erreurExport = null;
        _exportEnCours = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var csv = await scope.ServiceProvider
                .GetRequiredService<CIT.Plateforme.Application.Tickets.ExporterTicketsCsvQuery>()
                .ExecuterPourClientAsync(_utilisateurId, societeId);

            await Js.InvokeVoidAsync(
                "telechargerFichier",
                $"mes-demandes-{DateTime.UtcNow:yyyyMMdd-HHmm}.csv",
                "text/csv",
                Convert.ToBase64String(csv));
        }
        catch (Exception ex)
        {
            // Pas _erreur : celle-ci remplace toute la page. Un export qui échoue ne doit pas
            // faire disparaître la liste que le client était en train de consulter.
            _erreurExport = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _exportEnCours = false;
        }
    }

    /// <summary>
    /// SOC-14 — variante Excel de l'export : mêmes contrôles de cloisonnement, format .xlsx.
    /// </summary>
    private async Task ExporterExcelAsync()
    {
        if (_societeId is not Guid societeId)
        {
            return;
        }

        _erreurExport = null;
        _exportExcelEnCours = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var xlsx = await scope.ServiceProvider
                .GetRequiredService<CIT.Plateforme.Application.Tickets.ExporterTicketsExcelQuery>()
                .ExecuterPourClientAsync(_utilisateurId, societeId);

            await Js.InvokeVoidAsync(
                "telechargerFichier",
                $"mes-demandes-{DateTime.UtcNow:yyyyMMdd-HHmm}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(xlsx));
        }
        catch (Exception ex)
        {
            _erreurExport = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _exportExcelEnCours = false;
        }
    }

    private static string BadgeClassDossier(StatutVisuelDossier etat) => etat switch
    {
        StatutVisuelDossier.ClotureTermine => "bg-success text-white",
        StatutVisuelDossier.EnAttenteClient => "bg-warning text-dark",
        StatutVisuelDossier.EnCoursTraitement => "bg-primary text-white",
        StatutVisuelDossier.Annule => "bg-secondary text-white",
        StatutVisuelDossier.Rejete => "bg-danger text-white",
        _ => "bg-info text-dark"
    };

    private static string LibelleEtatDossier(StatutVisuelDossier etat) => etat switch
    {
        StatutVisuelDossier.ClotureTermine => SharedResourcesLocalizer.Get("Dash.EtatCloture"),
        StatutVisuelDossier.EnAttenteClient => SharedResourcesLocalizer.Get("Dash.EtatActionRequise"),
        StatutVisuelDossier.EnCoursTraitement => SharedResourcesLocalizer.Get("Dash.EtatEnCoursCit"),
        StatutVisuelDossier.Annule => SharedResourcesLocalizer.Get("Dash.EtatAnnule"),
        StatutVisuelDossier.Rejete => SharedResourcesLocalizer.Get("Dash.EtatRejete"),
        _ => SharedResourcesLocalizer.Get("Dash.EtatEnAttenteCit")
    };
}
