@page "/notifications/preferences"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Notifications
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Notifications
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject GererPreferencesCanauxCommand PreferencesCommand

@* FEATURE 009 — CONTRAT C9-09 (COM-05, Should).

   SEULE dimension prévue par le CDC : le canal. Ni fréquence, ni langue, ni type d'événement,
   ni plage horaire, ni opt-out global — aucun n'est proposé (spec.md §21).

   Le canal In-App n'apparaît pas : il n'est pas débrayable, sans quoi NOT-01 et NOT-03
   deviendraient inatteignables.

   Une notification qualifiée d'OBLIGATOIRE au paramétrage est transmise MALGRÉ une
   désactivation ici — l'utilisateur en est informé explicitement. *@

<PageTitle>@Loc["NotifPref.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title"><span>⚙️</span> @Loc["NotifPref.Title"]</h1>
        <div class="cit-page-subtitle">@Loc["NotifPref.Subtitle"]</div>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["NotifPref.Loading"]" />
}
else
{
    @if (_erreur is not null)
    {
        <div class="alert alert-danger" role="alert">@_erreur</div>
    }

    <div class="alert alert-info" role="alert">
        @((MarkupString)Loc["NotifPref.Info"].Value)
    </div>

    <div class="list-group shadow-sm">
        @foreach (var canal in CanauxDebrayables)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-bold">@Libelle(canal)</div>
                    <div class="text-muted small">@Description(canal)</div>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="@($"canal-{canal}")"
                           checked="@EstActif(canal)"
                           @onchange="e => BasculerAsync(canal, (bool)(e.Value ?? false))" />
                    <label class="form-check-label visually-hidden" for="@($"canal-{canal}")">@Libelle(canal)</label>
                </div>
            </div>
        }
    </div>
}

@code {
    /// <summary>Le canal In-App est volontairement absent : il n'est pas débrayable.</summary>
    private static readonly CanalNotification[] CanauxDebrayables =
        [CanalNotification.Email];

    private IReadOnlyList<PreferenceCanalUtilisateur> _preferences = [];
    private bool _chargement = true;
    private string? _erreur;
    private ContexteUtilisateurVue? _contexte;

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private async Task ChargerAsync()
    {
        try
        {
            _chargement = true;
            _contexte = await ContexteService.ObtenirContexteAsync();
            _preferences = await PreferencesCommand.ListerMesPreferencesAsync(_contexte.UtilisateurId);
            _erreur = null;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    /// <summary>Absence de préférence enregistrée = canal actif (comportement par défaut).</summary>
    private bool EstActif(CanalNotification canal) =>
        _preferences.FirstOrDefault(p => p.Canal == canal)?.EstActif ?? true;

    private async Task BasculerAsync(CanalNotification canal, bool actif)
    {
        try
        {
            await PreferencesCommand.DefinirAsync(_contexte!.UtilisateurId, canal, actif);
            await ChargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private string Libelle(CanalNotification canal) => canal switch
    {
        CanalNotification.Email => Loc["NotifPref.CanalEmail"].Value,
        _ => canal.ToString(),
    };

    private string Description(CanalNotification canal) => canal switch
    {
        CanalNotification.Email => Loc["NotifPref.DescEmail"].Value,
        _ => string.Empty,
    };
}
