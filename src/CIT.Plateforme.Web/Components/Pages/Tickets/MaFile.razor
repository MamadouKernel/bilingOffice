@page "/tickets/ma-file"
@rendermode InteractiveServer
@using CIT.Plateforme.Web.Components.Shared
@inject ConsulterFileQuery ConsulterFile
@inject PriseLibreCommand PriseLibre

<PageTitle>Ma file — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>📋</span> Ma file de traitement (SOC-04)
        </h2>
        <div class="cit-page-subtitle">File de travail et prise en charge des tickets en attente</div>
    </div>
</div>

<div class="cit-card mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-5">
            <label class="form-label small fw-semibold text-muted" for="agent-id">Identifiant agent (démonstration)</label>
            <input id="agent-id" class="form-control form-control-sm font-monospace" @bind="agentId" />
        </div>
        <div class="col-12 col-md-5">
            <label class="form-label small fw-semibold text-muted" for="file-id">Identifiant de la file</label>
            <input id="file-id" class="form-control form-control-sm font-monospace" @bind="fileId" />
        </div>
        <div class="col-12 col-md-2">
            <button class="btn btn-primary btn-sm w-100 fw-bold" @onclick="ChargerAsync">Charger la file</button>
        </div>
    </div>
</div>

@if (ticketsDeLaFile is not null)
{
    <div class="cit-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Numéro de Ticket</th>
                        <th>Statut</th>
                        <th>Dernière activité</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in ticketsDeLaFile)
                    {
                        <tr>
                            <td>
                                <a href="/tickets/@ticket.Id" class="fw-bold text-primary font-monospace text-decoration-none">
                                    @ticket.Numero
                                </a>
                            </td>
                            <td>
                                <StatutBadge Statut="@ticket.Statut" />
                            </td>
                            <td class="small text-muted font-monospace">@ticket.DateDerniereActiviteUtc.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                @if (ticket.Statut == StatutTicket.EnAttenteDePriseEnCharge)
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="() => PrendreEnChargeAsync(ticket.Id)">
                                        Prendre en charge (PEC-02)
                                    </button>
                                }
                                else
                                {
                                    <a href="/tickets/@ticket.Id" class="btn btn-sm btn-outline-secondary">
                                        Consulter
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private string agentId = Guid.NewGuid().ToString();
    private string fileId = string.Empty;
    private IReadOnlyList<Ticket>? ticketsDeLaFile;

    private async Task ChargerAsync()
    {
        ticketsDeLaFile = await ConsulterFile.ExecuterAsync(Guid.Parse(agentId), Guid.Parse(fileId));
    }

    private async Task PrendreEnChargeAsync(Guid ticketId)
    {
        await PriseLibre.ExecuterAsync(Guid.Parse(agentId), ticketId);
        await ChargerAsync();
    }
}
