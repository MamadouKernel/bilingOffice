@page "/tickets/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Application.Affectation
@using CIT.Plateforme.Application.Messagerie
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Tickets
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ObtenirFicheTicketQuery FicheTicketQuery
@inject PrendreEnChargeCommand PrendreEnCharge
@inject AttenteClientCommand AttenteClient
@inject PublierMessageCommand PublierMessage
@inject CloturerReclamationCommand ClotureReclamation
@inject EvaluerReclamationCommand EvaluerReclamation
@using Microsoft.Extensions.DependencyInjection
@inject Microsoft.Extensions.DependencyInjection.IServiceScopeFactory ScopeFactory
@inject NavigationManager Navigation

<PageTitle>@(_fiche is null ? Loc["Ticket.PageTitleFallback"].Value : string.Format(Loc["Ticket.PageTitleTicket"].Value, _fiche.NumeroTicket)) — CIT</PageTitle>

<div class="container-fluid py-3">
    @if (_chargement)
    {
        <IndicateurChargement Message="@Loc["Ticket.Loading"]" />
    }
    else if (_nonAutorise)
    {
        <div class="container py-4">
            <PermissionDenied Message="@_messageNonAutorise" />
        </div>
    }
    else if (_erreur is not null)
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between" role="alert">
            <div>
                <strong>@Loc["Ticket.AccessErrorLabel"]</strong> @_erreur
            </div>
            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="RetourArriere">@Loc["Ticket.Back"]</button>
        </div>
    }
    else if (_fiche is not null)
    {
        <FilAriane Elements="@(new List<FilAriane.ElementAriane> { new(Loc["FicheAvoirExo.BcHome"].Value, "/"), new(string.Format(Loc["Ticket.BcDossier"].Value, _fiche.NumeroDossier), $"/dossiers/{_fiche.DossierId}"), new(string.Format(Loc["Ticket.BcTicket"].Value, _fiche.NumeroTicket)) })" />

        <!-- Barre de navigation supérieure & retour -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3 pb-2 border-bottom">
            <div class="d-flex align-items-start gap-3 min-w-0">
                <button type="button" class="btn btn-outline-secondary btn-sm flex-shrink-0 mt-1" @onclick="RetourArriere">
                    @Loc["Ticket.Back"]
                </button>
                <div class="min-w-0">
                    <h1 class="h4 fw-bold text-dark mb-0 text-break">
                        @if (!string.IsNullOrWhiteSpace(_fiche.NumeroBooking))
                        {
                            <span>Booking @_fiche.NumeroBooking</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(_fiche.NumeroBl))
                        {
                            <span>BL @_fiche.NumeroBl</span>
                        }
                        else
                        {
                            <span>Ticket @_fiche.NumeroTicket</span>
                        }
                    </h1>
                    <div class="small text-muted text-break">
                        @Loc["Ticket.FileLabel"] <a href="/dossiers/@_fiche.DossierId" class="text-decoration-none fw-semibold">@_fiche.NumeroDossier</a> • @Loc["Ticket.RefLabel"] @_fiche.NumeroTicket
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap flex-shrink-0">
                <StatutBadge Statut="@_fiche.Statut" />
                @if (_fiche.TypeAnnulationExport == TypeAnnulationExport.RejetBackOffice)
                {
                    <span class="badge bg-danger">@Loc["Ticket.RejectBackOffice"]</span>
                }
                @if (_fiche.DeclarationPresentielle)
                {
                    <span class="badge bg-dark">@Loc["Ticket.InPersonFinalization"]</span>
                }
                @if (_fiche.Statut is not StatutTicket.Cloture and not StatutTicket.Annule)
                {
                    <a href="/rendez-vous/prendre/@_fiche.TicketId" class="btn btn-outline-primary btn-sm" title="@Loc["Ticket.BookApptTitle"]">
                        @Loc["Ticket.BookAppt"]
                    </a>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_actionFeedback))
        {
            <div class="alert alert-info py-2 small mb-3">@_actionFeedback</div>
        }

        <!-- Alerte si action requise -->
        @if (_fiche.Statut == StatutTicket.EnAttenteClient)
        {
            <div class="alert alert-warning d-flex align-items-center justify-content-between mb-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4">⚠️</span>
                    <div>
                        <strong>@Loc["Ticket.ActionRequiredLabel"]</strong> @Loc["Ticket.ActionRequiredText"]
                    </div>
                </div>
                @if (_fiche.PeutReprendreApresClient)
                {
                    <button type="button" class="btn btn-warning btn-sm fw-bold" @onclick="ReprendreApresClientAsync">
                        @Loc["Ticket.MarkComplementProvided"]
                    </button>
                }
            </div>
        }

        @if (_fiche.Module == "CustomerComplaint")
        {
            <!-- REMÉDIATION POST-AUDIT (post-implementation-audit.md §2.1) : contenu réel de la
                 réclamation, réponse formalisée et évaluation — jamais affichés avant remédiation. -->
            <div class="cit-card mb-4">
                <h6 class="fw-bold text-dark mb-3">@Loc["Ticket.ComplaintPrefix"] @_fiche.NumeroTicket</h6>
                @if (!string.IsNullOrWhiteSpace(_fiche.Objet))
                {
                    <div class="mb-2"><span class="text-muted small">@Loc["FicheAvoirExo.ObjectField"]</span> <span class="fw-semibold">@_fiche.Objet</span></div>
                }
                @if (!string.IsNullOrWhiteSpace(_fiche.Description))
                {
                    <div class="mb-3"><span class="text-muted small d-block">@Loc["Ticket.DescLabel"]</span> <span>@_fiche.Description</span></div>
                }

                @if (!string.IsNullOrWhiteSpace(_fiche.ReponseFormalisee))
                {
                    <div class="alert alert-success mb-0" role="status">
                        <strong>@Loc["Ticket.FormalResponseLabel"]</strong>
                        <div>@_fiche.ReponseFormalisee</div>
                    </div>
                }
                else if (!_estClient && _fiche.PeutCloturer)
                {
                    <div class="border-top pt-3">
                        <label class="form-label fw-semibold small" for="reponseFormalisee">@Loc["Ticket.FormalResponseFieldLabel"]</label>
                        <textarea id="reponseFormalisee" class="form-control mb-2" rows="3" @bind="_reponseFormalisee" @bind:event="oninput"></textarea>
                        <button type="button" class="btn btn-success btn-sm" @onclick="ClotureReclamationAsync" disabled="@string.IsNullOrWhiteSpace(_reponseFormalisee)">
                            @Loc["Ticket.CloseWithResponse"]
                        </button>
                    </div>
                }

                @if (_fiche.Statut == StatutTicket.Cloture && _estClient)
                {
                    <div class="border-top pt-3 mt-3">
                        @if (_fiche.EvaluationNote.HasValue)
                        {
                            <div class="small text-muted">
                                @Loc["Ticket.YourRating"] <span class="fw-bold">@(new string('★', _fiche.EvaluationNote.Value))@(new string('☆', 5 - _fiche.EvaluationNote.Value))</span>
                                @if (!string.IsNullOrWhiteSpace(_fiche.EvaluationCommentaire))
                                {
                                    <div class="fst-italic">« @_fiche.EvaluationCommentaire »</div>
                                }
                            </div>
                        }
                        else
                        {
                            <label class="form-label fw-semibold small">@Loc["Ticket.YourSatisfaction"]</label>
                            <div class="d-flex gap-1 mb-2">
                                @for (var n = 1; n <= 5; n++)
                                {
                                    var note = n;
                                    <button type="button" class="btn btn-link p-0 fs-4 text-decoration-none" @onclick="() => _noteEvaluation = note">
                                        @(note <= _noteEvaluation ? "★" : "☆")
                                    </button>
                                }
                            </div>
                            <input class="form-control form-control-sm mb-2" placeholder="@Loc["Ticket.CommentOptional"]" @bind="_commentaireEvaluation" />
                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="EvaluerAsync" disabled="@(_noteEvaluation == 0)">
                                @Loc["Ticket.SendRating"]
                            </button>
                        }
                    </div>
                }
            </div>
        }

        <!-- Grille principale -->
        <div class="row g-3 mb-4">
            <!-- Colonne gauche : Synthèse & Informations -->
            <div class="col-12 col-lg-4">
                <div class="cit-card mb-3">
                    <h6 class="fw-bold text-dark mb-3">@Loc["Ticket.GeneralInfo"]</h6>
                    <ul class="list-unstyled mb-0 small">
                        <li class="mb-2 d-flex justify-content-between">
                            <span class="text-muted">@Loc["Ticket.ClientCompany"]</span>
                            <span class="fw-semibold text-end">@_fiche.SocieteNom</span>
                        </li>
                        <li class="mb-2 d-flex justify-content-between">
                            <span class="text-muted">@Loc["Ticket.ModuleLabel"]</span>
                            <span class="fw-semibold">@Loc.Module(_fiche.Module)</span>
                        </li>
                        @if (_fiche.Module == "CustomerComplaint" && !string.IsNullOrWhiteSpace(_fiche.CategorieReclamationLibelle))
                        {
                            <li class="mb-2 d-flex justify-content-between">
                                <span class="text-muted">@Loc["FicheAvoirExo.DocCategory"]</span>
                                <span class="fw-semibold text-end">@_fiche.CategorieReclamationLibelle</span>
                            </li>
                        }
                        @if (!string.IsNullOrWhiteSpace(_fiche.NumeroBooking))
                        {
                            <li class="mb-2 d-flex justify-content-between">
                                <span class="text-muted">@Loc["Ticket.BookingLabel"]</span>
                                <span class="fw-semibold text-primary">@_fiche.NumeroBooking</span>
                            </li>
                        }
                        else if (!string.IsNullOrWhiteSpace(_fiche.NumeroBl))
                        {
                            <li class="mb-2 d-flex justify-content-between">
                                <span class="text-muted">@Loc["Ticket.BlLabel"]</span>
                                <span class="fw-semibold text-primary">@_fiche.NumeroBl</span>
                            </li>
                        }
                        <li class="mb-2 d-flex justify-content-between">
                            <span class="text-muted">@Loc["Ticket.CurrentQueue"]</span>
                            <span class="badge bg-light text-dark border">@_fiche.FileNom</span>
                        </li>
                        @if (!string.IsNullOrWhiteSpace(_fiche.LibellePaiementCdc))
                        {
                            @* IMP-13 : libellé littéral CDC du statut de paiement — affichage
                               uniquement, dérivé de la file courante (voir LibellePaiementCdcHelper). *@
                            <li class="mb-2 d-flex justify-content-between">
                                <span class="text-muted">@Loc["Ticket.PaymentStatusLabel"]</span>
                                <span class="fw-semibold">@_fiche.LibellePaiementCdc</span>
                            </li>
                        }
                        <li class="mb-2 d-flex justify-content-between">
                            <span class="text-muted">@Loc["Ticket.AssignedOperator"]</span>
                            <span class="fw-semibold text-primary">@(_fiche.OperateurAssigneNom ?? Loc["Ticket.Unassigned"].Value)</span>
                        </li>
                        <li class="mb-2 d-flex justify-content-between">
                            <span class="text-muted">@Loc["Ticket.CreatedLabel"]</span>
                            <span>@_fiche.DateCreationUtc.Horodate()</span>
                        </li>
                        @if (_fiche.DatePriseEnChargeUtc.HasValue)
                        {
                            <li class="mb-2 d-flex justify-content-between">
                                <span class="text-muted">@Loc["Ticket.TakenChargeLabel"]</span>
                                <span>@_fiche.DatePriseEnChargeUtc.Value.Horodate()</span>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Barre d'actions métier -->
                <div class="cit-card">
                    <h6 class="fw-bold text-dark mb-3">@Loc["Ticket.AvailableActions"]</h6>
                    <div class="d-grid gap-2">
                        @if (_fiche.PeutPrendreEnCharge)
                        {
                            <button type="button" class="btn btn-primary" @onclick="PrendreEnChargeAsync">
                                @Loc["Ticket.TakeCharge"]
                            </button>
                        }

                        @if (_fiche.PeutMettreEnAttenteClient)
                        {
                            <button type="button" class="btn btn-outline-warning" @onclick="MettreEnAttenteClientAsync">
                                @Loc["Ticket.PutOnHoldClient"]
                            </button>
                        }

                        @if (_fiche.PeutReprendreApresClient && _fiche.Statut == StatutTicket.EnAttenteClient)
                        {
                            <button type="button" class="btn btn-outline-success" @onclick="ReprendreApresClientAsync">
                                @Loc["Ticket.ResumeProcessing"]
                            </button>
                        }

                        @if (_fiche.PeutDemanderFacture)
                        {
                            <button type="button" class="btn btn-outline-primary" @onclick="DemanderFactureAsync" disabled="@_factureDemandee">
                                🧾 @(_factureDemandee ? Loc["Ticket.InvoiceRequested"].Value : Loc["Ticket.RequestInvoice"].Value)
                            </button>
                        }

                        @if (_fiche.PeutDeposerDocument)
                        {
                            @* IMP-12 / EXP-03 — c'est par ici que le client joint sa preuve de
                               paiement. La page existait, rien n'y menait. *@
                            <a class="btn btn-outline-secondary" href="@($"/tickets/{_fiche.TicketId}/documents")">
                                @Loc["Ticket.AttachDocument"]
                            </a>
                        }

                        @if (_fiche.PeutAnnuler)
                        {
                            <button type="button" class="btn btn-outline-danger" @onclick="AnnulerTicketAsync">
                                @Loc["Ticket.CancelMyRequest"]
                            </button>
                        }
                    </div>
                </div>
            </div>

            @* SOC-10 — « liaison entre tickets, y compris entre modules, créée par un agent
               habilité, visible par les agents ET par le client concerné ». La commande existait,
               testée ; aucun écran ne l'appelait, et aucune fiche ne montrait ses liaisons. *@
            <div class="cit-card p-3 mb-3">
                <h6 class="fw-bold text-dark mb-3">@Loc["Ticket.LinkedTickets"]</h6>

                @if (_fiche.Liaisons is null || _fiche.Liaisons.Count == 0)
                {
                    <div class="small text-muted mb-2">@Loc["Ticket.NoLinkedTickets"]</div>
                }
                else
                {
                    <ul class="list-unstyled mb-2">
                        @foreach (var liaison in _fiche.Liaisons)
                        {
                            <li class="d-flex align-items-center justify-content-between gap-2 py-1 border-bottom">
                                <a href="@($"/tickets/{liaison.TicketId}")" class="text-decoration-none fw-semibold">
                                    @liaison.Numero
                                </a>
                                <span class="small text-muted">@Loc.Module(liaison.Module) · @Loc.StatutTicket(liaison.Statut)</span>
                            </li>
                        }
                    </ul>
                }

                @if (_fiche.PeutLierTickets)
                {
                    <div class="input-group input-group-sm mt-2">
                        <input class="form-control" @bind="_numeroALier" placeholder="@Loc["Ticket.LinkPlaceholder"]"
                               aria-label="@Loc["Ticket.LinkAria"]" />
                        <button type="button" class="btn btn-outline-primary" @onclick="LierTicketAsync"
                                disabled="@(string.IsNullOrWhiteSpace(_numeroALier))">@Loc["Ticket.Link"]</button>
                    </div>
                    @if (_erreurLiaison is not null)
                    {
                        <div class="small text-danger mt-2">@_erreurLiaison</div>
                    }
                }
            </div>

            <!-- Colonne droite : Onglets Messagerie / Documents / Chronologie -->
            <div class="col-12 col-lg-8">
                <div class="cit-card p-0">
                    <ul class="nav nav-tabs px-3 pt-3 border-bottom" role="tablist">
                        <li class="nav-item">
                            <button type="button" class="nav-link @(_ongletActif == "messages" ? "active fw-bold" : "")" @onclick="@(() => _ongletActif = "messages")">
                                @Loc["Ticket.TabMessages"] (@_fiche.Messages.Count)
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link @(_ongletActif == "documents" ? "active fw-bold" : "")" @onclick="@(() => _ongletActif = "documents")">
                                @Loc["Ticket.TabDocuments"] (@_fiche.Documents.Count)
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link @(_ongletActif == "chronologie" ? "active fw-bold" : "")" @onclick="@(() => _ongletActif = "chronologie")">
                                @Loc["Ticket.TabHistory"] (@_fiche.Chronologie.Count)
                            </button>
                        </li>
                    </ul>

                    <div class="p-3">
                        @if (_ongletActif == "messages")
                        {
                            <!-- Liste des messages -->
                            <div class="messages-container mb-3" style="max-height: 400px; overflow-y: auto;">
                                @if (_fiche.Messages.Count == 0)
                                {
                                    <div class="text-muted small py-4 text-center">@Loc["Ticket.NoMessages"]</div>
                                }
                                else
                                {
                                    @foreach (var msg in _fiche.Messages.OrderBy(m => m.DateEnvoiUtc))
                                    {
                                        <div class="card mb-2 @(msg.EstInterne ? "border-warning bg-warning-subtle" : "bg-light border-0")">
                                            <div class="card-body p-2">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="fw-bold small text-dark">
                                                        @msg.AuteurNom
                                                        @if (msg.EstInterne)
                                                        {
                                                            <span class="badge bg-warning text-dark ms-2">@Loc["Ticket.InternalNoteBadge"]</span>
                                                        }
                                                    </span>
                                                    <span class="text-muted u-fs-xs">@msg.DateEnvoiUtc.Horodate()</span>
                                                </div>
                                                <div class="small text-dark">@msg.Contenu</div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            <!-- Zone de saisie d'un nouveau message -->
                            @if (_fiche.PeutAjouterMessage)
                            {
                                <div class="border-top pt-3">
                                    <div class="input-group">
                                        <input type="text" class="form-control" placeholder="@Loc["Ticket.MessagePlaceholder"]" @bind="_nouveauMessageContenu" />
                                        @if (!_estClient)
                                        {
                                            <div class="input-group-text bg-light">
                                                <input class="form-check-input mt-0 me-1" type="checkbox" @bind="_estNoteInterne" id="chkNoteInterne" />
                                                <label class="small mb-0" for="chkNoteInterne">@Loc["Ticket.InternalNoteCheck"]</label>
                                            </div>
                                        }
                                        <button type="button" class="btn btn-primary" @onclick="EnvoyerMessageAsync" disabled="@string.IsNullOrWhiteSpace(_nouveauMessageContenu)">
                                            @Loc["Ticket.Send"]
                                        </button>
                                    </div>

                                    @if (!_estClient && _estNoteInterne)
                                    {
                                        @* MSG-04 — mentionner un collaborateur dans une note interne. Il est
                                           notifié ; MSG-05 : le ticket reste à son opérateur, une mention ne
                                           réaffecte jamais. Le champ n'apparaît que sur une note interne,
                                           puisqu'une mention n'existe que là. *@
                                        <div class="mt-2">
                                            <input type="email" class="form-control form-control-sm"
                                                   placeholder="@Loc["Ticket.MentionPlaceholder"]"
                                                   aria-label="@Loc["Ticket.MentionAria"]"
                                                   @bind="_emailCollaborateur" />
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else if (_ongletActif == "documents")
                        {
                            @if (_fiche.Documents.Count == 0)
                            {
                                <div class="text-muted small py-4 text-center">@Loc["Ticket.NoDocuments"]</div>
                            }
                            else
                            {
                                <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>@Loc["Ticket.ColFileName"]</th>
                                                <th>@Loc["Ticket.ColType"]</th>
                                                <th>@Loc["Ticket.ColSize"]</th>
                                                <th>@Loc["Ticket.ColDepositDate"]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var doc in _pagination1.Appliquer(_fiche.Documents))
                                            {
                                                <tr>
                                                    <td class="fw-semibold">📄 @doc.NomFichier</td>
                                                    <td><span class="badge bg-secondary">@doc.TypeContenu</span></td>
                                                    <td>@((doc.TailleOctets / 1024.0).ToString("0.0")) @Loc["Common.KoUnit"]</td>
                                                    <td class="small text-muted">@doc.DateDepotUtc.Horodate()</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                    <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
                                </div>
                            }
                        }
                        else if (_ongletActif == "chronologie")
                        {
                            <ChronologieTicket Evenements="@_fiche.Chronologie" />
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private readonly EtatPagination _pagination1 = new();

    [Parameter]
    public Guid Id { get; set; }

    private bool _chargement = true;
    private bool _nonAutorise = false;
    private string _messageNonAutorise = string.Empty;
    private string? _erreur;
    private string? _actionFeedback;
    private FicheTicketVue? _fiche;
    private Guid _utilisateurId;
    private bool _estClient;
    private bool _factureDemandee;
    private string _ongletActif = "messages";
    private string _numeroALier = string.Empty;
    private string? _erreurLiaison;
    private string _nouveauMessageContenu = string.Empty;
    private bool _estNoteInterne = false;
    private string _emailCollaborateur = string.Empty;

    // REMÉDIATION POST-AUDIT (post-implementation-audit.md §2.1) : état local pour la clôture avec
    // réponse formalisée (C7-02) et l'évaluation de satisfaction (C7-03).
    private string _reponseFormalisee = string.Empty;
    private int _noteEvaluation;
    private string _commentaireEvaluation = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await RechargerAsync();
    }

    private async Task RechargerAsync()
    {
        _chargement = true;
        _nonAutorise = false;
        _erreur = null;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (!contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["Ticket.LoginRequired"].Value;
                return;
            }

            _utilisateurId = contexte.UtilisateurId;
            _estClient = contexte.Nature == NatureUtilisateur.Client;
            _fiche = await FicheTicketQuery.ExecuterAsync(_utilisateurId, Id);
        }
        catch (AccesRefuseException ex)
        {
            _nonAutorise = true;
            _messageNonAutorise = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task PrendreEnChargeAsync()
    {
        try
        {
            await PrendreEnCharge.ExecuterAsync(_utilisateurId, Id);
            _actionFeedback = Loc["Ticket.MsgTakenCharge"].Value;
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionFeedback = $"{Loc["Collab.ErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
    }

    private async Task MettreEnAttenteClientAsync()
    {
        try
        {
            await AttenteClient.MettreEnAttenteAsync(_utilisateurId, Id, Loc["Ticket.HoldReason"].Value);
            _actionFeedback = Loc["Ticket.MsgOnHold"].Value;
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionFeedback = $"{Loc["Collab.ErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
    }

    private async Task ReprendreApresClientAsync()
    {
        try
        {
            await AttenteClient.RependreApresReponseAsync(Id);
            _actionFeedback = Loc["Ticket.MsgResumed"].Value;
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionFeedback = $"{Loc["Collab.ErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
    }

    /// <summary>
    /// IMP-10 — « Après validation, le client demande la facture depuis son ticket ». La commande
    /// existait, testée, et aucun écran ne l'appelait : le client ne pouvait pas la demander
    /// (audit du 2026-09-04, docs/89).
    /// </summary>
    /// <summary>
    /// SOC-10 — l'agent lie ce ticket à un autre, désigné par son numéro. La commande vérifie
    /// l'habilitation sur la file du ticket courant ; le droit affiché ne fait que masquer une
    /// action, il ne la remplace jamais (Principe VII).
    /// </summary>
    private async Task LierTicketAsync()
    {
        _erreurLiaison = null;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider
                .GetRequiredService<CIT.Plateforme.Application.Tickets.LierTicketsCommand>()
                .ExecuterParNumeroAsync(_utilisateurId, _fiche!.TicketId, _numeroALier);

            _numeroALier = string.Empty;
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            // Erreur locale au panneau : lier un ticket qui n'existe pas ne doit pas remplacer la
            // fiche par un bandeau d'erreur pleine page.
            _erreurLiaison = MessagesUtilisateur.Pour(ex);
        }
    }

    private async Task DemanderFactureAsync()
    {
        try
        {
            // Portée dédiée plutôt qu'injection directe : c'est le patron retenu dans ce projet
            // depuis les collisions de DbContext, et il évite d'imposer une nouvelle dépendance au
            // rendu de la fiche — six tests bUnit la rendent sans avoir à connaître cette commande.
            using var scope = ScopeFactory.CreateScope();
            var demanderFacture = scope.ServiceProvider
                .GetRequiredService<CIT.Plateforme.Application.BillingImport.DemanderFactureCommand>();
            await demanderFacture.ExecuterAsync(_utilisateurId, _fiche!.TicketId);
            _factureDemandee = true;
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _erreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private async Task AnnulerTicketAsync()
    {
        // Rediriger vers l'espace client ou afficher confirmation
        _actionFeedback = Loc["Ticket.MsgCancelSent"].Value;
        await RechargerAsync();
    }

    private async Task EnvoyerMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_nouveauMessageContenu)) return;

        try
        {
            if (_estClient)
            {
                // CONSOLIDATION SÉCURITÉ : l'identité transmise est celle de l'UTILISATEUR, résolue
                // côté serveur — jamais une valeur tirée de la fiche affichée.
                //
                // Ce site passait auparavant `_fiche!.SocieteId`, pour contourner un refus
                // systématique : CloisonnementService comparait l'appelant à Dossier.ClientId, qui
                // porte la société sur les parcours Billing. Le contournement rendait le contrôle
                // tautologique — l'appelant fournissait la valeur comparée — et faisait de la
                // société l'AUTEUR du message, au lieu de la personne (RG-SEC-03, ENT-03).
                //
                // La façade délègue désormais au contrôle central, qui sait résoudre le
                // rattachement société : l'identité réelle est acceptée, et elle seule.
                await PublierMessage.PublierMessageClientAsync(_utilisateurId, Id, _nouveauMessageContenu);
            }
            else
            {
                if (_estNoteInterne && !string.IsNullOrWhiteSpace(_emailCollaborateur))
                {
                    using var scope = ScopeFactory.CreateScope();
                    await scope.ServiceProvider
                        .GetRequiredService<CIT.Plateforme.Application.Messagerie.MentionnerCollaborateurCommand>()
                        .MentionnerParEmailAsync(_utilisateurId, Id, _emailCollaborateur, _nouveauMessageContenu);
                }
                else if (_estNoteInterne)
                {
                    await PublierMessage.PublierNoteInterneAsync(_utilisateurId, Id, _nouveauMessageContenu);
                }
                else
                {
                    await PublierMessage.PublierMessageAgentAsync(_utilisateurId, Id, _nouveauMessageContenu);
                }
            }

            _nouveauMessageContenu = string.Empty;
            _emailCollaborateur = string.Empty;
            _actionFeedback = Loc["Ticket.MsgSent"].Value;
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionFeedback = $"{Loc["Ticket.SendErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
    }

    private async Task ClotureReclamationAsync()
    {
        if (string.IsNullOrWhiteSpace(_reponseFormalisee)) return;

        try
        {
            await ClotureReclamation.ExecuterAsync(new CloturerReclamationRequete(_utilisateurId, Id, _reponseFormalisee));
            _reponseFormalisee = string.Empty;
            _actionFeedback = Loc["Ticket.MsgComplaintClosed"].Value;
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionFeedback = $"{Loc["Collab.ErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
    }

    private async Task EvaluerAsync()
    {
        if (_noteEvaluation is < 1 or > 5) return;

        try
        {
            await EvaluerReclamation.ExecuterAsync(new EvaluerReclamationRequete(_utilisateurId, Id, _noteEvaluation, _commentaireEvaluation));
            _actionFeedback = Loc["Ticket.MsgThanksRating"].Value;
            await RechargerAsync();
        }
        catch (Exception ex)
        {
            _actionFeedback = $"{Loc["Collab.ErrorPrefix"].Value}{MessagesUtilisateur.Pour(ex)}";
        }
    }

    private void RetourArriere()
    {
        if (_estClient)
        {
            Navigation.NavigateTo("/client/demandes");
        }
        else
        {
            Navigation.NavigateTo("/agent/dashboard");
        }
    }
