@page "/tickets/soumettre"
@rendermode InteractiveServer
@inject CreerTicketCommand CreerTicket

<PageTitle>Soumettre une demande — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>📝</span> Soumettre une demande (US1, C-08)
        </h2>
        <div class="cit-page-subtitle">Formulaire technique de création directe de ticket</div>
    </div>
</div>

<div style="max-width: 700px;">
    <div class="cit-card mb-4">
        <EditForm Model="modele" OnValidSubmit="SoumettreAsync" FormName="soumettre-ticket">
            <div class="mb-3">
                <label class="form-label small fw-semibold text-dark" for="client-id">Identifiant client (démonstration)</label>
                <InputText id="client-id" class="form-control font-monospace form-control-sm" @bind-Value="modele.ClientId" />
            </div>
            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                    <label class="form-label small fw-semibold text-dark" for="module">Module</label>
                    <InputText id="module" class="form-control" @bind-Value="modele.Module" />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label small fw-semibold text-dark" for="type">Type de demande</label>
                    <InputText id="type" class="form-control" @bind-Value="modele.TypeDemande" />
                </div>
            </div>
            <div class="mb-4">
                <label class="form-label small fw-semibold text-dark" for="file">Identifiant de la file cible (GUID)</label>
                <InputText id="file" class="form-control font-monospace form-control-sm" @bind-Value="modele.FileCibleId" />
            </div>
            <div class="text-end">
                <button type="submit" class="btn btn-primary px-4 fw-bold">🚀 Soumettre la demande</button>
            </div>
        </EditForm>
    </div>

    @if (numeroCree is not null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2">
            <span class="fs-4">✅</span>
            <div>
                Ticket créé avec succès : <strong class="font-monospace">@numeroCree</strong> (SOC-01 — numéro unique communiqué immédiatement).
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromForm]
    private ModeleSoumission? modeleFormulaire { get; set; }

    private ModeleSoumission modele = new();
    private string? numeroCree;

    protected override void OnInitialized() => modele = modeleFormulaire ?? modele;

    private async Task SoumettreAsync()
    {
        var ticket = await CreerTicket.ExecuterAsync(new CreerTicketRequete(
            Guid.Parse(modele.ClientId),
            modele.Module,
            modele.TypeDemande,
            Guid.Parse(modele.FileCibleId),
            DossierExistantId: null));

        numeroCree = ticket.Numero;
        modele = new ModeleSoumission();
    }

    private sealed class ModeleSoumission
    {
        public string ClientId { get; set; } = Guid.NewGuid().ToString();
        public string Module { get; set; } = "BillingOffice";
        public string TypeDemande { get; set; } = "Import";
        public string FileCibleId { get; set; } = string.Empty;
    }
}
