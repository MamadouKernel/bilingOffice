@* Route distincte de la fiche ticket : /tickets/{id} appartient à FicheTicket.razor. Les deux
   pages déclaraient auparavant la même route, ce qui faisait échouer TOUTE ouverture de ticket
   avec une AmbiguousMatchException. *@
@page "/tickets/{TicketId:guid}/administration"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Administration
@using CIT.Plateforme.Application.BillingImport
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Supervision
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ListerFilesQuery ListerFiles
@inject VueChargeQuery VueCharge
@inject TransfererTicketCommand Transferer
@inject ReaffecterTicketCommand Reaffecter
@inject AttenteClientCommand AttenteClient
@inject AnnulerTicketCommand Annuler
@inject CloturerTicketCommand Cloturer
@inject ReouvrirTicketCommand Reouvrir
@inject DeclarerFinalisationPresentielleCommand DeclarerFinalisationPresentielle

<PageTitle>@Loc["TicketAct.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>⚙️</span> @Loc["TicketAct.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["TicketAct.Subtitle"]</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="@($"/tickets/{TicketId}")" class="btn btn-outline-secondary btn-sm">@Loc["TicketAct.BtnRevenir"]</a>
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["TicketAct.Loading"]" />
}
else if (_nonAutorise)
{
    <PermissionDenied Message="@_messageNonAutorise" />
}
else
{
    @if (message is not null)
    {
        <div class="alert @(erreur ? "alert-danger" : "alert-success") mb-4">@message</div>
    }

    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-6">
            <div class="cit-card h-100">
                <h6 class="fw-bold text-dark mb-3">@Loc["TicketAct.TransfertTitle"]</h6>
                @if (_files is null || _files.Count == 0)
                {
                    <p class="text-muted small mb-0">@Loc["TicketAct.TransfertUnavailable"]</p>
                }
                else
                {
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-dark" for="file-cible">@Loc["TicketAct.LblFileDest"]</label>
                            <select id="file-cible" class="form-select form-select-sm" @bind="_fileCible">
                                @foreach (var file in _files)
                                {
                                    <option value="@file.Id">@Loc.File(file.Nom) — @file.Module</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-dark" for="motif-transfert">@Loc["TicketAct.LblMotifTransfert"]</label>
                            <input id="motif-transfert" class="form-control form-control-sm" @bind="motifTransfert" />
                        </div>
                        <div class="col-12 text-end"><button type="button" class="btn btn-primary btn-sm" @onclick="TransfererAsync">@Loc["TicketAct.BtnTransferer"]</button></div>
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="cit-card h-100">
                <h6 class="fw-bold text-dark mb-3">@Loc["TicketAct.ReaffTitle"]</h6>
                @if (_operateurs is null || _operateurs.Count == 0)
                {
                    <p class="text-muted small mb-0">@Loc["TicketAct.ReaffUnavailable"]</p>
                }
                else
                {
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-dark" for="operateur">@Loc["TicketAct.LblNouvelOp"]</label>
                            <select id="operateur" class="form-select form-select-sm" @bind="_nouvelOperateur">
                                @foreach (var operateur in _operateurs)
                                {
                                    <option value="@operateur.OperateurId">
                                        @(string.IsNullOrWhiteSpace(operateur.NomOperateur) ? Loc["TicketAct.OperateurNonId"].Value : operateur.NomOperateur)
                                        @Loc["TicketAct.EnCoursSuffix", operateur.TicketsEnCours]
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-12 text-end pt-2"><button type="button" class="btn btn-secondary btn-sm" @onclick="ReaffecterAsync">@Loc["TicketAct.BtnReaffecter"]</button></div>
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="cit-card h-100">
                <h6 class="fw-bold text-dark mb-3">@Loc["TicketAct.AttenteTitle"]</h6>
                <div class="row g-2">
                    <div class="col-12">
                        <label class="form-label small fw-semibold text-dark" for="motif-attente">@Loc["TicketAct.LblComplement"]</label>
                        <input id="motif-attente" class="form-control form-control-sm" @bind="motifAttente" />
                    </div>
                    <div class="col-12 d-flex justify-content-end gap-2 pt-2">
                        <button type="button" class="btn btn-warning btn-sm" @onclick="MettreEnAttenteAsync">@Loc["TicketAct.BtnDemanderComplement"]</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RependreAsync">@Loc["TicketAct.BtnReprendre"]</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="cit-card h-100">
                <h6 class="fw-bold text-dark mb-3">@Loc["TicketAct.CycleTitle"]</h6>
                <div class="row g-2">
                    <div class="col-12">
                        <label class="form-label small fw-semibold text-dark" for="motif-cycle">@Loc["TicketAct.LblMotifAction"]</label>
                        <input id="motif-cycle" class="form-control form-control-sm" @bind="motifCycleDeVie" />
                    </div>
                    <div class="col-12 d-flex justify-content-end gap-2 pt-2 flex-wrap">
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="DemanderAnnulation">@Loc["TicketAct.BtnAnnuler"]</button>
                        <button type="button" class="btn btn-success btn-sm" @onclick="DemanderCloture">@Loc["TicketAct.BtnCloturer"]</button>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="RouvrirAsync">@Loc["TicketAct.BtnRouvrir"]</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="cit-card bg-light">
                <h6 class="fw-bold text-dark mb-2">@Loc["TicketAct.PresentielTitle"]</h6>
                <p class="text-muted small mb-3">
                    @Loc["TicketAct.PresentielDesc"]
                </p>
                <div>
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="DeclarerFinalisationPresentielleAsync">@Loc["TicketAct.BtnDeclarerPresentiel"]</button>
                </div>
            </div>
        </div>
    </div>
}

@* AM-03 (Stratégie B) — seules les transitions IRRÉVERSIBLES ou ENGAGEANTES sont confirmées :
   l'annulation (destructive) et la clôture (archivage automatique, irréversible). Les actions
   réversibles du cycle de vie (mise en attente, reprise, réouverture, réaffectation) ne le sont
   pas — une confirmation sur chaque bouton banaliserait le geste. La modale n'est jamais une
   frontière de sécurité : chaque commande revérifie identité, habilitation et état côté serveur. *@
<ModaleConfirmation EstOuvert="_confirmationOuverte"
                    Titre="@_confirmationTitre"
                    Message="@_confirmationMessage"
                    BoutonConfirmerLibelle="@_confirmationLibelle"
                    BoutonAnnulerLibelle="@Loc["TicketAct.ModaleRetour"].Value"
                    BoutonConfirmerClass="@_confirmationClass"
                    Desactive="_confirmationEnCours"
                    OnConfirmer="ConfirmerActionAsync"
                    OnAnnuler="AnnulerConfirmation" />

@code {
    [Parameter]
    public Guid TicketId { get; set; }

    private bool _chargement = true;
    private bool _nonAutorise;
    private string _messageNonAutorise = string.Empty;

    private Guid _initiateurId;
    private IReadOnlyList<FileAdministrable>? _files;
    private IReadOnlyList<VueOperateur>? _operateurs;
    private Guid _fileCible;
    private Guid _nouvelOperateur;

    private string motifTransfert = string.Empty;
    private string motifAttente = string.Empty;
    private string motifCycleDeVie = string.Empty;
    private string? message;
    private bool erreur;

    // AM-03 — état de la modale de confirmation partagée. Une seule instance sert toutes les
    // actions engageantes : l'action à exécuter est mémorisée dans _actionConfirmee.
    private bool _confirmationOuverte;
    private bool _confirmationEnCours;
    private string _confirmationTitre = string.Empty;
    private string _confirmationMessage = string.Empty;
    private string _confirmationLibelle = "Confirmer";
    private string _confirmationClass = "btn-danger";
    private Func<Task>? _actionConfirmee;

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    // L'initiateur de chaque action est l'utilisateur authentifié : aucun identifiant n'est saisi,
    // et chaque commande revérifie l'habilitation côté serveur sur la file courante du ticket.
    private async Task ChargerAsync()
    {
        _chargement = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            if (contexte is null || !contexte.EstAuthentifie)
            {
                _nonAutorise = true;
                _messageNonAutorise = Loc["TicketAct.LoginRequis"].Value;
                return;
            }

            _initiateurId = contexte.UtilisateurId;

            // Chaque liste est chargée indépendamment : ne pas être habilité au transfert ne doit
            // pas masquer les actions de cycle de vie, et réciproquement.
            _files = await ChargerSansEchecAsync(() => ListerFiles.ListerPourTransfertAsync(_initiateurId));
            _operateurs = await ChargerSansEchecAsync(() => VueCharge.ExecuterAsync(_initiateurId));

            if (_files is { Count: > 0 }) _fileCible = _files[0].Id;
            if (_operateurs is { Count: > 0 }) _nouvelOperateur = _operateurs[0].OperateurId;

            _nonAutorise = false;
        }
        finally
        {
            _chargement = false;
        }
    }

    private static async Task<IReadOnlyList<T>?> ChargerSansEchecAsync<T>(Func<Task<IReadOnlyList<T>>> chargement)
    {
        try
        {
            return await chargement();
        }
        catch (AccesRefuseException)
        {
            return null;
        }
    }

    private async Task MettreEnAttenteAsync() => await ExecuterAvecGestionErreurAsync(
        async () => await AttenteClient.MettreEnAttenteAsync(_initiateurId, TicketId, motifAttente),
        Loc["TicketAct.SuccessAttente"].Value);

    private async Task RependreAsync() => await ExecuterAvecGestionErreurAsync(
        async () => await AttenteClient.RependreApresReponseAsync(TicketId),
        Loc["TicketAct.SuccessReprise"].Value);

    // REMÉDIATION P1-01 : l'écran passait ici `etapeBloquanteAtteinte: false` en dur, ce qui
    // désactivait la garde CYC-01 côté serveur. La décision appartient désormais à la commande,
    // qui la prend seule — l'interface n'a plus rien à en dire.
    private async Task AnnulerAsync() => await ExecuterAvecGestionErreurAsync(
        async () => await Annuler.AnnulerLibrementAsync(_initiateurId, TicketId, motifCycleDeVie),
        Loc["TicketAct.SuccessAnnule"].Value);

    private async Task ClorerAsync() => await ExecuterAvecGestionErreurAsync(
        async () => await Cloturer.ExecuterAsync(_initiateurId, TicketId),
        Loc["TicketAct.SuccessCloture"].Value);

    // AM-03 — les deux actions irréversibles ouvrent d'abord la modale ; l'exécution réelle
    // (AnnulerAsync / ClorerAsync) reste inchangée et n'est déclenchée qu'après confirmation.
    private void DemanderAnnulation() => DemanderConfirmation(
        Loc["TicketAct.ConfAnnulerTitre"].Value,
        Loc["TicketAct.ConfAnnulerMsg"].Value,
        Loc["TicketAct.ConfAnnulerBtn"].Value,
        "btn-danger",
        AnnulerAsync);

    private void DemanderCloture() => DemanderConfirmation(
        Loc["TicketAct.ConfCloturerTitre"].Value,
        Loc["TicketAct.ConfCloturerMsg"].Value,
        Loc["TicketAct.ConfCloturerBtn"].Value,
        "btn-success",
        ClorerAsync);

    private void DemanderConfirmation(string titre, string message, string libelleConfirmer, string cssConfirmer, Func<Task> action)
    {
        _confirmationTitre = titre;
        _confirmationMessage = message;
        _confirmationLibelle = libelleConfirmer;
        _confirmationClass = cssConfirmer;
        _actionConfirmee = action;
        _confirmationOuverte = true;
    }

    private void AnnulerConfirmation()
    {
        // Neutralisé pendant le traitement : on ne referme pas une action déjà partie.
        if (_confirmationEnCours)
        {
            return;
        }

        _confirmationOuverte = false;
        _actionConfirmee = null;
    }

    private async Task ConfirmerActionAsync()
    {
        // Protection anti double-validation : la modale désactive déjà ses boutons via
        // _confirmationEnCours, cette garde couvre en plus les rendus concurrents.
        if (_actionConfirmee is null || _confirmationEnCours)
        {
            return;
        }

        _confirmationEnCours = true;
        try
        {
            await _actionConfirmee();
        }
        finally
        {
            _confirmationEnCours = false;
            _confirmationOuverte = false;
            _actionConfirmee = null;
        }
    }

    private async Task RouvrirAsync() => await ExecuterAvecGestionErreurAsync(
        async () => await Reouvrir.RouvrirAsync(_initiateurId, TicketId, motifCycleDeVie),
        Loc["TicketAct.SuccessRouvert"].Value);

    private async Task DeclarerFinalisationPresentielleAsync() => await ExecuterAvecGestionErreurAsync(
        async () => await DeclarerFinalisationPresentielle.ExecuterAsync(_initiateurId, TicketId),
        Loc["TicketAct.SuccessPresentiel"].Value);

    private async Task TransfererAsync() => await ExecuterAvecGestionErreurAsync(
        async () => await Transferer.ExecuterAsync(_initiateurId, TicketId, _fileCible, motifTransfert),
        Loc["TicketAct.SuccessTransfert"].Value);

    private async Task ReaffecterAsync() => await ExecuterAvecGestionErreurAsync(
        async () => await Reaffecter.ExecuterAsync(_initiateurId, TicketId, _nouvelOperateur),
        Loc["TicketAct.SuccessReaffecte"].Value);

    private async Task ExecuterAvecGestionErreurAsync(Func<Task> action, string messageSucces)
    {
        try
        {
            await action();
            message = messageSucces;
            erreur = false;
        }
        catch (Exception ex)
        {
            message = MessagesUtilisateur.Pour(ex);
            erreur = true;
        }
    }
}
