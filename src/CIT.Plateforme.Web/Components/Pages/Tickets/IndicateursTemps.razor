@page "/tickets/{TicketId:guid}/temps"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using CIT.Plateforme.Domain.SuiviTemps
@using Microsoft.Extensions.DependencyInjection
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IServiceScopeFactory ScopeFactory
@inject IContexteUtilisateurWeb ContexteService

<PageTitle>@Loc["TempsSla.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>⏱️</span> @Loc["TempsSla.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["TempsSla.SubtitlePrefix"]<span class="font-monospace text-primary">@TicketId</span></div>
    </div>
</div>

@if (_accesRefuse)
{
    <PermissionDenied Message="@Loc["TempsSla.AccessDenied"]" />
}
else if (mesure is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="cit-stat-card border-start border-4 border-primary">
                <div class="cit-stat-icon bg-primary-subtle text-primary">⏳</div>
                <div>
                    <div class="cit-stat-label">@Loc["TempsSla.AttenteInitiale"]</div>
                    <div class="cit-stat-value text-primary font-monospace">@mesure.TempsAttente.ToString(@"hh\:mm\:ss")</div>
                    <div class="small text-muted">@Loc["TempsSla.AttenteInitialeSub"]</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="cit-stat-card border-start border-4 border-info">
                <div class="cit-stat-icon bg-info-subtle text-info">⚙️</div>
                <div>
                    <div class="cit-stat-label">@Loc["TempsSla.Traitement"]</div>
                    <div class="cit-stat-value text-info font-monospace">@mesure.TempsTraitement.ToString(@"hh\:mm\:ss")</div>
                    <div class="small text-muted">@Loc["TempsSla.TraitementSub"]</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="cit-stat-card border-start border-4 border-warning">
                <div class="cit-stat-icon bg-warning-subtle text-warning">⏸️</div>
                <div>
                    <div class="cit-stat-label">@Loc["TempsSla.AttenteClient"]</div>
                    <div class="cit-stat-value text-warning font-monospace">@mesure.TempsAttenteClient.ToString(@"hh\:mm\:ss")</div>
                    <div class="small text-muted">@Loc["TempsSla.AttenteClientSub"]</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-6">
            <div class="cit-stat-card border-start border-4 border-secondary">
                <div class="cit-stat-icon bg-secondary-subtle text-secondary">🏢</div>
                <div>
                    <div class="cit-stat-label">@Loc["TempsSla.InterneCit"]</div>
                    <div class="cit-stat-value text-dark font-monospace">@mesure.TempsInterneCit.ToString(@"hh\:mm\:ss")</div>
                    <div class="small text-muted">@Loc["TempsSla.InterneCitSub"]</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-6">
            <div class="cit-stat-card border-start border-4 border-success">
                <div class="cit-stat-icon bg-success-subtle text-success">🏁</div>
                <div>
                    <div class="cit-stat-label">@Loc["TempsSla.Total"]</div>
                    <div class="cit-stat-value text-success font-monospace">@mesure.TempsTotal.ToString(@"hh\:mm\:ss")</div>
                    <div class="small text-muted">@Loc["TempsSla.TotalSub"]</div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid TicketId { get; set; }

    private MesureTemps? mesure;
    private bool _accesRefuse;

    protected override async Task OnInitializedAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<CIT.Plateforme.Infrastructure.Persistence.PlateformeDbContext>();
        var ticket = await db.Tickets.FindAsync(TicketId);

        // VARIANTE DU P0 CORRIGÉE ICI : cette page lisait le ticket désigné par la route et
        // affichait ses temps SANS aucun contrôle d'accès — n'importe quel utilisateur
        // authentifié pouvait consulter les délais d'un ticket tiers en changeant l'identifiant.
        // La décision est déléguée au contrôle central, comme sur toute autre ressource.
        var contexte = await ContexteService.ObtenirContexteAsync();
        var controleAcces = scope.ServiceProvider.GetRequiredService<ControleAccesRessourceService>();

        if (ticket is not null && !await controleAcces.PeutConsulterLeTicketAsync(contexte.UtilisateurId, ticket))
        {
            _accesRefuse = true;
            return;
        }

        if (ticket is not null)
        {
            // TPS-03 : le temps total court depuis la CRÉATION, non depuis l'arrivée dans la file
            // courante — celle-ci est réinitialisée à chaque transfert.
            mesure = MesureTemps.Calculer(
                ticket.DateCreationUtc,
                ticket.DateArriveeEnFileUtc,
                ticket.DatePriseEnChargeUtc,
                ticket.DateClotureUtc ?? DateTime.UtcNow,
                ticket.DureeAttenteClienteCumulee);
        }
    }
}
