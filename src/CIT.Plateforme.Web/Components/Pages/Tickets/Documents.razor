@page "/tickets/{TicketId:guid}/documents"
@rendermode InteractiveServer
@using CIT.Plateforme.Application.Documents
@using CIT.Plateforme.Application.Abstractions
@using CIT.Plateforme.Domain.Documents
@inject DeposerDocumentCommand DeposerDocument
@inject IDocumentRepository DepotDocuments

<PageTitle>Documents du ticket — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title">
            <span>📁</span> Documents du ticket
        </h2>
        <div class="cit-page-subtitle">Formats acceptés : PDF, JPG, PNG — 10 Mo maximum par fichier (Règles dynamiques par étape SOC-07, PC-08)</div>
    </div>
</div>

<div class="cit-card mb-4">
    <h6 class="fw-bold text-dark mb-3">Déposer un nouveau document</h6>
    <div class="row g-2 align-items-center">
        <div class="col-12 col-md-3">
            <input class="form-control form-control-sm" placeholder="Votre identifiant" @bind="deposantId" />
        </div>
        <div class="col-12 col-md-3">
            <select class="form-select form-select-sm" @bind="natureDeposant">
                <option value="Client">Client (propriétaire du ticket)</option>
                <option value="Agent">Agent (habilité sur la file)</option>
            </select>
        </div>
        <div class="col-12 col-md-6">
            <InputFile class="form-control form-control-sm" OnChange="DeposerAsync" />
        </div>
    </div>
</div>

@if (documents is not null)
{
    <div class="cit-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nom du fichier</th>
                        <th>Taille</th>
                        <th>Analyse antivirus</th>
                        <th>Déposé le (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var document in documents)
                    {
                        <tr>
                            <td class="fw-semibold text-dark">📄 @document.NomFichier</td>
                            <td class="small text-muted font-monospace">@((document.TailleOctets / 1024.0).ToString("0.0")) Ko</td>
                            <td><span class="badge bg-success-subtle text-success">@document.StatutAntivirus</span></td>
                            <td class="small text-muted font-monospace">@document.DateDepotUtc.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (message is not null)
{
    <div class="alert @(erreur ? "alert-danger" : "alert-success") mb-4">@message</div>
}

@code {
    [Parameter]
    public Guid TicketId { get; set; }

    private string deposantId = string.Empty;
    private string natureDeposant = "Client";
    private IReadOnlyList<Document>? documents;
    private string? message;
    private bool erreur;

    protected override async Task OnInitializedAsync() => documents = await DepotDocuments.ListerParTicketAsync(TicketId);

    private static readonly ReglesDepotDocument ReglesDemonstration = new(
        ExtensionsAutorisees: ["pdf", "jpg", "jpeg", "png"], TailleMaxOctets: 10 * 1024 * 1024);

    private async Task DeposerAsync(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        try
        {
            await using var flux = e.File.OpenReadStream(ReglesDemonstration.TailleMaxOctets);
            await using var memoire = new MemoryStream();
            await flux.CopyToAsync(memoire);

            if (natureDeposant == "Agent")
            {
                await DeposerDocument.DeposerPourAgentAsync(
                    Guid.Parse(deposantId), TicketId, e.File.Name, e.File.ContentType, memoire, memoire.Length, ReglesDemonstration);
            }
            else
            {
                await DeposerDocument.DeposerPourClientAsync(
                    Guid.Parse(deposantId), TicketId, e.File.Name, e.File.ContentType, memoire, memoire.Length, ReglesDemonstration);
            }

            documents = await DepotDocuments.ListerParTicketAsync(TicketId);
            message = "Document déposé et analysé.";
            erreur = false;
        }
        catch (Exception ex)
        {
            message = ex.Message;
            erreur = true;
        }
    }
}
