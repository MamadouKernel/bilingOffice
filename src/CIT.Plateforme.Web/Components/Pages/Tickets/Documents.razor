@page "/tickets/{TicketId:guid}/documents"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Documents
@using CIT.Plateforme.Application.Securite
@using CIT.Plateforme.Application.Tickets
@using CIT.Plateforme.Domain.Documents
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject IServiceScopeFactory ScopeFactory
@inject Microsoft.JSInterop.IJSRuntime Js

@*
    DÉFAUT CORRIGÉ (audit du 2026-09-04, docs/89) — cet écran était un prototype resté routable.
    Il cumulait quatre défauts :

      1. aucun [Authorize] et aucun contrôle en page : connaître un identifiant de ticket
         suffisait pour lister ses documents ;
      2. IDocumentRepository injecté DIRECTEMENT, ce qui court-circuitait la couche applicative
         où vit le cloisonnement (Principe VII) ;
      3. l'identité du déposant était SAISIE DANS UN CHAMP. Le contrôle d'habilitation de la
         commande portait donc sur une valeur choisie par l'appelant ;
      4. les règles de dépôt étaient un objet nommé « ReglesDemonstration ».

    La lecture passe désormais par ObtenirFicheTicketQuery, qui applique le cloisonnement et lève
    AccesRefuseException, et l'identité vient du contexte authentifié.
*@

<PageTitle>@Loc["Docs.PageTitle"]</PageTitle>

<div class="cit-page-header mb-4">
    <h1 class="cit-page-title fw-bold text-dark mb-1">@Loc["Docs.Title"]</h1>
    <div class="cit-page-subtitle text-muted">
        @string.Format(Loc["Docs.Subtitle"].Value, TailleMaxMo)
    </div>
</div>

@if (_chargement)
{
    <IndicateurChargement Message="@Loc["Docs.Loading"]" />
}
else if (_refuse)
{
    <PermissionDenied Message="@_messageRefus" />
}
else
{
    @if (_message is not null)
    {
        <div class="alert @(_erreur ? "alert-danger" : "alert-success") border-0 mb-4 rounded-3 p-3" role="alert">
            @_message
        </div>
    }

    <div class="cit-card p-4 mb-4 border-0 shadow-sm">
        <h4 class="fw-bold text-dark fs-5 mb-3">@Loc["Docs.UploadTitle"]</h4>
        @* IMP-01 : la catégorie de pièce n'a de sens que sur le parcours Billing Import — les
           autres modules (réclamations, enrôlement, etc.) n'affichent pas le sélecteur. *@
        @if (_moduleTicket is "BillingImport")
        {
            <div class="mb-2">
                <label class="form-label small fw-semibold" for="categorie-document">@Loc["Docs.CategoryLabel"]</label>
                <select id="categorie-document" class="form-select form-select-sm" style="max-width:320px"
                        @bind="_categorieSelectionnee">
                    <option value="">@Loc["Docs.CategoryNone"]</option>
                    <option value="@CategorieDocumentBillingImport.DeclarationDouane">@Loc["Docs.CategoryDeclarationDouane"]</option>
                    <option value="@CategorieDocumentBillingImport.CopieDuBl">@Loc["Docs.CategoryCopieDuBl"]</option>
                    <option value="@CategorieDocumentBillingImport.AutresPieces">@Loc["Docs.CategoryAutresPieces"]</option>
                </select>
            </div>
        }
        <InputFile OnChange="DeposerAsync" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.xlsx" />
        <div class="form-text small">
            @string.Format(Loc["Docs.UploadHint"].Value, _nomAffiche)
        </div>
    </div>

    @if (_documents is null || _documents.Count == 0)
    {
        <div class="cit-card p-5 text-center text-muted border-0 shadow-sm">
            <div class="fs-1 mb-2" aria-hidden="true">📁</div>
            <div class="fw-semibold">@Loc["Docs.EmptyTitle"]</div>
            <div class="small">@Loc["Docs.EmptyHint"]</div>
        </div>
    }
    else
    {
        <div class="cit-card border-0 shadow-sm overflow-hidden">
            <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <caption class="visually-hidden">@Loc["Docs.TableCaption"]</caption>
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="small fw-bold">@Loc["Docs.ColFile"]</th>
                            <th scope="col" class="small fw-bold">@Loc["FicheAvoirExo.DocDepositedOn"]</th>
                            <th scope="col" class="small fw-bold">@Loc["Docs.ColAntivirus"]</th>
                            <th scope="col" class="small fw-bold text-end"><span class="visually-hidden">@Loc["Docs.DownloadHidden"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in _pagination1.Appliquer(_documents))
                        {
                            <tr>
                                <td class="fw-semibold">@doc.NomFichier</td>
                                <td>@doc.DateDepotUtc.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@doc.StatutAntivirus</td>
                                <td class="text-end">
                                    @if (doc.StatutAntivirus == StatutAnalyseAntivirus.Sain)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                @onclick="() => TelechargerAsync(doc)"
                                                disabled="@(_telechargementEnCours == doc.Id)">
                                            @(_telechargementEnCours == doc.Id ? Loc["Docs.Preparing"].Value : Loc["Docs.Download"].Value)
                                        </button>
                                    }
                                    else
                                    {
                                        @* SEC-07/SEC-12 : tant que l'analyse n'a pas conclu, le fichier n'est pas
                                           téléchargeable. Le dire ici évite un bouton qui échoue sans expliquer. *@
                                        <span class="small text-muted">
                                            @(doc.StatutAntivirus == StatutAnalyseAntivirus.Infecte
                                                ? Loc["Docs.BlockedInfected"].Value
                                                : Loc["Docs.Scanning"].Value)
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    [Parameter]
    public Guid TicketId { get; set; }

    private IReadOnlyList<DocumentItemVue>? _documents;
    private Guid _appelantId;
    private string _nomAffiche = string.Empty;
    private bool _estClient;
    private bool _chargement = true;
    private bool _refuse;
    private string _messageRefus = string.Empty;
    private string? _message;
    private bool _erreur;
    private Guid? _telechargementEnCours;
    private string? _moduleTicket;
    private string _categorieSelectionnee = string.Empty;

    private const long TailleMax = ValidateurFichierDocument.TailleMaxDefaut;
    private static readonly string[] Extensions = [".pdf", ".jpg", ".jpeg", ".png", ".xlsx"];
    private static int TailleMaxMo => (int)(TailleMax / 1024 / 1024);

    protected override async Task OnInitializedAsync()
    {
        var contexte = await ContexteService.ObtenirContexteAsync();

        if (!contexte.EstAuthentifie)
        {
            _refuse = true;
            _messageRefus = Loc["Docs.AccessDenied"].Value;
            _chargement = false;
            return;
        }

        _appelantId = contexte.UtilisateurId;
        _nomAffiche = contexte.NomAffiche;
        _estClient = contexte.Nature == CIT.Plateforme.Domain.Securite.NatureUtilisateur.Client;

        await ChargerAsync();
    }

    /// <summary>
    /// La liste passe par <c>ObtenirFicheTicketQuery</c> et NON par le repository : c'est cette
    /// requête qui applique le cloisonnement (un client ne voit que les tickets de sa société, et
    /// selon son droit de consultation, que ses propres demandes).
    /// </summary>
    private async Task ChargerAsync()
    {
        _chargement = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var fiche = await scope.ServiceProvider
                .GetRequiredService<ObtenirFicheTicketQuery>()
                .ExecuterAsync(_appelantId, TicketId);

            _documents = fiche.Documents;
            _moduleTicket = fiche.Module;
            _refuse = false;
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargement = false;
        }
    }

    /// <summary>
    /// SOC-02 — les documents se déposaient et se listaient ; ils ne se téléchargeaient pas.
    /// <c>TelechargerDocumentQuery</c> existait, testée, et aucun écran ne l'appelait.
    ///
    /// SEC-12 exige un contrôle d'identité et d'habilitation à CHAQUE accès, pas seulement au
    /// dépôt : la voie agent et la voie client ne portent pas les mêmes contrôles, et la nature de
    /// l'utilisateur authentifié — jamais un champ de saisie — décide de celle qu'on emprunte.
    /// </summary>
    private async Task TelechargerAsync(DocumentItemVue doc)
    {
        _message = null;
        _telechargementEnCours = doc.Id;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var telecharger = scope.ServiceProvider.GetRequiredService<TelechargerDocumentQuery>();

            await using var flux = _estClient
                ? await telecharger.TelechargerPourClientAsync(_appelantId, doc.Id)
                : await telecharger.TelechargerPourAgentAsync(_appelantId, doc.Id);

            await using var memoire = new MemoryStream();
            await flux.CopyToAsync(memoire);

            await Js.InvokeVoidAsync(
                "telechargerFichier", doc.NomFichier, doc.TypeContenu, Convert.ToBase64String(memoire.ToArray()));
        }
        catch (AccesRefuseException ex)
        {
            _erreur = true;
            _message = ex.Message;
        }
        catch (DocumentNonAccessibleException ex)
        {
            _erreur = true;
            _message = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _telechargementEnCours = null;
        }
    }

    private async Task DeposerAsync(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        _message = null;
        try
        {
            await using var flux = e.File.OpenReadStream(TailleMax);
            await using var memoire = new MemoryStream();
            await flux.CopyToAsync(memoire);

            using var scope = ScopeFactory.CreateScope();
            var deposer = scope.ServiceProvider.GetRequiredService<DeposerDocumentCommand>();
            var regles = new CIT.Plateforme.Domain.Documents.ReglesDepotDocument(Extensions, TailleMax);

            // IMP-01 : catégorie applicable uniquement sur le parcours Billing Import — ailleurs,
            // le sélecteur n'est pas affiché et la catégorie reste toujours null.
            CategorieDocumentBillingImport? categorie = _moduleTicket is "BillingImport" && !string.IsNullOrEmpty(_categorieSelectionnee)
                ? Enum.Parse<CategorieDocumentBillingImport>(_categorieSelectionnee)
                : null;

            // L'identité vient du contexte authentifié, jamais d'un champ de saisie. La nature
            // décide de la voie : les deux commandes ne portent pas les mêmes habilitations.
            if (_estClient)
            {
                await deposer.DeposerPourClientAsync(
                    _appelantId, TicketId, e.File.Name, e.File.ContentType, memoire, memoire.Length, regles, categorie);
            }
            else
            {
                await deposer.DeposerPourAgentAsync(
                    _appelantId, TicketId, e.File.Name, e.File.ContentType, memoire, memoire.Length, regles, categorie);
            }

            _message = Loc["Docs.Deposited"].Value;
            _erreur = false;
            _categorieSelectionnee = string.Empty;
            await ChargerAsync();
        }
        catch (AccesRefuseException ex)
        {
            _refuse = true;
            _messageRefus = ex.Message;
        }
        catch (Exception ex)
        {
            _erreur = true;
            _message = MessagesUtilisateur.Pour(ex);
        }
    }
}
