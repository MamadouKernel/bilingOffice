@page "/rendez-vous/prendre/{TicketId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Abstractions
@using CIT.Plateforme.Application.Guichet
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject CIT.Plateforme.Application.Tickets.ObtenirFicheTicketQuery FicheTicket
@inject ListerCreneauxDisponiblesQuery ListerCreneauxQuery
@inject ReserverRendezVousCommand ReserverCommand
@inject NavigationManager Navigation

<PageTitle>@Loc["PrdRdv.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>📅</span> @Loc["PrdRdv.Title"]
        </h1>
        <div class="cit-page-subtitle">
            @Loc["PrdRdv.Subtitle"]
        </div>
    </div>
    <div>
        <a href="/rendez-vous/mes-rendez-vous" class="btn btn-outline-secondary">
            @Loc["PrdRdv.MyAppointments"]
        </a>
    </div>
</div>

@if (_chargementInitial)
{
    <IndicateurChargement Message="@Loc["PrdRdv.LoadingTicket"]" />
}
else if (_ticket is null)
{
    <div class="alert alert-danger" role="alert">
        <strong>@Loc["PrdRdv.ErrorLabel"]</strong> @Loc["PrdRdv.TicketNotFound"]
    </div>
}
else if (_ticket.Statut is StatutTicket.Cloture or StatutTicket.Annule)
{
    <div class="alert alert-warning" role="alert">
        <strong>@Loc["PrdRdv.WarnLabel"]</strong> @Loc["PrdRdv.ClosedTicketWarn"]
    </div>
}
else
{
    @if (_messageErreur is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @_messageErreur
            <button type="button" class="btn-close" @onclick="() => _messageErreur = null"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-bold">@Loc["PrdRdv.TicketDetails"]</h6>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <span class="text-muted small">@Loc["PrdRdv.FieldNumber"]</span>
                        <div class="fw-bold">@_ticket.NumeroTicket</div>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small">@Loc["PrdRdv.FieldModule"]</span>
                        <div><span class="badge bg-secondary">@_ticket.Module</span></div>
                    </div>
                    @if (!string.IsNullOrEmpty(_ticket.NumeroBl))
                    {
                        <div class="mb-2">
                            <span class="text-muted small">@Loc["PrdRdv.FieldBl"]</span>
                            <div class="fw-bold text-primary">@_ticket.NumeroBl</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_ticket.NumeroBooking))
                    {
                        <div class="mb-2">
                            <span class="text-muted small">@Loc["PrdRdv.FieldBooking"]</span>
                            <div class="fw-bold text-primary">@_ticket.NumeroBooking</div>
                        </div>
                    }
                    <div class="mb-2">
                        <span class="text-muted small">@Loc["PrdRdv.FieldStatus"]</span>
                        <div><span class="badge bg-info text-dark">@_ticket.Statut</span></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0 text-primary">@Loc["PrdRdv.Step1"]</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3 mb-4 align-items-center">
                        <div class="col-md-6">
                            <label for="date-du-rendez-vous" class="form-label fw-bold">@Loc["PrdRdv.DateLabel"]</label>
                            <input id="date-du-rendez-vous" type="date" class="form-control form-control-lg" min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   value="@_dateSelectionnee.ToString("yyyy-MM-dd")" @onchange="ChangerDateAsync" />
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <button class="btn btn-outline-primary" @onclick="() => ChargerCreneauxAsync()">
                                @Loc["PrdRdv.RefreshSlots"]
                            </button>
                        </div>
                    </div>

                    @if (_chargementCreneaux)
                    {
                        <IndicateurChargement Message="@Loc["Rdv.SearchingSlots"]" />
                    }
                    else if (_creneaux.Count == 0)
                    {
                        <div class="alert alert-info">
                            @Loc["PrdRdv.NoSlotsWorkday"]
                        </div>
                    }
                    else
                    {
                        <label class="form-label fw-bold">@Loc["PrdRdv.SlotsAvailable"]</label>
                        <div class="row g-2 mb-4">
                            @foreach (var c in _creneaux)
                            {
                                var disponible = !c.EstComplet;
                                <div class="col-md-4 col-sm-6">
                                    <button type="button"
                                            class="btn w-100 p-2 text-center @(disponible ? (_heureSelectionnee == c.HeureDebut ? "btn-primary" : "btn-outline-primary") : "btn-light disabled")"
                                            @onclick="() => ChoisirHeure(c.HeureDebut)" disabled="@(!disponible)">
                                        <div class="fw-bold">@c.HeureDebut.ToString(@"hh\:mm") - @c.HeureFin.ToString(@"hh\:mm")</div>
                                        <small class="d-block @(disponible ? "text-success" : "text-danger")">
                                            @(disponible ? string.Format(Loc["Rdv.PlacesLeft"].Value, c.PlacesRestantes) : Loc["Rdv.Full"].Value)
                                        </small>
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    <hr />

                    <h5 class="mb-3 text-primary">@Loc["PrdRdv.Step2"]</h5>
                    <div class="mb-3">
                        <label for="motif-du-deplacement-physique" class="form-label fw-bold">@Loc["PrdRdv.MotifLabel"]</label>
                        <select id="motif-du-deplacement-physique" class="form-select" @bind="_motifSelectionne">
                            <option value="Paiement Caisse">@Loc["PrdRdv.MotifPaiement"]</option>
                            <option value="Dépôt Pièces Physiques">@Loc["PrdRdv.MotifDepot"]</option>
                            <option value="Assistance Guichet">@Loc["PrdRdv.MotifAssistance"]</option>
                            <option value="Autre démarche">@Loc["PrdRdv.MotifAutre"]</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/rendez-vous/mes-rendez-vous" class="btn btn-secondary">@Loc["Common.Cancel"]</a>
                        <button class="btn btn-success btn-lg" @onclick="ConfirmerReservationAsync"
                                disabled="@(_heureSelectionnee is null || _enReservation)">
                            @if (_enReservation)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>@Loc["PrdRdv.Reserving"]</span>
                            }
                            else
                            {
                                <span>@Loc["PrdRdv.Confirm"]</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid TicketId { get; set; }

    private bool _chargementInitial = true;
    private Guid _utilisateurId;
    private CIT.Plateforme.Application.Tickets.FicheTicketVue? _ticket;

    private DateOnly _dateSelectionnee = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
    private bool _chargementCreneaux = false;
    private IReadOnlyList<CreneauDisponibleDto> _creneaux = [];
    private TimeSpan? _heureSelectionnee;
    private string _motifSelectionne = "Paiement Caisse";
    private bool _enReservation = false;

    private string? _messageErreur;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            _utilisateurId = contexte.UtilisateurId;

            // CLOISONNEMENT (audit du 2026-09-04) : la lecture passait par ITicketRepository,
            // qui ne contrôle rien. Un client authentifié pouvait donc afficher le numéro, le
            // module et le BL de N'IMPORTE QUEL ticket en devinant son identifiant.
            // ObtenirFicheTicketQuery applique le cloisonnement et refuse l'accès (SEC-03).
            try
            {
                _ticket = await FicheTicket.ExecuterAsync(_utilisateurId, TicketId);
                await ChargerCreneauxAsync();
            }
            catch (CIT.Plateforme.Application.Securite.AccesRefuseException)
            {
                _ticket = null;
            }
        }
        finally
        {
            _chargementInitial = false;
        }
    }

    private async Task ChangerDateAsync(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
        {
            _dateSelectionnee = d;
            _heureSelectionnee = null;
            await ChargerCreneauxAsync();
        }
    }

    private async Task ChargerCreneauxAsync()
    {
        _chargementCreneaux = true;
        _messageErreur = null;
        try
        {
            _creneaux = await ListerCreneauxQuery.ExecuterAsync(_dateSelectionnee);
        }
        catch (Exception ex)
        {
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargementCreneaux = false;
        }
    }

    private void ChoisirHeure(TimeSpan heure)
    {
        _heureSelectionnee = heure;
    }

    private async Task ConfirmerReservationAsync()
    {
        if (_heureSelectionnee is null)
        {
            _messageErreur = Loc["PrdRdv.SelectSlot"].Value;
            return;
        }

        _enReservation = true;
        _messageErreur = null;
        try
        {
            await ReserverCommand.ExecuterAsync(new ReserverRendezVousRequest(
                _utilisateurId,
                TicketId,
                _dateSelectionnee,
                _heureSelectionnee.Value,
                _motifSelectionne
            ));

            Navigation.NavigateTo("/rendez-vous/mes-rendez-vous");
        }
        catch (Exception ex)
        {
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _enReservation = false;
        }
    }
}
