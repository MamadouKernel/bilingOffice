@page "/rendez-vous/mes-rendez-vous"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Abstractions
@using CIT.Plateforme.Application.Guichet
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Guichet
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject ListerMesRendezVousQuery ListerMesRdvQuery
@inject AnnulerRendezVousCommand AnnulerCommand
@inject ReporterRendezVousCommand ReporterCommand
@inject ListerCreneauxDisponiblesQuery ListerCreneauxQuery
@inject NavigationManager Navigation

<PageTitle>@Loc["Rdv.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>📅</span> @Loc["Rdv.Title"]
        </h1>
        <div class="cit-page-subtitle">
            @Loc["Rdv.Subtitle"]
        </div>
    </div>
</div>

@if (_chargementInitial)
{
    <IndicateurChargement Message="@Loc["Rdv.Loading"]" />
}
else
{
    @if (_messageErreur is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @_messageErreur
            <button type="button" class="btn-close" @onclick="() => _messageErreur = null"></button>
        </div>
    }

    @if (_messageSucces is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @_messageSucces
            <button type="button" class="btn-close" @onclick="() => _messageSucces = null"></button>
        </div>
    }

    @* Modal de report de rendez-vous *@
    @if (_rdvEnReport is not null)
    {
        <div class="card shadow border-warning mb-4">
            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Loc["Rdv.ReportHeaderPrefix"] @_rdvEnReport.Date.ToString("dd/MM/yyyy") (@_rdvEnReport.NumeroTicket)</h5>
                <button type="button" class="btn btn-sm btn-outline-dark" @onclick="FermerReport">@Loc["Rdv.Close"]</button>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="nouvelle-date" class="form-label fw-bold">@Loc["Rdv.NewDate"]</label>
                        <input id="nouvelle-date" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               value="@_nouvelleDateReport.ToString("yyyy-MM-dd")" @onchange="ChangerDateReportAsync" />
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <button type="button" class="btn btn-outline-primary" @onclick="ChargerCreneauxReportAsync">
                            @Loc["ProfilSoc.Refresh"]
                        </button>
                    </div>
                </div>

                @if (_chargementCreneauxReport)
                {
                    <IndicateurChargement Message="@Loc["Rdv.SearchingSlots"]" />
                }
                else if (_creneauxReport.Count == 0)
                {
                    <div class="alert alert-info">@Loc["Rdv.NoSlots"]</div>
                }
                else
                {
                    <label class="form-label fw-bold">@Loc["Rdv.NewSlot"]</label>
                    <div class="row g-2 mb-3">
                        @foreach (var c in _creneauxReport)
                        {
                            var disponible = !c.EstComplet;
                            <div class="col-md-4 col-sm-6">
                                <button type="button"
                                        class="btn w-100 p-2 text-center @(disponible ? (_nouvelleHeureReport == c.HeureDebut ? "btn-warning" : "btn-outline-secondary") : "btn-light disabled")"
                                        @onclick="() => _nouvelleHeureReport = c.HeureDebut" disabled="@(!disponible)">
                                    <div class="fw-bold">@c.HeureDebut.ToString(@"hh\:mm") - @c.HeureFin.ToString(@"hh\:mm")</div>
                                    <small class="d-block @(disponible ? "text-success" : "text-danger")">
                                        @(disponible ? string.Format(Loc["Rdv.PlacesLeft"].Value, c.PlacesRestantes) : Loc["Rdv.Full"].Value)
                                    </small>
                                </button>
                            </div>
                        }
                    </div>
                }

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" @onclick="FermerReport">@Loc["Common.Cancel"]</button>
                    <button type="button" class="btn btn-warning" @onclick="ConfirmerReportAsync" disabled="@(_nouvelleHeureReport is null || _enAction)">
                        @if (_enAction)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <span>@Loc["Rdv.ValidateReport"]</span>
                    </button>
                </div>
            </div>
        </div>
    }

    @* Modal d'annulation de rendez-vous *@
    @if (_rdvEnAnnulation is not null)
    {
        <div class="card shadow border-danger mb-4">
            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Loc["Rdv.CancelHeaderPrefix"] (@_rdvEnAnnulation.NumeroTicket)</h5>
                <button type="button" class="btn btn-sm btn-light" @onclick="FermerAnnulation">@Loc["Rdv.Close"]</button>
            </div>
            <div class="card-body">
                <p>@Loc["Rdv.CancelConfirmPre"] <strong>@_rdvEnAnnulation.Date.ToString("dd/MM/yyyy") @Loc["Rdv.At"] @_rdvEnAnnulation.HeureDebut.ToString(@"hh\:mm")</strong> @Loc["Rdv.CancelConfirmPost"]</p>
                <div class="mb-3">
                    <label for="motif-de-l-annulation" class="form-label fw-bold">@Loc["Rdv.CancelMotifLabel"]</label>
                    <input id="motif-de-l-annulation" type="text" class="form-control" placeholder="@Loc["Rdv.CancelMotifPlaceholder"]" @bind="_motifAnnulation" />
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" @onclick="FermerAnnulation">@Loc["Rdv.KeepRdv"]</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmerAnnulationAsync" disabled="@_enAction">
                        @if (_enAction)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <span>@Loc["Rdv.ConfirmCancel"]</span>
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_rendezVousList.Count == 0)
    {
        <div class="card shadow-sm text-center p-5 border-0">
            <div class="text-muted fs-5 mb-3">
                @Loc["Rdv.EmptyMsg"]
            </div>
            <div>
                <a href="/client/demandes" class="btn btn-primary">
                    @Loc["Rdv.EmptyCta"]
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <h5 class="mb-0">@Loc["Rdv.HistoryTitlePrefix"] (@_rendezVousList.Count)</h5>
            </div>
            <div class="card-body p-0">
                <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Loc["Rdv.ColTicket"]</th>
                                <th>@Loc["Rdv.ColDateTime"]</th>
                                <th>@Loc["Rdv.ColMotif"]</th>
                                <th>@Loc["Societe.ColStatus"]</th>
                                <th>@Loc["Rdv.ColReservedOn"]</th>
                                <th>@Loc["Common.Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _pagination1.Appliquer(_rendezVousList))
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@r.NumeroTicket</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold">📅 @r.Date.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">⏱️ @r.HeureDebut.ToString(@"hh\:mm") - @r.HeureFin.ToString(@"hh\:mm")</small>
                                    </td>
                                    <td>@r.Motif</td>
                                    <td>
                                        @switch (r.Statut)
                                        {
                                            case "Reserve":
                                                <span class="badge bg-primary">@Loc["Rdv.StatusReserved"]</span>
                                                break;
                                            case "Honore":
                                                <span class="badge bg-success">@Loc["Rdv.StatusHonored"]</span>
                                                break;
                                            case "Annule":
                                                <span class="badge bg-secondary">@Loc["Rdv.StatusCancelled"]</span>
                                                break;
                                            case "NonPresente":
                                                <span class="badge bg-danger">@Loc["Rdv.StatusNoShow"]</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@r.Statut</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-muted small">@r.DateCreationUtc.Horodate()</td>
                                    <td>
                                        @if (r.Statut == "Reserve")
                                        {
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-warning" @onclick="() => OuvrirReport(r)">
                                                    @Loc["Rdv.Reschedule"]
                                                </button>
                                                <button type="button" class="btn btn-outline-danger" @onclick="() => OuvrirAnnulation(r)">
                                                    @Loc["Rdv.CancelBtn"]
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
                </div>
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargementInitial = true;
    private Guid _utilisateurId;
    private IReadOnlyList<RendezVousClientDto> _rendezVousList = [];

    private RendezVousClientDto? _rdvEnReport;
    private DateOnly _nouvelleDateReport = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
    private TimeSpan? _nouvelleHeureReport;
    private bool _chargementCreneauxReport = false;
    private IReadOnlyList<CreneauDisponibleDto> _creneauxReport = [];

    private RendezVousClientDto? _rdvEnAnnulation;
    private string _motifAnnulation = string.Empty;

    private bool _enAction = false;
    private string? _messageErreur;
    private string? _messageSucces;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            _utilisateurId = contexte.UtilisateurId;
            await ChargerRendezVousAsync();
        }
        finally
        {
            _chargementInitial = false;
        }
    }

    private async Task ChargerRendezVousAsync()
    {
        _messageErreur = null;
        try
        {
            _rendezVousList = await ListerMesRdvQuery.ExecuterAsync(_utilisateurId);
        }
        catch (Exception ex)
        {
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private async Task OuvrirReport(RendezVousClientDto rdv)
    {
        _rdvEnReport = rdv;
        _rdvEnAnnulation = null;
        _nouvelleDateReport = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
        _nouvelleHeureReport = null;
        await ChargerCreneauxReportAsync();
    }

    private void FermerReport()
    {
        _rdvEnReport = null;
    }

    private async Task ChangerDateReportAsync(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
        {
            _nouvelleDateReport = d;
            _nouvelleHeureReport = null;
            await ChargerCreneauxReportAsync();
        }
    }

    private async Task ChargerCreneauxReportAsync()
    {
        _chargementCreneauxReport = true;
        _messageErreur = null;
        try
        {
            _creneauxReport = await ListerCreneauxQuery.ExecuterAsync(_nouvelleDateReport);
        }
        catch (Exception ex)
        {
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargementCreneauxReport = false;
        }
    }

    private async Task ConfirmerReportAsync()
    {
        if (_rdvEnReport is null || _nouvelleHeureReport is null) return;

        _enAction = true;
        _messageErreur = null;
        _messageSucces = null;
        try
        {
            await ReporterCommand.ExecuterAsync(new ReporterRendezVousRequest(
                _utilisateurId,
                _rdvEnReport.Id,
                _nouvelleDateReport,
                _nouvelleHeureReport.Value
            ));
            _messageSucces = Loc["Rdv.MsgRescheduled"].Value;
            _rdvEnReport = null;
            await ChargerRendezVousAsync();
        }
        catch (Exception ex)
        {
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _enAction = false;
        }
    }

    private void OuvrirAnnulation(RendezVousClientDto rdv)
    {
        _rdvEnAnnulation = rdv;
        _rdvEnReport = null;
        _motifAnnulation = Loc["Rdv.DefaultCancelMotif"].Value;
    }

    private void FermerAnnulation()
    {
        _rdvEnAnnulation = null;
    }

    private async Task ConfirmerAnnulationAsync()
    {
        if (_rdvEnAnnulation is null) return;

        _enAction = true;
        _messageErreur = null;
        _messageSucces = null;
        try
        {
            await AnnulerCommand.ExecuterAsync(new AnnulerRendezVousRequest(
                _utilisateurId,
                _rdvEnAnnulation.Id,
                _motifAnnulation
            ));
            _messageSucces = Loc["Rdv.MsgCancelled"].Value;
            _rdvEnAnnulation = null;
            await ChargerRendezVousAsync();
        }
        catch (Exception ex)
        {
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _enAction = false;
        }
    }
}
