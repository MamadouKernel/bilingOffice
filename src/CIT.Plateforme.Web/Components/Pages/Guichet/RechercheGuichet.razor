@page "/guichet/recherche"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Abstractions
@using CIT.Plateforme.Application.Documents
@using CIT.Plateforme.Application.Guichet
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject RechercherGuichetQuery RechercheQuery
@inject ConsulterDossierGuichetQuery ConsulterDossierQuery
@inject RegulariserModeDegradeCommand RegulariserCommand
@inject TelechargerDocumentQuery TelechargerDocument
@inject Microsoft.JSInterop.IJSRuntime Js
@inject NavigationManager Navigation

<PageTitle>@Loc["GuiRech.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>🏛️</span> @Loc["GuiRech.Title"]
        </h1>
        <div class="cit-page-subtitle">
            @Loc["GuiRech.Subtitle"]
        </div>
    </div>
    <div class="d-flex gap-2">
        <a href="/guichet/agenda" class="btn btn-outline-primary">
            @Loc["GuiRech.LinkAgenda"]
        </a>
    </div>
</div>

@if (_chargementInitial)
{
    <IndicateurChargement Message="@Loc["Gui.CheckingPerm"]" />
}
else if (!_estHabilite)
{
    <div class="alert alert-danger" role="alert">
        @((MarkupString)Loc["GuiRech.AccessDenied"].Value)
    </div>
}
else
{
    @if (_messageErreur is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @_messageErreur
            <button type="button" class="btn-close" @onclick="() => _messageErreur = null"></button>
        </div>
    }

    @if (_messageSucces is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @_messageSucces
            <button type="button" class="btn-close" @onclick="() => _messageSucces = null"></button>
        </div>
    }

    @* Zone de recherche rapide (CON-02) *@
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body">
            <h5 class="card-title text-primary mb-3">@Loc["GuiRech.SearchTitle"]</h5>
            <div class="row g-3">
                <div class="col-md-7">
                    <label for="numero-de-ticket-bl" class="form-label fw-bold">@Loc["GuiRech.LblTerme"]</label>
                    <input id="numero-de-ticket-bl" type="text" class="form-control form-control-lg" placeholder="@Loc["GuiRech.PlaceholderTerme"]"
                           @bind="_termeRecherche" @bind:event="oninput" @onkeyup="GererToucheRecherche" />
                </div>
                <div class="col-md-3">
                    <label for="module" class="form-label fw-bold">@Loc["GuiRech.LblModule"]</label>
                    <select id="module" class="form-select form-select-lg" @bind="_moduleFiltre">
                        <option value="">@Loc["GuiRech.ModuleAll"]</option>
                        <option value="BillingImport">@Loc["GuiRech.ModuleImport"]</option>
                        <option value="BillingExport">@Loc["GuiRech.ModuleExport"]</option>
                        <option value="Enrolement">@Loc["GuiRech.ModuleEnrolement"]</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary btn-lg w-100" @onclick="EffectuerRechercheAsync" disabled="@_enRecherche">
                        @if (_enRecherche)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <span>@Loc["GuiRech.BtnRechercher"]</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* Affichage du dossier sélectionné (CON-01) *@
    @if (_dossierConsulte is not null)
    {
        <div class="card shadow border-primary mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    @Loc["GuiRech.DossierTitle", _dossierConsulte.NumeroTicket, _dossierConsulte.Module]
                </h5>
                <button class="btn btn-sm btn-light" @onclick="FermerDossier">@Loc["GuiRech.BtnFermerVue"]</button>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="text-muted small">@Loc["GuiRech.LblNumeroDossier"]</div>
                        <div class="fw-bold fs-5">@_dossierConsulte.NumeroDossier</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">@Loc["GuiRech.LblSociete"]</div>
                        <div class="fw-bold fs-5">@_dossierConsulte.ClientNom</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">@Loc["GuiRech.LblRefMetier"]</div>
                        <div class="fw-bold fs-5 text-primary">@_dossierConsulte.ReferenceBlOuBooking</div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="text-muted small">@Loc["GuiRech.LblStatutTicket"]</div>
                        <span class="badge bg-info text-dark">@_dossierConsulte.Statut</span>
                    </div>
                    <div class="col-md-8">
                        <div class="text-muted small">@Loc["GuiRech.LblRdvActif"]</div>
                        @if (_dossierConsulte.RendezVousActif is not null)
                        {
                            <span class="badge bg-success">
                                @Loc["GuiRech.RdvActifBadge", _dossierConsulte.RendezVousActif.Date.ToString("dd/MM/yyyy"), _dossierConsulte.RendezVousActif.HeureDebut.ToString(@"hh\:mm"), _dossierConsulte.RendezVousActif.Motif]
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">@Loc["GuiRech.AucunRdvActif"]</span>
                        }
                    </div>
                </div>

                <hr />

                <h6>@Loc["GuiRech.PiecesTitle"]</h6>
                @if (_dossierConsulte.Documents.Count == 0)
                {
                    <p class="text-muted fst-italic">@Loc["GuiRech.AucunDoc"]</p>
                }
                else
                {
                    <ul class="list-group mb-3">
                        @foreach (var doc in _dossierConsulte.Documents)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@doc.NomFichier</strong>
                                    <span class="text-muted small ms-2">@Loc["GuiRech.DocDepose", doc.DateDepotUtc.Horodate()]</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-secondary">@doc.TypeContenu</span>
                                    <button type="button" class="btn btn-sm btn-primary"
                                            @onclick="() => OuvrirApercuAsync(doc)"
                                            disabled="@(_telechargementEnCours == doc.Id)">
                                        👁 @Loc["Preview.Open"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            @onclick="() => TelechargerAsync(doc)"
                                            disabled="@(_telechargementEnCours == doc.Id)">
                                        @(_telechargementEnCours == doc.Id ? Loc["GuiRech.DocPreparing"].Value : Loc["GuiRech.DocDownload"].Value)
                                    </button>
                                </div>
                            </li>
                        }
                    </ul>
                }

                <ApercuDocument EstOuvert="_apercuDoc is not null"
                                NomFichier="@(_apercuDoc?.NomFichier ?? string.Empty)"
                                TypeContenu="@(_apercuDoc?.TypeContenu ?? string.Empty)"
                                Base64="_apercuBase64"
                                OnFermer="FermerApercu"
                                OnTelecharger="TelechargerDepuisApercuAsync" />

                @* Régularisation mode dégradé (ERR-04 / C10-11) *@
                <div class="card bg-light mt-3 border-warning">
                    <div class="card-body">
                        <h6 class="card-title text-warning-emphasis">@Loc["GuiRech.DegradeTitle"]</h6>
                        <p class="card-text small text-muted">
                            @Loc["GuiRech.DegradeDesc"]
                        </p>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label for="date-et-heure-de" class="form-label small">@Loc["GuiRech.LblDateOp"]</label>
                                <input id="date-et-heure-de" type="datetime-local" class="form-control form-control-sm" @bind="_dateOperationDegrade" />
                            </div>
                            <div class="col-md-6">
                                <label for="description-de-l-operation" class="form-label small">@Loc["GuiRech.LblDescOp"]</label>
                                <input id="description-de-l-operation" type="text" class="form-control form-control-sm" placeholder="@Loc["GuiRech.PlaceholderDescOp"]" @bind="_descriptionDegrade" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button class="btn btn-warning btn-sm w-100" @onclick="RegulariserModeDegradeAsync" disabled="@_enRegularisation">
                                    @if (_enRegularisation)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <span>@Loc["GuiRech.BtnRegulariser"]</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Tableau des résultats de recherche *@
    @if (_resultats is not null)
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Loc["GuiRech.ResultsTitle", _resultats.Count]</h5>
            </div>
            <div class="card-body p-0">
                @if (_resultats.Count == 0)
                {
                    <div class="p-4 text-center text-muted">
                        @Loc["GuiRech.NoResults"]
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Loc["GuiRech.ColTicket"]</th>
                                    <th>@Loc["GuiRech.ColDossier"]</th>
                                    <th>@Loc["GuiRech.ColModule"]</th>
                                    <th>@Loc["GuiRech.ColClient"]</th>
                                    <th>@Loc["GuiRech.ColBlBooking"]</th>
                                    <th>@Loc["GuiRech.ColStatut"]</th>
                                    <th>@Loc["GuiRech.ColRdvActif"]</th>
                                    <th>@Loc["GuiRech.ColActions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _pagination1.Appliquer(_resultats))
                                {
                                    <tr>
                                        <td class="fw-bold">@r.NumeroTicket</td>
                                        <td>@(r.NumeroDossier ?? "—")</td>
                                        <td><span class="badge bg-secondary">@r.Module</span></td>
                                        <td>@r.ClientNom</td>
                                        <td class="text-primary fw-bold">@(r.ReferenceBlOuBooking ?? "—")</td>
                                        <td><span class="badge bg-info text-dark">@r.StatutTicket</span></td>
                                        <td>
                                            @if (r.PossedeRendezVousActif)
                                            {
                                                <span class="badge bg-success">@Loc["GuiRech.BadgeOui"]</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@Loc["GuiRech.BadgeNon"]</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => ConsulterDossierAsync(r.TicketId)">
                                                @Loc["GuiRech.BtnOuvrirGuichet"]
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargementInitial = true;
    private bool _estHabilite = false;
    private Guid _agentId;

    private string _termeRecherche = string.Empty;
    private string _moduleFiltre = string.Empty;
    private bool _enRecherche = false;
    private IReadOnlyList<ResultatRechercheGuichetDto>? _resultats;

    private DossierGuichetCompletDto? _dossierConsulte;
    private DateTime _dateOperationDegrade = DateTime.UtcNow;
    private string _descriptionDegrade = string.Empty;
    private bool _enRegularisation = false;
    private Guid? _telechargementEnCours;
    private DocumentGuichetDto? _apercuDoc;
    private string? _apercuBase64;

    private string? _messageErreur;
    private string? _messageSucces;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            _agentId = contexte.UtilisateurId;
            _estHabilite = contexte.Permissions.Contains(Permission.GuichetRecherche);
        }
        finally
        {
            _chargementInitial = false;
        }
    }

    private async Task GererToucheRecherche(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await EffectuerRechercheAsync();
        }
    }

    private async Task EffectuerRechercheAsync()
    {
        _enRecherche = true;
        _messageErreur = null;
        try
        {
            var criteres = new CriteresRechercheGuichet(
                Terme: _termeRecherche,
                Module: string.IsNullOrWhiteSpace(_moduleFiltre) ? null : _moduleFiltre,
                Limite: 50
            );
            _resultats = await RechercheQuery.ExecuterAsync(_agentId, criteres);
        }
        catch (Exception ex)
        {
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _enRecherche = false;
        }
    }

    private async Task ConsulterDossierAsync(Guid ticketId)
    {
        _messageErreur = null;
        try
        {
            _dossierConsulte = await ConsulterDossierQuery.ExecuterAsync(_agentId, ticketId);
        }
        catch (Exception ex)
        {
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private void FermerDossier()
    {
        _dossierConsulte = null;
    }

    /// <summary>
    /// SEC-12 — le téléchargement passe par <c>TelechargerDocumentQuery</c>, qui revérifie
    /// l'habilitation et le périmètre à CHAQUE accès. L'agent guichet est toujours une voie
    /// « agent » : l'identité vient du contexte authentifié, jamais d'un champ.
    /// </summary>
    private async Task TelechargerAsync(DocumentGuichetDto doc)
    {
        _messageErreur = null;
        _telechargementEnCours = doc.Id;
        try
        {
            var base64 = await LireContenuAsync(doc);
            await Js.InvokeVoidAsync("telechargerFichier", doc.NomFichier, doc.TypeContenu, base64);
        }
        catch (DocumentNonAccessibleException)
        {
            _messageErreur = Loc["GuiRech.DocInaccessible"].Value;
        }
        catch (Exception ex)
        {
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _telechargementEnCours = null;
        }
    }

    /// <summary>Aperçu dans l'application : même contrôle d'accès que le téléchargement.</summary>
    private async Task OuvrirApercuAsync(DocumentGuichetDto doc)
    {
        _messageErreur = null;
        _apercuDoc = doc;
        _apercuBase64 = null;
        _telechargementEnCours = doc.Id;
        try
        {
            _apercuBase64 = await LireContenuAsync(doc);
        }
        catch (DocumentNonAccessibleException)
        {
            FermerApercu();
            _messageErreur = Loc["GuiRech.DocInaccessible"].Value;
        }
        catch (Exception ex)
        {
            FermerApercu();
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _telechargementEnCours = null;
        }
    }

    private void FermerApercu()
    {
        _apercuDoc = null;
        _apercuBase64 = null;
    }

    private Task TelechargerDepuisApercuAsync() =>
        _apercuDoc is null || _apercuBase64 is null
            ? Task.CompletedTask
            : Js.InvokeVoidAsync("telechargerFichier", _apercuDoc.NomFichier, _apercuDoc.TypeContenu, _apercuBase64).AsTask();

    private async Task<string> LireContenuAsync(DocumentGuichetDto doc)
    {
        await using var flux = await TelechargerDocument.TelechargerPourAgentAsync(_agentId, doc.Id);
        await using var memoire = new MemoryStream();
        await flux.CopyToAsync(memoire);
        return Convert.ToBase64String(memoire.ToArray());
    }

    private async Task RegulariserModeDegradeAsync()
    {
        if (_dossierConsulte is null) return;
        if (string.IsNullOrWhiteSpace(_descriptionDegrade))
        {
            _messageErreur = Loc["GuiRech.ErrDescDegrade"].Value;
            return;
        }

        _enRegularisation = true;
        _messageErreur = null;
        _messageSucces = null;
        try
        {
            await RegulariserCommand.ExecuterAsync(new RegulariserModeDegradeRequest(
                _agentId,
                _dossierConsulte.TicketId,
                _dateOperationDegrade.ToUniversalTime(),
                _descriptionDegrade
            ));
            _messageSucces = Loc["GuiRech.SuccessRegul"].Value;
            _descriptionDegrade = string.Empty;
        }
        catch (Exception ex)
        {
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _enRegularisation = false;
        }
    }
}
