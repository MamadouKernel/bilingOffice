@page "/guichet/agenda"
@rendermode InteractiveServer
@attribute [Authorize]
@using CIT.Plateforme.Application.Abstractions
@using CIT.Plateforme.Application.Guichet
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Guichet
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject CIT.Plateforme.Application.Guichet.ListerAgendaGuichetQuery ListerAgenda
@inject MarquerRendezVousHonoreCommand MarquerHonoreCommand
@inject MarquerRendezVousNonPresenteCommand MarquerNonPresenteCommand
@inject NavigationManager Navigation

<PageTitle>@Loc["GuiAgenda.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>📅</span> @Loc["GuiAgenda.Title"]
        </h1>
        <div class="cit-page-subtitle">
            @Loc["GuiAgenda.Subtitle"]
        </div>
    </div>
    <div class="d-flex gap-2">
        <a href="/guichet/recherche" class="btn btn-outline-secondary">
            @Loc["GuiAgenda.LinkRecherche"]
        </a>
    </div>
</div>

@if (_chargementInitial)
{
    <IndicateurChargement Message="@Loc["Gui.CheckingPerm"]" />
}
else if (!_estHabilite)
{
    <div class="alert alert-danger" role="alert">
        @((MarkupString)Loc["GuiAgenda.AccessDenied"].Value)
    </div>
}
else
{
    @if (_messageErreur is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @_messageErreur
            <button type="button" class="btn-close" @onclick="() => _messageErreur = null"></button>
        </div>
    }

    @if (_messageSucces is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @_messageSucces
            <button type="button" class="btn-close" @onclick="() => _messageSucces = null"></button>
        </div>
    }

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-auto">
                    <label for="selectionner-la-date" class="form-label fw-bold mb-0">@Loc["GuiAgenda.SelectDate"]</label>
                </div>
                <div class="col-auto">
                    <input id="selectionner-la-date" type="date" class="form-control" value="@_dateSelectionnee.ToString("yyyy-MM-dd")" @onchange="ChangerDateAsync" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-outline-primary" @onclick="() => AllerAujourdhuiAsync()">@Loc["GuiAgenda.Today"]</button>
                </div>
            </div>
        </div>
    </div>

    @if (_chargementAgenda)
    {
        <IndicateurChargement Message="@Loc["GuiAgenda.LoadingAgenda"]" />
    }
    else if (_rendezVousJournee.Count == 0)
    {
        <div class="card shadow-sm text-center p-5 border-0">
            <div class="text-muted fs-5">
                @Loc["GuiAgenda.NoRdv", _dateSelectionnee.ToString("dd/MM/yyyy")]
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    @Loc["GuiAgenda.RdvOfDay", _dateSelectionnee.ToString("dddd dd MMMM yyyy"), _rendezVousJournee.Count]
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Loc["GuiAgenda.ColCreneau"]</th>
                                <th>@Loc["GuiAgenda.ColMotif"]</th>
                                <th>@Loc["GuiAgenda.ColStatut"]</th>
                                <th>@Loc["GuiAgenda.ColDateReservation"]</th>
                                <th>@Loc["GuiAgenda.ColCommentaire"]</th>
                                <th>@Loc["GuiAgenda.ColActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rdv in _pagination1.Appliquer(_rendezVousJournee))
                            {
                                <tr>
                                    <td class="fw-bold">
                                        ⏱️ @rdv.HeureDebut.ToString(@"hh\:mm") - @rdv.HeureFin.ToString(@"hh\:mm")
                                    </td>
                                    <td>@rdv.Motif</td>
                                    <td>
                                        @switch (rdv.Statut)
                                        {
                                            case StatutRendezVous.Reserve:
                                                <span class="badge bg-primary">@Loc["GuiAgenda.StReserve"]</span>
                                                break;
                                            case StatutRendezVous.Honore:
                                                <span class="badge bg-success">@Loc["GuiAgenda.StHonore"]</span>
                                                break;
                                            case StatutRendezVous.Annule:
                                                <span class="badge bg-secondary">@Loc["GuiAgenda.StAnnule"]</span>
                                                break;
                                            case StatutRendezVous.NonPresente:
                                                <span class="badge bg-danger">@Loc["GuiAgenda.StNonPresente"]</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-muted small">@rdv.DateCreationUtc.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-muted small">@(rdv.CommentaireAgent ?? "—")</td>
                                    <td>
                                        @if (rdv.Statut == StatutRendezVous.Reserve)
                                        {
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-success" @onclick="() => ValiderPresenceAsync(rdv.Id)" title="@Loc["GuiAgenda.BtnPresentTitle"]">
                                                    @Loc["GuiAgenda.BtnPresent"]
                                                </button>
                                                <button class="btn btn-outline-danger" @onclick="() => MarquerAbsenceAsync(rdv.Id)" title="@Loc["GuiAgenda.BtnAbsentTitle"]">
                                                    @Loc["GuiAgenda.BtnAbsent"]
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">@Loc["GuiAgenda.Traite"]</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
                </div>
            </div>
        </div>
    }
}

@code {
    private readonly EtatPagination _pagination1 = new();

    private bool _chargementInitial = true;
    private bool _estHabilite = false;
    private Guid _agentId;

    private DateOnly _dateSelectionnee = DateOnly.FromDateTime(DateTime.Today);
    private bool _chargementAgenda = false;
    private IReadOnlyList<RendezVous> _rendezVousJournee = [];

    private string? _messageErreur;
    private string? _messageSucces;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            _agentId = contexte.UtilisateurId;
            _estHabilite = contexte.Permissions.Contains(Permission.RendezVousGerer);

            if (_estHabilite)
            {
                await ChargerAgendaAsync();
            }
        }
        finally
        {
            _chargementInitial = false;
        }
    }

    private async Task ChargerAgendaAsync()
    {
        _chargementAgenda = true;
        _messageErreur = null;
        try
        {
            // La lecture passe par un cas d'usage qui exige l'habilitation : un repository
            // injecté en page ne garde rien (audit du 2026-09-04, docs/89).
            _rendezVousJournee = await ListerAgenda.ExecuterAsync(_agentId, _dateSelectionnee);
        }
        catch (Exception ex)
        {
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargementAgenda = false;
        }
    }

    private async Task ChangerDateAsync(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
        {
            _dateSelectionnee = d;
            await ChargerAgendaAsync();
        }
    }

    private async Task AllerAujourdhuiAsync()
    {
        _dateSelectionnee = DateOnly.FromDateTime(DateTime.Today);
        await ChargerAgendaAsync();
    }

    private async Task ValiderPresenceAsync(Guid rdvId)
    {
        _messageErreur = null;
        _messageSucces = null;
        try
        {
            await MarquerHonoreCommand.ExecuterAsync(new MarquerHonoreRequest(
                _agentId,
                rdvId,
                Loc["GuiAgenda.PresenceComment"].Value
            ));
            _messageSucces = Loc["GuiAgenda.SuccessPresence"].Value;
            await ChargerAgendaAsync();
        }
        catch (Exception ex)
        {
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private async Task MarquerAbsenceAsync(Guid rdvId)
    {
        _messageErreur = null;
        _messageSucces = null;
        try
        {
            await MarquerNonPresenteCommand.ExecuterAsync(new MarquerNonPresenteRequest(
                _agentId,
                rdvId,
                Loc["GuiAgenda.AbsenceComment"].Value
            ));
            _messageSucces = Loc["GuiAgenda.SuccessAbsence"].Value;
            await ChargerAgendaAsync();
        }
        catch (Exception ex)
        {
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
    }
}
