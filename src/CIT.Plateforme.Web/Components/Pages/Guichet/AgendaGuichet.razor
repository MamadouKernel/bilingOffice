@page "/guichet/agenda"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using CIT.Plateforme.Application.Abstractions
@using CIT.Plateforme.Application.Guichet
@using CIT.Plateforme.Application.Web
@using CIT.Plateforme.Domain.Guichet
@using CIT.Plateforme.Domain.Securite
@using CIT.Plateforme.Web.Components.Shared
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc
@inject IContexteUtilisateurWeb ContexteService
@inject CIT.Plateforme.Application.Guichet.ListerAgendaGuichetQuery ListerAgenda
@inject MarquerRendezVousHonoreCommand MarquerHonoreCommand
@inject MarquerRendezVousNonPresenteCommand MarquerNonPresenteCommand

<PageTitle>@Loc["GuiAgenda.PageTitle"]</PageTitle>

<div class="cit-page-header">
    <div>
        <h1 class="cit-page-title">
            <span>📅</span> @Loc["GuiAgenda.Title"]
        </h1>
        <div class="cit-page-subtitle">@Loc["GuiAgenda.Subtitle"]</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/guichet/recherche" class="btn btn-outline-secondary">@Loc["GuiAgenda.LinkRecherche"]</a>
    </div>
</div>

@if (_chargementInitial)
{
    <IndicateurChargement Message="@Loc["Gui.CheckingPerm"]" />
}
else if (!_estHabilite)
{
    <div class="alert alert-danger" role="alert">@((MarkupString)Loc["GuiAgenda.AccessDenied"].Value)</div>
}
else
{
    @if (_messageErreur is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @_messageErreur
            <button type="button" class="btn-close" @onclick="() => _messageErreur = null"></button>
        </div>
    }
    @if (_messageSucces is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            @_messageSucces
            <button type="button" class="btn-close" @onclick="() => _messageSucces = null"></button>
        </div>
    }

    @* ── Barre d'outils façon Teams : aujourd'hui, précédent/suivant, période, vue ── *@
    <div class="cit-card cit-agenda-toolbar mb-3">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button class="btn btn-outline-primary btn-sm fw-semibold" @onclick="AllerAujourdhuiAsync">@Loc["GuiAgenda.Today"]</button>
            <div class="btn-group btn-group-sm" role="group">
                <button class="btn btn-outline-secondary" @onclick="() => DeplacerAsync(-1)" aria-label="@Loc["GuiAgenda.Prev"]">‹</button>
                <button class="btn btn-outline-secondary" @onclick="() => DeplacerAsync(1)" aria-label="@Loc["GuiAgenda.Next"]">›</button>
            </div>
            <h2 class="cit-agenda-periode mb-0">@LibellePeriode</h2>
            <label for="agenda-date" class="visually-hidden">@Loc["GuiAgenda.SelectDate"]</label>
            <input id="agenda-date" type="date" class="form-control form-control-sm" style="width: auto;"
                   value="@_dateReference.ToString("yyyy-MM-dd")" @onchange="ChangerDateAsync" />
        </div>

        <div class="btn-group btn-group-sm cit-agenda-vues" role="group" aria-label="@Loc["GuiAgenda.ViewsAria"]">
            @foreach (var vue in Enum.GetValues<VueAgenda>())
            {
                <button class="btn @(vue == _vue ? "btn-primary" : "btn-outline-secondary")"
                        aria-pressed="@(vue == _vue)" @onclick="() => ChangerVueAsync(vue)">
                    @LibelleVue(vue)
                </button>
            }
        </div>
    </div>

    @if (_chargementAgenda)
    {
        <IndicateurChargement Message="@Loc["GuiAgenda.LoadingAgenda"]" />
    }
    else if (_vue == VueAgenda.Jour)
    {
        @if (_rendezVous.Count == 0)
        {
            <div class="cit-card text-center p-5 text-muted fs-5">@Loc["GuiAgenda.NoRdv", _dateReference.ToString("dd/MM/yyyy")]</div>
        }
        else
        {
            <div class="cit-card p-0 overflow-hidden">
                <FiltreTable Etat="_pagination1" AuChangement="StateHasChanged" />
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Loc["GuiAgenda.ColCreneau"]</th>
                                <th>@Loc["GuiAgenda.ColMotif"]</th>
                                <th>@Loc["GuiAgenda.ColStatut"]</th>
                                <th>@Loc["GuiAgenda.ColDateReservation"]</th>
                                <th>@Loc["GuiAgenda.ColCommentaire"]</th>
                                <th>@Loc["GuiAgenda.ColActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rdv in _pagination1.Appliquer(_rendezVous))
                            {
                                <tr>
                                    <td class="fw-bold font-monospace">@Creneau(rdv)</td>
                                    <td>@rdv.Motif</td>
                                    <td>@BadgeStatut(rdv.Statut)</td>
                                    <td class="text-muted small">@rdv.DateCreationUtc.Horodate()</td>
                                    <td class="text-muted small">@(rdv.CommentaireAgent ?? "—")</td>
                                    <td>@Actions(rdv)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <Pagination Etat="_pagination1" AuChangement="StateHasChanged" />
                </div>
            </div>
        }
    }
    else if (_vue == VueAgenda.Mois)
    {
        @* ── Vue mois : grille calendrier, 3 rendez-vous visibles par jour puis « +N » ── *@
        <div class="cit-card p-0 overflow-hidden">
            <div class="cit-agenda-mois">
                @foreach (var jourSemaine in JoursDeSemaine(7))
                {
                    <div class="cit-agenda-mois-entete">@NomJourCourt(jourSemaine)</div>
                }
                @foreach (var jour in JoursDeLaPeriode())
                {
                    var rdvs = RendezVousDu(jour);
                    <button type="button"
                            class="cit-agenda-mois-cellule @(jour.Month != _dateReference.Month ? "hors-mois" : "") @(jour == Aujourdhui ? "aujourdhui" : "")"
                            @onclick="() => OuvrirJourAsync(jour)"
                            aria-label="@Loc["GuiAgenda.OpenDay", jour.ToString("dd/MM/yyyy"), rdvs.Count]">
                        <span class="cit-agenda-num">@jour.Day</span>
                        @foreach (var rdv in rdvs.Take(3))
                        {
                            <span class="cit-agenda-puce statut-@rdv.Statut.ToString().ToLowerInvariant()">
                                <span class="font-monospace">@rdv.HeureDebut.ToString(@"hh\:mm")</span> @rdv.Motif
                            </span>
                        }
                        @if (rdvs.Count > 3)
                        {
                            <span class="cit-agenda-plus">@Loc["GuiAgenda.MoreN", rdvs.Count - 3]</span>
                        }
                    </button>
                }
            </div>
        </div>
    }
    else
    {
        @* ── Vues semaine / semaine de travail : une colonne par jour ── *@
        <div class="cit-agenda-semaine" style="--jours: @JoursDeLaPeriode().Count();">
            @foreach (var jour in JoursDeLaPeriode())
            {
                var rdvs = RendezVousDu(jour);
                <section class="cit-agenda-colonne @(jour == Aujourdhui ? "aujourdhui" : "")">
                    <button type="button" class="cit-agenda-colonne-entete" @onclick="() => OuvrirJourAsync(jour)">
                        <span class="cit-agenda-jour-nom">@NomJourCourt(jour.DayOfWeek)</span>
                        <span class="cit-agenda-jour-num">@jour.Day</span>
                        @if (rdvs.Count > 0)
                        {
                            <span class="badge bg-primary-subtle text-primary">@rdvs.Count</span>
                        }
                    </button>
                    <div class="cit-agenda-colonne-corps">
                        @if (rdvs.Count == 0)
                        {
                            <div class="cit-agenda-vide">—</div>
                        }
                        @foreach (var rdv in rdvs)
                        {
                            <article class="cit-agenda-rdv statut-@rdv.Statut.ToString().ToLowerInvariant()">
                                <div class="cit-agenda-rdv-heure font-monospace">@Creneau(rdv)</div>
                                <div class="cit-agenda-rdv-motif">@rdv.Motif</div>
                                <div class="d-flex align-items-center justify-content-between gap-1 flex-wrap">
                                    @BadgeStatut(rdv.Statut)
                                    @Actions(rdv)
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>
        @if (_rendezVous.Count == 0)
        {
            <div class="text-center text-muted small mt-3">@Loc["GuiAgenda.NoRdvPeriod"]</div>
        }
    }
}

@code {
    private enum VueAgenda { Jour, SemaineTravail, Semaine, Mois }

    private readonly EtatPagination _pagination1 = new();

    private bool _chargementInitial = true;
    private bool _estHabilite;
    private Guid _agentId;

    private VueAgenda _vue = VueAgenda.SemaineTravail;
    private DateOnly _dateReference = DateOnly.FromDateTime(DateTime.Today);
    private bool _chargementAgenda;
    private IReadOnlyList<RendezVous> _rendezVous = [];
    private ILookup<DateOnly, RendezVous> _parJour = Array.Empty<RendezVous>().ToLookup(r => r.Date);

    private string? _messageErreur;
    private string? _messageSucces;

    private static DateOnly Aujourdhui => DateOnly.FromDateTime(DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            _agentId = contexte.UtilisateurId;
            _estHabilite = contexte.Permissions.Contains(Permission.RendezVousGerer);
            if (_estHabilite)
            {
                await ChargerAgendaAsync();
            }
        }
        finally
        {
            _chargementInitial = false;
        }
    }

    // ------------------------------------------------------------------ période affichée

    private (DateOnly Du, DateOnly Au) Periode()
    {
        switch (_vue)
        {
            case VueAgenda.Jour:
                return (_dateReference, _dateReference);
            case VueAgenda.SemaineTravail:
                return (Lundi(_dateReference), Lundi(_dateReference).AddDays(4));
            case VueAgenda.Semaine:
                return (Lundi(_dateReference), Lundi(_dateReference).AddDays(6));
            default:
                // Mois : 6 semaines complètes, du lundi précédant le 1er — grille toujours rectangulaire.
                var premier = new DateOnly(_dateReference.Year, _dateReference.Month, 1);
                var debut = Lundi(premier);
                return (debut, debut.AddDays(41));
        }
    }

    private static DateOnly Lundi(DateOnly d) => d.AddDays(-(((int)d.DayOfWeek + 6) % 7));

    private IEnumerable<DateOnly> JoursDeLaPeriode()
    {
        var (du, au) = Periode();
        for (var d = du; d <= au; d = d.AddDays(1))
        {
            yield return d;
        }
    }

    private static IEnumerable<DayOfWeek> JoursDeSemaine(int nombre) =>
        Enumerable.Range(0, nombre).Select(i => (DayOfWeek)((i + 1) % 7));

    private IReadOnlyList<RendezVous> RendezVousDu(DateOnly jour) => _parJour[jour].ToList();

    private string LibellePeriode
    {
        get
        {
            var culture = CultureInfo.CurrentUICulture;
            var (du, au) = Periode();
            return _vue switch
            {
                VueAgenda.Jour => Capitaliser(_dateReference.ToString("dddd d MMMM yyyy", culture)),
                VueAgenda.Mois => Capitaliser(_dateReference.ToString("MMMM yyyy", culture)),
                _ => du.Month == au.Month
                    ? $"{du.Day} – {au.ToString("d MMMM yyyy", culture)}"
                    : $"{du.ToString("d MMM", culture)} – {au.ToString("d MMM yyyy", culture)}",
            };
        }
    }

    private static string Capitaliser(string s) => string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s[1..];

    private static string NomJourCourt(DayOfWeek jour) =>
        Capitaliser(CultureInfo.CurrentUICulture.DateTimeFormat.GetAbbreviatedDayName(jour));

    private string LibelleVue(VueAgenda vue) => vue switch
    {
        VueAgenda.Jour => Loc["GuiAgenda.ViewDay"],
        VueAgenda.SemaineTravail => Loc["GuiAgenda.ViewWorkWeek"],
        VueAgenda.Semaine => Loc["GuiAgenda.ViewWeek"],
        _ => Loc["GuiAgenda.ViewMonth"],
    };

    private static string Creneau(RendezVous rdv) =>
        $"{rdv.HeureDebut.ToString(@"hh\:mm")} – {rdv.HeureFin.ToString(@"hh\:mm")}";

    // ------------------------------------------------------------------ navigation

    private async Task ChargerAgendaAsync()
    {
        _chargementAgenda = true;
        _messageErreur = null;
        try
        {
            // La lecture passe par un cas d'usage qui exige l'habilitation côté serveur.
            var (du, au) = Periode();
            _rendezVous = _vue == VueAgenda.Jour
                ? await ListerAgenda.ExecuterAsync(_agentId, _dateReference)
                : await ListerAgenda.ExecuterPeriodeAsync(_agentId, du, au);
            _parJour = _rendezVous.ToLookup(r => r.Date);
        }
        catch (Exception ex)
        {
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
        finally
        {
            _chargementAgenda = false;
        }
    }

    private Task ChangerVueAsync(VueAgenda vue)
    {
        _vue = vue;
        return ChargerAgendaAsync();
    }

    private Task DeplacerAsync(int sens)
    {
        _dateReference = _vue switch
        {
            VueAgenda.Jour => _dateReference.AddDays(sens),
            VueAgenda.Mois => _dateReference.AddMonths(sens),
            _ => _dateReference.AddDays(7 * sens),
        };
        return ChargerAgendaAsync();
    }

    private Task AllerAujourdhuiAsync()
    {
        _dateReference = Aujourdhui;
        return ChargerAgendaAsync();
    }

    private Task OuvrirJourAsync(DateOnly jour)
    {
        _dateReference = jour;
        _vue = VueAgenda.Jour;
        return ChargerAgendaAsync();
    }

    private async Task ChangerDateAsync(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
        {
            _dateReference = d;
            await ChargerAgendaAsync();
        }
    }

    // ------------------------------------------------------------------ rendu partagé

    private RenderFragment BadgeStatut(StatutRendezVous statut) => __builder =>
    {
        switch (statut)
        {
            case StatutRendezVous.Reserve:
                <span class="badge bg-primary">@Loc["GuiAgenda.StReserve"]</span>
                break;
            case StatutRendezVous.Honore:
                <span class="badge bg-success">@Loc["GuiAgenda.StHonore"]</span>
                break;
            case StatutRendezVous.Annule:
                <span class="badge bg-secondary">@Loc["GuiAgenda.StAnnule"]</span>
                break;
            case StatutRendezVous.NonPresente:
                <span class="badge bg-danger">@Loc["GuiAgenda.StNonPresente"]</span>
                break;
        }
    };

    private RenderFragment Actions(RendezVous rdv) => __builder =>
    {
        if (rdv.Statut == StatutRendezVous.Reserve)
        {
            <div class="btn-group btn-group-sm">
                <button class="btn btn-success" @onclick="() => ValiderPresenceAsync(rdv.Id)" title="@Loc["GuiAgenda.BtnPresentTitle"]">@Loc["GuiAgenda.BtnPresent"]</button>
                <button class="btn btn-outline-danger" @onclick="() => MarquerAbsenceAsync(rdv.Id)" title="@Loc["GuiAgenda.BtnAbsentTitle"]">@Loc["GuiAgenda.BtnAbsent"]</button>
            </div>
        }
        else
        {
            <span class="text-muted small">@Loc["GuiAgenda.Traite"]</span>
        }
    };

    // ------------------------------------------------------------------ actions (inchangées)

    private async Task ValiderPresenceAsync(Guid rdvId)
    {
        _messageErreur = null;
        _messageSucces = null;
        try
        {
            await MarquerHonoreCommand.ExecuterAsync(new MarquerHonoreRequest(_agentId, rdvId, Loc["GuiAgenda.PresenceComment"].Value));
            _messageSucces = Loc["GuiAgenda.SuccessPresence"].Value;
            await ChargerAgendaAsync();
        }
        catch (Exception ex)
        {
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
    }

    private async Task MarquerAbsenceAsync(Guid rdvId)
    {
        _messageErreur = null;
        _messageSucces = null;
        try
        {
            await MarquerNonPresenteCommand.ExecuterAsync(new MarquerNonPresenteRequest(_agentId, rdvId, Loc["GuiAgenda.AbsenceComment"].Value));
            _messageSucces = Loc["GuiAgenda.SuccessAbsence"].Value;
            await ChargerAgendaAsync();
        }
        catch (Exception ex)
        {
            _messageErreur = MessagesUtilisateur.Pour(ex);
        }
    }
}
