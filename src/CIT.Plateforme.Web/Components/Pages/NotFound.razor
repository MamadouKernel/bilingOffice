@page "/not-found"
@using CIT.Plateforme.Web.Resources
@using Microsoft.Extensions.Localization
@layout MainLayout
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["Error.404.PageTitle"]</PageTitle>

<div class="py-5 mx-auto" style="max-width: 720px;">
    <div class="cit-card text-center p-4 p-md-5 border-0 shadow-lg position-relative overflow-hidden" 
         style="border-radius: 1.5rem; background: linear-gradient(180deg, var(--surface) 0%, var(--surface-2) 100%); border-top: 5px solid var(--action);">
        
        <!-- Halo décoratif discret en arrière-plan -->
        <div class="position-absolute top-0 start-50 translate-middle-x pointer-events-none" 
             style="width: 280px; height: 140px; background: radial-gradient(circle, var(--azure-50) 0%, transparent 70%); border-radius: 50%;"></div>

        <!-- Icône de recherche 404 -->
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4 p-3 shadow-sm position-relative z-1" 
             style="width: 84px; height: 84px; background: var(--azure-100); border: 2px solid var(--action);">
            <span class="fs-1" role="img" aria-label="@Loc["Error.404.NotFoundAria"]">🔍</span>
        </div>

        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-bold mb-3 border border-primary-subtle">
            <span>⚓</span> @Loc["Error.404.Badge"]
        </div>

        <h1 class="fw-bold text-dark mb-2 h2">
            @Loc["Error.404.Title"] <span class="badge bg-primary bg-opacity-10 text-primary fs-6 align-middle border border-primary-subtle ms-1 px-3 py-1 rounded-pill">404</span>
        </h1>

        <p class="text-secondary mb-4 mx-auto" style="max-width: 520px; line-height: 1.6; font-size: 1rem;">
            @Loc["Error.404.Body"]
        </p>

        <!-- Liens rapides utiles -->
        <div class="row g-3 text-start mb-4 mx-auto" style="max-width: 540px;">
            <div class="col-12 col-sm-6">
                <a href="/comptes/connexion" class="p-3 bg-light rounded-3 border d-block text-decoration-none text-dark h-100 hover-shadow">
                    <div class="fw-bold text-primary mb-1">🔑 @Loc["Error.404.LoginLinkTitle"]</div>
                    <div class="small text-muted">@Loc["Error.404.LoginLinkText"]</div>
                </a>
            </div>
            <div class="col-12 col-sm-6">
                <a href="/simulation/proforma" class="p-3 bg-light rounded-3 border d-block text-decoration-none text-dark h-100 hover-shadow">
                    <div class="fw-bold text-primary mb-1">🧮 @Loc["Error.404.SimLinkTitle"]</div>
                    <div class="small text-muted">@Loc["Error.404.SimLinkText"]</div>
                </a>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-center align-items-center gap-3">
            <a href="/" class="btn btn-primary px-4 py-2 fw-semibold rounded-pill shadow-sm d-inline-flex align-items-center gap-2">
                <span>🏠</span> @Loc["Common.BackHome"]
            </a>
            <a href="/client/dashboard" class="btn btn-outline-secondary px-4 py-2 fw-semibold rounded-pill d-inline-flex align-items-center gap-2">
                <span>📊</span> @Loc["Tableau de bord"]
            </a>
        </div>
    </div>
</div>