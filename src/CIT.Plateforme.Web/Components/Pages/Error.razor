@page "/Error"
@using System.Diagnostics
@using CIT.Plateforme.Web.Resources
@using Microsoft.Extensions.Localization
@layout MainLayout
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["Error.500.PageTitle"]</PageTitle>

<div class="py-5 mx-auto" style="max-width: 760px;">
    <div class="cit-card text-center p-4 p-md-5 border-0 shadow-lg position-relative overflow-hidden" 
         style="border-radius: 1.5rem; background: linear-gradient(180deg, var(--surface) 0%, var(--surface-2) 100%); border-top: 5px solid var(--signal-500);">
        
        <!-- Halo décoratif discret en arrière-plan -->
        <div class="position-absolute top-0 start-50 translate-middle-x pointer-events-none" 
             style="width: 280px; height: 140px; background: radial-gradient(circle, var(--warn-100) 0%, transparent 70%); border-radius: 50%;"></div>

        <!-- Icône d'incident -->
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4 p-3 shadow-sm position-relative z-1" 
             style="width: 84px; height: 84px; background: var(--warn-100); border: 2px solid var(--signal-500);">
            <span class="fs-1" role="img" aria-label="@Loc["Error.500.IncidentAria"]">⚠️</span>
        </div>

        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-warning bg-opacity-10 text-warning small fw-bold mb-3 border border-warning-subtle">
            <span>⚡</span> @Loc["Error.500.Badge"]
        </div>

        <h1 class="fw-bold text-dark mb-2 h2">
            @Loc["Error.500.Title"] <span class="badge bg-warning bg-opacity-10 text-dark fs-6 align-middle border border-warning-subtle ms-1 px-3 py-1 rounded-pill">500</span>
        </h1>

        <p class="text-secondary mb-4 mx-auto" style="max-width: 540px; line-height: 1.6; font-size: 1rem;">
            @Loc["Error.500.Body"]
        </p>

        @if (ShowRequestId)
        {
            <div class="p-3 bg-light rounded-4 border mb-4 text-start mx-auto" style="max-width: 540px;">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-semibold">@Loc["Error.500.RequestIdLabel"]</span>
                    <span class="badge bg-secondary-subtle text-dark">@Loc["Error.500.AuditBadge"]</span>
                </div>
                <div class="font-monospace fw-bold text-dark fs-6 text-break">@RequestId</div>
            </div>
        }

        <div class="d-flex flex-wrap justify-content-center align-items-center gap-3">
            <a href="/" class="btn btn-primary px-4 py-2 fw-semibold rounded-pill shadow-sm d-inline-flex align-items-center gap-2">
                <span>🏠</span> @Loc["Common.BackHome"]
            </a>
            <button type="button" data-reload class="btn btn-outline-secondary px-4 py-2 fw-semibold rounded-pill d-inline-flex align-items-center gap-2">
                <span>🔄</span> @Loc["Common.Retry"]
            </button>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
