@page "/Error"
@using System.Diagnostics

<PageTitle>Erreur — CIT</PageTitle>

<div class="cit-page-header">
    <div>
        <h2 class="cit-page-title text-danger">
            <span>⚠️</span> Erreur d'exécution
        </h2>
        <div class="cit-page-subtitle">Une anomalie inattendue est survenue lors du traitement de votre requête</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="/" class="btn btn-outline-secondary btn-sm shadow-sm">← Retour à l'accueil</a>
    </div>
</div>

<div style="max-width: 800px;">
    <div class="cit-card border-danger mb-4">
        <h5 class="fw-bold text-danger mb-3">Détail de l'incident</h5>
        <p class="text-muted">
            Un incident a interrompu l'opération demandée. Veuillez réitérer ultérieurement ou contacter l'assistance technique si le problème persiste.
        </p>

        @if (ShowRequestId)
        {
            <div class="p-3 bg-light rounded-3 border mb-3">
                <span class="text-muted small">Identifiant de suivi d'incident (Request ID) :</span>
                <div class="font-monospace fw-bold text-dark mt-1">@RequestId</div>
            </div>
        }

        <div class="alert alert-secondary small mb-0">
            <strong>Mode Développement :</strong> Activez la variable <code>ASPNETCORE_ENVIRONMENT=Development</code> sur votre environnement local pour visualiser la trace détaillée de la pile.
        </div>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
