@using CIT.Plateforme.Application.Affectation
@using CIT.Plateforme.Domain.Affectation
@using CIT.Plateforme.Web.Services
@inject IContexteUtilisateurWeb ContexteService
@using Microsoft.Extensions.DependencyInjection
@inject Microsoft.Extensions.DependencyInjection.IServiceScopeFactory ScopeFactory

<div class="cit-card mb-4 p-3 border-start border-4 @(_estDisponible ? "border-success" : "border-danger")">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center @(_estDisponible ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")" style="width: 44px; height: 44px; font-size: 1.25rem;">
                @(_estDisponible ? "🟢" : "🔴")
            </div>
            <div>
                <div class="fw-bold fs-6 text-dark">
                    Statut Opérateur : <span class="@(_estDisponible ? "text-success" : "text-danger")">@(_estDisponible ? "Disponible pour affectation" : "Indisponible / En pause")</span>
                </div>
                <div class="small text-muted">
                    @(_estDisponible ? "Vous êtes éligible à la distribution automatique de tickets." : "Aucun nouveau ticket ne vous sera attribué automatiquement.")
                </div>
            </div>
        </div>
        <div>
            @if (_changementEnCours)
            {
                <span class="spinner-border spinner-border-sm text-primary"></span>
            }
            else
            {
                <button type="button" class="btn @(_estDisponible ? "btn-outline-danger" : "btn-success") btn-sm px-4 fw-bold shadow-sm" @onclick="BasculerDisponibiliteAsync">
                    @(_estDisponible ? "Passer en indisponible" : "Se déclarer disponible")
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public bool EstDisponibleInitial { get; set; } = true;

    [Parameter]
    public Guid AgentId { get; set; }

    [Parameter]
    public EventCallback<bool> OnDisponibiliteChangee { get; set; }

    private bool _estDisponible;
    private bool _changementEnCours;

    protected override void OnParametersSet()
    {
        _estDisponible = EstDisponibleInitial;
    }

    private async Task BasculerDisponibiliteAsync()
    {
        _changementEnCours = true;
        try
        {
            var contexte = await ContexteService.ObtenirContexteAsync();
            var nouveauStatut = _estDisponible ? StatutDisponibilite.Indisponible : StatutDisponibilite.Disponible;
            // Portée dédiée : ce bandeau est incrusté dans des pages qui chargent leurs propres
            // données. Partager le DbContext scopé exposait aux collisions de threads.
            using var scope = ScopeFactory.CreateScope();
            var gererDisponibilite = scope.ServiceProvider.GetRequiredService<GererDisponibiliteCommand>();
            await gererDisponibilite.DefinirAsync(contexte.UtilisateurId, AgentId, nouveauStatut);
            _estDisponible = !_estDisponible;
            await OnDisponibiliteChangee.InvokeAsync(_estDisponible);
        }
        catch (Exception)
        {
            // En cas d'erreur, ne pas basculer l'état
        }
        finally
        {
            _changementEnCours = false;
        }
    }
}
