@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc

@* Pièces jointes d'un formulaire de demande : choisies avant l'envoi, déposées sur le ticket créé
   (contrôle de format, de taille et antivirus au dépôt). Plusieurs sélections s'ajoutent. *@
<div class="mb-3">
    <label class="form-label fw-semibold text-dark" for="@_id">@Loc["PJ.Label"]</label>
    <ZoneDepot Id="@_id" Accept="@Formats" OnChange="Ajouter" />
    <div class="form-text small text-muted">@Loc["PJ.HintFormats", FormatsLisibles, DepotFichiers.MaxParDepot] @Loc["PJ.Differe"]</div>
    @if (_erreur is not null)
    {
        <div class="small text-danger mt-1" role="alert">@_erreur</div>
    }
    @if (Fichiers.Count > 0)
    {
        <ul class="pj-liste">
            @foreach (var f in Fichiers)
            {
                <li class="pj-item">
                    <span class="pj-badge">@Path.GetExtension(f.Name).TrimStart('.').ToUpperInvariant()</span><span class="pj-nom" title="@f.Name">@f.Name</span><span class="pj-taille">@((f.Size / 1024.0).ToString("0.0")) @Loc["Common.KoUnit"]</span>
                    <button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => Fichiers.Remove(f)">@Loc["PJ.Remove"]</button>
                </li>
            }
        </ul>
    }
</div>

@code {
    /// <summary>Liste tenue par le formulaire hôte, qui dépose ces fichiers après la création du ticket.</summary>
    [Parameter, EditorRequired] public List<IBrowserFile> Fichiers { get; set; } = [];

    /// <summary>Extensions acceptées (attribut <c>accept</c>) ; le dépôt revérifie côté serveur.</summary>
    [Parameter] public string Formats { get; set; } = ".pdf,.jpg,.jpeg,.png,.xlsx";

    private string FormatsLisibles => string.Join(", ", Formats.Split(',')
        .Select(f => f.Trim().TrimStart('.').ToUpperInvariant()).Where(f => f != "JPEG"));

    private readonly string _id = $"pieces-{Guid.NewGuid():N}";
    private string? _erreur;

    private void Ajouter(InputFileChangeEventArgs e)
    {
        _erreur = null;
        var choisis = DepotFichiers.Lire(e);
        if (choisis is null || Fichiers.Count + choisis.Count > DepotFichiers.MaxParDepot)
        {
            _erreur = Loc["Docs.TooManyFiles", DepotFichiers.MaxParDepot].Value;
            return;
        }

        Fichiers.AddRange(choisis);
    }
}
