@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc

@* Écart 06/10 #1 — document commun à plusieurs BL/bookings : le client dépose UNE fois une pièce et
   coche les références concernées. Un seul dépôt physique au moment de la soumission. *@
<div class="mb-3">
    <div class="form-label fw-semibold text-dark mb-1">📎 @Loc["DocCommun.Titre"]</div>
    <div class="form-text small text-muted mb-2">@Loc["DocCommun.Intro"]</div>

    @if (References.Count == 0)
    {
        <div class="small text-muted fst-italic">@Loc["DocCommun.SaisirRefs"]</div>
    }
    else
    {
        <ZoneDepot Compact="true" Multiple="false" Accept=".pdf,.jpg,.jpeg,.png,.xlsx" OnChange="Ajouter" />
        @foreach (var doc in Documents)
        {
            <div class="border rounded p-2 mt-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small fw-semibold text-success">✓ @doc.Fichier.Name</span>
                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => Documents.Remove(doc)">✕</button>
                </div>
                <div class="small text-muted mb-1">@Loc["DocCommun.AssocierA"]</div>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var reference in References)
                    {
                        var r = reference;
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@($"dc-{doc.Fichier.Name}-{r}")"
                                   checked="@doc.References.Contains(r)"
                                   @onchange="e => Basculer(doc, r, e.Value is true)" />
                            <label class="form-check-label small font-monospace" for="@($"dc-{doc.Fichier.Name}-{r}")">@r</label>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    /// <summary>Références (BL/booking) saisies dans le formulaire, proposées à la sélection.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> References { get; set; } = [];

    /// <summary>Liste possédée par le parent : la soumission la dépose après création des tickets.</summary>
    [Parameter, EditorRequired] public List<DocumentCommunSaisi> Documents { get; set; } = default!;

    private void Ajouter(InputFileChangeEventArgs e)
    {
        foreach (var fichier in e.GetMultipleFiles())
        {
            // Par défaut un document commun concerne toutes les références saisies ; le client décoche au besoin.
            Documents.Add(new DocumentCommunSaisi(fichier, new HashSet<string>(References, StringComparer.OrdinalIgnoreCase)));
        }
    }

    private static void Basculer(DocumentCommunSaisi doc, string reference, bool actif)
    {
        if (actif) { doc.References.Add(reference); } else { doc.References.Remove(reference); }
    }
}
