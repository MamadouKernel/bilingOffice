@using CIT.Plateforme.Web.Resources

<div class="cit-chargement d-flex flex-column align-items-center justify-content-center py-5">
    <div class="spinner-border text-primary mb-3" role="status" style="width: 2.5rem; height: 2.5rem;">
        <span class="visually-hidden">@SharedResourcesLocalizer.Get("Common.Loading")</span>
    </div>
    <p class="text-muted fw-medium">@(Message ?? SharedResourcesLocalizer.Get("Common.LoadingData"))</p>
</div>

@code {
    [Parameter]
    public string? Message { get; set; }
}
