@using CIT.Plateforme.Domain.Comptes
@using CIT.Plateforme.Web.Resources
@using CIT.Plateforme.Web.Services
@using Microsoft.Extensions.Localization
@inject AnnuaireClients Annuaire
@inject IStringLocalizer<SharedResources> Loc

@* Client du dossier, sous le n° de BL ou de booking : l'agent voit pour qui il traite (et le profil,
   qui change la facturation) sans ouvrir la fiche. *@
@if (_client is not null)
{
    <div class="small text-muted text-truncate" style="max-width: 16rem;" title="@_client.Nom">
        🏢 @_client.Nom
        @if (_client.Profil != TypeClient.Normal)
        {
            <span class="badge bg-secondary-subtle text-secondary ms-1">@Loc[$"ProfilClient.{_client.Profil}"]</span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid DossierId { get; set; }

    private ClientDossier? _client;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _client = await Annuaire.ObtenirAsync(DossierId);
        }
        catch (Exception)
        {
            // Information de confort : la file reste utilisable si le client ne peut être lu.
            _client = null;
        }
    }
}
