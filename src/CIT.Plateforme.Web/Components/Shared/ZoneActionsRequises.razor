@using CIT.Plateforme.Application.Client
@using CIT.Plateforme.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Loc

@if (Actions is not null && Actions.Count > 0)
{
    <div class="cit-action-box mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4">⚠️</span>
                <h5 class="m-0 fw-bold text-dark">
                    @Loc["Zar.TitlePrefix"] (@Actions.Count)
                </h5>
            </div>
            <span class="badge bg-warning text-dark px-3 py-1 fw-semibold">@Loc["Zar.Badge"]</span>
        </div>

        <div class="d-flex flex-column gap-3">
            @foreach (var action in Actions)
            {
                <div class="card border-0 bg-white shadow-sm p-3">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-secondary">Ticket #@action.NumeroTicket</span>
                                @if (!string.IsNullOrWhiteSpace(action.NumeroBl))
                                {
                                    <span class="badge bg-primary">BL @action.NumeroBl</span>
                                }
                            </div>
                            <h6 class="fw-bold m-0 text-dark">@action.Titre</h6>
                            <p class="small text-muted m-0 mt-1">@action.Description</p>
                        </div>
                        <a href="@action.UrlCible" class="btn btn-warning btn-sm text-dark fw-semibold text-nowrap px-3 py-2">
                            👉 @action.ActionLibelle
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    @* Rien à faire : on le dit clairement plutôt que de laisser un vide qui inquiète. *@
    <div class="cit-card border-0 shadow-sm bg-success-subtle d-flex align-items-center gap-3 p-3 mb-4">
        <span class="fs-3" aria-hidden="true">✅</span>
        <div>
            <h6 class="fw-bold m-0 text-success-emphasis">@Loc["Zar.EmptyTitle"]</h6>
            <p class="small text-muted m-0">@Loc["Zar.EmptyText"]</p>
        </div>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<ActionRequiseItemVue>? Actions { get; set; }
}
