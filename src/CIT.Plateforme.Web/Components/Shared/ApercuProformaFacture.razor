@using CIT.Plateforme.Application.Tarification

@* Facture proforma — design officiel CIT (maquette HTML). Composant paramétré, réutilisable par le
   simulateur live et la page de détail. Document de présentation : toujours sur fond clair. *@

@{
    var trafic = (Sens?.Libelle ?? "").StartsWith("Export", StringComparison.OrdinalIgnoreCase) ? "Export" : "Import";
    var rubriques = ConstruireRubriques();
}

<div class="facture">
    <div class="f-top">
        <div class="f-brand">
            <div class="cit">CÔTE D'IVOIRE TERMINAL<small>ABIDJAN</small></div>
        </div>
        <div class="f-title">
            <div class="t1">@TexteProforma.T("FACTURE PROFORMA")</div>
            <div class="t2">@TexteProforma.T("Simulation — document non contractuel")</div>
        </div>
        <div class="f-num">
            @TexteProforma.T("N° simulation")<br />
            <b>@(string.IsNullOrWhiteSpace(Reference) ? "SIM-" + DateTime.UtcNow.Ticks.ToString()[^8..] : Reference)</b>
        </div>
    </div>

    <div class="f-meta">
        <div>
            <div class="line"><span class="k">@TexteProforma.T("Client")</span><span>@Ou(ClientNom)</span></div>
            <div class="line"><span class="k">@TexteProforma.T("Type client")</span><span>@Ou(TexteProforma.T(TypeClient ?? ""))</span></div>
            <div class="line"><span class="k">@TexteProforma.T("Trafic")</span><span>@trafic</span></div>
            <div class="line"><span class="k">@TexteProforma.T("Port de chargement")</span><span>@Ou(PortChargement)</span></div>
            <div class="line"><span class="k">@TexteProforma.T("Port de déchargement")</span><span>@Ou(PortDechargement)</span></div>
        </div>
        <div>
            <div class="line"><span class="k">@TexteProforma.T("Date d'arrivée navire")</span><span>@DateArrivee.ToString("dd/MM/yyyy")</span></div>
            <div class="line"><span class="k">@TexteProforma.T("Date d'enlèvement")</span><span>@DateEnlevement.ToString("dd/MM/yyyy")</span></div>
            <div class="line"><span class="k">@TexteProforma.T("Durée de séjour")</span><span>@Duree @TexteProforma.T("jour(s)")</span></div>
            <div class="line"><span class="k">@TexteProforma.T("Escale")</span><span>@Ou(Escale)</span></div>
            <div class="line"><span class="k">@TexteProforma.T("Grille appliquée")</span><span>@Ou(GrilleLibelle)</span></div>
        </div>
    </div>

    <table class="f-esc">
        <thead>
            <tr><th>@TexteProforma.T("Navire")</th><th>@TexteProforma.T("Voyage")</th><th>BL / Booking</th></tr>
        </thead>
        <tbody>
            <tr>
                <td>@Ou(Navire)</td>
                <td>@Ou(Voyage)</td>
                <td>@Ou(Bl)</td>
            </tr>
        </tbody>
    </table>

    <table class="f-rub">
        <thead>
            <tr><th>@TexteProforma.T("Rubriques")</th><th class="num">@TexteProforma.T("Montant CFA")</th><th class="num">@TexteProforma.T("Total CFA")</th></tr>
        </thead>
        <tbody>
            @if (rubriques.Count == 0)
            {
                <tr><td colspan="3" class="vide">@TexteProforma.T("Aucune rubrique facturable.")</td></tr>
            }
            else
            {
                @foreach (var r in rubriques)
                {
                    <tr>
                        <td>
                            <div class="grp-title">@r.Presta</div>
                            <div class="grp-calc">@r.Qte @TexteProforma.T("Unité(s)") &nbsp;*&nbsp; @Fmt(r.Pu) XOF</div>
                        </td>
                        <td class="num">@Fmt(r.Total)</td>
                        <td class="grp-total">@Fmt(r.Total)</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="f-totes">
        <div class="l"><span>@TexteProforma.T("Montant Total Hors Taxes Prestations")</span><span>@Fmt(Total) CFA</span></div>
        <div class="l"><span>@TexteProforma.T("Montant Total TVA")</span><span>0 CFA</span></div>
        <div class="l big"><span>@TexteProforma.T("Montant Total à Payer")</span><span>@Fmt(Total) CFA</span></div>
    </div>

    @if (Total > 0)
    {
        <div class="f-lettres">@TexteProforma.MontantEnLettres(Total).ToUpperInvariant()</div>
    }

    @if (!string.IsNullOrWhiteSpace(MentionLegale))
    {
        <div class="f-legal">@TexteProforma.T(MentionLegale)</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ReferenceTarifaireVue? Sens { get; set; }
    [Parameter] public DateOnly DateArrivee { get; set; }
    [Parameter] public DateOnly DateEnlevement { get; set; }
    [Parameter] public int Duree { get; set; }
    [Parameter] public IReadOnlyList<LigneResultatSimulationVue> Lignes { get; set; } = [];
    [Parameter] public decimal Total { get; set; }
    [Parameter] public string? MentionLegale { get; set; }
    [Parameter] public string? Reference { get; set; }
    [Parameter] public string? GrilleLibelle { get; set; }
    [Parameter] public string? Navire { get; set; }
    [Parameter] public string? Voyage { get; set; }
    [Parameter] public string? Bl { get; set; }
    [Parameter] public string? ClientNom { get; set; }
    [Parameter] public string? TypeClient { get; set; }
    [Parameter] public string? Escale { get; set; }
    [Parameter] public string? PortChargement { get; set; }
    [Parameter] public string? PortDechargement { get; set; }

    private sealed record Rubrique(string Presta, int Qte, decimal Pu, decimal Total, int Ordre);

    private static string Ou(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;

    private static string Fmt(decimal n) =>
        Math.Round(n).ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"));

    /// <summary>
    /// Agrège les postes de tous les conteneurs par (libellé + taille + prix unitaire), comme la
    /// maquette : une même prestation au même tarif forme une ligne « Qté × PU ».
    /// </summary>
    private IReadOnlyList<Rubrique> ConstruireRubriques()
    {
        var sens = Sens?.Libelle ?? "";
        var groupes = new Dictionary<string, (string Presta, int Qte, decimal Pu, decimal Total, int Ordre)>();

        void Ajouter(string lib, string tailleCode, decimal pu, int ordre)
        {
            if (pu <= 0) return;
            var cle = $"{lib}|{tailleCode}|{pu}";
            var presta = $"{sens} - {lib} {tailleCode}";
            if (groupes.TryGetValue(cle, out var g))
            {
                groupes[cle] = (presta, g.Qte + 1, pu, g.Total + pu, ordre);
            }
            else
            {
                groupes[cle] = (presta, 1, pu, pu, ordre);
            }
        }

        foreach (var l in Lignes)
        {
            var t = l.Taille.Code;
            Ajouter(TexteProforma.T("Acconage Plein"), t, l.Acconage, 1);
            Ajouter(TexteProforma.T("Relevage Plein"), t, l.Relevage, 2);
            Ajouter(TexteProforma.T("Branchement Frigo"), t, l.BranchementFrigorifique, 3);
            Ajouter(TexteProforma.T("Majoration Lourd"), t, l.MajorationLourd, 4);
            Ajouter(TexteProforma.T("Majoration Dangereux"), t, l.MajorationDangereux, 5);
            Ajouter(TexteProforma.T("Majoration Hors Gabarit"), t, l.MajorationHorsGabarit, 6);
            foreach (var part in l.RepartitionStationnement)
            {
                Ajouter($"{TexteProforma.T("Stationnement")} {part.Beneficiaire}", t, part.Montant, 7);
            }
        }

        return groupes.Values
            .OrderBy(g => g.Ordre)
            .ThenBy(g => g.Presta, StringComparer.Ordinal)
            .Select(g => new Rubrique(g.Presta, g.Qte, g.Pu, g.Total, g.Ordre))
            .ToList();
    }
}
