@using CIT.Plateforme.Domain.Tickets
@using CIT.Plateforme.Web.Resources

<span class="cit-badge @BadgeClass">
    @Libelle
</span>

@code {
    [Parameter, EditorRequired]
    public StatutTicket Statut { get; set; }

    [Parameter]
    public bool EstRejetManifeste { get; set; }

    private string BadgeClass => EstRejetManifeste ? "cit-badge-rejet" : Statut switch
    {
        StatutTicket.EnAttenteDePriseEnCharge => "cit-badge-attente",
        StatutTicket.EnCours => "cit-badge-encours",
        StatutTicket.EnAttenteClient => "cit-badge-client",
        StatutTicket.Cloture => "cit-badge-cloture",
        StatutTicket.Annule => "cit-badge-annule",
        _ => "cit-badge-annule"
    };

    // NFR-07 — libellé localisé (FR/EN) via la source de traduction partagée. La valeur interne
    // de l'énum n'est jamais affichée brute ; le libellé suit la culture active. Le défaut fr-FR
    // rend exactement les mêmes chaînes qu'auparavant (aucune régression en français).
    private string Libelle => EstRejetManifeste
        ? SharedResourcesLocalizer.Get("Statut.Ticket.RejetManifeste")
        : SharedResourcesLocalizer.Get($"Statut.Ticket.{Statut}");
}
