{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PlateformeDb": ""
  },
  "Securite": {
    "Fichiers": {
      "ExtensionsAutorisees": [ ".pdf", ".jpg", ".jpeg", ".png", ".xlsx" ],
      "TailleMaxOctets": 10485760
    },
    "Antivirus": {
      "Mode": "Defender",
      "FailClosed": true,
      "TimeoutSecondes": 15
    }
  }
}
